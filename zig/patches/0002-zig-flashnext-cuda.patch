+        const w8 = try L.staging(npad * k);
+        try fp8.fragmentOrder(codes, n, k, npad, w8);
+        var pb: [192]u8 = undefined;
+        var l: fp8.Linear = .{ .n = @intCast(n), .k = @intCast(k), .npad = @intCast(npad) };
