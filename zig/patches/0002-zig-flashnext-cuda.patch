index 00000000..1691ae5f
--- /dev/null
+++ b/zig/tests/cuda/flashnext/box/capture.sh
@@ -0,0 +1,70 @@
+#!/bin/bash
+# The Python Flash Next engine's oracle run for the Zig port (TP=1): launches, dumps, digests, tokens, then the manifest
+# and the packed kernel set. Usage: TF_FN=<work dir: TensorFold/ out/ aot/> TF_MODEL=<snapshot dir> \
+#   flock <work>/gpu.lock bash -u capture.sh RUN [capture.py options]
+set -u
+RUN="${1:?run id}"
+shift
+MORE=("$@")
+TF="${TF_FN:?set TF_FN}"
+MODEL="${TF_MODEL:?set TF_MODEL}"
+SRC="${TF:?}/TensorFold"
+OUT="${TF:?}/out/${RUN:?}"
+CACHE="${TF:?}/aot/${RUN:?}"
+IMAGE="${TF_ZIG_IMAGE:-nvcr.io/nvidia/pytorch:26.07-py3}"
+NAME="fnz-capture-${RUN:?}"
+MIN_KB=$(( ${TF_MIN_AVAILABLE_GIB:-8} * 1024 * 1024 ))
+HF="${HF_HOME_HOST:-$HOME/.cache/huggingface}"
+mkdir -p "${OUT:?}" "${CACHE:?}/triton" "${CACHE:?}/torch_ext" "${CACHE:?}/cuda_cache"
+
+apps=$(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader)
+if [ -n "$apps" ]; then echo "PREFLIGHT-FAIL: compute apps present: $apps"; exit 3; fi
+if docker ps -a --format '{{.Names}}' | grep -qx "$NAME"; then echo "PREFLIGHT-FAIL: $NAME exists"; exit 3; fi
+avail=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
+if [ "$avail" -lt $(( 100 * 1024 * 1024 )) ]; then echo "PREFLIGHT-FAIL: MemAvailable ${avail} kB < 100 GiB"; exit 3; fi
+free_gb=$(df -BG --output=avail / | tail -1 | tr -dc 0-9)
+if [ "$free_gb" -lt 110 ]; then echo "PREFLIGHT-FAIL: ${free_gb} GB free on /"; exit 3; fi
+{ git -C "$SRC" rev-parse HEAD; git -C "$SRC" status --short src; } > "${OUT:?}/tree.txt" 2>&1
+case "$MODEL" in "$HF"/*) INNER="/hf/${MODEL#"$HF"/}";; *) echo "model must be under $HF"; exit 2;; esac
+
+# TF_CAPTURE_ENV="NAME=value ...": extra engine settings for the container (e.g. TF_FLASHNEXT_YARN=4.0)
+envs=()
+for kv in ${TF_CAPTURE_ENV:-}; do envs+=(-e "$kv"); done
+echo "${TF_CAPTURE_ENV:-}" > "${OUT:?}/capture_env.txt"
+
+cleanup() { docker stop --time 20 "$NAME" >/dev/null 2>&1; docker rm -f "$NAME" >/dev/null 2>&1; }
+trap 'cleanup; kill $WATCH 2>/dev/null; exit 143' TERM INT
+
+date -u +"start %FT%TZ" > "${OUT:?}/mem.log"
+docker run -d --name "$NAME" --user "$(id -u):$(id -g)" --gpus all --ipc host --network none --shm-size 16g --ulimit memlock=-1 \
+  --ulimit stack=67108864 --read-only --tmpfs /tmp:size=8g \
+  -v "$HF:/hf:ro" -e HF_HOME=/hf -v "${SRC:?}:/tensorfold:ro" -v "${OUT:?}:/out" -v "${CACHE:?}:/aot" \
+  -e HOME=/tmp -e PYTHONPATH=/tensorfold/src -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONUNBUFFERED=1 \
+  "${envs[@]}" -e HF_HUB_OFFLINE=1 -e TENSORFOLD_NO_UPDATE_CHECK=1 -e TORCH_CUDA_ARCH_LIST=12.1 \
+  -e TRITON_CACHE_DIR=/aot/triton -e TORCH_EXTENSIONS_DIR=/aot/torch_ext -e CUDA_CACHE_PATH=/aot/cuda_cache \
+  -w /tensorfold --entrypoint python "$IMAGE" -B /tensorfold/zig/tests/cuda/flashnext/capture.py \
+  --model "$INNER" --out /out --tools /tensorfold/tools/zig "${MORE[@]}" > /dev/null || { cleanup; exit 4; }
+
+# the memory watchdog: GB10's unified memory freezes the machine when exhausted
+( while docker ps -q --filter "name=^${NAME}$" | grep -q .; do
+    kb=$(awk '/MemAvailable/ {print $2}' /proc/meminfo)
+    echo "$(date -u +%T) MemAvailable_kB=$kb" >> "${OUT:?}/mem.log"
+    if [ "$kb" -lt "$MIN_KB" ]; then echo "WATCHDOG: stopping $NAME at $kb kB" >> "${OUT:?}/mem.log"; docker stop --time 5 "$NAME"; fi
+    sleep 5
+  done ) &
+WATCH=$!
+rc=$(timeout "${TF_TIMEOUT:-5400}" docker wait "$NAME" || echo 124)
+docker logs "$NAME" > "${OUT:?}/capture.log" 2>&1
+kill $WATCH 2>/dev/null
+cleanup
+echo "container rc $rc"
+if [ "$rc" = 0 ]; then
+  python3 -B "${SRC:?}/tools/zig/triton_aot_manifest.py" --cache "${CACHE:?}/triton" --launches "${OUT:?}/launches.json" \
+    --mount /aot/triton --out "${OUT:?}/manifest.json" || rc=5
+fi
+if [ "$rc" = 0 ]; then
+  python3 -B "${SRC:?}/tools/zig/aot_pack.py" --manifest "${OUT:?}/manifest.json" --cache "${CACHE:?}/triton" \
+    --jit "${OUT:?}/jit.json" --out "${CACHE:?}" > "${OUT:?}/pack.log" 2>&1 || { rc=6; cat "${OUT:?}/pack.log"; }
+fi
+echo "rc $rc"
+exit "$rc"
diff --git a/zig/tests/cuda/flashnext/box/comm.sh b/zig/tests/cuda/flashnext/box/comm.sh
new file mode 100644
index 00000000..d6dce17f
--- /dev/null
+++ b/zig/tests/cuda/flashnext/box/comm.sh
@@ -0,0 +1,88 @@
+#!/bin/bash
+# Flash Next's two-rank transport on a pair of Sparks: builds tf-flashnext-comm (zig/tests/cuda/flashnext/comm_test.zig)
+# in the PyTorch image (no GPU, no network), copies it to both boxes, and runs rank 0 on HOST0 and rank 1 on HOST1 in
+# that image with the recipe's NCCL settings (scripts/nodes.sh: the link's netdev, both PCIe rails of the cabled CX7
+# port, the RoCE v2 GID index, 4 channels), each under its box's GPU lock.
+# Usage: TF_FN=<work dir: src/ out/ cache/> TF_ZIG=<zig binary> bash -u comm.sh RUN HOST0 HOST1 PEER [PORT] [ITERS] [WARMUP]
+#   HOST0, HOST1: ssh targets (user@address) or "local" for this machine; PEER: HOST1's address on the CX7 link (the
+#   link and MASTER, HOST0's link address, are found from the route to it, as nodes.sh's detect_link does).
+# Env: TF_NODES_SH (default $TF_FN/../scripts/nodes.sh), TF_ZIG_IMAGE, TF_SKIP_BUILD=1, NCCL_RAILS=1 (one rail),
+#   NCCL_CHANNELS (4), TF_NCCL_DEBUG (INFO), TF_LOCK0 / TF_LOCK1 (the GPU lock: ~/fnz-gpu.lock; on spark1 work/gpu.lock),
+#   TF_NCCL_EXTRA (more docker -e settings for both ranks, e.g. "-e NCCL_PROTO=LL -e NCCL_BUFFSIZE=1048576").
+# Writes out/RUN/{build.log,link.txt,rank0.log,rank1.log}. Containers fnz-comm-RUN-r0/-r1, removed after.
+set -u
+RUN="${1:?run id}"; HOST0="${2:?host of rank 0}"; HOST1="${3:?host of rank 1}"; PEER="${4:?rank 1 address on the link}"
+PORT="${5:-29561}"; ITERS="${6:-1000}"; WARMUP="${7:-100}"
+TF="${TF_FN:?set TF_FN}"
+IMAGE="${TF_ZIG_IMAGE:-nvcr.io/nvidia/pytorch:26.07-py3}"
+NODES="${TF_NODES_SH:-${TF:?}/../scripts/nodes.sh}"
+OUT="${TF:?}/out/${RUN:?}"
+SRC="${TF:?}/src"
+BIN="${OUT:?}/zig-out/bin/tf-flashnext-comm"
+REMOTE_DIR='fnz-work/comm'
+mkdir -p "${OUT:?}"
+[[ -w "${OUT:?}" ]] || { echo "${OUT} is not writable (made by a container as root?): use another RUN"; exit 1; }
+
+on() { # on <host> <command>: run on a box (local: here)
+  local h=$1; shift
+  if [[ "$h" == local ]]; then bash -c "$*"; else ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 "$h" "$*"; fi
+}
+
+if [[ "${TF_SKIP_BUILD:-0}" != 1 ]]; then
+  ZIG="${TF_ZIG:?set TF_ZIG}"
+  timeout 1800 docker run --rm --name "fnz-build-${RUN}" --network none --memory 16g -v "${TF:?}:${TF:?}" \
+    -v "$(dirname "${ZIG:?}"):/zigtool:ro" -w "${SRC:?}" \
+    -e ZIG_LOCAL_CACHE_DIR="${TF:?}/cache/zig-local" -e ZIG_GLOBAL_CACHE_DIR="${TF:?}/cache/zig-global" \
+    --entrypoint /zigtool/zig "$IMAGE" build -Doptimize=safe --prefix "${OUT:?}/zig-out" -j16 flashnext-comm \
+    > "${OUT:?}/build.log" 2>&1 || { tail -60 "${OUT:?}/build.log"; echo "build failed"; exit 1; }
+fi
+[[ -x "$BIN" ]] || { echo "no $BIN"; exit 1; }
+
+# the link, with nodes.sh's own functions run on each box: "<address> <netdev> <rdma device> <gid index>", then rails
+source "$NODES" || exit 1
+read -r A0 DEV0 HCA0 GID0 <<<"$(on "$HOST0" "$(declare -f link_info); link_info $PEER")"
+[[ -n "${A0:-}" && "${HCA0:--}" != - && "${GID0:--}" != - ]] || { echo "rank 0: no RoCE link toward $PEER ($A0 $DEV0 $HCA0 $GID0)"; exit 1; }
+read -r A1 DEV1 HCA1 GID1 <<<"$(on "$HOST1" "$(declare -f link_info); link_info $A0")"
+[[ -n "${A1:-}" && "${HCA1:--}" != - && "${GID1:--}" != - ]] || { echo "rank 1: no RoCE link toward $A0 ($A1 $DEV1 $HCA1 $GID1)"; exit 1; }
+HCAS0=$(on "$HOST0" "$(declare -f rails); rails $DEV0 $GID0"); HCAS1=$(on "$HOST1" "$(declare -f rails); rails $DEV1 $GID1")
+[[ "$(tr ',' '\n' <<<"$HCAS0" | wc -l)" == "$(tr ',' '\n' <<<"$HCAS1" | wc -l)" ]] || { HCAS0=$HCA0; HCAS1=$HCA1; }
+[[ "${NCCL_RAILS:-2}" == 1 ]] && { HCAS0=$HCA0; HCAS1=$HCA1; }
+ENV0="$(nccl_env "$DEV0" "$HCAS0" "$GID0") -e NCCL_DEBUG=${TF_NCCL_DEBUG:-INFO} -e NCCL_DEBUG_SUBSYS=INIT,NET,ENV ${TF_NCCL_EXTRA:-}"
+ENV1="$(nccl_env "$DEV1" "$HCAS1" "$GID1") -e NCCL_DEBUG=${TF_NCCL_DEBUG:-INFO} -e NCCL_DEBUG_SUBSYS=INIT,NET,ENV ${TF_NCCL_EXTRA:-}"
+{ echo "rank 0 $HOST0: $A0 $DEV0 $HCAS0 gid $GID0"; echo "rank 1 $HOST1: $A1 $DEV1 $HCAS1 gid $GID1"
+  echo "env0 $ENV0"; echo "env1 $ENV1"; echo "master $A0:$PORT iters $ITERS warmup $WARMUP"; } | tee "${OUT:?}/link.txt"
+
+# preflight on both: the image, no other compute app, memory
+for h in "$HOST0" "$HOST1"; do
+  on "$h" "docker image inspect '$IMAGE' >/dev/null 2>&1" || { echo "$h has no $IMAGE"; exit 1; }
+  on "$h" "nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader; awk '/MemAvailable/ {print \"MemAvailable\", int(\$2/1048576), \"GiB\"}' /proc/meminfo" | sed "s|^|$h: |"
+  avail=$(on "$h" "awk '/MemAvailable/ {print int(\$2/1048576)}' /proc/meminfo")
+  (( avail >= 20 )) || { echo "$h: only $avail GiB available"; exit 1; }
+done
+
+# the binary to both boxes
+for h in "$HOST0" "$HOST1"; do
+  if [[ "$h" == local ]]; then mkdir -p "$HOME/$REMOTE_DIR" && cp "$BIN" "$HOME/$REMOTE_DIR/"
+  else on "$h" "mkdir -p ~/$REMOTE_DIR" && scp -q -o BatchMode=yes "$BIN" "$h:$REMOTE_DIR/"; fi || { echo "copy to $h failed"; exit 1; }
+done
+
+cleanup() {
+  on "$HOST0" "docker rm -f fnz-comm-${RUN}-r0 >/dev/null 2>&1" ; on "$HOST1" "docker rm -f fnz-comm-${RUN}-r1 >/dev/null 2>&1"
+}
+trap cleanup EXIT
+
+launch() { # launch <rank> <host> <env> <lock>
+  local r=$1 h=$2 env=$3 lock=$4
+  on "$h" "flock -w 900 $lock timeout 900 docker run --rm --name fnz-comm-${RUN}-r$r --gpus all --network host \
+    --device /dev/infiniband --cap-add IPC_LOCK --ulimit memlock=-1 --shm-size 1g $env \
+    -v \$HOME/$REMOTE_DIR:/comm:ro --entrypoint /comm/tf-flashnext-comm '$IMAGE' $r $A0 $PORT $ITERS $WARMUP" \
+    > "${OUT:?}/rank$r.log" 2>&1
+}
+launch 0 "$HOST0" "$ENV0" "${TF_LOCK0:-\$HOME/fnz-gpu.lock}" & P0=$!
+launch 1 "$HOST1" "$ENV1" "${TF_LOCK1:-\$HOME/fnz-gpu.lock}" & P1=$!
+wait $P0; rc0=$?; wait $P1; rc1=$?
+# NCCL's INFO lines share the output, so a line of ours may start mid-line
+grep -ohE '(RESULT|PASS|FAIL|INFO rank) .*' "${OUT:?}/rank0.log" "${OUT:?}/rank1.log"
+grep -h -E 'NCCL INFO (NCCL version|NET/IB : Using|Using network|Channel 0./0 .*send|Connected all|NCCL_IB_GID)' "${OUT:?}/rank0.log" | head -12
+echo "rank0 rc=$rc0 rank1 rc=$rc1"
+(( rc0 == 0 && rc1 == 0 ))
diff --git a/zig/tests/cuda/flashnext/box/serve.sh b/zig/tests/cuda/flashnext/box/serve.sh
new file mode 100644
index 00000000..382651f5
--- /dev/null
+++ b/zig/tests/cuda/flashnext/box/serve.sh
@@ -0,0 +1,344 @@
+#!/bin/bash
+# tensorfold-native serving Flash Next on Sparks, then the API checks: /v1/models, a greedy chat completion with
+# thinking off, the same with "draft": false (equal text), the same streamed (equal text), a tool call. One rank
+# (HOST1 "-") or two (rank 0 on HOST0 serving, rank 1 on HOST1 following over the CX7 link toward PEER).
+# Usage: TF_FN=<work dir> bash -u serve.sh RUN BIN KSET HOST0 [HOST1 PEER]
+#   BIN: a built tensorfold-native (box/build.sh's out/<build>/zig-out/native/bin/tensorfold-native); KSET: the kernel
+#   set dir (aot.json + cubins/). HOST*: ssh targets. The checkpoint is the box's read-only volume glm53-hf-ablit.
+#   A host may be "local" (this machine). Per rank R (0, 1): TF_LOCKR (the GPU lock, default ~/fnz-gpu.lock; spark1:
+#   work/gpu.lock; held for the whole run, taken in the order spark1 < spark2 < spark3 < spark4), TF_HFR (the Hugging Face cache mounted read-only: a docker volume, default glm53-hf-ablit, or a path
+#   such as $HOME/.cache/huggingface). TF_ENV: extra docker -e flags for both ranks (-e TF_FLASHNEXT_YARN=4.0).
+# Env: TF_CLI (a built `tensorfold`: after the server, its `run` on the greedy prompt's ids, drafted and serial, must
+#   give the server's token sha), TF_ZIG_IMAGE, TF_CONTEXT (32768), TF_PARALLEL (1), TF_PORT (8888), TF_MASTER_PORT (29551), TF_EXTRA (serve
+#   flags), TF_HOLD_S (0: seconds to keep serving after the checks), TF_AFTER (a command run while serving), TF_MIN_AVAILABLE_GIB (8: the watchdog's floor).
+# Writes out/RUN/{rank0.log,rank1.log,checks/*.json,checks.txt}. Containers fnz-serve-RUN-r0/-r1, removed after.
+set -u
+RUN="${1:?run id}"; BIN="${2:?tensorfold-native}"; KSET="${3:?kernel set dir}"; HOST0="${4:?host of rank 0}"
+HOST1="${5:--}"; PEER="${6:-}"
+TF="${TF_FN:?set TF_FN}"
+IMAGE="${TF_ZIG_IMAGE:-nvcr.io/nvidia/pytorch:26.07-py3}"
+# TF_SNAP: another snapshot under the mounted cache (INT4-AutoRound: models--azampatti--...-INT4-AutoRound/snapshots/1464274...)
+SNAP=${TF_SNAP:-/root/.cache/huggingface/hub/models--nvidia--Qwen3.8-Flash-Next-NVFP4/snapshots/fc694b54fb0174e0913e6adf86691ef85a4ead47}
+NAME=${TF_NAME:-Qwen3.8-Flash-Next}
+PORT="${TF_PORT:-8888}"; MPORT="${TF_MASTER_PORT:-29551}"
+OUT="${TF:?}/out/${RUN:?}"
+NODES="${TF_NODES_SH:-${TF:?}/../scripts/nodes.sh}"
+REMOTE="fnz-work/serve-${RUN}"
+mkdir -p "${OUT:?}/checks"
+[[ -x "$BIN" && -f "$KSET/aot.json" ]] || { echo "need $BIN and $KSET/aot.json"; exit 1; }
+
+on() { if [[ "$1" == local ]]; then bash -c "${*:2}"; else ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 "$1" "${@:2}"; fi; }
+put() { # put <host> <src> <dir under ~> [rsync flags]
+  if [[ "$1" == local ]]; then mkdir -p "$HOME/$3" && rsync -a ${4:-} "$2" "$HOME/$3"; else rsync -a ${4:-} -e 'ssh -o BatchMode=yes' "$2" "$1:$3"; fi
+}
+get() { if [[ "$1" == local ]]; then cp "$HOME/$2" "$3"; else scp -q -o BatchMode=yes "$1:$2" "$3"; fi; }
+HF=("${TF_HF0:-glm53-hf-ablit}" "${TF_HF1:-glm53-hf-ablit}")
+LOCK=("${TF_LOCK0:-\$HOME/fnz-gpu.lock}" "${TF_LOCK1:-\$HOME/fnz-gpu.lock}")
+
+TP=1; HOSTS=("$HOST0")
+[[ "$HOST1" != - ]] && { TP=2; HOSTS+=("$HOST1"); }
+
+# PLAN.md "Box locking": every box's GPU lock is held for the whole run (load, checks, stop), taken in the fixed
+# order spark1 < spark2 < spark3 < spark4; a holder process keeps each lock until release_locks
+order_of() { case "$1" in local) echo 1 ;; *10.0.22.2*) echo 2 ;; *10.0.0.3*) echo 3 ;; *10.0.41.4* | *10.0.0.4*) echo 4 ;; *) echo 9 ;; esac; }
+LOCKPIDS=()
+take_locks() {
+  local i h
+  for i in $(for j in "${!HOSTS[@]}"; do echo "$(order_of "${HOSTS[$j]}") $j"; done | sort -n | awk '{print $2}'); do
+    h=${HOSTS[$i]}
+    on "$h" "mkdir -p ~/$REMOTE && rm -f ~/$REMOTE/unlock" || exit 1
+    on "$h" "flock ${LOCK[$i]} bash -c 'echo locked; while [ ! -f ~/$REMOTE/unlock ]; do sleep 1; done'" > "$OUT/lock$i.txt" 2>&1 &
+    LOCKPIDS+=($!)
+    echo "$h: waiting for its GPU lock (${LOCK[$i]})"
+    until grep -q locked "$OUT/lock$i.txt" 2>/dev/null; do
+      kill -0 "${LOCKPIDS[-1]}" 2>/dev/null || { echo "$h: the lock holder ended: $(cat "$OUT/lock$i.txt")"; exit 1; }
+      sleep 2
+    done
+  done
+}
+release_locks() {
+  for h in "${HOSTS[@]}"; do on "$h" "touch ~/$REMOTE/unlock" 2>/dev/null; done
+  for p in "${LOCKPIDS[@]}"; do wait "$p" 2>/dev/null; done
+  LOCKPIDS=()
+}
+trap release_locks EXIT
+take_locks
+
+for i in "${!HOSTS[@]}"; do
+  h=${HOSTS[$i]}; hf=${HF[$i]}
+  on "$h" "docker image inspect '$IMAGE' >/dev/null && { [[ '$hf' == /* ]] && [ -d '$hf/hub' ] || docker volume inspect '$hf' >/dev/null; }" || { echo "$h: no image or $hf"; exit 1; }
+  # one rank of two holds about half the weights: TF_MIN_START_GIB (110 one rank, 80 a rank of two); TF_ALLOW_APPS=1
+  # starts beside small compute apps that are not ours (spark3's services); a box running another fnz- job is
+  # waited for (TF_WAIT_S, 1800 s)
+  waited=0
+  while true; do
+    apps=$(on "$h" "nvidia-smi --query-compute-apps=pid --format=csv,noheader | wc -l")
+    avail=$(on "$h" "awk '/MemAvailable/ {print int(\$2/1048576)}' /proc/meminfo")
+    ours=$(on "$h" "docker ps --format '{{.Names}}' | grep '^fnz-' | grep -vc '^fnz-nfs$'")  # fnz-nfs: spark4's NFS export
+    (( (apps == 0 || ${TF_ALLOW_APPS:-0} == 1) && ours == 0 && avail >= ${TF_MIN_START_GIB:-$(( TP == 2 ? 80 : 110 ))} )) && break
+    (( waited >= ${TF_WAIT_S:-1800} )) && { echo "$h is busy (apps $apps, fnz jobs $ours, MemAvailable $avail GiB)"; exit 1; }
+    sleep 20; waited=$(( waited + 20 ))
+  done
+  echo "$h: compute apps $apps, MemAvailable $avail GiB (waited ${waited} s)"
+  on "$h" "mkdir -p ~/$REMOTE/bin ~/$REMOTE/kernels" && put "$h" "$BIN" "$REMOTE/bin/" &&
+    put "$h" "$KSET/" "$REMOTE/kernels/" --delete || { echo "copy to $h failed"; exit 1; }
+done
+
+ENV0=""; ENV1=""; TPFLAGS0=""; TPFLAGS1=""; DEVS=""
+if (( TP == 2 )); then
+  source "$NODES" || exit 1
+  read -r A0 DEV0 HCA0 GID0 <<<"$(on "$HOST0" "$(declare -f link_info); link_info $PEER")"
+  read -r A1 DEV1 HCA1 GID1 <<<"$(on "$HOST1" "$(declare -f link_info); link_info $A0")"
+  HCAS0=$(on "$HOST0" "$(declare -f rails); rails $DEV0 $GID0"); HCAS1=$(on "$HOST1" "$(declare -f rails); rails $DEV1 $GID1")
+  ENV0="$(nccl_env "$DEV0" "$HCAS0" "$GID0")"; ENV1="$(nccl_env "$DEV1" "$HCAS1" "$GID1")"
+  echo "rank 0 $HOST0 $A0 $DEV0 $HCAS0 gid $GID0 | rank 1 $HOST1 $A1 $DEV1 $HCAS1 gid $GID1" | tee "$OUT/link.txt"
+  TPFLAGS0="--tp 2 --rank 0 --master $A0 --master-port $MPORT"; TPFLAGS1="--tp 2 --rank 1 --master $A0 --master-port $MPORT"
+  DEVS="--device /dev/infiniband --cap-add IPC_LOCK --ulimit memlock=-1"
+fi
+
+# one session a box under its GPU lock: start, watch memory, wait for the stop file, remove the container
+session() { # session <rank> <host> <env> <tp flags>
+  local r=$1 h=$2 env="$3 ${TF_ENV:-}" tpf=$4 c="fnz-serve-${RUN}-r$1" hf=${HF[$1]} lock=${LOCK[$1]}
+  on "$h" "cat > ~/$REMOTE/session.sh" <<EOF
+set -u
+rm -f ~/$REMOTE/stop$r ~/$REMOTE/exited$r
+docker rm -f $c >/dev/null 2>&1
+docker run -d --name $c --gpus all --network host --shm-size 1g $DEVS $env \\
+  -v $hf:/root/.cache/huggingface:ro -v \$HOME/$REMOTE:/srv:ro -e TENSORFOLD_CUDA_KERNELS=/srv/kernels \\
+  --entrypoint /srv/bin/tensorfold-native '$IMAGE' serve $SNAP --name $NAME --host 0.0.0.0 --port $PORT \\
+  --context ${TF_CONTEXT:-32768} --parallel ${TF_PARALLEL:-1} ${TF_EXTRA:-} $tpf >/dev/null || exit 1
+while [ ! -f ~/$REMOTE/stop$r ]; do
+  [ "\$(docker inspect -f '{{.State.Running}}' $c 2>/dev/null)" = true ] || {
+    docker inspect -f '{{.State.ExitCode}} {{.State.FinishedAt}}' $c > ~/$REMOTE/exited$r; echo "rank $r container exited"; break; }
+  a=\$(awk '/MemAvailable/ {print int(\$2/1048576)}' /proc/meminfo)
+  if [ "\$a" -lt ${TF_MIN_AVAILABLE_GIB:-8} ]; then echo "watchdog: MemAvailable \$a GiB, stopping"; docker stop -t 5 $c; break; fi
+  sleep 1
+done
+docker stop -t 30 $c >/dev/null 2>&1 # SIGTERM first: a rank stops its peer and frees its GPU itself
+docker logs $c > ~/$REMOTE/rank$r.log 2>&1
+docker rm -f $c >/dev/null 2>&1
+EOF
+  on "$h" "bash ~/$REMOTE/session.sh" & # under the lock this run holds
+  SESSIONS+=($!)
+}
+SESSIONS=()
+stop_all() {
+  # rank 0 first (it stops rank 1); rank 1 gets 30 s to leave on its own before it is stopped too
+  on "$HOST0" "touch ~/$REMOTE/stop0"
+  if (( TP == 2 )); then
+    for _ in $(seq 30); do on "$HOST1" "docker inspect -f '{{.State.Running}}' fnz-serve-${RUN}-r1 2>/dev/null" | grep -q true || break; sleep 1; done
+    on "$HOST1" "touch ~/$REMOTE/stop1"
+  fi
+  for p in "${SESSIONS[@]}"; do wait "$p" 2>/dev/null; done
+  SESSIONS=()
+  for i in "${!HOSTS[@]}"; do get "${HOSTS[$i]}" "$REMOTE/rank$i.log" "$OUT/" 2>/dev/null; done
+}
+trap 'stop_all; release_locks' EXIT
+(( TP == 2 )) && session 1 "$HOST1" "$ENV1" "$TPFLAGS1"
+session 0 "$HOST0" "$ENV0" "$TPFLAGS0"
+
+URL="http://127.0.0.1:$PORT"
+t0=$(date +%s)
