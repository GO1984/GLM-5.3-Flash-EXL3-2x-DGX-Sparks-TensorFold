+            try f.mark(.shared_down);
+        } else {
+            try f.fp4At(.shared_down, shared_act, slots * ni, .{ .weight = dn.weight, .scale = dn.scale, .scale2 = dn.scale2 }, f.sc.shared_y, x.y_f32, R, dn.n, dn.k);
