+        if (dn_px) |q| try q.down(f.s, act, ni, ex, plan, slots, E + 1, y, x.y_f32, R, skip) else try f.ops.nvfp4Down(act, ni, ex, plan, slots, E + 1, y, x.y_f32, R, skip);
