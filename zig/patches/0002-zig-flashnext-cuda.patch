+                return error.UnexpectedTensor;
+            }
+            const kk = if (p.cols) |c| c[1] - c[0] else t.dim(1);
+            if (i == 0) k = kk else if (kk != k) return error.UnexpectedTensor;
+            if (p.rows.len == 0) n += t.dim(0) else for (p.rows) |r| {
