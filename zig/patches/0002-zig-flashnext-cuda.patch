+        return snap;
+    }
+
+    pub fn freeSnapshot(e: *Engine, snap: *Snapshot) void {
+        e.stream.synchronize() catch {};
+        e.budget.used -|= snap.mem.len;
+        snap.mem.free();
+        e.gpa.free(snap.tokens);
+        e.gpa.destroy(snap);
+    }
