+        for (0..e.g.attention_layers + @intFromBool(e.g.mtp)) |i| {
+            const t = e.ikcTail(i, snap.pos, snap.mtp_len);
+            try e.f.th.copy(st.ikc[i] + t[0] * row, snap.ikc + i * e.g.index_ratio * row, (t[1] - t[0]) * row);
