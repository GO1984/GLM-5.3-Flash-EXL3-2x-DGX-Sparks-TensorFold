+    b.costs = costs;
+    b.cost_count = max_rows;
+    b.mtp_ms = 0.4;
+    for (b.shared[0..2], [_]usize{ 2, 4 }) |*c, n| c.* = .{ .width = @intCast(n * max_rows), .ms = 9.0 + 0.2 * @as(f64, @floatFromInt(n * max_rows)) };
+    b.shared_count = 2;
