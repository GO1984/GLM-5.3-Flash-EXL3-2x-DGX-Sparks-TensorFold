+    /// State.restore: the snapshot's state into `seq` (its caches' first snap.pos rows must hold the prompt's).
+    fn restore(e: *Engine, seq: *Seq, snap: *const Snapshot) !void {
+        const st = &seq.st;
+        const sz = e.snapshotBytes();
