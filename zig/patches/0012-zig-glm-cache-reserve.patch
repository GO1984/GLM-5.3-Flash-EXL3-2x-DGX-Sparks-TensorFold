+    std.log.info("prompt cache: {d:.1} GiB for kept states, at most {d} (fixed {d} MiB each){s}; per chat {d}, bytes cap {d} MiB, shared prefix {d}; {d:.1} GiB reserved, {d:.1} GiB headroom for the prompts' buffers", .{
