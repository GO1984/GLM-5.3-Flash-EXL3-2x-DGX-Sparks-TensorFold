+//! Upload cuda_weights.Plan: glm5_next/cuda/split.py RankReader.get and weights.py on_device.
+//! Raw checkpoint bits only; prepared Q4/F8 projections are a separate load-time transformation.
+const std = @import("std");
+const cuda = @import("cuda");
+const weights = @import("cuda_weights.zig");
+pub const DeviceWeights = struct {
+    buffer: cuda.DeviceBuffer,
+    plan: *const weights.Plan,
+    pub fn deinit(w: *DeviceWeights) void {
+        w.buffer.free();
+    }
+    pub fn tensor(w: DeviceWeights, name: []const u8) !u64 {
+        for (w.plan.items.items) |item| if (std.mem.eql(u8, item.src.name, name)) return w.buffer.ptr + item.device_offset;
+        return error.MissingWeight;
+    }
+    /// At most 8 MiB staging. Column/dim1 slices seek each contiguous rank span rather than reading a whole shard.
+    /// Names and metadata remain owned by Plan/Catalog; both must outlive this value.
+    pub fn upload(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, plan: *const weights.Plan, model_dir: []const u8, draft_dir: ?[]const u8) !DeviceWeights {
+        var buf = try cuda.DeviceBuffer.alloc(d, @intCast(plan.device_bytes));
+        errdefer buf.free();
+        try buf.fill8(0, null);
+        const staging = try gpa.alloc(u8, 8 << 20);
+        defer gpa.free(staging);
+        const window = try gpa.alloc(u8, 32 << 20);
+        defer gpa.free(window);
+        for (plan.items.items) |item| {
+            const is_draft = item.src.source == .dflash2;
+            const dir = if (is_draft) draft_dir orelse return error.MissingDraftDirectory else model_dir;
+            const file_name = if (is_draft) item.src.file["dflash2:".len..] else item.src.file;
+            const path = try std.fs.path.join(gpa, &.{ dir, file_name });
+            defer gpa.free(path);
+            const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+            defer file.close(io);
+            const spans = try SliceSpans.init(item);
+            var i: u64 = 0;
+            if (spans.bytes > staging.len) {
+                // large spans: the staging buffer cycles through each one
+                while (i < spans.count) : (i += 1) {
+                    var copied: u64 = 0;
+                    while (copied < spans.bytes) {
+                        const n: usize = @intCast(@min(staging.len, spans.bytes - copied));
+                        if (try file.readPositionalAll(io, staging[0..n], spans.file_begin + i * spans.file_stride + copied) != n) return error.TruncatedWeight;
+                        try buf.upload(@intCast(item.device_offset + i * spans.bytes + copied), staging[0..n]);
+                        copied += n;
+                    }
+                }
+            }
+            while (i < spans.count) {
+                const n = try spans.readRun(io, file, i, staging, window);
+                try buf.upload(@intCast(item.device_offset + i * spans.bytes), staging[0 .. n * spans.bytes]);
+                i += n;
+            }
+        }
+        return .{ .buffer = buf, .plan = plan };
+    }
+};
+/// A row/column/dim1 rank slice decomposed into contiguous file spans (all offsets in bytes).
+pub const SliceSpans = struct {
+    file_begin: u64,
+    file_stride: u64,
+    bytes: u64,
+    count: u64,
+    /// Reads spans `first..` into `out` (contiguously, `bytes` each), as many as fit: a strided slice is read as
+    /// whole file windows (one sequential pread covers many spans) instead of one small read per span.
+    /// Returns the number of spans read.
+    pub fn readRun(sp: SliceSpans, io: std.Io, file: std.Io.File, first: u64, out: []u8, window: []u8) !u64 {
+        const fit: u64 = @max(1, @as(u64, out.len) / sp.bytes);
+        var n = @min(fit, sp.count - first);
+        const at = sp.file_begin + first * sp.file_stride;
+        if (n > 1 or sp.bytes <= out.len) {
+            if (sp.file_stride > sp.bytes and n * sp.file_stride <= window.len + sp.file_stride - sp.bytes) {
+                // a strided run inside one window
+                n = @min(n, (@as(u64, window.len) - sp.bytes) / sp.file_stride + 1);
+                const len: usize = @intCast((n - 1) * sp.file_stride + sp.bytes);
+                if (try file.readPositionalAll(io, window[0..len], at) != len) return error.TruncatedWeight;
+                for (0..@as(usize, @intCast(n))) |k| @memcpy(out[k * @as(usize, @intCast(sp.bytes)) ..][0..@intCast(sp.bytes)], window[k * @as(usize, @intCast(sp.file_stride)) ..][0..@intCast(sp.bytes)]);
+                return n;
+            }
+            if (sp.file_stride == sp.bytes) {
+                const len: usize = @intCast(n * sp.bytes);
+                if (try file.readPositionalAll(io, out[0..len], at) != len) return error.TruncatedWeight;
+                return n;
+            }
+        }
+        if (sp.bytes > out.len) {
+            // one span larger than the staging: the caller's staging cannot hold it; read its first part
+            return error.SpanLargerThanStaging;
+        }
+        const len: usize = @intCast(sp.bytes);
+        if (try file.readPositionalAll(io, out[0..len], at) != len) return error.TruncatedWeight;
+        return 1;
+    }
+    pub fn init(item: weights.Item) !SliceSpans {
+        const src = item.src;
+        const sl = item.slice;
+        var inner: u64 = src.dtype_size;
+        const axis: usize = sl.axis orelse return .{ .file_begin = src.header_base + src.data_begin, .file_stride = sl.device_bytes, .bytes = sl.device_bytes, .count = 1 };
+        if (axis >= src.rank or sl.stop > src.shape[axis] or sl.start > sl.stop) return error.BadWeightSlice;
+        for (src.shape[axis + 1 .. src.rank]) |n| inner *= n;
+        var outer: u64 = 1;
+        for (src.shape[0..axis]) |n| outer *= n;
+        const bytes = (sl.stop - sl.start) * inner;
+        if (outer * bytes != sl.device_bytes) return error.UnsupportedWeightConversion;
+        return .{ .file_begin = src.header_base + src.data_begin + sl.start * inner, .file_stride = src.shape[axis] * inner, .bytes = bytes, .count = outer };
+    }
+};
+test "noncontiguous trellis dim1 and dense column slices preserve raw bits" {
+    var item: weights.Item = undefined;
+    item.src = .{ .name = "trellis", .file = "x", .dtype = "I16", .dtype_size = 2, .rank = 3, .shape = .{ 256, 128, 64, 1, 1, 1, 1, 1 }, .header_base = 100, .data_begin = 20, .data_end = 0 };
+    item.slice = .{ .kind = .col, .axis = 1, .start = 48, .stop = 88, .device_dtype = "I32", .device_bytes = 256 * 40 * 64 * 2 };
+    const spans = try SliceSpans.init(item);
+    try std.testing.expectEqual(@as(u64, 120 + 48 * 128), spans.file_begin);
+    try std.testing.expectEqual(@as(u64, 256), spans.count);
+    try std.testing.expectEqual(@as(u64, 128 * 128), spans.file_stride);
+    try std.testing.expectEqual(@as(u64, 40 * 128), spans.bytes);
+}
+test "analyze upload without loading CUDA" {
+    if (std.c.getenv("TF_GLM_P6_COMPILE_PROBE") != null) {
+        var w = try DeviceWeights.upload(std.testing.allocator, undefined, undefined, undefined, "", null);
+        defer w.deinit();
+    }
+}
+
+test "readRun reads strided and contiguous spans like one read per span" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = std.testing.io;
+    var data: [4096]u8 = undefined;
+    for (&data, 0..) |*b, i| b.* = @truncate(i *% 31 +% (i >> 8));
+    try tmp.dir.writeFile(io, .{ .sub_path = "f", .data = &data });
+    const file = try tmp.dir.openFile(io, "f", .{});
+    defer file.close(io);
+    const cases = [_]SliceSpans{
+        .{ .file_begin = 100, .file_stride = 200, .bytes = 40, .count = 17 },
+        .{ .file_begin = 7, .file_stride = 64, .bytes = 64, .count = 30 },
+        .{ .file_begin = 0, .file_stride = 1000, .bytes = 300, .count = 4 },
+    };
+    for (cases) |sp| {
+        for ([_]usize{ 50, 128, 700, 4000 }) |staging_len| {
+            for ([_]usize{ 300, 1000, 4096 }) |window_len| {
+                var staging: [4096]u8 = undefined;
+                var window: [4096]u8 = undefined;
+                if (staging_len < sp.bytes) continue;
+                var i: u64 = 0;
+                while (i < sp.count) {
+                    const n = try sp.readRun(io, file, i, staging[0..staging_len], window[0..window_len]);
+                    try std.testing.expect(n >= 1);
+                    for (0..@as(usize, @intCast(n))) |k| {
+                        const want = data[@intCast(sp.file_begin + (i + k) * sp.file_stride)..][0..@intCast(sp.bytes)];
+                        try std.testing.expectEqualSlices(u8, want, staging[k * @as(usize, @intCast(sp.bytes)) ..][0..@intCast(sp.bytes)]);
+                    }
+                    i += n;
+                }
+            }
+        }
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_verify.zig b/zig/src/families/glm_cuda/cuda_verify.zig
new file mode 100644
index 00000000..69076cb5
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_verify.zig
@@ -0,0 +1,163 @@
+//! glm5_next/cuda/verify.py BatchedVerify: graphs keyed only by R, device positions/segments/parities.
+//! Ash Hart and TensorFold contributors; graph capture pattern from TensorFold Flash Next.
+const std = @import("std");
+const cuda = @import("cuda");
+const Forward = @import("cuda_forward.zig").Forward;
+const State = @import("cuda_state.zig").State;
+const segments = @import("cuda_segments.zig");
+const Stager = @import("cuda_stage.zig").Stager;
+pub const Segment = struct { st: *const State, tokens: []const i32 };
+pub const Verify = struct {
+    f: *Forward,
+    tables: *segments.SegRows,
+    kseg: cuda.DeviceBuffer,
+    graphs: [65]?cuda.graph.Exec = @splat(null),
+    host: [8][6]i32 = @splat(@splat(0)),
+    used: usize = 0,
+    /// Pinned, stream-ordered staging of the per-round metadata (ids, row/segment tables, KDA table). Unset: the
+    /// synchronous path (drain the stream, blocking uploads).
+    stager: Stager = .{},
+    pub fn init(f: *Forward, tables: *segments.SegRows) !Verify {
+        if (f.b.rows > 64 or tables.max_segs > 8 or tables.rows != f.b.rows or tables.dev == null) return error.BadWindow;
+        const kseg = try cuda.DeviceBuffer.alloc(f.tri.s.d, tables.max_segs * 6 * 4);
+        f.tables = tables;
+        f.kseg = kseg.ptr;
+        var stager: Stager = .{};
+        if (std.c.getenv("TF_GLM_SYNC_STAGE") == null) stager = try Stager.init(f.tri.s.d, f.tri.s, 64 << 10);
+        return .{ .f = f, .tables = tables, .kseg = kseg, .stager = stager };
+    }
+    pub fn deinit(v: *Verify) void {
+        v.stager.deinit();
+        for (&v.graphs) |*g| if (g.*) |*e| e.deinit();
+        v.kseg.free();
+        v.f.kseg = 0;
+    }
+    /// No committed state changes. Validate the entire window before replacing device tables.
+    pub fn stage(v: *Verify, spans: []const Segment) !usize {
+        var descriptions: [8]segments.Segment = undefined;
+        var table: [8][6]i32 = @splat(@splat(0));
+        if (spans.len == 0 or spans.len > v.tables.max_segs) return error.BadSegments;
+        var total: usize = 0;
+        for (spans, 0..) |s, si| {
+            if (s.tokens.len == 0 or s.st.slot >= v.f.slots.count or s.st.pos > s.st.capacity or s.tokens.len > s.st.capacity - s.st.pos or s.tokens.len > v.f.b.rows - total) return error.BadSegment;
+            for (spans[0..si]) |old| if (old.st.slot == s.st.slot) return error.DuplicateSlot;
+            for (s.st.cur) |parity| if (parity != s.st.cur[0]) return error.MixedKdaParity;
+            for (s.tokens) |token| if (token < 0 or token >= 154880) return error.BadToken;
+            descriptions[si] = .{ .base = s.st.base, .pos = s.st.pos, .rows = s.tokens.len, .ring_base = s.st.slot * v.f.caches.ring };
+            table[si] = .{ @intCast(total), @intCast(s.tokens.len), @intCast(s.st.slot), s.st.cur[0], @intCast(s.st.slot), @intCast(s.tokens.len) };
+            total += s.tokens.len;
+        }
+        for (table[spans.len..v.tables.max_segs]) |*row| row.* = .{ @intCast(total), 0, 0, 0, 0, 0 };
+        _ = try v.tables.fill(descriptions[0..spans.len], 2051);
+        if (v.stager.ready()) {
+            // Stream-ordered: the copies queue behind the previous round's graph, which may still read the tables.
+            var ids: [64]i32 = undefined;
+            var n: usize = 0;
+            for (spans) |s| {
+                @memcpy(ids[n..][0..s.tokens.len], s.tokens);
+                n += s.tokens.len;
+            }
+            try v.stager.put(v.f.b.ids, std.mem.sliceAsBytes(ids[0..n]));
+            try v.tables.stageAsync(&v.stager);
+            try v.stager.put(v.kseg.ptr, std.mem.asBytes(&table)[0 .. v.tables.max_segs * 24]);
+        } else {
+            // A graph may still be reading the previous round's tables. Synchronous staging needs no pinned lifetime.
+            try v.f.tri.s.synchronize();
+            var row: usize = 0;
+            for (spans) |s| {
+                const view: cuda.DeviceBuffer = .{ .d = v.f.tri.s.d, .ptr = v.f.b.ids, .len = v.f.b.rows * 4 };
+                try view.upload(row * 4, std.mem.sliceAsBytes(s.tokens));
+                row += s.tokens.len;
+            }
+            try v.tables.stage();
+            try v.kseg.upload(0, std.mem.asBytes(&table)[0 .. v.tables.max_segs * 24]);
+        }
+        v.host = table;
+        v.used = total;
+        return total;
+    }
+    /// Caller stages a valid dummy window first. Warm-up resolves AOT variants before entering capture.
+    /// Capture before stream admission; clear slot 0 after capturing every R as Python does.
+    pub fn capture(v: *Verify) !void {
+        const r = v.used;
+        if (r == 0 or r > 64) return error.BadRows;
+        if (v.graphs[r] != null) return error.AlreadyCaptured;
+        if (v.f.observer != null) return error.ObserverDuringCapture;
+        try v.f.compute(r);
+        try v.f.compute(r);
+        try v.f.tri.s.synchronize();
+        try cuda.graph.beginCapture(v.f.tri.s, .global);
+        v.f.compute(r) catch |e| {
+            if (cuda.graph.endCapture(v.f.tri.s)) |g0| {
+                var g = g0;
+                g.deinit();
+            } else |_| {}
+            return e;
+        };
+        var graph = try cuda.graph.endCapture(v.f.tri.s);
+        defer graph.deinit();
+        var executable = try graph.instantiate();
+        errdefer executable.deinit();
+        try executable.upload(v.f.tri.s);
+        v.graphs[r] = executable;
+    }
+    /// BatchedVerify.capture's full 1..window graph table, before any slot is admitted.
+    pub fn captureAll(v: *Verify, home: *const State) !void {
+        if (home.slot != 0 or home.base != 0 or home.pos != 0) return error.CaptureAfterAdmission;
+        for (home.cur) |parity| if (parity != 0) return error.CaptureAfterAdmission;
+        var tokens: [64]i32 = @splat(0);
+        for (1..v.f.b.rows + 1) |rows| {
+            _ = try v.stage(&.{.{ .st = home, .tokens = tokens[0..rows] }});
+            try v.capture();
+        }
+        try v.f.tri.s.synchronize();
+        const sizes = @import("cuda_state.zig").Slots.layout(v.f.g, 1, v.f.slots.rows);
+        const rec: cuda.DeviceBuffer = .{ .d = v.f.tri.s.d, .ptr = v.f.slots.rec, .len = sizes[0] };
+        const conv: cuda.DeviceBuffer = .{ .d = v.f.tri.s.d, .ptr = v.f.slots.conv, .len = sizes[1] };
+        try rec.fill8(0, null);
+        try conv.fill8(0, null);
+        v.used = 0;
+    }
+    pub fn forward(v: *Verify, spans: []const Segment) !void {
+        const r = try v.stage(spans);
+        if (v.graphs[r]) |graph| try graph.launchOn(v.f.tri.s) else try v.f.compute(r);
+    }
+};
+test "compile BatchedVerify graph and staging entry points" {
+    std.testing.refAllDecls(Verify);
+    if (std.c.getenv("TF_GLM_P6_COMPILE_PROBE") != null) {
+        var v = try Verify.init(undefined, undefined);
+        defer v.deinit();
+        try v.capture();
+        try v.captureAll(undefined);
+        try v.forward(&.{});
+    }
+}
+
+test "invalid verify windows cannot reach staging or mutate tables" {
+    var slots: @import("cuda_state.zig").Slots = undefined;
+    slots.count = 2;
+    var caches: @import("cuda_state.zig").Caches = undefined;
+    caches.ring = 64;
+    var f: Forward = undefined;
+    f.slots = &slots;
+    f.caches = &caches;
+    f.b.rows = 4;
+    var tables = try segments.SegRows.init(std.testing.allocator, 4, 4, 64);
+    defer tables.deinit();
+    var v: Verify = .{ .f = &f, .tables = &tables, .kseg = undefined };
+    var st: State = undefined;
+    st.slot = 0;
+    st.base = 0;
+    st.pos = 5;
+    st.capacity = 8;
+    st.cur = @splat(0);
+    try std.testing.expectError(error.BadSegments, v.stage(&.{}));
+    try std.testing.expectError(error.BadSegment, v.stage(&.{.{ .st = &st, .tokens = &.{ 1, 2, 3, 4 } }}));
+    try std.testing.expectError(error.BadToken, v.stage(&.{.{ .st = &st, .tokens = &.{154880} }}));
+    try std.testing.expectError(error.DuplicateSlot, v.stage(&.{ .{ .st = &st, .tokens = &.{1} }, .{ .st = &st, .tokens = &.{2} } }));
+    st.cur[33] = 1;
+    try std.testing.expectError(error.MixedKdaParity, v.stage(&.{.{ .st = &st, .tokens = &.{1} }}));
+    try std.testing.expectEqual(@as(usize, 0), tables.used);
+    for (tables.host) |word| try std.testing.expectEqual(@as(i32, 0), word);
+}
diff --git a/zig/src/families/glm_cuda/cuda_vision.zig b/zig/src/families/glm_cuda/cuda_vision.zig
new file mode 100644
index 00000000..8e326d06
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_vision.zig
@@ -0,0 +1,1008 @@
+//! GLM-5.3-Flash image and video input on CUDA, the vision tower: patches -> conv3d patch embed -> 24 blocks of
+//! rotary attention + SwiGLU -> post norm -> 2x2 downsample -> merger -> bf16 [rows, 4096] on the device.
+//!
+//! The reference is the Python engine's GlmVisionTower (tensorfold/vision/glm.py, plain torch on bf16 weights). This
+//! file reproduces its arithmetic: the linear layers go through cuBLASLt / cuBLAS with the calls PyTorch makes (so the
+//! same kernels run), the convolutions are tensor-core GEMM chains in cuDNN's accumulation order, attention follows
+//! flash-attention-2's forward kernel (what torch's SDPA runs), and the elementwise parts follow ATen's kernels. See
+//! zig/kernels/cuda/glm_vision.cu and the report work/zig-notes/r107-vision-tower.md for what is bit-exact.
+//!
+//! Written from the Python reference and the CUDA/torch semantics, not from any other implementation.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const kernels = @import("cuda_kernels.zig");
+const blas_mod = @import("cuda_vision_blas.zig");
+const cudnn_mod = @import("cuda_vision_cudnn.zig");
+
+const st = core.safetensors;
+
+pub const Blas = blas_mod.Blas;
+
+/// What the attention stage runs. `flash2` reproduces PyTorch's flash-attention-2 forward bits (see `flash_variant`);
+/// `plain` is an fp32 online-softmax kernel (not bit-identical, slower), kept as a fallback and for measuring.
+pub const Attention = enum { flash2, plain };
+
+/// The K order cuDNN's implicit-GEMM patch embedding accumulates in (see `embedMaps`).
+pub const EmbedOrder = enum { ctyx, tyxc, tyxc4, tyxc8, yxtc, yxtc8, yxct };
+/// How the patch embedding accumulates: `seq` adds one product at a time in fp32 in the map order (cuDNN's order for
+/// this convolution, found by probing), `mma` is a tensor-core chain in k16 groups.
+pub const EmbedKind = enum { seq, mma };
+/// The two convolutions: `cudnn` calls cuDNN's backend API the way PyTorch does (bit-identical to torch's convolutions;
+/// needs libcudnn.so.9), `own` runs our tensor-core / sequential kernels (not bit-identical; no cuDNN needed).
+pub const ConvImpl = enum { cudnn, own };
+
+pub const Options = struct {
+    /// Patches per pass (GlmVisionTower's PASS_PATCHES): a pass holds as many frame pairs of one grid as fit.
+    pass_patches: usize = 8192,
+    attention: Attention = .flash2,
+    /// Arithmetic variants of the flash kernel (glm_vision.cu V_*): 1 rcp.approx, 2 unfused exp argument (PyTorch builds
+    /// flash-attention with UNFUSE_FMA), 4 exp2f, 8 QK^T in reverse head-dim order, 16 PV in reverse key order.
+    flash_variant: u32 = 2,
+    /// LayerNorm arithmetic variants (glm_vision.cu): 1 unfused final, 2 1/sqrt, 4 Welford division, 8 combine division.
+    ln_variant: u32 = 0,
+    /// GELU through the table of torch's own results at every bf16 value (vision_gelu_bf16.bin): the erf formula in fp32
+    /// is off by one bf16 step on 7 of the 65,536 inputs with some CUDA math libraries. false uses the formula.
+    gelu_table: bool = true,
+    conv: ConvImpl = .cudnn,
+    embed_order: EmbedOrder = .tyxc,
+    embed_kind: EmbedKind = .seq,
+    /// partial-sum length of the downsample's tensor-core chain (0 = one running accumulator)
+    downsample_fresh: u32 = 0,
+    /// LayerNorm block rows (ATen's vectorized_layer_norm_kernel launches (32, BY) threads).
+    ln_rows: u32 = 4,
+    /// Called after each stage with the device pointer when set (checks, debugging); each call synchronizes the stream.
+    stage_hook: ?StageHook = null,
+    /// Time each kind of step with CUDA events (see `Tower.profile`); costs a few event records per layer.
+    profile: bool = false,
+};
+
+pub const StageDType = enum { bf16, f32 };
+pub const StageHook = struct {
+    ctx: ?*anyopaque,
+    call: *const fn (ctx: ?*anyopaque, name: []const u8, ptr: u64, count: usize, dtype: StageDType) anyerror!void,
+};
+
+/// One picture (`frames` = 1: a [3, H, W] canvas the tower expands to a frame pair) or one clip (`frames` even:
+/// [frames, 3, H, W]); `pixels` is the uint8 data on the host, H and W multiples of 28.
+pub const Item = struct {
+    frames: usize,
+    h: usize,
+    w: usize,
+    pixels: []const u8,
+
+    pub fn pairs(i: Item) usize {
+        return if (i.frames == 1) 1 else i.frames / 2;
+    }
+    pub fn rows(i: Item) usize {
+        return i.pairs() * (i.h / 28) * (i.w / 28);
+    }
+    pub fn valid(i: Item) bool {
+        return (i.frames == 1 or i.frames % 2 == 0) and i.h % 28 == 0 and i.w % 28 == 0 and i.h > 0 and i.w > 0 and i.pixels.len == i.frames * 3 * i.h * i.w;
+    }
+};
+
+pub const Config = struct {
+    hidden: usize = 1024,
+    heads: usize = 16,
+    depth: usize = 24,
+    inter: usize = 4096,
+    out: usize = 4096,
+    proj_inter: usize = 10240,
+    patch: usize = 14,
+    temporal: usize = 2,
+    merge: usize = 2,
+    eps: f32 = 1e-5,
+    limit: f32 = 10,
+    theta: f32 = 10000,
+
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, model_dir: []const u8) !Config {
+        const path = try std.fs.path.join(gpa, &.{ model_dir, "config.json" });
+        defer gpa.free(path);
+        const raw = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 24));
+        defer gpa.free(raw);
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, raw, .{});
+        defer parsed.deinit();
+        if (parsed.value != .object) return error.BadConfig;
+        const vc = parsed.value.object.get("vision_config") orelse return error.NoVisionTower;
+        if (vc != .object) return error.BadConfig;
+        var c: Config = .{};
+        c.hidden = try int(vc.object, "hidden_size");
+        c.heads = try int(vc.object, "num_heads");
+        c.depth = try int(vc.object, "depth");
+        c.inter = try int(vc.object, "intermediate_size");
+        c.out = try int(vc.object, "out_hidden_size");
+        c.proj_inter = try int(vc.object, "projection_intermediate_size");
+        c.patch = try int(vc.object, "patch_size");
+        c.temporal = try int(vc.object, "temporal_patch_size");
+        c.merge = try int(vc.object, "spatial_merge_size");
+        c.eps = @floatCast(try float(vc.object, "rms_norm_eps", 1e-5));
+        c.limit = @floatCast(try float(vc.object, "swiglu_limit", 10));
+        if (vc.object.get("rope_parameters")) |rp| if (rp == .object) {
+            c.theta = @floatCast(try float(rp.object, "rope_theta", 10000));
+        };
+        if (c.hidden != 1024 or c.heads != 16 or c.patch != 14 or c.temporal != 2 or c.merge != 2 or c.out != 4096 or c.depth == 0) return error.UnsupportedVisionGeometry;
+        return c;
+    }
+    fn int(o: std.json.ObjectMap, name: []const u8) !usize {
+        const v = o.get(name) orelse return error.BadConfig;
+        if (v != .integer or v.integer < 0) return error.BadConfig;
+        return @intCast(v.integer);
+    }
+    fn float(o: std.json.ObjectMap, name: []const u8, default: f64) !f64 {
+        const v = o.get(name) orelse return default;
+        return switch (v) {
+            .float => |f| f,
+            .integer => |i| @floatFromInt(i),
+            else => error.BadConfig,
+        };
+    }
+};
+
+pub const Block = struct {
+    norm1: u64,
+    qkv_w: u64,
+    qkv_b: u64,
+    q_norm: u64,
+    k_norm: u64,
+    proj_w: u64,
+    proj_b: u64,
+    norm2: u64,
+    gate_w: u64,
+    gate_b: u64,
+    up_w: u64,
+    up_b: u64,
+    down_w: u64,
+    down_b: u64,
+};
+
+pub const Weights = struct {
+    buf: cuda.DeviceBuffer,
+    embed_w: u64,
+    embed_b: u64,
+    blocks: []Block,
+    post_norm: u64,
+    down_w: u64,
+    down_b: u64,
+    merger_proj: u64,
+    merger_norm_w: u64,
+    merger_norm_b: u64,
+    merger_gate: u64,
+    merger_up: u64,
+    merger_down: u64,
+    bytes: usize,
+};
+
+const Fns = struct {
+    patches: cuda.Function,
+    rope: cuda.Function,
+    rms: cuda.Function,
+    qk: cuda.Function,
+    add: cuda.Function,
+    swiglu: cuda.Function,
+    ln_gelu: cuda.Function,
+    gelu: cuda.Function,
+    chain: cuda.Function,
+    seq: cuda.Function,
+    bias_add: cuda.Function,
+    down_perm: cuda.Function,
+    flash: cuda.Function,
+    plain: cuda.Function,
+};
+
+pub const mean_rgb = [3]f32{ 0.48145466, 0.4578275, 0.40821073 };
+pub const std_rgb = [3]f32{ 0.26862954, 0.26130258, 0.27577711 };
+
+pub const Buffers = struct {
+    cap: usize = 0, // patch rows the buffers hold
+    x: cuda.DeviceBuffer = undefined, // residual stream [R, 1024]
+    h: cuda.DeviceBuffer = undefined, // norm output [R, 1024]
+    qkv: cuda.DeviceBuffer = undefined, // [R, 3072]
+    q: cuda.DeviceBuffer = undefined, // [R, 1024]
+    k: cuda.DeviceBuffer = undefined,
+    o: cuda.DeviceBuffer = undefined,
+    gate: cuda.DeviceBuffer = undefined, // [R, 4096]
+    up: cuda.DeviceBuffer = undefined,
+    rope_cos: cuda.DeviceBuffer = undefined, // [S, 64] fp32
+    rope_sin: cuda.DeviceBuffer = undefined,
+    patches: cuda.DeviceBuffer = undefined, // bf16 [R, 1176]
+    patches_f32: cuda.DeviceBuffer = undefined, // only when a stage hook is set
+    rope_cap: usize = 0,
+    frames: cuda.DeviceBuffer = undefined, // uint8 pass input
+    frames_cap: usize = 0,
+};
+
+/// torch's F.gelu of every bf16 value (index = the input's bit pattern), see tests/vision/tower/gen_luts.py
+const gelu_table_bytes = @embedFile("vision_gelu_bf16.bin");
+
+const Mark = struct { name: []const u8, ev: cuda.Event };
+
+pub const Tower = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    cfg: Config,
+    opts: Options,
+    w: Weights,
+    mod: cuda.Module,
+    f: Fns,
+    blas: Blas,
+    b: Buffers = .{},
+    maps: [2]cuda.DeviceBuffer, // embed A and W maps for opts.embed_order
+    ds_map: ?cuda.DeviceBuffer = null, // downsample weight map
+    cudnn: ?cudnn_mod.Cudnn = null,
+    marks: std.ArrayList(Mark) = .empty,
+    prof_ms: std.StringArrayHashMapUnmanaged(f64) = .empty,
+    down_w: ?cuda.DeviceBuffer = null, // the downsample weight in channels-last order (for cuDNN)
+    gelu_lut: ?cuda.DeviceBuffer = null,
+    ds_map_ptr: u64 = 0,
+    kpad: usize,
+    peak_bytes: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, model_dir: []const u8, opts: Options) !Tower {
+        var self: Tower = undefined;
+        self.gpa = gpa;
+        self.d = d;
+        self.stream = stream;
+        self.opts = opts;
+        self.b = .{};
+        self.peak_bytes = 0;
+        self.ds_map = null;
+        self.ds_map_ptr = 0;
+        self.cudnn = null;
+        self.down_w = null;
+        self.gelu_lut = null;
+        self.marks = .empty;
+        self.prof_ms = .empty;
+        self.cfg = try Config.load(gpa, io, model_dir);
+        self.w = try loadWeights(gpa, io, d, model_dir, self.cfg);
+        errdefer freeWeights(gpa, &self.w);
+        self.mod = try kernels.load(d, .vision);
+        errdefer self.mod.unload();
+        self.f = .{
+            .patches = try self.mod.function("vis_patches"),
+            .rope = try self.mod.function("vis_rope_table"),
+            .rms = try self.mod.function("vis_rms1024"),
+            .qk = try self.mod.function("vis_qk_norm_rope"),
+            .add = try self.mod.function("vis_add"),
+            .swiglu = try self.mod.function("vis_swiglu"),
+            .ln_gelu = try self.mod.function("vis_layernorm_gelu"),
+            .gelu = try self.mod.function("vis_gelu"),
+            .chain = try self.mod.function("vis_gemm_chain"),
+            .seq = try self.mod.function("vis_gemm_seq"),
+            .bias_add = try self.mod.function("vis_bias_add"),
+            .down_perm = try self.mod.function("vis_down_weight_nhwc"),
+            .flash = try self.mod.function("vis_flash"),
+            .plain = try self.mod.function("vis_attn_plain"),
+        };
+        self.blas = try Blas.init(gpa, d, stream);
+        errdefer self.blas.deinit();
+        self.maps = .{ undefined, undefined };
+        self.kpad = try self.uploadMaps(opts.embed_order);
+        try self.ensureDownsampleMap();
+        self.gelu_lut = try cuda.DeviceBuffer.fromHost(d, gelu_table_bytes);
+        errdefer self.gelu_lut.?.free();
+        if (opts.conv == .cudnn) {
+            self.cudnn = try cudnn_mod.Cudnn.init(gpa, d, stream);
+            errdefer self.cudnn.?.deinit();
+            var dw = try cuda.DeviceBuffer.alloc(d, 4096 * 4096 * 2);
+            errdefer dw.free();
+            var a: cuda.Args = .{};
+            a.add(self.w.down_w);
+            a.add(dw.ptr);
+            try cuda.launch.launch(self.f.down_perm, .{ .grid = .{ .x = 4096 }, .block = .{ .x = 256 } }, stream, &a);
+            try stream.synchronize();
+            self.down_w = dw;
+        }
+        return self;
+    }
+
+    pub fn deinit(self: *Tower) void {
+        self.freeBuffers();
+        for (&self.maps) |*m| m.free();
+        if (self.ds_map) |*m| m.free();
+        if (self.down_w) |*m| m.free();
+        if (self.gelu_lut) |*m| m.free();
+        if (self.cudnn) |*c| c.deinit();
+        for (self.marks.items) |*m| m.ev.deinit();
+        self.marks.deinit(self.gpa);
+        self.prof_ms.deinit(self.gpa);
+        self.blas.deinit();
+        self.mod.unload();
+        freeWeights(self.gpa, &self.w);
+        self.* = undefined;
+    }
+
+    pub fn setEmbedOrder(self: *Tower, order: EmbedOrder) !void {
+        for (&self.maps) |*m| m.free();
+        self.opts.embed_order = order;
+        self.kpad = try self.uploadMaps(order);
+    }
+
+    /// Feature rows an item produces.
+    /// The cuDNN engine (global index) the heuristics pick for a convolution of `rows` rows, for diagnostics.
+    pub fn convEngine(self: *Tower, downsample: bool, n_rows: usize) !i64 {
+        const c = &(self.cudnn orelse return -1);
+        const p = try c.plan(if (downsample) cudnn_mod.Spec.downsample(n_rows) else cudnn_mod.Spec.embed(n_rows));
+        return p.engine;
+    }
+
+    pub fn rows(_: *const Tower, item: Item) usize {
+        return item.rows();
+    }
+
+    /// Device bytes beyond the weights for a pass of `patches` patch rows (the Python tower reserves 0.75 GiB).
+    pub fn workspaceBytes(patches: usize) usize {
+        const R = patches;
+        const bf = 2;
+        return R * (1024 * bf * 4 + 3072 * bf + 4096 * bf * 2 + 1176 * bf) + (R / 1) * 64 * 4 * 2 + blas_mod.lt_workspace_bytes + blas_mod.gemm_workspace_bytes;
+    }
+
+    // ---- buffers ----
+    fn freeBuffers(self: *Tower) void {
+        if (self.b.cap > 0) {
+            inline for (.{ "x", "h", "qkv", "q", "k", "o", "gate", "up", "patches" }) |n| @field(self.b, n).free();
+            if (self.b.patches_f32.len > 0) self.b.patches_f32.free();
+        }
+        if (self.b.rope_cap > 0) {
+            self.b.rope_cos.free();
+            self.b.rope_sin.free();
+        }
+        if (self.b.frames_cap > 0) self.b.frames.free();
+        self.b = .{};
+    }
+
+    pub fn ensure(self: *Tower, R: usize, S: usize, frame_bytes: usize) !void {
+        if (R > self.b.cap) {
+            const old = self.b;
+            const keep_rope = old.rope_cap;
+            _ = keep_rope;
+            if (old.cap > 0) {
+                inline for (.{ "x", "h", "qkv", "q", "k", "o", "gate", "up", "patches" }) |n| @field(self.b, n).free();
+                if (old.patches_f32.len > 0) self.b.patches_f32.free();
+            }
+            const d = self.d;
+            self.b.x = try cuda.DeviceBuffer.alloc(d, R * 1024 * 2);
+            self.b.h = try cuda.DeviceBuffer.alloc(d, R * 1024 * 2);
+            self.b.qkv = try cuda.DeviceBuffer.alloc(d, R * 3072 * 2);
+            self.b.q = try cuda.DeviceBuffer.alloc(d, R * 1024 * 2);
+            self.b.k = try cuda.DeviceBuffer.alloc(d, R * 1024 * 2);
+            self.b.o = try cuda.DeviceBuffer.alloc(d, R * 1024 * 2);
+            self.b.gate = try cuda.DeviceBuffer.alloc(d, @max(R * self.cfg.inter, R / 4 * self.cfg.proj_inter) * 2);
+            self.b.up = try cuda.DeviceBuffer.alloc(d, @max(R * self.cfg.inter, R / 4 * self.cfg.proj_inter) * 2);
+            self.b.patches = try cuda.DeviceBuffer.alloc(d, R * 1176 * 2);
+            self.b.patches_f32 = if (self.opts.stage_hook != null) try cuda.DeviceBuffer.alloc(d, R * 1176 * 4) else .{ .d = d, .ptr = 0, .len = 0 };
+            self.b.cap = R;
+        } else if (self.opts.stage_hook != null and self.b.patches_f32.len < R * 1176 * 4) {
+            if (self.b.patches_f32.len > 0) self.b.patches_f32.free();
+            self.b.patches_f32 = try cuda.DeviceBuffer.alloc(self.d, R * 1176 * 4);
+        }
+        if (S > self.b.rope_cap) {
+            if (self.b.rope_cap > 0) {
+                self.b.rope_cos.free();
+                self.b.rope_sin.free();
+            }
+            self.b.rope_cos = try cuda.DeviceBuffer.alloc(self.d, S * 64 * 4);
+            self.b.rope_sin = try cuda.DeviceBuffer.alloc(self.d, S * 64 * 4);
+            self.b.rope_cap = S;
+        }
+        if (frame_bytes > self.b.frames_cap) {
+            if (self.b.frames_cap > 0) self.b.frames.free();
+            self.b.frames = try cuda.DeviceBuffer.alloc(self.d, frame_bytes);
+            self.b.frames_cap = frame_bytes;
+        }
+        const u = cuda.usage(false);
+        self.peak_bytes = @max(self.peak_bytes, u.peak);
+    }
+
+    // ---- launches ----
+    fn grid1(n: usize) u32 {
+        return @intCast(@min((n + 255) / 256, 1 << 16));
+    }
+
+    fn launch(self: *const Tower, f: cuda.Function, grid: cuda.Dim3, block: cuda.Dim3, shared: u32, a: *cuda.Args) !void {
+        try cuda.launch.launch(f, .{ .grid = grid, .block = block, .shared = shared }, self.stream, a);
+    }
+
+    /// Records a CUDA event named for the work queued since the previous mark (only when `Options.profile`).
+    fn mark(self: *Tower, name: []const u8) !void {
+        if (!self.opts.profile) return;
+        var ev = try cuda.Event.init(self.d, true);
+        errdefer ev.deinit();
+        try ev.record(self.stream);
+        try self.marks.append(self.gpa, .{ .name = name, .ev = ev });
+    }
+
+    /// Adds the marks' durations to `prof_ms` (per name) and drops them; call after the stream has finished.
+    pub fn profileFlush(self: *Tower) !void {
+        var prev: ?cuda.Event = null;
+        for (self.marks.items) |*m| {
+            if (prev) |p| {
+                const ms = try cuda.Event.elapsedMs(p, m.ev);
+                const e = try self.prof_ms.getOrPut(self.gpa, m.name);
+                if (!e.found_existing) e.value_ptr.* = 0;
+                e.value_ptr.* += ms;
+            }
+            prev = m.ev;
+        }
+        for (self.marks.items) |*m| m.ev.deinit();
+        self.marks.clearRetainingCapacity();
+    }
+
+    fn hook(self: *const Tower, name: []const u8, ptr: u64, count: usize, dtype: StageDType) !void {
+        if (self.opts.stage_hook) |h| {
+            try self.stream.synchronize();
+            try h.call(h.ctx, name, ptr, count, dtype);
+        }
+    }
+
+    // ---- stages (public so a check can run each one from a reference input) ----
+
+    /// Patch matrix of a pass: bf16 (and fp32 when `patches_f32` is set) from frames already on the device.
+    pub fn stagePatches(self: *Tower, frames: u64, frame_stride: u64, pair0: usize, pairs: usize, gh: usize, gw: usize, h: usize, w: usize, bf_out: u64, f32_out: u64) !void {
+        var a: cuda.Args = .{};
+        a.add(frames);
+        a.add(@as(i64, @intCast(frame_stride)));
+        a.add(@as(i32, @intCast(pair0)));
+        a.add(@as(i32, @intCast(pairs)));
+        a.add(@as(i32, @intCast(gh)));
+        a.add(@as(i32, @intCast(gw)));
+        a.add(@as(i32, @intCast(h)));
+        a.add(@as(i32, @intCast(w)));
+        // (x - mean * 255) / (std * 255): the scaled constants are fp32 products, as torch forms them
+        for (mean_rgb) |m| a.add(m * 255.0);
+        for (std_rgb) |s| a.add(s * 255.0);
+        a.add(bf_out);
+        a.add(f32_out);
+        try self.launch(self.f.patches, .{ .x = grid1(pairs * gh * gw * 1176) }, .{ .x = 256 }, 0, &a);
+    }
+
+    /// conv3d patch embedding: bf16 patches [R, 1176] -> x [R, 1024]; the bias is a second bf16 add.
+    pub fn stageEmbed(self: *Tower, patches: u64, out: u64, R: usize, with_bias: bool) !void {
+        const bias = if (with_bias) self.w.embed_b else 0;
+        if (self.opts.conv == .cudnn) if (self.cudnn) |*c| {
+            try c.run(cudnn_mod.Spec.embed(R), patches, self.w.embed_w, out);
+            if (with_bias) try self.biasAdd(out, bias, 1024, R * 1024);
+            return;
+        };
+        switch (self.opts.embed_kind) {
+            .mma => try self.chain(patches, 1176, self.w.embed_w, 1176, self.maps[0].ptr, self.maps[1].ptr, self.kpad, bias, out, R, 1024, 0),
+            .seq => {
+                var a: cuda.Args = .{};
+                a.add(patches);
+                a.add(@as(i64, 1176));
+                a.add(self.w.embed_w);
+                a.add(@as(i64, 1176));
+                a.add(self.maps[0].ptr);
+                a.add(self.maps[1].ptr);
+                a.add(@as(i32, @intCast(self.kpad)));
+                a.add(bias);
+                a.add(out);
+                a.add(@as(i32, @intCast(R)));
+                a.add(@as(i32, 1024));
+                try self.launch(self.f.seq, .{ .x = 16, .y = @intCast((R + 63) / 64) }, .{ .x = 256 }, 0, &a);
+            },
+        }
+    }
+
+    pub fn chain(self: *Tower, a_ptr: u64, lda: usize, w_ptr: u64, ldw: usize, amap: u64, wmap: u64, kpad: usize, bias: u64, out: u64, M: usize, N: usize, fresh: u32) !void {
+        var a: cuda.Args = .{};
+        a.add(a_ptr);
+        a.add(@as(i64, @intCast(lda)));
+        a.add(w_ptr);
+        a.add(@as(i64, @intCast(ldw)));
+        a.add(amap);
+        a.add(wmap);
+        a.add(@as(i32, @intCast(kpad)));
+        a.add(bias);
+        a.add(out);
+        a.add(@as(i32, @intCast(M)));
+        a.add(@as(i32, @intCast(N)));
+        a.add(@as(i32, @intCast(fresh)));
+        try self.launch(self.f.chain, .{ .x = @intCast((N + 63) / 64), .y = @intCast((M + 63) / 64) }, .{ .x = 128 }, 0, &a);
+    }
+
+    pub fn stageRope(self: *Tower, gh: usize, gw: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(self.b.rope_cos.ptr);
+        a.add(self.b.rope_sin.ptr);
+        a.add(@as(i32, @intCast(gh)));
+        a.add(@as(i32, @intCast(gw)));
+        a.add(self.cfg.theta);
+        try self.launch(self.f.rope, .{ .x = grid1(gh * gw * 64) }, .{ .x = 256 }, 0, &a);
+    }
+
+    pub fn stageRms(self: *Tower, x: u64, w: u64, out: u64, R: usize) !void {
+        // ATen's mean-reduce block follows the row count: 16 or more rows -> 32 lanes per row (a (32, 16) block)
+        var bh: u32 = 1;
+        while (bh * 2 <= @min(R, 16)) bh *= 2;
+        const bw: u32 = @min(256, 512 / bh);
+        const per_block: u32 = @max(1, 128 / bw);
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(w);
+        a.add(out);
+        a.add(@as(i32, @intCast(R)));
+        a.add(self.cfg.eps);
+        try self.launch(self.f.rms, .{ .x = @intCast((R + per_block - 1) / per_block) }, .{ .x = bw, .y = per_block }, bw * per_block * 4, &a);
+    }
+
+    pub fn stageQkNormRope(self: *Tower, qkv: u64, qw: u64, kw: u64, q_out: u64, k_out: u64, R: usize, S: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(qkv);
+        a.add(qw);
+        a.add(kw);
+        a.add(self.b.rope_cos.ptr);
+        a.add(self.b.rope_sin.ptr);
+        a.add(q_out);
+        a.add(k_out);
+        a.add(@as(i32, @intCast(R)));
+        a.add(@as(i32, @intCast(S)));
+        a.add(self.cfg.eps);
+        try self.launch(self.f.qk, .{ .x = @intCast((R * 32 * 32 + 255) / 256) }, .{ .x = 256 }, 0, &a); // one warp a (row, q or k, head): not a grid-stride loop
+    }
+
+    pub fn stageAttention(self: *Tower, q: u64, k: u64, v: u64, out: u64, R: usize, S: usize) !void {
+        switch (self.opts.attention) {
+            .flash2 => {
+                var a: cuda.Args = .{};
+                a.add(q);
+                a.add(k);
+                a.add(v);
+                a.add(@as(i64, 3072));
+                a.add(out);
+                a.add(@as(i32, @intCast(S)));
+                // scale * log2(e) in double, then rounded: flash-attention's params.scale_softmax_log2
+                a.add(@as(f32, @floatCast(0.125 * 1.4426950408889634)));
+                a.add(@as(i32, @intCast(self.opts.flash_variant)));
+                try self.launch(self.f.flash, .{ .x = @intCast((S + 63) / 64), .y = 16, .z = @intCast(R / S) }, .{ .x = 128 }, 0, &a);
+            },
+            .plain => {
+                var a: cuda.Args = .{};
+                a.add(q);
+                a.add(k);
+                a.add(v);
+                a.add(@as(i64, 3072));
+                a.add(out);
+                a.add(@as(i32, @intCast(S)));
+                a.add(@as(i32, @intCast(R)));
+                try self.launch(self.f.plain, .{ .x = @intCast((R * 16 * 32 + 255) / 256) }, .{ .x = 256 }, 0, &a);
+            },
+        }
+    }
+
+    pub fn stageAdd(self: *Tower, a_ptr: u64, b_ptr: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(a_ptr);
+        a.add(b_ptr);
+        a.add(out);
+        a.add(@as(i64, @intCast(n)));
+        try self.launch(self.f.add, .{ .x = grid1(n) }, .{ .x = 256 }, 0, &a);
+    }
+
+    pub fn stageSwiglu(self: *Tower, gate: u64, up: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(gate);
+        a.add(up);
+        a.add(out);
+        a.add(@as(i64, @intCast(n)));
+        a.add(self.cfg.limit);
+        try self.launch(self.f.swiglu, .{ .x = grid1(n) }, .{ .x = 256 }, 0, &a);
+    }
+
+    pub fn stageLnGelu(self: *Tower, x: u64, ln_out: u64, out: u64, R: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(self.w.merger_norm_w);
+        a.add(self.w.merger_norm_b);
+        a.add(ln_out);
+        a.add(out);
+        a.add(@as(f32, 1e-5));
+        a.add(@as(i32, @intCast(self.opts.ln_variant)));
+        a.add(self.geluLut());
+        const by = self.opts.ln_rows;
+        try self.launch(self.f.ln_gelu, .{ .x = @intCast(R) }, .{ .x = 32, .y = by }, by * 3 / 2 * 4 + 64, &a);
+    }
+
+    fn geluLut(self: *const Tower) u64 {
+        return if (self.opts.gelu_table) self.gelu_lut.?.ptr else 0;
+    }
+
+    pub fn stageGelu(self: *Tower, x: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(out);
+        a.add(@as(i64, @intCast(n)));
+        a.add(self.geluLut());
+        try self.launch(self.f.gelu, .{ .x = grid1(n) }, .{ .x = 256 }, 0, &a);
+    }
+
+    /// One transformer block on x [R, 1024] (in place), groups of S tokens attending within themselves.
+    pub fn stageBlock(self: *Tower, i: usize, R: usize, S: usize) !void {
+        const w = self.w.blocks[i];
+        const b = &self.b;
+        const bl = &self.blas;
+        const first = i == 0;
+        try self.stageRms(b.x.ptr, w.norm1, b.h.ptr, R);
+        try self.mark("block: rms norms");
+        if (first) try self.hook("b0_norm1", b.h.ptr, R * 1024, .bf16);
+        try bl.linear(self.stream, b.h.ptr, w.qkv_w, w.qkv_b, b.qkv.ptr, R, 3072, 1024);
+        try self.mark("block: qkv linear");
+        if (first) try self.hook("b0_qkv", b.qkv.ptr, R * 3072, .bf16);
+        try self.stageQkNormRope(b.qkv.ptr, w.q_norm, w.k_norm, b.q.ptr, b.k.ptr, R, S);
+        try self.mark("block: q/k norm + rotary");
+        if (first) {
+            try self.hook("b0_qr", b.q.ptr, R * 1024, .bf16);
+            try self.hook("b0_kr", b.k.ptr, R * 1024, .bf16);
+        }
+        try self.stageAttention(b.q.ptr, b.k.ptr, b.qkv.ptr + 2048 * 2, b.o.ptr, R, S);
+        try self.mark("block: attention");
+        if (first) try self.hook("b0_attn", b.o.ptr, R * 1024, .bf16);
+        try bl.linear(self.stream, b.o.ptr, w.proj_w, w.proj_b, b.q.ptr, R, 1024, 1024); // q is free now
+        try self.mark("block: proj linear");
+        if (first) try self.hook("b0_proj", b.q.ptr, R * 1024, .bf16);
+        try self.stageAdd(b.x.ptr, b.q.ptr, b.x.ptr, R * 1024);
+        try self.mark("block: rms norms");
+        if (first) try self.hook("b0_res1", b.x.ptr, R * 1024, .bf16);
+        try self.stageRms(b.x.ptr, w.norm2, b.h.ptr, R);
+        if (first) try self.hook("b0_norm2", b.h.ptr, R * 1024, .bf16);
+        const inter = self.cfg.inter;
+        try bl.linear(self.stream, b.h.ptr, w.gate_w, w.gate_b, b.gate.ptr, R, inter, 1024);
+        try bl.linear(self.stream, b.h.ptr, w.up_w, w.up_b, b.up.ptr, R, inter, 1024);
+        try self.mark("block: gate/up linears");
+        if (first) {
+            try self.hook("b0_gate_raw", b.gate.ptr, R * inter, .bf16);
+            try self.hook("b0_up_raw", b.up.ptr, R * inter, .bf16);
+        }
+        try self.stageSwiglu(b.gate.ptr, b.up.ptr, b.gate.ptr, R * inter);
+        try self.mark("block: swiglu");
+        if (first) try self.hook("b0_act", b.gate.ptr, R * inter, .bf16);
+        try bl.linear(self.stream, b.gate.ptr, w.down_w, w.down_b, b.h.ptr, R, 1024, inter);
+        try self.mark("block: down linear");
+        try self.stageAdd(b.x.ptr, b.h.ptr, b.x.ptr, R * 1024);
+        try self.mark("block: rms norms");
+    }
+
+    /// post norm, downsample and the merger on x [R, 1024] -> out [R/4, 4096].
+    pub fn stageHead(self: *Tower, R: usize, out: u64) !void {
+        const b = &self.b;
+        const bl = &self.blas;
+        const M = R / 4;
+        try self.stageRms(b.x.ptr, self.w.post_norm, b.h.ptr, R);
+        try self.hook("post_norm", b.h.ptr, R * 1024, .bf16);
+        // downsample: a 2x2 conv, stride 2, on rows already in merge-block order: K = (kh, kw, c) in memory order
+        try self.stageDownsample(b.h.ptr, b.o.ptr, M, true);
+        try self.hook("downsample", b.o.ptr, M * 4096, .bf16);
+        try bl.linear(self.stream, b.o.ptr, self.w.merger_proj, 0, b.q.ptr, M, 4096, 4096);
+        try self.hook("merger_proj", b.q.ptr, M * 4096, .bf16);
+        // b.k holds the LayerNorm result, b.q the GELU output (both [M, 4096] bf16 fit in the q/k/o/h rows used here)
+        try self.stageLnGelu(b.q.ptr, b.k.ptr, b.q.ptr, M);
+        try self.hook("merger_ln", b.k.ptr, M * 4096, .bf16);
+        try self.hook("merger_gelu", b.q.ptr, M * 4096, .bf16);
+        const pi = self.cfg.proj_inter;
+        try bl.linear(self.stream, b.q.ptr, self.w.merger_gate, 0, b.gate.ptr, M, pi, 4096);
+        try bl.linear(self.stream, b.q.ptr, self.w.merger_up, 0, b.up.ptr, M, pi, 4096);
+        try self.stageSwiglu(b.gate.ptr, b.up.ptr, b.gate.ptr, M * pi);
+        try bl.linear(self.stream, b.gate.ptr, self.w.merger_down, 0, out, M, 4096, pi);
+        try self.hook("features", out, M * 4096, .bf16);
+    }
+
+    pub fn biasAdd(self: *Tower, y: u64, bias: u64, cols: usize, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(y);
+        a.add(bias);
+        a.add(@as(i32, @intCast(cols)));
+        a.add(@as(i64, @intCast(n)));
+        try self.launch(self.f.bias_add, .{ .x = grid1(n) }, .{ .x = 256 }, 0, &a);
+    }
+
+    pub fn stageDownsample(self: *Tower, x: u64, out: u64, M: usize, with_bias: bool) !void {
+        if (self.opts.conv == .cudnn) if (self.cudnn) |*c| {
+            try c.run(cudnn_mod.Spec.downsample(M), x, self.down_w.?.ptr, out);
+            if (with_bias) try self.biasAdd(out, self.w.down_b, 4096, M * 4096);
+            return;
+        };
+        // W [4096, 1024, 2, 2] (c, kh, kw) -> K order (kh, kw, c): wmap[k] = c * 4 + kh * 2 + kw
+        try self.chain(x, 4096, self.w.down_w, 4096, 0, self.dsmap(), 4096, if (with_bias) self.w.down_b else 0, out, M, 4096, self.opts.downsample_fresh);
+    }
+
+    fn dsmap(self: *Tower) u64 {
+        return self.ds_map_ptr;
+    }
+
+    // ---- the pass loop ----
+    /// Encodes the items to `out` (bf16, [sum of rows, 4096]) in item order, pass by pass as GlmVisionTower.features.
+    pub fn encode(self: *Tower, items: []const Item, out: u64) !void {
+        try self.ensureDownsampleMap();
+        var at: usize = 0;
+        for (items) |it| {
+            if (!it.valid()) return error.BadItem;
+            const gh = it.h / 14;
+            const gw = it.w / 14;
+            const S = gh * gw;
+            const frames_total = if (it.frames == 1) 2 else it.frames;
+            const pairs_total = frames_total / 2;
+            const per = @max(1, self.opts.pass_patches / S);
+            var start: usize = 0;
+            while (start < pairs_total) : (start += per) {
+                const n = @min(per, pairs_total - start);
+                const R = n * S;
+                const frame_bytes = 3 * it.h * it.w;
+                const upload = if (it.frames == 1) frame_bytes else 2 * n * frame_bytes;
+                try self.ensure(R, S, upload);
+                const src = if (it.frames == 1) it.pixels else it.pixels[2 * start * frame_bytes ..][0..upload];
+                try self.b.frames.upload(0, src);
+                try self.runPass(self.b.frames.ptr, if (it.frames == 1) 0 else frame_bytes, 0, n, gh, gw, it.h, it.w, out + at * 4096 * 2);
+                at += R / 4;
+            }
+        }
+        try self.stream.synchronize();
+    }
+
+    fn runPass(self: *Tower, frames: u64, frame_stride: u64, pair0: usize, n: usize, gh: usize, gw: usize, h: usize, w: usize, out: u64) !void {
+        const S = gh * gw;
+        const R = n * S;
+        const b = &self.b;
+        try self.mark("start");
+        try self.stagePatches(frames, frame_stride, pair0, n, gh, gw, h, w, b.patches.ptr, b.patches_f32.ptr);
+        if (self.opts.stage_hook != null) try self.hook("patches", b.patches_f32.ptr, R * 1176, .f32);
+        try self.mark("patches");
+        try self.stageEmbed(b.patches.ptr, b.x.ptr, R, true);
+        try self.mark("embed conv");
+        try self.hook("embed", b.x.ptr, R * 1024, .bf16);
+        try self.stageRope(gh, gw);
+        if (self.opts.stage_hook != null) {
+            try self.hook("rope_cos", b.rope_cos.ptr, S * 64, .f32);
+            try self.hook("rope_sin", b.rope_sin.ptr, S * 64, .f32);
+        }
+        var name: [16]u8 = undefined;
+        for (0..self.cfg.depth) |i| {
+            try self.stageBlock(i, R, S);
+            if (self.opts.stage_hook != null) {
+                const nm = try std.fmt.bufPrint(&name, "block{d:0>2}", .{i});
+                try self.hook(nm, b.x.ptr, R * 1024, .bf16);
+            }
+        }
+        try self.stageHead(R, out);
+        try self.mark("head (post norm, downsample, merger)");
+    }
+
+    fn ensureDownsampleMap(self: *Tower) !void {
+        if (self.ds_map != null) return;
+        var m: [4096]i32 = undefined;
+        for (0..4096) |k| {
+            const kh = k / 2048;
+            const kw = (k / 1024) % 2;
+            const c = k % 1024;
+            m[k] = @intCast(c * 4 + kh * 2 + kw);
+        }
+        self.ds_map = try cuda.DeviceBuffer.fromHost(self.d, std.mem.sliceAsBytes(&m));
+        self.ds_map_ptr = self.ds_map.?.ptr;
+    }
+
+    fn uploadMaps(self: *Tower, order: EmbedOrder) !usize {
+        const m = try embedMaps(self.gpa, order);
+        defer self.gpa.free(m.a);
+        defer self.gpa.free(m.w);
+        self.maps[0] = try cuda.DeviceBuffer.fromHost(self.d, std.mem.sliceAsBytes(m.a));
+        errdefer self.maps[0].free();
+        self.maps[1] = try cuda.DeviceBuffer.fromHost(self.d, std.mem.sliceAsBytes(m.w));
+        return m.a.len;
+    }
+};
+
+/// The patch embedding as an implicit GEMM: K positions of the accumulation chain mapped to indices in a patch row /
+/// weight row (both laid out (channel, time, y, x), 1176 values); -1 is a zero pad. The order is the hypothesis for
+/// cuDNN's kernel; the report says which one reproduces torch.
+pub fn embedMaps(gpa: std.mem.Allocator, order: EmbedOrder) !struct { a: []i32, w: []i32 } {
+    const slots: usize = switch (order) {
+        .ctyx => 1176,
+        .tyxc, .yxct => 1176,
+        .yxtc => 1176,
+        .tyxc4 => 4 * 392,
+        .tyxc8 => 8 * 392,
+        .yxtc8 => 8 * 196,
+    };
+    const kpad = (slots + 15) / 16 * 16;
+    const a = try gpa.alloc(i32, kpad);
+    errdefer gpa.free(a);
+    @memset(a, -1);
+    switch (order) {
+        .ctyx => for (0..1176) |k| {
+            a[k] = @intCast(k);
+        },
+        .tyxc, .tyxc4, .tyxc8 => {
+            const cs: usize = switch (order) {
+                .tyxc => 3,
+                .tyxc4 => 4,
+                else => 8,
+            };
+            for (0..2) |t| for (0..14) |y| for (0..14) |x| for (0..3) |c| {
+                a[((t * 14 + y) * 14 + x) * cs + c] = @intCast(((c * 2 + t) * 14 + y) * 14 + x);
+            };
+        },
+        .yxtc, .yxtc8 => {
+            const ts: usize = if (order == .yxtc) 6 else 8;
+            for (0..14) |y| for (0..14) |x| for (0..2) |t| for (0..3) |c| {
+                a[(y * 14 + x) * ts + t * 3 + c] = @intCast(((c * 2 + t) * 14 + y) * 14 + x);
+            };
+        },
+        .yxct => for (0..14) |y| for (0..14) |x| for (0..3) |c| for (0..2) |t| {
+            a[((y * 14 + x) * 3 + c) * 2 + t] = @intCast(((c * 2 + t) * 14 + y) * 14 + x);
+        },
+    }
+    const w = try gpa.dupe(i32, a);
+    return .{ .a = a, .w = w };
+}
+
+fn loadWeights(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, model_dir: []const u8, cfg: Config) !Weights {
+    // names -> shard files from the index
+    const ipath = try std.fs.path.join(gpa, &.{ model_dir, "model.safetensors.index.json" });
+    defer gpa.free(ipath);
+    const raw = try std.Io.Dir.cwd().readFileAlloc(io, ipath, gpa, .limited(1 << 28));
+    defer gpa.free(raw);
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, raw, .{});
+    defer parsed.deinit();
+    const wm = (parsed.value.object.get("weight_map") orelse return error.BadIndex).object;
+
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const al = arena.allocator();
+    var files: std.ArrayList(st.File) = .empty;
+    var file_names: std.ArrayList([]const u8) = .empty;
+    defer {
+        for (files.items) |*f| f.close(io);
+        files.deinit(gpa);
+        file_names.deinit(gpa);
+    }
+
+    const Local = struct {
+        fn find(gpa_: std.mem.Allocator, io_: std.Io, dir: []const u8, wm_: std.json.ObjectMap, files_: *std.ArrayList(st.File), names_: *std.ArrayList([]const u8), al_: std.mem.Allocator, name: []const u8) !st.Tensor {
+            const fv = wm_.get(name) orelse {
+                std.log.err("vision tower: {s} is not in the checkpoint", .{name});
+                return error.MissingVisionTensor;
+            };
+            const fname = fv.string;
+            for (names_.items, 0..) |n, i| if (std.mem.eql(u8, n, fname)) return files_.items[i].get(name) orelse error.MissingVisionTensor;
+            const p = try std.fs.path.join(al_, &.{ dir, fname });
+            var f = try st.File.open(gpa_, io_, p);
+            errdefer f.close(io_);
+            try files_.append(gpa_, f);
+            try names_.append(gpa_, try al_.dupe(u8, fname));
+            return files_.items[files_.items.len - 1].get(name) orelse error.MissingVisionTensor;
+        }
+    };
+    var total: usize = 0;
+    const Req = struct {
+        name: []const u8,
+        shape: [5]usize,
+        rank: usize,
+    };
+    var reqs: std.ArrayList(Req) = .empty;
+    defer reqs.deinit(gpa);
+    const add = struct {
+        fn f(r: *std.ArrayList(Req), gpa_: std.mem.Allocator, al_: std.mem.Allocator, comptime fmt: []const u8, args: anytype, shape: []const usize) !void {
+            var req: Req = .{ .name = try std.fmt.allocPrint(al_, fmt, args), .shape = @splat(1), .rank = shape.len };
+            @memcpy(req.shape[0..shape.len], shape);
+            try r.append(gpa_, req);
+        }
+    }.f;
+    const V = "model.visual.";
+    try add(&reqs, gpa, al, V ++ "patch_embed.proj.weight", .{}, &.{ 1024, 3, 2, 14, 14 });
+    try add(&reqs, gpa, al, V ++ "patch_embed.proj.bias", .{}, &.{1024});
+    for (0..cfg.depth) |i| {
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.norm1.weight", .{i}, &.{1024});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.qkv.weight", .{i}, &.{ 3072, 1024 });
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.qkv.bias", .{i}, &.{3072});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.q_norm.weight", .{i}, &.{64});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.k_norm.weight", .{i}, &.{64});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.proj.weight", .{i}, &.{ 1024, 1024 });
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.attn.proj.bias", .{i}, &.{1024});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.norm2.weight", .{i}, &.{1024});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.gate_proj.weight", .{i}, &.{ cfg.inter, 1024 });
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.gate_proj.bias", .{i}, &.{cfg.inter});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.up_proj.weight", .{i}, &.{ cfg.inter, 1024 });
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.up_proj.bias", .{i}, &.{cfg.inter});
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.down_proj.weight", .{i}, &.{ 1024, cfg.inter });
+        try add(&reqs, gpa, al, V ++ "blocks.{d}.mlp.down_proj.bias", .{i}, &.{1024});
+    }
+    try add(&reqs, gpa, al, V ++ "post_layernorm.weight", .{}, &.{1024});
+    try add(&reqs, gpa, al, V ++ "downsample.weight", .{}, &.{ 4096, 1024, 2, 2 });
+    try add(&reqs, gpa, al, V ++ "downsample.bias", .{}, &.{4096});
+    try add(&reqs, gpa, al, V ++ "merger.proj.weight", .{}, &.{ 4096, 4096 });
+    try add(&reqs, gpa, al, V ++ "merger.post_projection_norm.weight", .{}, &.{4096});
+    try add(&reqs, gpa, al, V ++ "merger.post_projection_norm.bias", .{}, &.{4096});
+    try add(&reqs, gpa, al, V ++ "merger.gate_proj.weight", .{}, &.{ cfg.proj_inter, 4096 });
+    try add(&reqs, gpa, al, V ++ "merger.up_proj.weight", .{}, &.{ cfg.proj_inter, 4096 });
+    try add(&reqs, gpa, al, V ++ "merger.down_proj.weight", .{}, &.{ 4096, cfg.proj_inter });
+
+    var offsets = try gpa.alloc(usize, reqs.items.len);
+    defer gpa.free(offsets);
+    var tensors = try gpa.alloc(st.Tensor, reqs.items.len);
+    defer gpa.free(tensors);
+    for (reqs.items, 0..) |r, i| {
+        const t = try Local.find(gpa, io, model_dir, wm, &files, &file_names, al, r.name);
+        if (!t.is(.bf16, r.shape[0..r.rank])) {
+            std.log.err("vision tower: {s} is not bf16 with the expected shape", .{r.name});
+            return error.BadVisionTensor;
+        }
+        tensors[i] = t;
+        offsets[i] = total;
+        total += (t.bytes.len + 255) / 256 * 256;
+    }
+    var buf = try cuda.DeviceBuffer.alloc(d, total);
+    errdefer buf.free();
+    for (tensors, offsets) |t, off| try buf.upload(off, t.bytes);
+
+    const blocks = try gpa.alloc(Block, cfg.depth);
+    errdefer gpa.free(blocks);
+    var at: usize = 0;
+    const P = struct {
+        fn next(b: cuda.DeviceBuffer, o: []const usize, i: *usize) u64 {
+            const v = b.ptr + o[i.*];
+            i.* += 1;
+            return v;
+        }
+    };
+    var w: Weights = undefined;
+    w.buf = buf;
+    w.bytes = total;
+    w.embed_w = P.next(buf, offsets, &at);
+    w.embed_b = P.next(buf, offsets, &at);
+    for (blocks) |*b| {
+        b.norm1 = P.next(buf, offsets, &at);
+        b.qkv_w = P.next(buf, offsets, &at);
+        b.qkv_b = P.next(buf, offsets, &at);
+        b.q_norm = P.next(buf, offsets, &at);
+        b.k_norm = P.next(buf, offsets, &at);
+        b.proj_w = P.next(buf, offsets, &at);
+        b.proj_b = P.next(buf, offsets, &at);
+        b.norm2 = P.next(buf, offsets, &at);
+        b.gate_w = P.next(buf, offsets, &at);
+        b.gate_b = P.next(buf, offsets, &at);
+        b.up_w = P.next(buf, offsets, &at);
+        b.up_b = P.next(buf, offsets, &at);
+        b.down_w = P.next(buf, offsets, &at);
+        b.down_b = P.next(buf, offsets, &at);
+    }
+    w.blocks = blocks;
+    w.post_norm = P.next(buf, offsets, &at);
+    w.down_w = P.next(buf, offsets, &at);
+    w.down_b = P.next(buf, offsets, &at);
+    w.merger_proj = P.next(buf, offsets, &at);
+    w.merger_norm_w = P.next(buf, offsets, &at);
+    w.merger_norm_b = P.next(buf, offsets, &at);
+    w.merger_gate = P.next(buf, offsets, &at);
+    w.merger_up = P.next(buf, offsets, &at);
+    w.merger_down = P.next(buf, offsets, &at);
+    std.debug.assert(at == reqs.items.len);
+    return w;
+}
+
+fn freeWeights(gpa: std.mem.Allocator, w: *Weights) void {
+    gpa.free(w.blocks);
+    w.buf.free();
+}
+
+test "item geometry" {
+    const it: Item = .{ .frames = 1, .h = 56, .w = 84, .pixels = &.{} };
+    try std.testing.expectEqual(@as(usize, 6), it.rows());
+    const clip: Item = .{ .frames = 4, .h = 56, .w = 56, .pixels = &.{} };
+    try std.testing.expectEqual(@as(usize, 8), clip.rows());
+}
+
+test "embed maps cover the 1176 patch values once" {
+    const gpa = std.testing.allocator;
+    for (std.enums.values(EmbedOrder)) |ord| {
+        const m = try embedMaps(gpa, ord);
+        defer gpa.free(m.a);
+        defer gpa.free(m.w);
+        var seen: [1176]u8 = @splat(0);
+        for (m.a) |v| if (v >= 0) {
+            seen[@intCast(v)] += 1;
+        };
+        for (seen) |c| try std.testing.expectEqual(@as(u8, 1), c);
+        try std.testing.expect(m.a.len % 16 == 0);
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_vision_blas.zig b/zig/src/families/glm_cuda/cuda_vision_blas.zig
new file mode 100644
index 00000000..92a02bd4
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_vision_blas.zig
@@ -0,0 +1,154 @@
+//! The vision tower's matrix products, issued the way PyTorch 2.13 issues them so that cuBLAS picks the same kernels:
+//!  * F.linear with a bias (addmm on a 2-D input, bf16): cublasLtMatmul with CUBLASLT_EPILOGUE_BIAS, a 1 MiB workspace,
+//!    256-byte alignment preferences and the first heuristic result (`gemm_and_bias` in ATen/cuda/CUDABlas.cpp);
+//!  * F.linear without a bias (mm): cublasGemmEx, CUBLAS_COMPUTE_32F, CUBLAS_GEMM_DEFAULT_TENSOR_OP, default math mode,
+//!    a 32 MiB workspace set on the handle.
+//! Both libraries are opened at run time (libcublasLt.so.13 / libcublas.so.13), like the rest of this runtime.
+//! Written for this port from the CUDA headers and the call sequences cuBLAS's own logging shows for PyTorch's calls.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const lt = cuda.cublaslt;
+
+pub const Error = lt.Error || error{GemmFailed};
+
+pub const lt_workspace_bytes: usize = 1 << 20;
+pub const gemm_workspace_bytes: usize = 32 << 20;
+
+const bias_epilogue: c_int = 4; // CUBLASLT_EPILOGUE_BIAS
+const attr_epilogue: c_int = 7;
+const attr_bias_pointer: c_int = 8;
+const pref_align_a: c_int = 5;
+
+const Plan = struct { desc: lt.MatmulDesc, a: lt.Layout, b: lt.Layout, c: lt.Layout, pref: lt.Preference, algo: lt.Algo, ws: usize };
+const Key = struct { m: u32, n: u32, k: u32, bias: bool };
+
+pub const CublasApi = struct {
+    cublasCreate_v2: *const fn (*?*anyopaque) callconv(.c) c_int,
+    cublasDestroy_v2: *const fn (?*anyopaque) callconv(.c) c_int,
+    cublasSetStream_v2: *const fn (?*anyopaque, cuda.abi.Stream) callconv(.c) c_int,
+    cublasSetWorkspace_v2: *const fn (?*anyopaque, u64, usize) callconv(.c) c_int,
+    cublasSetMathMode: *const fn (?*anyopaque, c_int) callconv(.c) c_int,
+    cublasGemmEx: *const fn (?*anyopaque, c_int, c_int, c_int, c_int, c_int, *const anyopaque, u64, c_int, c_int, u64, c_int, c_int, *const anyopaque, u64, c_int, c_int, c_int, c_int) callconv(.c) c_int,
+};
+
+pub const Blas = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    ltlib: lt.Library,
+    handle: lt.Handle,
+    plans: std.AutoHashMapUnmanaged(Key, Plan) = .empty,
+    workspace: cuda.DeviceBuffer,
+    gemm_ws: cuda.DeviceBuffer,
+    cublas_lib: std.DynLib,
+    cublas_api: CublasApi,
+    cublas: ?*anyopaque,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream) !Blas {
+        var self: Blas = undefined;
+        self.gpa = gpa;
+        self.d = d;
+        self.plans = .empty;
+        self.ltlib = try lt.Library.open();
+        errdefer self.ltlib.close();
+        try self.ltlib.check(self.ltlib.api.cublasLtCreate(&self.handle), "cublasLtCreate");
+        errdefer _ = self.ltlib.api.cublasLtDestroy(self.handle);
+        self.workspace = try cuda.DeviceBuffer.alloc(d, lt_workspace_bytes);
+        errdefer self.workspace.free();
+        self.gemm_ws = try cuda.DeviceBuffer.alloc(d, gemm_workspace_bytes);
+        errdefer self.gemm_ws.free();
+        self.cublas_lib = std.DynLib.open("libcublas.so.13") catch std.DynLib.open("libcublas.so") catch return error.LibraryUnavailable;
+        errdefer self.cublas_lib.close();
+        inline for (@typeInfo(CublasApi).@"struct".field_names, @typeInfo(CublasApi).@"struct".field_types) |name, T| {
+            @field(self.cublas_api, name) = self.cublas_lib.lookup(T, name) orelse return error.MissingSymbol;
+        }
+        if (self.cublas_api.cublasCreate_v2(&self.cublas) != 0) return error.GemmFailed;
+        errdefer _ = self.cublas_api.cublasDestroy_v2(self.cublas);
+        if (self.cublas_api.cublasSetStream_v2(self.cublas, stream.handle) != 0) return error.GemmFailed;
+        if (self.cublas_api.cublasSetWorkspace_v2(self.cublas, self.gemm_ws.ptr, gemm_workspace_bytes) != 0) return error.GemmFailed;
+        if (self.cublas_api.cublasSetMathMode(self.cublas, 0) != 0) return error.GemmFailed;
+        return self;
+    }
+
+    pub fn deinit(self: *Blas) void {
+        const api = self.ltlib.api;
+        var it = self.plans.valueIterator();
+        while (it.next()) |p| {
+            _ = api.cublasLtMatmulPreferenceDestroy(p.pref);
+            _ = api.cublasLtMatrixLayoutDestroy(p.c);
+            _ = api.cublasLtMatrixLayoutDestroy(p.b);
+            _ = api.cublasLtMatrixLayoutDestroy(p.a);
+            _ = api.cublasLtMatmulDescDestroy(p.desc);
+        }
+        self.plans.deinit(self.gpa);
+        _ = self.cublas_api.cublasDestroy_v2(self.cublas);
+        self.cublas_lib.close();
+        _ = api.cublasLtDestroy(self.handle);
+        self.ltlib.close();
+        self.gemm_ws.free();
+        self.workspace.free();
+        self.* = undefined;
+    }
+
+    fn plan(self: *Blas, m: usize, n: usize, k: usize, bias: u64) !*Plan {
+        const key: Key = .{ .m = @intCast(m), .n = @intCast(n), .k = @intCast(k), .bias = bias != 0 };
+        if (self.plans.getPtr(key)) |p| return p;
+        const l = &self.ltlib;
+        const api = l.api;
+        var p: Plan = undefined;
+        try l.check(api.cublasLtMatmulDescCreate(&p.desc, lt.compute_32f, .f32), "cublasLtMatmulDescCreate");
+        errdefer _ = api.cublasLtMatmulDescDestroy(p.desc);
+        const ta: c_int = 1;
+        const tb: c_int = 0;
+        try l.check(api.cublasLtMatmulDescSetAttribute(p.desc, lt.desc_transa, &ta, 4), "transa");
+        try l.check(api.cublasLtMatmulDescSetAttribute(p.desc, lt.desc_transb, &tb, 4), "transb");
+        if (bias != 0) {
+            const ep: c_int = bias_epilogue;
+            try l.check(api.cublasLtMatmulDescSetAttribute(p.desc, attr_epilogue, &ep, 4), "epilogue");
+            try l.check(api.cublasLtMatmulDescSetAttribute(p.desc, attr_bias_pointer, &bias, 8), "bias pointer");
+        }
+        // the column-major view PyTorch hands cuBLAS: D^T [n, m] = W [k, n]^T . X^T [k, m]
+        try l.check(api.cublasLtMatrixLayoutCreate(&p.a, .bf16, k, n, @intCast(k)), "layout A");
+        errdefer _ = api.cublasLtMatrixLayoutDestroy(p.a);
+        try l.check(api.cublasLtMatrixLayoutCreate(&p.b, .bf16, k, m, @intCast(k)), "layout B");
+        errdefer _ = api.cublasLtMatrixLayoutDestroy(p.b);
+        try l.check(api.cublasLtMatrixLayoutCreate(&p.c, .bf16, n, m, @intCast(n)), "layout C");
+        errdefer _ = api.cublasLtMatrixLayoutDestroy(p.c);
+        try l.check(api.cublasLtMatmulPreferenceCreate(&p.pref), "preference");
+        errdefer _ = api.cublasLtMatmulPreferenceDestroy(p.pref);
+        const limit: u64 = lt_workspace_bytes;
+        try l.check(api.cublasLtMatmulPreferenceSetAttribute(p.pref, lt.pref_max_workspace_bytes, &limit, 8), "workspace");
+        const alignment: u32 = 256;
+        for (0..4) |i| try l.check(api.cublasLtMatmulPreferenceSetAttribute(p.pref, pref_align_a + @as(c_int, @intCast(i)), &alignment, 4), "alignment");
+        var found: [1]lt.Heuristic = undefined;
+        var count: c_int = 0;
+        try l.check(api.cublasLtMatmulAlgoGetHeuristic(self.handle, p.desc, p.a, p.b, p.c, p.c, p.pref, 1, &found, &count), "heuristic");
+        if (count < 1 or found[0].state != 0) return error.NoAlgorithm;
+        p.algo = found[0].algo;
+        p.ws = found[0].workspace_size;
+        try self.plans.put(self.gpa, key, p);
+        return self.plans.getPtr(key).?;
+    }
+
+    /// out[m, n] = x[m, k] . w[n, k]^T (+ bias[n] in the epilogue when `bias` != 0), bf16 throughout, fp32 accumulation.
+    pub fn linear(self: *Blas, stream: cuda.Stream, x: u64, w: u64, bias: u64, out: u64, m: usize, n: usize, k: usize) !void {
+        if (bias == 0) return self.gemm(x, w, out, m, n, k);
+        const p = try self.plan(m, n, k, bias);
+        const l = &self.ltlib;
+        try l.check(l.api.cublasLtMatmulDescSetAttribute(p.desc, attr_bias_pointer, &bias, 8), "bias pointer");
+        const one: f32 = 1;
+        const zero: f32 = 0;
+        try l.check(l.api.cublasLtMatmul(self.handle, p.desc, &one, w, p.a, x, p.b, &zero, out, p.c, out, p.c, &p.algo, self.workspace.ptr, lt_workspace_bytes, stream.handle), "cublasLtMatmul");
+    }
+
+    /// The same product through cublasGemmEx (torch's mm).
+    pub fn gemm(self: *Blas, x: u64, w: u64, out: u64, m: usize, n: usize, k: usize) !void {
+        const one: f32 = 1;
+        const zero: f32 = 0;
+        const st = self.cublas_api.cublasGemmEx(self.cublas, 1, 0, @intCast(n), @intCast(m), @intCast(k), &one, w, 14, @intCast(k), x, 14, @intCast(k), &zero, out, 14, @intCast(n), 68, 99);
+        if (st != 0) {
+            std.log.err("cublasGemmEx failed: status {d} (m={d} n={d} k={d})", .{ st, m, n, k });
+            return error.GemmFailed;
+        }
+    }
+};
diff --git a/zig/src/families/glm_cuda/cuda_vision_check.zig b/zig/src/families/glm_cuda/cuda_vision_check.zig
new file mode 100644
index 00000000..1a32ada1
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_vision_check.zig
@@ -0,0 +1,506 @@
+//! GPU self-check of the vision tower against the Python reference's stages (zig/tests/vision/tower/gen.py writes the
+//! fixtures): the full chain stage by stage, and each stage run from the reference's own input ("teacher forced"), which
+//! places a first difference inside a stage instead of letting it spread through the 24 blocks.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const vision = @import("cuda_vision.zig");
+const kernels = @import("cuda_kernels.zig");
+
+pub const Stats = struct {
+    n: usize = 0,
+    identical: usize = 0,
+    max_abs: f64 = 0,
+    sum_abs: f64 = 0,
+    sum_ref: f64 = 0,
+    bad_nan: usize = 0,
+    first: [4]usize = .{ 0, 0, 0, 0 }, // indices of the first four differing values
+    nfirst: usize = 0,
+
+    pub fn identicalFrac(s: Stats) f64 {
+        return if (s.n == 0) 1 else @as(f64, @floatFromInt(s.identical)) / @as(f64, @floatFromInt(s.n));
+    }
+    pub fn meanRel(s: Stats) f64 {
+        return if (s.sum_ref == 0) 0 else s.sum_abs / s.sum_ref;
+    }
+};
+
+fn bf(u: u16) f32 {
+    return @bitCast(@as(u32, u) << 16);
+}
+
+pub fn compare(dtype: vision.StageDType, got: []const u8, ref: []const u8) Stats {
+    var s: Stats = .{};
+    switch (dtype) {
+        .bf16 => {
+            const a = std.mem.bytesAsSlice(u16, got);
+            const b = std.mem.bytesAsSlice(u16, ref);
+            s.n = @min(a.len, b.len);
+            for (a[0..s.n], b[0..s.n], 0..) |x, y, idx16| {
+                if (x == y) s.identical += 1 else if (s.nfirst < 4) {
+                    s.first[s.nfirst] = idx16;
+                    s.nfirst += 1;
+                }
+                const fx: f64 = bf(x);
+                const fy: f64 = bf(y);
+                if (std.math.isNan(fx) or std.math.isNan(fy)) {
+                    s.bad_nan += 1;
+                    continue;
+                }
+                const dd = @abs(fx - fy);
+                s.max_abs = @max(s.max_abs, dd);
+                s.sum_abs += dd;
+                s.sum_ref += @abs(fy);
+            }
+        },
+        .f32 => {
+            const a = std.mem.bytesAsSlice(f32, got);
+            const b = std.mem.bytesAsSlice(f32, ref);
+            s.n = @min(a.len, b.len);
+            for (a[0..s.n], b[0..s.n]) |x, y| {
+                if (@as(u32, @bitCast(x)) == @as(u32, @bitCast(y))) s.identical += 1;
+                const dd = @abs(@as(f64, x) - @as(f64, y));
+                if (std.math.isNan(dd)) {
+                    s.bad_nan += 1;
+                    continue;
+                }
+                s.max_abs = @max(s.max_abs, dd);
+                s.sum_abs += dd;
+                s.sum_ref += @abs(@as(f64, y));
+            }
+        },
+    }
+    return s;
+}
+
+pub const Fixture = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    dir: []const u8,
+    parsed: std.json.Parsed(std.json.Value),
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Fixture {
+        const path = try std.fs.path.join(gpa, &.{ dir, "manifest.json" });
+        defer gpa.free(path);
+        const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(text);
+        return .{ .gpa = gpa, .io = io, .dir = dir, .parsed = try std.json.parseFromSlice(std.json.Value, gpa, text, .{}) };
+    }
+    pub fn deinit(f: *Fixture) void {
+        f.parsed.deinit();
+    }
+    fn obj(f: Fixture) std.json.ObjectMap {
+        return f.parsed.value.object;
+    }
+    pub fn int(f: Fixture, name: []const u8) usize {
+        return @intCast(f.obj().get(name).?.integer);
+    }
+    pub fn has(f: Fixture, stage: []const u8) bool {
+        for (f.obj().get("stages").?.array.items) |s| if (std.mem.eql(u8, s.object.get("name").?.string, stage)) return true;
+        return false;
+    }
+    pub fn dtype(f: Fixture, stage: []const u8) ?vision.StageDType {
+        for (f.obj().get("stages").?.array.items) |s| if (std.mem.eql(u8, s.object.get("name").?.string, stage)) {
+            return if (std.mem.eql(u8, s.object.get("dtype").?.string, "float32")) .f32 else .bf16;
+        };
+        return null;
+    }
+    pub fn read(f: Fixture, stage: []const u8) ![]u8 {
+        const fname = try std.fmt.allocPrint(f.gpa, "{s}.bin", .{stage});
+        defer f.gpa.free(fname);
+        const path = try std.fs.path.join(f.gpa, &.{ f.dir, fname });
+        defer f.gpa.free(path);
+        return std.Io.Dir.cwd().readFileAlloc(f.io, path, f.gpa, .limited(1 << 31));
+    }
+};
+
+pub const Report = struct {
+    out: *std.Io.Writer,
+    pub fn line(r: Report, label: []const u8, s: Stats) void {
+        r.out.print("{s:<34} n={d:<9} identical={d:>9.6} max_abs={e:>10.3} mean_rel={e:>10.3}{s}\n", .{ label, s.n, s.identicalFrac(), s.max_abs, s.meanRel(), if (s.bad_nan > 0) " NaN!" else "" }) catch {};
+        r.out.flush() catch {};
+    }
+};
+
+const ChainCtx = struct {
+    c: *Checker,
+    pass: usize = 0,
+    prefix: []const u8 = "",
+};
+
+pub const Checker = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    fx: Fixture,
+    rep: Report,
+    scratch: std.ArrayList(u8) = .empty,
+    worst_block: usize = 0,
+    sweep: bool = false,
+    detail: bool = false,
+
+    fn download(c: *Checker, ptr: u64, bytes: usize) ![]u8 {
+        try c.scratch.resize(c.gpa, bytes);
+        const view: cuda.DeviceBuffer = .{ .d = c.d, .ptr = ptr, .len = bytes };
+        try view.download(0, c.scratch.items);
+        return c.scratch.items;
+    }
+
+    /// Compares a device array with a fixture stage and prints one table line.
+    pub fn check(c: *Checker, label: []const u8, stage: []const u8, ptr: u64, count: usize, dtype: vision.StageDType) !?Stats {
+        if (!c.fx.has(stage)) return null;
+        const ref = try c.fx.read(stage);
+        defer c.gpa.free(ref);
+        const esz: usize = if (dtype == .f32) 4 else 2;
+        const got = try c.download(ptr, @min(count * esz, ref.len));
+        const s = compare(dtype, got, ref);
+        c.rep.line(label, s);
+        if (c.detail and s.nfirst > 0 and dtype == .bf16) {
+            const a = std.mem.bytesAsSlice(u16, got);
+            const b = std.mem.bytesAsSlice(u16, ref);
+            for (s.first[0..s.nfirst]) |i| c.rep.out.print("    index {d} (row {d}, col {d} of 1024): got 0x{x:0>4} ref 0x{x:0>4}\n", .{ i, i / 1024, i % 1024, a[i], b[i] }) catch {};
+        }
+        return s;
+    }
+
+    fn hookCall(ctx: ?*anyopaque, name: []const u8, ptr: u64, count: usize, dtype: vision.StageDType) anyerror!void {
+        const h: *ChainCtx = @ptrCast(@alignCast(ctx.?));
+        if (std.mem.eql(u8, name, "patches")) h.pass += 1;
+        var buf: [96]u8 = undefined;
+        const stage = try std.fmt.bufPrint(&buf, "p{d}_{s}", .{ h.pass - 1, name });
+        _ = try h.c.check(stage, stage, ptr, count, dtype);
+    }
+
+    /// The whole tower through `encode`, every stage compared as it passes.
+    pub fn chain(c: *Checker, model_dir: []const u8, opts: vision.Options, canvas: []const u8, frames: usize, h: usize, w: usize) !void {
+        var ctx: ChainCtx = .{ .c = c };
+        var o = opts;
+        o.stage_hook = .{ .ctx = &ctx, .call = hookCall };
+        var t = try vision.Tower.init(c.gpa, c.io, c.d, c.stream, model_dir, o);
+        defer t.deinit();
+        const item: vision.Item = .{ .frames = frames, .h = h, .w = w, .pixels = canvas };
+        var out = try cuda.DeviceBuffer.alloc(c.d, item.rows() * 4096 * 2);
+        defer out.free();
+        try t.encode(&.{item}, out.ptr);
+        if (c.fx.has("features_all")) _ = try c.check("FINAL features vs features_all", "features_all", out.ptr, item.rows() * 4096, .bf16);
+    }
+
+    fn up(c: *Checker, stage: []const u8, ptr: u64) !void {
+        const raw = try c.fx.read(stage);
+        defer c.gpa.free(raw);
+        const view: cuda.DeviceBuffer = .{ .d = c.d, .ptr = ptr, .len = raw.len };
+        try view.upload(0, raw);
+    }
+
+    fn fmtz(buf: []u8, comptime fmt: []const u8, args: anytype) []const u8 {
+        return std.fmt.bufPrint(buf, fmt, args) catch unreachable;
+    }
+
+    /// Block `i`'s steps, each run from the reference's input to that step (the fixture stores b{i}_*).
+    fn innerBlock(c: *Checker, t: *vision.Tower, i: usize, R: usize, S: usize) !void {
+        const b = &t.b;
+        const bl = &t.blas;
+        const w0 = t.w.blocks[i];
+        var sb: [48]u8 = undefined;
+        var lb: [64]u8 = undefined;
+        const block_in = if (i == 0) "p0_embed" else fmtz(&sb, "p0_block{d:0>2}", .{i - 1});
+        const pre = fmtz(&lb, "p0_b{d}_", .{i});
+        var s1: [64]u8 = undefined;
+        var s2: [64]u8 = undefined;
+        var l1: [96]u8 = undefined;
+        // the step names
+        try c.up(block_in, b.x.ptr);
+        try t.stageRms(b.x.ptr, w0.norm1, b.h.ptr, R);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} norm1", .{i}), fmtz(&s1, "{s}norm1", .{pre}), b.h.ptr, R * 1024, .bf16);
+        try c.up(fmtz(&s1, "{s}norm1", .{pre}), b.h.ptr);
+        try bl.linear(c.stream, b.h.ptr, w0.qkv_w, w0.qkv_b, b.qkv.ptr, R, 3072, 1024);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} qkv linear (+bias)", .{i}), fmtz(&s1, "{s}qkv", .{pre}), b.qkv.ptr, R * 3072, .bf16);
+        try c.up(fmtz(&s1, "{s}qkv", .{pre}), b.qkv.ptr);
+        try t.stageQkNormRope(b.qkv.ptr, w0.q_norm, w0.k_norm, b.q.ptr, b.k.ptr, R, S);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} q norm+rope", .{i}), fmtz(&s1, "{s}qr", .{pre}), b.q.ptr, R * 1024, .bf16);
+        _ = try c.check(fmtz(&l1, "b{d} k norm+rope", .{i}), fmtz(&s1, "{s}kr", .{pre}), b.k.ptr, R * 1024, .bf16);
+        try c.up(fmtz(&s1, "{s}qr", .{pre}), b.q.ptr);
+        try c.up(fmtz(&s1, "{s}kr", .{pre}), b.k.ptr);
+        const keep = t.opts.attention;
+        for ([_]vision.Attention{ .flash2, .plain }) |att| {
+            if (att == .plain and i != 0) continue;
+            t.opts.attention = att;
+            try t.stageAttention(b.q.ptr, b.k.ptr, b.qkv.ptr + 2048 * 2, b.o.ptr, R, S);
+            try c.stream.synchronize();
+            _ = try c.check(fmtz(&l1, "b{d} attention {t}", .{ i, att }), fmtz(&s1, "{s}attn", .{pre}), b.o.ptr, R * 1024, .bf16);
+        }
+        t.opts.attention = keep;
+        if (c.sweep and (i == 0 or i == 23)) {
+            const keep_v = t.opts.flash_variant;
+            var v: u32 = 1;
+            while (v < 32) : (v += 1) {
+                t.opts.flash_variant = v;
+                try t.stageAttention(b.q.ptr, b.k.ptr, b.qkv.ptr + 2048 * 2, b.o.ptr, R, S);
+                try c.stream.synchronize();
+                _ = try c.check(fmtz(&l1, "b{d} attention flash2 variant {d}", .{ i, v }), fmtz(&s1, "{s}attn", .{pre}), b.o.ptr, R * 1024, .bf16);
+            }
+            t.opts.flash_variant = keep_v;
+        }
+        try c.up(fmtz(&s1, "{s}attn", .{pre}), b.o.ptr);
+        try bl.linear(c.stream, b.o.ptr, w0.proj_w, w0.proj_b, b.q.ptr, R, 1024, 1024);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} proj linear (+bias)", .{i}), fmtz(&s1, "{s}proj", .{pre}), b.q.ptr, R * 1024, .bf16);
+        try c.up(block_in, b.x.ptr);
+        try c.up(fmtz(&s1, "{s}proj", .{pre}), b.q.ptr);
+        try t.stageAdd(b.x.ptr, b.q.ptr, b.x.ptr, R * 1024);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} residual add", .{i}), fmtz(&s1, "{s}res1", .{pre}), b.x.ptr, R * 1024, .bf16);
+        try t.stageRms(b.x.ptr, w0.norm2, b.h.ptr, R);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} norm2", .{i}), fmtz(&s1, "{s}norm2", .{pre}), b.h.ptr, R * 1024, .bf16);
+        try c.up(fmtz(&s1, "{s}norm2", .{pre}), b.h.ptr);
+        try bl.linear(c.stream, b.h.ptr, w0.gate_w, w0.gate_b, b.gate.ptr, R, 4096, 1024);
+        try bl.linear(c.stream, b.h.ptr, w0.up_w, w0.up_b, b.up.ptr, R, 4096, 1024);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} gate linear (+bias)", .{i}), fmtz(&s1, "{s}gate_raw", .{pre}), b.gate.ptr, R * 4096, .bf16);
+        _ = try c.check(fmtz(&l1, "b{d} up linear (+bias)", .{i}), fmtz(&s2, "{s}up_raw", .{pre}), b.up.ptr, R * 4096, .bf16);
+        try c.up(fmtz(&s1, "{s}gate_raw", .{pre}), b.gate.ptr);
+        try c.up(fmtz(&s2, "{s}up_raw", .{pre}), b.up.ptr);
+        try t.stageSwiglu(b.gate.ptr, b.up.ptr, b.gate.ptr, R * 4096);
+        try c.stream.synchronize();
+        _ = try c.check(fmtz(&l1, "b{d} swiglu", .{i}), fmtz(&s1, "{s}act", .{pre}), b.gate.ptr, R * 4096, .bf16);
+        try c.up(fmtz(&s1, "{s}act", .{pre}), b.gate.ptr);
+        try bl.linear(c.stream, b.gate.ptr, w0.down_w, w0.down_b, b.h.ptr, R, 1024, 4096);
+        try c.up(fmtz(&s1, "{s}res1", .{pre}), b.x.ptr);
+        try t.stageAdd(b.x.ptr, b.h.ptr, b.x.ptr, R * 1024);
+        try c.stream.synchronize();
+        const out_name = if (i == 23) "p0_block23" else fmtz(&s1, "p0_block{d:0>2}", .{i});
+        _ = try c.check(fmtz(&l1, "b{d} down linear + add = block output", .{i}), out_name, b.x.ptr, R * 1024, .bf16);
+    }
+
+    /// Each stage of pass 0 from the reference's input to that stage.
+    pub fn teacher(c: *Checker, model_dir: []const u8, opts: vision.Options, canvas: []const u8, frames: usize, h: usize, w: usize, hypotheses: bool) !void {
+        var t = try vision.Tower.init(c.gpa, c.io, c.d, c.stream, model_dir, opts);
+        defer t.deinit();
+        const gh = h / 14;
+        const gw = w / 14;
+        const S = gh * gw;
+        const pairs: usize = if (frames == 1) 1 else frames / 2;
+        const per = @max(1, opts.pass_patches / S);
+        const n = @min(per, pairs);
+        const R = n * S;
+        try t.ensure(R, S, canvas.len);
+        const b = &t.b;
+        const rep = c.rep;
+        rep.out.print("-- teacher-forced stages, pass 0: {d} rows, grid {d}x{d}\n", .{ R, gh, gw }) catch {};
+        // patches
+        {
+            try b.frames.upload(0, canvas[0 .. if (frames == 1) canvas.len else 2 * n * 3 * h * w]);
+            var tmp = try cuda.DeviceBuffer.alloc(c.d, R * 1176 * 4);
+            defer tmp.free();
+            try t.stagePatches(b.frames.ptr, if (frames == 1) 0 else 3 * h * w, 0, n, gh, gw, h, w, b.patches.ptr, tmp.ptr);
+            try c.stream.synchronize();
+            _ = try c.check("patches (fp32)", "p0_patches", tmp.ptr, R * 1176, .f32);
+        }
+        // the rope tables from scratch
+        try t.stageRope(gh, gw);
+        try c.stream.synchronize();
+        _ = try c.check("rope cos", "p0_rope_cos", b.rope_cos.ptr, S * 64, .f32);
+        _ = try c.check("rope sin", "p0_rope_sin", b.rope_sin.ptr, S * 64, .f32);
+        // embed: the fp32 patches rounded to bf16 are the conv input
+        {
+            const order_names = [_]vision.EmbedOrder{ .ctyx, .tyxc, .tyxc4, .tyxc8, .yxtc, .yxtc8, .yxct };
+            var out = try cuda.DeviceBuffer.alloc(c.d, R * 1024 * 2);
+            defer out.free();
+            const list: []const vision.EmbedOrder = if (hypotheses) &order_names else &.{opts.embed_order};
+            const keep_conv = t.opts.conv;
+            t.opts.conv = .own;
+            for ([_]vision.EmbedKind{ .seq, .mma }) |kind| {
+                if (!hypotheses) break;
+                t.opts.embed_kind = kind;
+                for (list) |ord| {
+                    try t.setEmbedOrder(ord);
+                    try t.stageEmbed(b.patches.ptr, out.ptr, R, false);
+                    try c.stream.synchronize();
+                    var lab: [64]u8 = undefined;
+                    _ = try c.check(try std.fmt.bufPrint(&lab, "embed (no bias) {t} order={t}", .{ kind, ord }), "p0_embed_nobias", out.ptr, R * 1024, .bf16);
+                }
+            }
+            t.opts.embed_kind = opts.embed_kind;
+            t.opts.conv = keep_conv;
+            try t.setEmbedOrder(opts.embed_order);
+            try t.stageEmbed(b.patches.ptr, b.x.ptr, R, true);
+            try c.stream.synchronize();
+            var lab2: [96]u8 = undefined;
+            _ = try c.check(fmtz(&lab2, "embed (+bias) conv={t} cuDNN engine {d}", .{ t.opts.conv, try t.convEngine(false, R) }), "p0_embed", b.x.ptr, R * 1024, .bf16);
+        }
+        // block 0 (and any block whose inner steps are stored) piece by piece, each from the reference's input
+        var bi: usize = 0;
+        while (bi < t.cfg.depth) : (bi += 1) {
+            var nbuf: [32]u8 = undefined;
+            if (c.fx.has(try std.fmt.bufPrint(&nbuf, "p0_b{d}_norm1", .{bi}))) try c.innerBlock(&t, bi, R, S);
+        }
+        const bl = &t.blas;
+        // blocks, each from the reference's previous output
+        const all = c.fx.has("p0_block01");
+        const last: usize = if (all) 23 else 0;
+        var i: usize = 0;
+        var buf: [32]u8 = undefined;
+        while (i <= last) : (i += 1) {
+            const src = if (i == 0) "p0_embed" else try std.fmt.bufPrint(&buf, "p0_block{d:0>2}", .{i - 1});
+            try c.up(src, b.x.ptr);
+            try t.stageBlock(i, R, S);
+            try c.stream.synchronize();
+            var nbuf: [32]u8 = undefined;
+            const stage = try std.fmt.bufPrint(&nbuf, "p0_block{d:0>2}", .{i});
+            var lab: [48]u8 = undefined;
+            _ = try c.check(try std.fmt.bufPrint(&lab, "block {d:0>2} from reference input", .{i}), stage, b.x.ptr, R * 1024, .bf16);
+        }
+        if (!all) {
+            for ([_]usize{ 12, 23 }) |blk| {
+                var nbuf: [32]u8 = undefined;
+                var nbuf2: [32]u8 = undefined;
+                const src = try std.fmt.bufPrint(&nbuf, "p0_block{d:0>2}", .{blk - 1});
+                if (!c.fx.has(src)) continue; // only blocks 0, 12 and 23 are stored
+                try c.up(src, b.x.ptr);
+                try t.stageBlock(blk, R, S);
+                try c.stream.synchronize();
+                _ = try c.check("block from reference input", try std.fmt.bufPrint(&nbuf2, "p0_block{d:0>2}", .{blk}), b.x.ptr, R * 1024, .bf16);
+            }
+        }
+        // the head
+        try c.up("p0_block23", b.x.ptr);
+        const M = R / 4;
+        try t.stageRms(b.x.ptr, t.w.post_norm, b.h.ptr, R);
+        try c.stream.synchronize();
+        _ = try c.check("post norm", "p0_post_norm", b.h.ptr, R * 1024, .bf16);
+        try c.up("p0_post_norm", b.h.ptr);
+        {
+            var lab: [96]u8 = undefined;
+            try t.stageDownsample(b.h.ptr, b.o.ptr, M, false);
+            try c.stream.synchronize();
+            _ = try c.check(fmtz(&lab, "downsample (no bias) conv={t} cuDNN engine {d}", .{ t.opts.conv, try t.convEngine(true, M) }), "p0_downsample_nobias", b.o.ptr, M * 4096, .bf16);
+        }
+        if (hypotheses) {
+            const keep_conv = t.opts.conv;
+            t.opts.conv = .own;
+            for ([_]u32{ 0, 16, 32, 64, 128, 256, 512 }) |fresh| {
+                t.opts.downsample_fresh = fresh;
+                try t.stageDownsample(b.h.ptr, b.o.ptr, M, false);
+                try c.stream.synchronize();
+                var lab: [64]u8 = undefined;
+                _ = try c.check(try std.fmt.bufPrint(&lab, "downsample own chain partial={d}", .{fresh}), "p0_downsample_nobias", b.o.ptr, M * 4096, .bf16);
+            }
+            t.opts.conv = keep_conv;
+        }
+        t.opts.downsample_fresh = opts.downsample_fresh;
+        try t.stageDownsample(b.h.ptr, b.o.ptr, M, true);
+        try c.stream.synchronize();
+        _ = try c.check("downsample (+bias)", "p0_downsample", b.o.ptr, M * 4096, .bf16);
+        try c.up("p0_downsample", b.o.ptr);
+        try bl.linear(c.stream, b.o.ptr, t.w.merger_proj, 0, b.q.ptr, M, 4096, 4096);
+        try c.stream.synchronize();
+        _ = try c.check("merger proj (cublasGemmEx)", "p0_merger_proj", b.q.ptr, M * 4096, .bf16);
+        try c.up("p0_merger_proj", b.q.ptr);
+        const ly = [_]u32{ 1, 2, 4, 8, 16 };
+        for (ly) |rows| {
+            t.opts.ln_rows = rows;
+            const nv: u32 = if (c.sweep) 16 else 1;
+            var v: u32 = 0;
+            while (v < nv) : (v += 1) {
+                t.opts.ln_variant = v;
+                try t.stageLnGelu(b.q.ptr, b.k.ptr, b.o.ptr, M);
+                try c.stream.synchronize();
+                var lab: [64]u8 = undefined;
+                _ = try c.check(try std.fmt.bufPrint(&lab, "merger layer_norm (BY={d} variant {d})", .{ rows, v }), "p0_merger_ln", b.k.ptr, M * 4096, .bf16);
+                if (v == 0) _ = try c.check(try std.fmt.bufPrint(&lab, "merger gelu (BY={d})", .{rows}), "p0_merger_gelu", b.o.ptr, M * 4096, .bf16);
+            }
+        }
+        t.opts.ln_variant = opts.ln_variant;
+        t.opts.ln_rows = opts.ln_rows;
+        try c.up("p0_merger_ln", b.k.ptr);
+        try t.stageGelu(b.k.ptr, b.o.ptr, M * 4096);
+        try c.stream.synchronize();
+        _ = try c.check("gelu alone, from reference layer_norm", "p0_merger_gelu", b.o.ptr, M * 4096, .bf16);
+        try c.up("p0_merger_gelu", b.q.ptr);
+        const pi = t.cfg.proj_inter;
+        try bl.linear(c.stream, b.q.ptr, t.w.merger_gate, 0, b.gate.ptr, M, pi, 4096);
+        try bl.linear(c.stream, b.q.ptr, t.w.merger_up, 0, b.up.ptr, M, pi, 4096);
+        try t.stageSwiglu(b.gate.ptr, b.up.ptr, b.gate.ptr, M * pi);
+        try bl.linear(c.stream, b.gate.ptr, t.w.merger_down, 0, b.o.ptr, M, 4096, pi);
+        try c.stream.synchronize();
+        _ = try c.check("merger swiglu + down -> features", "p0_features", b.o.ptr, M * 4096, .bf16);
+    }
+
+    /// Time and device memory of `encode` on this input (no hook).
+    pub fn bench(c: *Checker, model_dir: []const u8, opts: vision.Options, canvas: []const u8, frames: usize, h: usize, w: usize) !void {
+        var o = opts;
+        o.stage_hook = null;
+        _ = cuda.usage(true);
+        var t = try vision.Tower.init(c.gpa, c.io, c.d, c.stream, model_dir, o);
+        defer t.deinit();
+        const item: vision.Item = .{ .frames = frames, .h = h, .w = w, .pixels = canvas };
+        var out = try cuda.DeviceBuffer.alloc(c.d, item.rows() * 4096 * 2);
+        defer out.free();
+        const weights = cuda.usage(false).device;
+        try t.encode(&.{item}, out.ptr);
+        var a = try cuda.Event.init(c.d, true);
+        defer a.deinit();
+        var b = try cuda.Event.init(c.d, true);
+        defer b.deinit();
+        try a.record(c.stream);
+        const runs: usize = 3;
+        for (0..runs) |_| try t.encode(&.{item}, out.ptr);
+        try b.record(c.stream);
+        try b.synchronize();
+        const ms = try cuda.Event.elapsedMs(a, b) / @as(f32, @floatFromInt(runs));
+        // a second, profiled pass
+        t.opts.profile = true;
+        try t.encode(&.{item}, out.ptr);
+        try t.profileFlush();
+        t.opts.profile = false;
+        var it = t.prof_ms.iterator();
+        while (it.next()) |e| c.rep.out.print("  profile {s:<44} {d:>8.2} ms\n", .{ e.key_ptr.*, e.value_ptr.* }) catch {};
+        const u = cuda.usage(false);
+        c.rep.out.print("bench: {d:.1} ms per encode ({d} rows); device bytes: weights+tower {d:.1} MiB at start, peak {d:.1} MiB (peak beyond the weights {d:.1} MiB, the weights are {d:.1} MiB)\n", .{ ms, item.rows(), @as(f64, @floatFromInt(weights)) / 1048576, @as(f64, @floatFromInt(u.peak)) / 1048576, @as(f64, @floatFromInt(u.peak - t.w.bytes)) / 1048576, @as(f64, @floatFromInt(t.w.bytes)) / 1048576 }) catch {};
+        c.rep.out.flush() catch {};
+    }
+};
+
+/// Candidate formulas for torch's bf16 GELU and SiLU against tables of torch's own results at every bf16 value
+/// (tests/vision/tower/gen_luts.py): prints how many of the 65536 inputs each candidate gets wrong.
+pub fn actCandidates(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, stream: cuda.Stream, out: *std.Io.Writer, luts_path: []const u8) !void {
+    const lut = try std.Io.Dir.cwd().readFileAlloc(io, luts_path, gpa, .limited(1 << 20));
+    defer gpa.free(lut);
+    if (lut.len != 4 * 65536) return error.BadLuts;
+    const table = std.mem.bytesAsSlice(u16, lut);
+    var mod = try kernels.load(d, .vision);
+    defer mod.unload();
+    const f = try mod.function("vis_act_candidates");
+    var buf = try cuda.DeviceBuffer.alloc(d, 65536 * 2);
+    defer buf.free();
+    const got = try gpa.alloc(u16, 65536);
+    defer gpa.free(got);
+    const names = [_][]const u8{ "gelu fp32", "gelu erf(double) of a double argument", "gelu double, fp32 argument", "silu fp32", "silu double", "gelu 0.5x erfc(-x/sqrt2)", "gelu x normcdf(x)", "gelu fma(0.5x, erf, 0.5x)", "gelu unfused", "gelu mixed fp32 erf, double product" };
+    for (names, 0..) |name, mode| {
+        var a: cuda.Args = .{};
+        a.add(buf.ptr);
+        a.add(@as(i32, @intCast(mode)));
+        try cuda.launch.launch(f, .{ .grid = .{ .x = 256 }, .block = .{ .x = 256 } }, stream, &a);
+        try stream.synchronize();
+        try buf.download(0, std.mem.sliceAsBytes(got));
+        const ref = if (mode < 3 or mode > 4) table[65536..] else table[0..65536];
+        var bad: usize = 0;
+        var shown: usize = 0;
+        for (got, ref, 0..) |g, r, i| {
+            if (g == r) continue;
+            // NaN payloads and the sign of zero are not what the model sees; count them apart
+            bad += 1;
+            if (shown < 4) {
+                out.print("    x=0x{x:0>4} ({e}): got 0x{x:0>4} ref 0x{x:0>4}\n", .{ i, bf(@intCast(i)), g, r }) catch {};
+                shown += 1;
+            }
+        }
+        out.print("act candidate {s:<42} wrong on {d} of 65536 inputs\n", .{ name, bad }) catch {};
+        out.flush() catch {};
+    }
+}
