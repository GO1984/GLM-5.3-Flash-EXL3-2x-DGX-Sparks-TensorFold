+    var e1: MiniEngine = .{ .gpa = gpa, .spill_on = true };
+    defer e1.deinit();
+    var r0 = B.init(gpa, &e0, true, 1 << 20, 8);
+    var r1 = B.init(gpa, &e1, true, 1 << 20, 8);
