+            if (t >= 154880) return error.BadToken;
+            d.* = @intCast(t);
+        }
+        var begin: usize = 0;
+        if (o.resume_from) |snap| {
+            if (snap.pos == 0 or snap.pos >= prompt.len or snap.pos % 64 != 0) return error.ResumeMustExtend;
