+        try f.tri.router_part(.{ (rows + bm - 1) / bm, (ne + 31) / 32, 8 }, f.b.normed, w, f.s.router_part, ci(rows), 4096, .{ .D = 4096, .NE = c(ne), .BM = c(bm), .BLOCK_E = 32, .BK = 64, .KS = 8 });
