+/// TF_GLM_AB=stage,greedy: measurement aid. Odd generations (1st, 3rd, ...) run the new paths, even ones the old: the
+/// blocking metadata staging and readbacks (`stage`) and/or the radix top-k greedy (`greedy`). Both ranks count the
+/// same generations, so they switch together; one process then carries an interleaved A/B with no session drift.
+var ab_calls: usize = 0;
+fn abSwitch(e: *engine.Engine) void {
+    const v = std.c.getenv("TF_GLM_AB") orelse return;
+    const spec = std.mem.span(v);
+    ab_calls += 1;
+    const old = ab_calls % 2 == 0;
+    @import("cuda_stage.zig").sync_mode = old and std.mem.indexOf(u8, spec, "stage") != null;
+    e.sampler.legacy_greedy = old and std.mem.indexOf(u8, spec, "greedy") != null;
+    std.log.info("A/B generation {d}: {s}", .{ ab_calls, if (old) "old paths" else "new paths" });
+}
+
+/// TF_GLM_PROFILE_AT=<seconds since this process started>: the profiled decode waits until then, so an nsys time window
+/// (`--delay`, `--duration`) can enclose it whatever the weight-load time was (nsys did not honour the capture range
+/// the driver and runtime profiler calls set).
+fn profileWait() void {
+    const v = std.c.getenv("TF_GLM_PROFILE_AT") orelse return;
+    const at = std.fmt.parseFloat(f64, std.mem.span(v)) catch return;
+    var buf: [1024]u8 = undefined;
+    const fd = std.c.open("/proc/self/stat", .{}, @as(std.c.mode_t, 0));
+    if (fd < 0) return;
+    defer _ = std.c.close(fd);
+    const n = std.c.read(fd, &buf, buf.len);
+    if (n <= 0) return;
+    const text = buf[0..@intCast(n)];
+    // fields after the ")" that ends the command name; starttime is field 22 overall = the 20th after it
+    const close = std.mem.lastIndexOfScalar(u8, text, ')') orelse return;
+    var it = std.mem.tokenizeScalar(u8, text[close + 1 ..], ' ');
+    var i: usize = 0;
+    var ticks: f64 = 0;
+    while (it.next()) |tok| : (i += 1) if (i == 19) {
+        ticks = std.fmt.parseFloat(f64, tok) catch return;
+        break;
+    };
+    var now: std.c.timespec = undefined;
+    if (std.c.clock_gettime(.BOOTTIME, &now) != 0) return;
+    const up = @as(f64, @floatFromInt(now.sec)) + @as(f64, @floatFromInt(now.nsec)) / 1e9 - ticks / 100.0;
+    if (up >= at) return;
+    const wait = at - up;
+    std.log.info("profile: waiting {d:.1} s (process age {d:.1} s)", .{ wait, up });
+    var req: std.c.timespec = .{ .sec = @intFromFloat(wait), .nsec = @intFromFloat((wait - @floor(wait)) * 1e9) };
+    _ = std.c.nanosleep(&req, null);
+}
diff --git a/zig/src/families/glm_cuda/cuda_nucleus.zig b/zig/src/families/glm_cuda/cuda_nucleus.zig
new file mode 100644
index 00000000..289c11dd
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_nucleus.zig
@@ -0,0 +1,261 @@
+//! Port of tensorfold/cuda/sampling.py _draw, _union_covers.
+//! Flash Next's top_k-off draws (Python tensorfold/cuda/sampling.nucleus_rows): each token's share of the row's mass
+//! in fixed point (floor(exp(f64(logit) / t - top) * 2^40), int64, on the GPU with CUDA's fp64 exp as torch's
+//! elementwise kernels run it: cuda_torch_ops.nucleusMass), every rank's top candidates (value, global id, mass) with
+//! its shard's mass sum and width, and the keyed draw over the top_p nucleus then min_p on the host (`_draw`): the
+//! nucleus cut by exact integer mass sums, the same on every rank. A rank whose nucleus runs past its candidates
+//! sends its whole shard instead. tools/zig/check_flashnext_nucleus.py checks the mass kernel against torch and
+//! records fixtures of Python's own _shares / _draw, which the test here replays.
+const std = @import("std");
+const lanes = @import("lanes");
+
+const Allocator = std.mem.Allocator;
+const S = lanes.sampling;
+
+extern "c" fn log(x: f64) f64;
+
+/// sampling.MASS and NUCLEUS
+pub const mass_scale: f64 = 1099511627776.0;
+pub const nucleus: usize = 1024;
+
+/// `_shares`' gathered arrays, [world][rows][count] row-major (and [world][rows] for sums and widths).
+pub const Shares = struct {
+    world: usize,
+    rows: usize,
+    count: usize,
+    vals: []const f64,
+    ids: []const i64,
+    mass: []const i64,
+    sums: []const i64,
+    widths: []const i64,
+};
+
+pub const Drawn = struct { token: u64, share: f64 };
+
+/// math.ceil(Fraction(top_p) * total), exact: top_p is m * 2^e.
+fn need(top_p: f64, total: i128) i128 {
+    const b: u64 = @bitCast(top_p);
+    const raw_exp: i64 = @intCast((b >> 52) & 0x7ff);
+    var m: u128 = b & ((@as(u64, 1) << 52) - 1);
+    var e: i64 = undefined;
+    if (raw_exp == 0) {
+        e = -1074;
+    } else {
+        m |= @as(u128, 1) << 52;
+        e = raw_exp - 1075;
+    }
+    const num: u128 = m * @as(u128, @intCast(total));
+    if (e >= 0) return @intCast(num << @intCast(e));
+    const sh: u7 = @intCast(@min(-e, 127));
+    const one: u128 = @as(u128, 1) << sh;
+    return @intCast((num + one - 1) >> sh);
+}
+
+const Entry = struct { v: f64, id: i64, m: i64 };
+
+/// np.lexsort((ids, -vals)): value descending, then id ascending.
+fn before(_: void, a: Entry, b: Entry) bool {
+    if (a.v != b.v) return a.v > b.v;
+    return a.id < b.id;
+}
+
+/// sampling._draw: each row's (token, share of the mass), or false when some rank's nucleus runs past its
+/// candidates (the caller then sends whole shards).
+pub fn drawShares(gpa: Allocator, sh: Shares, positions: []const u64, s: S.Sampling, out: []Drawn) !bool {
+    return drawSharesWithUnion(gpa, sh, positions, s, out, false);
+}
+
+pub fn drawSharesWithUnion(gpa: Allocator, sh: Shares, positions: []const u64, s: S.Sampling, out: []Drawn, union_cover: bool) !bool {
+    const cut = 0.0 < s.top_p and s.top_p < 1.0;
+    const min_log = s.minLog();
+    const list = try gpa.alloc(Entry, sh.world * sh.count);
+    defer gpa.free(list);
+    for (0..sh.rows) |r| {
+        var total: i128 = 0;
+        for (0..sh.world) |k| total += sh.sums[k * sh.rows + r];
+        const want: i128 = if (cut) need(s.top_p, total) else 0;
+        var top = -std.math.inf(f64);
+        for (0..sh.world) |k| for (sh.vals[(k * sh.rows + r) * sh.count ..][0..sh.count]) |v| {
+            top = @max(top, v);
+        };
+        const floor = top + min_log;
+        if (cut and union_cover) {
+            var n: usize = 0;
+            var boundary = -std.math.inf(f64);
+            for (0..sh.world) |k| {
+                const at = (k * sh.rows + r) * sh.count;
+                var real: usize = 0;
+                var last = std.math.inf(f64);
+                for (0..sh.count) |j| if (sh.ids[at + j] >= 0) {
+                    list[n] = .{ .v = sh.vals[at + j], .id = sh.ids[at + j], .m = sh.mass[at + j] };
+                    n += 1;
+                    real += 1;
+                    last = @min(last, sh.vals[at + j]);
+                };
+                if (real != sh.widths[k * sh.rows + r]) boundary = @max(boundary, last);
+            }
+            std.mem.sort(Entry, list[0..n], {}, before);
+            var acc: i128 = 0;
+            var covered = boundary == -std.math.inf(f64);
+            for (list[0..n]) |x| {
+                acc += x.m;
+                if (acc >= want) {
+                    covered = x.v > boundary;
+                    break;
+                }
+            }
+            if (!covered) return false;
+        }
+        // Per-shard coverage in the default path; opt-in union tested above.
+        for (0..if (cut and union_cover) 0 else sh.world) |k| {
+            const at = (k * sh.rows + r) * sh.count;
+            var n: usize = 0;
+            for (0..sh.count) |j| if (sh.ids[at + j] >= 0) {
+                list[n] = .{ .v = sh.vals[at + j], .id = sh.ids[at + j], .m = sh.mass[at + j] };
+                n += 1;
+            };
+            if (@as(i64, @intCast(n)) == sh.widths[k * sh.rows + r]) continue; // its whole shard
+            std.mem.sort(Entry, list[0..n], {}, before);
+            var covered = false;
+            if (cut) {
+                var acc: i128 = 0;
+                for (list[0..n]) |x| {
+                    acc += x.m;
+                    if (acc >= want) {
+                        covered = x.v > list[n - 1].v;
+                        break;
+                    }
+                }
+            } else if (s.min_p > 0.0) {
+                for (list[0..n]) |x| if (x.v < floor) {
+                    covered = true;
+                    break;
+                };
+            }
+            if (!covered) return false;
+        }
+        var n: usize = 0;
+        for (0..sh.world) |k| {
+            const at = (k * sh.rows + r) * sh.count;
+            for (0..sh.count) |j| if (sh.ids[at + j] >= 0) {
+                list[n] = .{ .v = sh.vals[at + j], .id = sh.ids[at + j], .m = sh.mass[at + j] };
+                n += 1;
+            };
+        }
+        std.mem.sort(Entry, list[0..n], {}, before);
+        var keep = n;
+        if (cut) {
+            var acc: i128 = 0;
+            var below: usize = 0;
+            for (list[0..n]) |x| {
+                acc += x.m;
+                if (acc < want) below += 1;
+            }
+            keep = below + 1;
+        }
+        if (s.min_p > 0.0) {
+            var above: usize = 0;
+            for (list[0..n]) |x| above += @intFromBool(x.v >= floor);
+            keep = @min(keep, above);
+        }
+        keep = @min(keep, n);
+        if (keep == 0) return error.EmptyNucleus;
+        var best: usize = 0;
+        var best_score: f64 = undefined;
+        for (list[0..keep], 0..) |x, j| {
+            const u = S.uniform(s.seed, positions[r], @bitCast(x.id));
+            const score = x.v - log(-log(u));
+            if (j == 0 or score > best_score) {
+                best = j;
+                best_score = score;
+            }
+        }
+        out[r] = .{ .token = @intCast(list[best].id), .share = @as(f64, @floatFromInt(list[best].m)) / @as(f64, @floatFromInt(total)) };
+    }
+    return true;
+}
+
+test "need is math.ceil(Fraction(top_p) * total)" {
+    try std.testing.expectEqual(@as(i128, 95), need(0.95, 100)); // 0.95 is just under 95/100: ceil gives 95
+    try std.testing.expectEqual(@as(i128, 1), need(0.5, 1));
+    try std.testing.expectEqual(@as(i128, 0), need(0.5, 0));
+    try std.testing.expectEqual(@as(i128, 549755813888), need(0.5, 1099511627776));
+}
+
+fn flatten(gpa: Allocator, comptime T: type, v: std.json.Value, out: *std.ArrayList(T)) !void {
+    switch (v) {
+        .array => |a| for (a.items) |x| try flatten(gpa, T, x, out),
+        .integer => |i| try out.append(gpa, if (T == f64) @bitCast(@as(u64, @bitCast(i))) else @intCast(i)),
+        // f64 values travel as their u64 bits; ids, masses, sums and widths as signed integers
+        .number_string => |s| try out.append(gpa, if (T == f64) @bitCast(try std.fmt.parseInt(u64, s, 10)) else try std.fmt.parseInt(i64, s, 10)),
+        else => return error.BadFixture,
+    }
+}
+
+const Owned = struct {
+    vals: std.ArrayList(f64) = .empty,
+    ids: std.ArrayList(i64) = .empty,
+    mass: std.ArrayList(i64) = .empty,
+    sums: std.ArrayList(i64) = .empty,
+    widths: std.ArrayList(i64) = .empty,
+
+    fn deinit(o: *Owned, gpa: Allocator) void {
+        o.vals.deinit(gpa);
+        o.ids.deinit(gpa);
+        o.mass.deinit(gpa);
+        o.sums.deinit(gpa);
+        o.widths.deinit(gpa);
+    }
+
+    fn shares(o: *Owned, gpa: Allocator, v: std.json.ObjectMap, world: usize, rows: usize) !Shares {
+        try flatten(gpa, f64, v.get("vals").?, &o.vals);
+        try flatten(gpa, i64, v.get("ids").?, &o.ids);
+        try flatten(gpa, i64, v.get("mass").?, &o.mass);
+        try flatten(gpa, i64, v.get("sums").?, &o.sums);
+        try flatten(gpa, i64, v.get("widths").?, &o.widths);
+        return .{ .world = world, .rows = rows, .count = try std.fmt.parseInt(usize, v.get("count").?.number_string, 10), .vals = o.vals.items, .ids = o.ids.items, .mass = o.mass.items, .sums = o.sums.items, .widths = o.widths.items };
+    }
+};
+
+test "the draws equal Python's _draw on its own candidates, one rank and two, whole-shard fallbacks included" {
+    const gpa = std.testing.allocator;
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, @embedFile("fixtures_cuda_nucleus.json"), .{ .parse_numbers = false });
+    defer parsed.deinit();
+    for (parsed.value.object.get("cases").?.array.items, 0..) |cv, ci| {
+        const c = cv.object;
+        const world: usize = @intCast(try std.fmt.parseInt(i64, c.get("world").?.number_string, 10));
+        const rows: usize = @intCast(try std.fmt.parseInt(i64, c.get("rows").?.number_string, 10));
+        var pos: [8]u64 = undefined;
+        for (c.get("positions").?.array.items, 0..) |p, i| pos[i] = try std.fmt.parseInt(u64, p.number_string, 10);
+        const so = c.get("sampling").?.object;
+        const s: S.Sampling = .{ .seed = try std.fmt.parseInt(u64, so.get("seed").?.number_string, 10), .temperature = try std.fmt.parseFloat(f64, so.get("temperature").?.number_string), .top_k = 0, .top_p = try std.fmt.parseFloat(f64, so.get("top_p").?.number_string), .min_p = try std.fmt.parseFloat(f64, so.get("min_p").?.number_string) };
+        var first: Owned = .{};
+        defer first.deinit(gpa);
+        var out: [8]Drawn = undefined;
+        var ok = try drawShares(gpa, try first.shares(gpa, c.get("first").?.object, world, rows), pos[0..rows], s, out[0..rows]);
+        var fb: Owned = .{};
+        defer fb.deinit(gpa);
+        if (c.get("fallback").? != .null) {
+            errdefer std.debug.print("case {d}: the first candidates should not cover\n", .{ci});
+            try std.testing.expect(!ok);
+            ok = try drawShares(gpa, try fb.shares(gpa, c.get("fallback").?.object, world, rows), pos[0..rows], s, out[0..rows]);
+        }
+        errdefer std.debug.print("case {d}\n", .{ci});
+        try std.testing.expect(ok);
+        for (c.get("drawn").?.array.items, out[0..rows]) |want, got| {
+            try std.testing.expectEqual(try std.fmt.parseInt(u64, want.array.items[0].number_string, 10), got.token);
+            try std.testing.expectEqual(try std.fmt.parseInt(u64, want.array.items[1].number_string, 10), @as(u64, @bitCast(got.share)));
+        }
+    }
+}
+
+test "union covers a nucleus that no individual shard covers, strict tie boundary requires fallback" {
+    const gpa = std.testing.allocator;
+    var drawn: [1]Drawn = undefined;
+    var sh: Shares = .{ .world = 2, .rows = 1, .count = 2, .vals = &.{ 3, 1, 2, 0 }, .ids = &.{ 0, 1, 2, 3 }, .mass = &.{ 40, 10, 35, 5 }, .sums = &.{ 55, 45 }, .widths = &.{ 3, 3 } };
+    const sampling: S.Sampling = .{ .seed = 1, .top_k = 0, .top_p = 0.7 };
+    try std.testing.expect(!try drawShares(gpa, sh, &.{7}, sampling, &drawn));
+    try std.testing.expect(try drawSharesWithUnion(gpa, sh, &.{7}, sampling, &drawn, true));
+    sh.vals = &.{ 3, 2, 2, 0 };
+    try std.testing.expect(!try drawSharesWithUnion(gpa, sh, &.{7}, sampling, &drawn, true));
+}
diff --git a/zig/src/families/glm_cuda/cuda_pool.zig b/zig/src/families/glm_cuda/cuda_pool.zig
new file mode 100644
index 00000000..4b5e8418
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_pool.zig
@@ -0,0 +1,120 @@
+//! Host extent placement from glm5_next/cuda/pool.py: Pool (device copies remain the caller's job).
+const std = @import("std");
+pub const alignment = 2048;
+pub const Extent = struct {
+    base: usize,
+    size: usize,
+    eid: u64,
+    owner: ?u64 = null,
+    kept: usize = 0,
+    pub fn end(x: Extent) usize {
+        return x.base + x.size;
+    }
+    pub fn free(x: Extent) bool {
+        return x.owner == null and x.kept == 0;
+    }
+};
+pub const Pool = struct {
+    gpa: std.mem.Allocator,
+    rows: usize,
+    extents: std.ArrayList(Extent) = .empty,
+    next_id: u64 = 0,
+    pub fn init(gpa: std.mem.Allocator, rows: usize) !Pool {
+        if (rows == 0 or rows % alignment != 0) return error.BadPool;
+        return .{ .gpa = gpa, .rows = rows };
+    }
+    pub fn deinit(p: *Pool) void {
+        p.extents.deinit(p.gpa);
+    }
+    fn sizeOf(size: usize) !usize {
+        if (size == 0 or size > std.math.maxInt(usize) - (alignment - 1)) return error.BadExtent;
+        return std.mem.alignForward(usize, size, alignment);
+    }
+    pub fn get(p: *Pool, eid: u64) !*Extent {
+        for (p.extents.items) |*x| {
+            if (x.eid == eid) return x;
+        }
+        return error.NoExtent;
+    }
+    pub fn freeRows(p: Pool) usize {
+        var n = p.rows;
+        for (p.extents.items) |x| n -= x.size;
+        return n;
+    }
+    /// Ignore the moving extent when searching for a relocation; lowest-base first fit.
+    pub fn place(p: Pool, requested: usize, ignore: ?u64) !?usize {
+        const size = try sizeOf(requested);
+        var at: usize = 0;
+        for (p.extents.items) |x| {
+            if (ignore != null and x.eid == ignore.?) continue;
+            if (x.base - at >= size) return at;
+            at = x.end();
+        }
+        return if (p.rows - at >= size) at else null;
+    }
+    fn validate(p: Pool, base: usize, size: usize, ignore: ?u64) !void {
+        if (base % alignment != 0 or base > p.rows or size > p.rows - base) return error.BadExtent;
+        for (p.extents.items) |x| {
+            if (ignore != null and x.eid == ignore.?) continue;
+            if (x.base < base + size and base < x.end()) return error.Overlap;
+        }
+    }
+    fn sort(p: *Pool) void {
+        std.mem.sort(Extent, p.extents.items, {}, struct {
+            fn less(_: void, a: Extent, b: Extent) bool {
+                return a.base < b.base;
+            }
+        }.less);
+    }
+    pub fn add(p: *Pool, base: usize, requested: usize) !u64 {
+        const size = try sizeOf(requested);
+        try p.validate(base, size, null);
+        const eid = p.next_id;
+        try p.extents.append(p.gpa, .{ .base = base, .size = size, .eid = eid });
+        p.next_id += 1;
+        p.sort();
+        return eid;
+    }
+    pub fn alloc(p: *Pool, requested: usize) !?u64 {
+        return try p.add(try p.place(requested, null) orelse return null, requested);
+    }
+    pub fn resize(p: *Pool, eid: u64, requested: usize) !void {
+        const size = try sizeOf(requested);
+        const x = try p.get(eid);
+        try p.validate(x.base, size, eid);
+        x.size = size;
+    }
+    pub fn move(p: *Pool, eid: u64, base: usize, requested: ?usize) !usize {
+        const x = try p.get(eid);
+        const size = if (requested) |n| try sizeOf(n) else x.size;
+        try p.validate(base, size, eid);
+        const old = x.base;
+        x.base = base;
+        x.size = size;
+        p.sort();
+        return old;
+    }
+    pub fn remove(p: *Pool, eid: u64) !void {
+        for (p.extents.items, 0..) |x, i| {
+            if (x.eid == eid) {
+                _ = p.extents.orderedRemove(i);
+                return;
+            }
+        }
+        return error.NoExtent;
+    }
+};
+test "deterministic first fit, growth, relocation and removal" {
+    var p = try Pool.init(std.testing.allocator, 6 * alignment);
+    defer p.deinit();
+    const a = (try p.alloc(1)).?;
+    const b = (try p.alloc(2049)).?;
+    try std.testing.expectError(error.Overlap, p.resize(a, 4096));
+    try std.testing.expectEqual(@as(usize, 2048), try p.move(b, 8192, null));
+    try p.resize(a, 4096);
+    try std.testing.expectEqual(@as(?usize, 4096), try p.place(2048, null));
+    try p.remove(a);
+    try std.testing.expectEqual(@as(?usize, 0), try p.place(4096, null));
+    try std.testing.expectEqual(@as(usize, 8192), p.freeRows());
+    try std.testing.expectEqual(@as(?usize, null), try p.place(16384, null));
+}
diff --git a/zig/src/families/glm_cuda/cuda_pool_capacity.zig b/zig/src/families/glm_cuda/cuda_pool_capacity.zig
new file mode 100644
index 00000000..855bb2cb
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_pool_capacity.zig
@@ -0,0 +1,85 @@
+//! Ports glm5_next/cuda/engine.py pool_rows and tensorfold/cuda/capacity.py reserve policy.
+//! TensorFold by Ash Hart and contributors; MiaAI-Lab recipe MEMORY_RESERVE_GIB / KV_POOL_GIB.
+//! Uses live allocation room after Zig's fixed arenas and drafter are installed, rather than Python estimates.
+const std = @import("std");
+const cuda = @import("cuda");
+const display = @import("cuda_display_kv.zig");
+const pool = @import("cuda_pool.zig");
+pub fn gibBytes(raw: ?[]const u8, default: f64) !usize {
+    const g = if (raw) |r| std.fmt.parseFloat(f64, std.mem.trim(u8, r, " \t\r\n")) catch return error.InvalidPoolGiB else default;
+    const bytes = g * (1 << 30);
+    if (!std.math.isFinite(bytes) or bytes < 0 or bytes >= 0x1p64) return error.InvalidPoolGiB;
+    return @intFromFloat(bytes);
+}
+pub fn reserve(raw: ?[]const u8, total: usize, unified: bool) !usize {
+    const value = if (raw) |r| (if (std.mem.trim(u8, r, " \t\r\n").len == 0) null else raw) else null;
+    const n = try gibBytes(value, @as(f64, @floatFromInt(@max(if (unified) @as(usize, 4 << 30) else 1 << 30, total / (if (unified) @as(usize, 10) else 32)))) / (1 << 30));
+    if (n < (if (unified) @as(usize, 2 << 30) else 1 << 29) or n > total) return error.InvalidMemoryReserve;
+    return n;
+}
+pub const Counts = struct { total: usize, available: usize };
+pub fn meminfo(text: []const u8) !Counts {
+    var total: ?usize = null;
+    var available: ?usize = null;
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        var words = std.mem.tokenizeAny(u8, line, ": \t");
+        const key = words.next() orelse continue;
+        if (!std.mem.eql(u8, key, "MemTotal") and !std.mem.eql(u8, key, "MemAvailable")) continue;
+        const kib = try std.fmt.parseInt(usize, words.next() orelse return error.BadMeminfo, 10);
+        if (!std.mem.eql(u8, words.next() orelse return error.BadMeminfo, "kB") or words.next() != null) return error.BadMeminfo;
+        const bytes = try std.math.mul(usize, kib, 1024);
+        if (std.mem.eql(u8, key, "MemTotal")) {
+            if (total != null) return error.BadMeminfo;
+            total = bytes;
+        } else {
+            if (available != null) return error.BadMeminfo;
+            available = bytes;
+        }
+    }
+    const t = total orelse return error.BadMeminfo;
+    const a = available orelse return error.BadMeminfo;
+    if (t == 0 or a > t) return error.BadMeminfo;
+    return .{ .total = t, .available = a };
+}
+pub fn room(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context) !usize {
+    const unified = (try ctx.attribute(.integrated)) != 0;
+    const counts: Counts = if (unified) blk: {
+        var f = try std.Io.Dir.cwd().openFile(io, "/proc/meminfo", .{});
+        defer f.close(io);
+        var buf: [4096]u8 = undefined;
+        var r = f.readerStreaming(io, &buf);
+        const text = try r.interface.allocRemaining(gpa, .limited(1 << 20));
+        defer gpa.free(text);
+        break :blk try meminfo(text);
+    } else blk: {
+        const m = try ctx.memInfo();
+        break :blk .{ .total = m.total, .available = m.free };
+    };
+    const res = try reserve(display.env("TENSORFOLD_MEMORY_RESERVE_GIB") orelse display.env("MEMORY_RESERVE_GIB"), counts.total, unified);
+    if (counts.available < res) return error.PoolMemoryBudget;
+    var left = counts.available - res;
+    if (display.env("TENSORFOLD_CUDA_MEMORY_LIMIT_GB")) |limit| left = @min(left, (try gibBytes(limit, 0)) -| cuda.usage(false).device);
+    return left;
+}
+/// Whole extents, with display credited above the ordinary-memory cap. No kept-state charge until caching exists.
+pub fn rows(capacity: usize, spare: usize, display_bytes: usize, per_token: usize) !usize {
+    if (per_token == 0) return error.InvalidTokenBytes;
+    const extra = try std.math.add(usize, spare, display_bytes);
+    const n = try std.math.add(usize, capacity, extra / per_token);
+    const result = std.mem.alignBackward(usize, n, pool.alignment);
+    if (result < pool.alignment) return error.BadPool;
+    return result;
+}
+test "pool reserve, host counts, cap and display credit use integer extent arithmetic" {
+    const g = 1 << 30;
+    try std.testing.expectEqual(@as(usize, 145 * g / 10), try reserve("14.5", 120 * g, true));
+    try std.testing.expectEqual(@as(usize, 12 * g), try reserve(null, 120 * g, true));
+    try std.testing.expectError(error.InvalidMemoryReserve, reserve("1", 120 * g, true));
+    for ([_][]const u8{ "nan", "inf", "-1" }) |s| try std.testing.expectError(error.InvalidPoolGiB, gibBytes(s, 3));
+    try std.testing.expectEqual(Counts{ .total = 102400, .available = 51200 }, try meminfo("MemTotal: 100 kB\nMemAvailable: 50 kB\n"));
+    try std.testing.expectError(error.BadMeminfo, meminfo("MemTotal: 100 kB\nMemAvailable: 101 kB\n"));
+    try std.testing.expectEqual(@as(usize, 4096), try rows(4096, 0, 0, 6204));
+    try std.testing.expectEqual(@as(usize, 6144), try rows(4096, 6204 * 2048, 0, 6204));
+    try std.testing.expectEqual(@as(usize, 6144), try rows(4096, 0, 6204 * 2048, 6204));
+}
diff --git a/zig/src/families/glm_cuda/cuda_prefill.zig b/zig/src/families/glm_cuda/cuda_prefill.zig
new file mode 100644
index 00000000..7632b0ab
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prefill.zig
@@ -0,0 +1,871 @@
+//! Unsplit prompt chunk: glm5_next/cuda/forward.py layer_forward / kda_rows / dsa_rows, one stream.
+//! Prompt matmuls, KDA chunk, and the Triton prompt kernels. SPLIT exchanges are P8b.
+//! Ash Hart and TensorFold contributors; CUDA launch patterns by jschmied (PR #443).
+const std = @import("std");
+const cuda = @import("cuda");
+const fw = @import("cuda_forward.zig");
+const mm = @import("cuda_matmuls.zig");
+const ex = @import("cuda_experts.zig");
+const state = @import("cuda_state.zig");
+const kda = @import("cuda_kda.zig");
+const hc = @import("cuda_hc.zig");
+const mla = @import("cuda_mla.zig");
+const Tri = @import("cuda_triton.zig").Tri;
+const grid = @import("cuda_prefill_grid.zig");
+const split = @import("cuda_prefill_split.zig");
+const micro = @import("cuda_prompt_micro.zig");
+
+fn cdiv(a: usize, b: usize) usize {
+    return (a + b - 1) / b;
+}
+fn ci(n: usize) !i32 {
+    if (n > std.math.maxInt(i32)) return error.BadRows;
+    return @intCast(n);
+}
+fn cz(n: usize) i64 {
+    return @intCast(n);
+}
+
+pub const Scratch = struct {
+    arena: state.Arena,
+    kproj: u64,
+    ka: u64,
+    kg: u64,
+    k_out: u64,
+    sums: u64,
+    gu: u64,
+    act: u64,
+    sy: u64,
+    router_part: u64,
+    router_out: u64,
+    pick: u64,
+    wts: u64,
+    ey: u64,
+    dp: u64,
+    qr: u64,
+    lat: u64,
+    q: u64,
+    ikr: u64,
+    igr: u64,
+    qi: u64,
+    qa: u64,
+    ol: u64,
+    o: u64,
+    po: u64,
+    pm: u64,
+    pl: u64,
+    scores: u64,
+    pools_i: u64,
+    tokens: u64,
+    counts: u64,
+    split: u64,
+    origins: u64,
+    dummy: u64,
+    plan: ex.Plan,
+    experts: ex.Scratch,
+    /// the contiguous copy of a misaligned f_a/g_a block (TP=3), rows * 128 bf16
+    stage: u64,
+    rows: usize,
+    pools: usize,
+    nch: usize,
+    part_rows: usize,
+    select: usize,
+    split_bytes: usize,
+    /// TF_GLM_PROMPT_OWN_FRONT: every row's selected pools (int64 [rows, 512]), this rank's rows written, the peer's received.
+    own_pools: u64,
+    pub fn init(d: *const cuda.Driver, g: state.Geometry, rows: usize, cache_rows: usize) !Scratch {
+        if (rows == 0 or rows > 16384 or cache_rows < 2048 or cache_rows % 2048 != 0) return error.BadScratch;
+        const experts_n = state.Geometry.experts + 1;
+        const pairs = rows * state.Geometry.slots;
+        const items = ex.maxItems(pairs, experts_n, 16);
+        const part_rows = @min(rows, grid.att_rows);
+        const nch = cdiv(@min(cache_rows, 2560) + rows, grid.att_rows);
+        const pools = cache_rows / 4;
+        const select = @min(rows, grid.select_rows);
+        const width = g.projWidth();
+        const kh = rows * g.lin_heads * 128;
+        const ah = rows * g.heads * 512;
+        const split_rows = @min(rows, grid.split_rows - 1);
+        const split_bytes: usize = if (pools >= grid.split_from) mla.splitScratch(@max(split_rows, 1), pools) * 4 else 4;
+        const sizes = [_]usize{
+            rows * width * 2,                      kh * 2,
+            kh * 2,                                kh * 2,
+            rows * 256 * 4,                        rows * 2 * g.dense_width * 2,
+            rows * g.dense_width * 2,              rows * 4096 * 4,
+            8 * rows * state.Geometry.experts * 4, rows * state.Geometry.experts * 4,
+            pairs * 4,                        pairs * 4,
+            pairs * 4096 * 4,                 rows * 2048 * 2,
+            rows * 1536 * 2,                  rows * 512 * 2,
+            rows * g.heads * 256 * 2,         rows * 160 * 2,
+            rows * 128 * 4,                   rows * state.Geometry.index_heads * state.Geometry.index_dim * 2,
+            ah * 2,                           ah * 2,
+            rows * g.heads * 256 * 2,         nch * part_rows * g.heads * 512 * 4,
+            nch * part_rows * g.heads * 4,    nch * part_rows * g.heads * 4,
+            select * pools * 4,               select * grid.topk_pools * 8,
+            rows * grid.tokens * 4,           rows * 4,
+            split_bytes,                      40 * 16,
+            4,                                pairs * 4,
+            items * 3 * 4,                    experts_n * 4,
+            pairs * 4,                        cdiv(pairs, 1024) * experts_n * 4,
+            pairs * 4096 * 2,                 pairs * 4096 * 2,
+            pairs * g.moe_width * 2,          4,
+            4,                                (pairs / 16 + 1024) * 4,
+            rows * grid.topk_pools * 8,
+            rows * 128 * 2,
+        };
+        var a = try state.Arena.init(d, &sizes);
+        errdefer a.deinit();
+        var s: Scratch = undefined;
+        const ptrs = [_]*u64{
+            &s.kproj, &s.ka,      &s.kg,    &s.k_out, &s.sums, &s.gu,  &s.act,    &s.sy,      &s.router_part, &s.router_out,
