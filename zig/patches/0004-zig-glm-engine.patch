+                try f.tri.topk(.{ rows, 1, 1 }, f.s.router_out, w.bias, f.s.pick, f.s.wts, 2.5, .{ .NE = 288, .TOPK = 8, .SLOTS = 9, .BLOCK = 512, .SLOTP = 16, .NORM = 1 });
