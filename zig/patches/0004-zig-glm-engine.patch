+        try t.seg_pool_keys(.{ rows, 1, 1 }, f.caches.keys[li], f.caches.gates[li], w.ape, pk, pk, pos, base, ibase, ci(f.caches.ring), .{ .D = 128, .RS = 144, .FP8 = 1 });
+        if (!dense) {
