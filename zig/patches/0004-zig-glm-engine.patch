+    var b: [3]u32 = undefined;
+    const parts = [_]Part{ .{ .logits = 0, .positions = &.{ 1, 2 }, .sampling = null, .out = &a }, .{ .logits = 0, .positions = &.{ 1, 2, 3 }, .sampling = null, .out = &b } };
