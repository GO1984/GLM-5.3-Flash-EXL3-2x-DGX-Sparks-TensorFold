+        va.run = &runs[0];
+        va.micro = true;
+        var vb = e.rowView(h);
+        vb.run = &runs[1];
+        vb.micro = true;
+        vb.b.gathered += h * 4096 * 4;
+        vb.s.origins += 8 * 16;
+        vb.pos_dev = e.s.origins + 32 * 16;
