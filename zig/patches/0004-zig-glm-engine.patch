+test "greedy order: NaN first, +0 over -0, lowest column among ties" {
+    const nan: f32 = @bitCast(@as(u32, 0x7fc00001));
+    const neg_nan: f32 = @bitCast(@as(u32, 0xffc00000));
+    const inf = std.math.inf(f32);
+    try std.testing.expectEqual(@as(usize, 2), greedyColumn(&.{ 1, inf, nan, nan, 5 }));
+    try std.testing.expectEqual(@as(usize, 1), greedyColumn(&.{ -inf, neg_nan, nan }));
+    try std.testing.expectEqual(@as(usize, 1), greedyColumn(&.{ -0.0, 0.0, 0.0 }));
+    try std.testing.expectEqual(@as(usize, 0), greedyColumn(&.{ -0.0, -0.0, -1.0 }));
+    try std.testing.expectEqual(@as(usize, 0), greedyColumn(&.{ -inf, -inf, -inf }));
+    try std.testing.expectEqual(@as(usize, 3), greedyColumn(&.{ -3, -2, -2, -1.5, -1.5 }));
+    try std.testing.expectEqual(@as(usize, 2), greedyColumn(&.{ 1e-40, 0, 2e-40, 1e-40 }));
+    // monotone over all finite bf16 values, as the radix keys are
+    var prev: u32 = 0;
+    var bits: u32 = 0;
+    var first = true;
+    // negative values from -max up to -0, then +0 up to +max
+    var order: [2 * 0x7f80]u32 = undefined;
+    var n: usize = 0;
+    bits = 0xff7f;
+    while (bits >= 0x8000) : (bits -= 1) {
+        order[n] = bits << 16;
+        n += 1;
+    }
+    bits = 0;
+    while (bits < 0x7f80) : (bits += 1) {
+        order[n] = bits << 16;
+        n += 1;
+    }
+    for (order[0..n]) |o| {
+        const k = greedyKey(@bitCast(o));
+        if (!first) try std.testing.expect(k > prev);
+        prev = k;
+        first = false;
+    }
+}
+
+/// decode.py:_probability: lexsort, float64 softmax, top-p renormalization; min_p is deliberately absent.
+extern "c" fn exp(f64) f64;
+pub fn probability(gpa: std.mem.Allocator, values: []const f64, ids: []const u64, chosen: u32, sampling: ?S.Sampling) !f64 {
+    const C = struct {
+        value: f64,
+        id: u64,
+        fn less(_: void, a: @This(), b: @This()) bool {
+            return a.value > b.value or (a.value == b.value and a.id < b.id);
+        }
+    };
+    const order = try gpa.alloc(C, values.len);
+    defer gpa.free(order);
+    for (order, values, ids) |*o, v, id| o.* = .{ .value = v, .id = id };
+    std.mem.sort(C, order, {}, C.less);
+    const k = if (sampling != null and sampling.?.top_k != 0) @min(order.len, sampling.?.top_k) else order.len;
+    const temp = if (sampling != null and sampling.?.temperature > 0) sampling.?.temperature else 1;
+    const p = try gpa.alloc(f64, k);
+    defer gpa.free(p);
+    for (p, order[0..k]) |*v, o| v.* = exp(o.value / temp - order[0].value / temp);
+    const sum = S.pairwiseSum(p);
+    for (p) |*v| v.* /= sum;
+    var keep = k;
+    var renormalize = false;
+    if (sampling) |s| if (s.top_p > 0 and s.top_p < 1) {
+        renormalize = true;
+        var cum: f64 = 0;
+        keep = 0;
+        for (p) |v| {
+            cum += v;
+            keep += 1;
+            if (cum >= s.top_p) break;
+        }
+    };
+    const mass = if (renormalize) S.pairwiseSum(p[0..keep]) else 1;
+    for (order[0..keep], p[0..keep]) |o, v| if (o.id == chosen) return v / mass;
+    return 0;
+}
+test "MTP confidence normalizes greedy competitors and sampled top-p; ignores min-p like Python" {
+    const a = std.testing.allocator;
+    try std.testing.expectApproxEqAbs(@as(f64, 0.5), try probability(a, &.{ 0, 0 }, &.{ 2, 1 }, 1, null), 1e-15);
+    try std.testing.expectEqual(@as(f64, 1), try probability(a, &.{ 0, 0 }, &.{ 2, 1 }, 1, .{ .seed = 0, .top_k = 2, .top_p = 0.4, .min_p = 1 }));
+    try std.testing.expectEqual(@as(f64, 0), try probability(a, &.{ 0, 0 }, &.{ 2, 1 }, 2, .{ .seed = 0, .top_k = 2, .top_p = 0.4 }));
+}
+
+test "MTP confidence matches 36 small NumPy fixtures from Python decode._probability" {
+    const F = struct { values: []f64, ids: []u64, chosen: u32, temperature: f64, top_p: f64, top_k: u32, probability: f64 };
+    const parsed = try std.json.parseFromSlice([]F, std.testing.allocator, @embedFile("fixtures_mtp_probability.json"), .{});
+    defer parsed.deinit();
+    try std.testing.expectEqual(@as(usize, 36), parsed.value.len);
+    for (parsed.value) |f| {
+        const p = try probability(std.testing.allocator, f.values, f.ids, f.chosen, .{ .seed = 0, .temperature = f.temperature, .top_p = f.top_p, .top_k = f.top_k });
+        try std.testing.expectApproxEqAbs(f.probability, p, 1e-15);
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_segments.zig b/zig/src/families/glm_cuda/cuda_segments.zig
new file mode 100644
index 00000000..dcc229a0
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_segments.zig
@@ -0,0 +1,108 @@
+//! Contiguous int32 SegRows tables from glm5_next/cuda/segments.py: SegRows.fill/set.
+const std = @import("std");
+const cuda = @import("cuda");
+const Stager = @import("cuda_stage.zig").Stager;
+pub const Segment = struct { base: usize, pos: usize, rows: usize, ring_base: ?usize = null };
+pub fn segCount(streams: usize) !usize {
+    if (streams < 1 or streams > 8) return error.BadSegments;
+    return @max(4, streams);
+}
+pub const SegRows = struct {
+    gpa: std.mem.Allocator,
+    rows: usize,
+    max_segs: usize,
+    ring: ?usize,
+    host: []i32,
+    dev: ?cuda.DeviceBuffer = null,
+    used: usize = 0,
+    pub fn init(gpa: std.mem.Allocator, rows: usize, max_segs: usize, ring: ?usize) !SegRows {
+        if (rows == 0 or rows > std.math.maxInt(i32) or max_segs < 1 or max_segs > 8 or (ring != null and ring.? < 4)) return error.BadSegments;
+        const host = try gpa.alloc(i32, 5 * rows + 4 * max_segs);
+        @memset(host, 0);
+        return .{ .gpa = gpa, .rows = rows, .max_segs = max_segs, .ring = ring, .host = host };
+    }
+    pub fn deinit(t: *SegRows) void {
+        if (t.dev) |*d| d.free();
+        t.gpa.free(t.host);
+    }
+    pub fn initDevice(t: *SegRows, d: *const cuda.Driver) !void {
+        if (t.dev != null) return error.AlreadyAllocated;
+        t.dev = try cuda.DeviceBuffer.alloc(d, t.host.len * 4);
+        errdefer {
+            t.dev.?.free();
+            t.dev = null;
+        }
+        try t.dev.?.fill8(0, null);
+    }
+    /// Row planes 0..4, then segment planes 5..8. Strides retain capacity, independent of used rows.
+    pub fn plane(t: SegRows, i: usize) []i32 {
+        return if (i < 5) t.host[i * t.rows ..][0..t.rows] else t.host[5 * t.rows + (i - 5) * t.max_segs ..][0..t.max_segs];
+    }
+    pub fn ptr(t: SegRows, i: usize) !u64 {
+        const d = t.dev orelse return error.NoDeviceTables;
+        return d.ptr + 4 * (if (i < 5) i * t.rows else 5 * t.rows + (i - 5) * t.max_segs);
+    }
+    /// Validate all inputs before changing a table used by a captured graph.
+    pub fn fill(t: *SegRows, segments: []const Segment, sparse_from: ?usize) !usize {
+        if (segments.len < 1 or segments.len > t.max_segs) return error.BadSegments;
+        var total: usize = 0;
+        for (segments) |s| {
+            if (s.rows == 0 or s.base % 2048 != 0 or s.base > std.math.maxInt(i32) or s.pos > std.math.maxInt(i32) or s.rows > @as(usize, std.math.maxInt(i32)) - s.pos) return error.BadSegment;
+            if (s.rows > t.rows - total) return error.TooManyRows;
+            if (t.ring) |ring| {
+                if (s.ring_base == null or s.ring_base.? > std.math.maxInt(i32) or s.rows + 3 > ring) return error.BadRing;
+            }
+            total += s.rows;
+        }
+        @memset(t.host, 0);
+        var r: usize = 0;
+        for (segments, 0..) |s, si| {
+            for (0..s.rows) |i| {
+                const q = s.pos + i;
+                t.plane(0)[r + i] = @intCast(q);
+                t.plane(1)[r + i] = @intCast(s.base);
+                t.plane(2)[r + i] = @intCast(si);
+                t.plane(3)[r + i] = @intFromBool(sparse_from != null and q >= sparse_from.?);
+                t.plane(4)[r + i] = @intCast(if (t.ring != null) s.ring_base.? else s.base);
+            }
+            const last = s.pos + s.rows - 1;
+            t.plane(5)[si] = @intCast(r);
+            t.plane(6)[si] = @intCast(s.rows);
+            t.plane(7)[si] = @intCast(s.base / 4);
+            t.plane(8)[si] = @intCast(if (sparse_from != null and last >= sparse_from.?) (last + 1) / 4 else 0);
+            r += s.rows;
+        }
+        t.used = total;
+        return total;
+    }
+    /// Synchronous upload owns no pinned staging lifetime; P6 may add the reference's event-guarded async path.
+    pub fn stage(t: SegRows) !void {
+        const d = t.dev orelse return error.NoDeviceTables;
+        try d.upload(0, std.mem.sliceAsBytes(t.host));
+    }
+    /// stage() as a stream-ordered copy from pinned memory: nothing waits, nothing drains.
+    pub fn stageAsync(t: SegRows, st: *Stager) !void {
+        const d = t.dev orelse return error.NoDeviceTables;
+        try st.put(d.ptr, std.mem.sliceAsBytes(t.host));
+    }
+    pub fn anySparse(t: SegRows) bool {
+        for (t.plane(3)[0..t.used]) |x| {
+            if (x != 0) return true;
+        }
+        return false;
+    }
+};
+test "SegRows dense boundary, ring bases and unused segments match Python" {
+    var t = try SegRows.init(std.testing.allocator, 8, 4, 64);
+    defer t.deinit();
+    try std.testing.expectEqual(@as(usize, 5), try t.fill(&.{ .{ .base = 0, .pos = 2050, .rows = 3, .ring_base = 0 }, .{ .base = 4096, .pos = 7, .rows = 2, .ring_base = 64 } }, 2051));
+    try std.testing.expectEqualSlices(i32, &.{ 2050, 2051, 2052, 7, 8, 0, 0, 0 }, t.plane(0));
+    try std.testing.expectEqualSlices(i32, &.{ 0, 1, 1, 0, 0, 0, 0, 0 }, t.plane(3));
+    try std.testing.expectEqualSlices(i32, &.{ 513, 0, 0, 0 }, t.plane(8));
+    try std.testing.expectEqualSlices(i32, &.{ 0, 1024, 0, 0 }, t.plane(7));
+    try std.testing.expect(t.anySparse());
+    _ = try t.fill(&.{.{ .base = 2048, .pos = 1, .rows = 1, .ring_base = 64 }}, null);
+    try std.testing.expect(!t.anySparse());
+    try std.testing.expectEqual(@as(i32, 0), t.plane(6)[1]);
+    try std.testing.expectError(error.BadSegment, t.fill(&.{.{ .base = 1, .pos = 0, .rows = 1 }}, 2051));
+}
