index 00000000..a486083e
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_serving.zig
@@ -0,0 +1,75 @@
+//! glm5_next/cuda/multi.py rank orchestration, modeled on Flash Next cuda_native.zig.
+//! P6 owns E and its CUDA resources. This wrapper owns lane state and mirrored calls.
+const std = @import("std");
+const lanes = @import("lanes");
+const backend = @import("cuda_lanes.zig");
+const mirror = @import("cuda_mirror.zig");
+pub fn Serving(comptime E: type) type {
+    return struct {
+        const Self = @This();
+        gpa: std.mem.Allocator,
+        local: backend.Lanes(E),
+        leader: ?mirror.Leader = null,
+        follower: ?mirror.Follower = null,
+        /// The object must remain at a stable address after init: mirrored backends point to local.
+        pub fn init(self: *Self, gpa: std.mem.Allocator, engine: *E, context: usize, drafts: bool, streams: usize, window: usize, rank: usize, channel: ?mirror.Channel) !void {
+            if (streams < 1 or streams > backend.max_streams or window < 1 or window > backend.max_rows or rank > 3) return error.BadServingGeometry;
+            self.* = .{ .gpa = gpa, .local = backend.Lanes(E).init(gpa, engine, drafts, context, window) };
+            self.local.streams = streams;
+            self.local.follower = channel != null and rank != 0;
+            if (channel) |wire| {
+                if (rank == 0) {
+                    self.leader = mirror.Leader.init(gpa, self.local.backend(), wire);
+                    self.local.notes = self.leader.?.notes();
+                } else {
+                    self.follower = mirror.Follower.init(gpa, self.local.backend(), wire);
+                    self.follower.?.family = .{ .ptr = &self.local, .note = noteFn, .saved = savedFn };
+                }
+            } else if (rank != 0) return error.MissingMirrorChannel;
+        }
+        fn noteFn(ptr: *anyopaque, bytes: []const u8) !void {
+            const local: *backend.Lanes(E) = @ptrCast(@alignCast(ptr));
+            try local.applyNote(bytes);
+        }
+        fn savedFn(ptr: *anyopaque, key: u64) ?*anyopaque {
+            const local: *backend.Lanes(E) = @ptrCast(@alignCast(ptr));
+            return local.savedFor(key);
+        }
+        /// Install the same prepare/agree/commit gate on every TP rank before serving.
+        pub fn setAgreement(self: *Self, gate: backend.Gate, watch: ?*mirror.Watch) void {
+            self.local.gate = gate;
+            if (self.leader) |*lead| lead.watch = watch;
+            if (self.follower) |*peer| peer.watch = watch;
+        }
+        pub fn laneBackend(self: *Self) lanes.backend.Backend {
+            return if (self.leader) |*lead| lead.backend() else self.local.backend();
+        }
+        pub fn facts(self: *const Self) lanes.Model {
+            return self.local.facts();
+        }
+        pub fn follow(self: *Self) !void {
+            if (self.follower) |*peer| try peer.run() else return error.NotFollower;
+        }
+        pub fn deinit(self: *Self) void {
+            if (self.leader) |*lead| {
+                lead.stop();
+                lead.deinit();
+            }
+            if (self.follower) |*peer| peer.deinit();
+            self.local.deinit();
+        }
+    };
+}
+test "serving creates the GLM lane vtable and mirror-compatible notes" {
+    const gpa = std.testing.allocator;
+    const E = @import("flashnext").lane_backend.Toy;
+    var e: E = .{ .gpa = gpa };
+    var serving: Serving(E) = undefined;
+    try serving.init(gpa, &e, 4096, true, 2, 8, 0, null);
+    defer serving.deinit();
+    const be = serving.laneBackend();
+    try std.testing.expect(be.ptr == @as(*anyopaque, @ptrCast(&serving.local)));
+    try std.testing.expectEqual(@as(u32, 2), serving.facts().max_streams);
+    try std.testing.expectEqual(@as(u32, 16), serving.facts().batch_rows);
+    _ = Serving(E).follow;
+}
diff --git a/zig/src/families/glm_cuda/cuda_side.zig b/zig/src/families/glm_cuda/cuda_side.zig
new file mode 100644
index 00000000..05dac747
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_side.zig
@@ -0,0 +1,112 @@
+//! TF_GLM_SIDE=1 (recipe patch 0105, glm5_next/cuda/forward.py moe_block): a decode window's MoE shared expert runs on a
+//! second stream beside the router, the selection, the plan and the routed experts, and is joined before the combine
+//! reads its output. The same kernels with the same arguments on disjoint buffers (sgu / sact / sums / sy and the
+//! matmul's split-K scratch are touched by nothing between the fork and the join), so the bits are the single stream's.
+//! Decode and verify windows only (Python: `not prefill`); the prompt chunk never has a side stream. The events are
+//! recorded while the window is captured as a graph, so the fork and the join become graph edges (the second stream
+//! joins the capture through the fork event and leaves it through the join event).
+//! Off by default, as in Python; the recipe's scripts turn it on at TP=4 only (config.sh: TF_GLM_SIDE, "off at two and
+//! three until measured"). Ash Hart and TensorFold contributors wrote the Python engine; this port is by Mia's AI Lab.
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// TF_GLM_SIDE as Python reads it: unset or empty is 0, only 0 and 1 are valid.
+pub fn parse(value: ?[]const u8) !bool {
+    const raw = value orelse return false;
+    const v = std.mem.trim(u8, raw, " \t\r\n");
+    if (v.len == 0 or std.mem.eql(u8, v, "0")) return false;
+    if (std.mem.eql(u8, v, "1")) return true;
+    return error.BadSideSetting;
+}
+
+pub fn fromEnv() !bool {
+    const v = std.c.getenv("TF_GLM_SIDE") orelse return false;
+    return parse(std.mem.span(v));
+}
+
+/// The second stream and the two events, generic over the stream and event types so a fake can log the order.
+/// `E.record(stream)` and `S.wait(event)` are the real types' methods (cuda.Stream / cuda.Event).
+pub fn Pair(comptime S: type, comptime E: type) type {
+    return struct {
+        stream: S,
+        forked: E,
+        joined: E,
+
+        const Self = @This();
+
+        /// Everything queued on `main` so far (the normed rows) is done before the side stream starts.
+        pub fn fork(p: *const Self, main: S) !void {
+            try p.forked.record(main);
+            try p.stream.wait(p.forked);
+        }
+        /// `main` waits for everything queued on the side stream (the shared expert's output) before going on.
+        pub fn join(p: *const Self, main: S) !void {
+            try p.joined.record(p.stream);
+            try main.wait(p.joined);
+        }
+    };
+}
+
+pub const Side = struct {
+    pair: Pair(cuda.Stream, cuda.Event),
+
+    pub fn init(d: *const cuda.Driver) !Side {
+        var s = try cuda.Stream.init(d, true);
+        errdefer s.deinit();
+        var a = try cuda.Event.init(d, false);
+        errdefer a.deinit();
+        const b = try cuda.Event.init(d, false);
+        return .{ .pair = .{ .stream = s, .forked = a, .joined = b } };
+    }
+    pub fn deinit(s: *Side) void {
+        s.pair.joined.deinit();
+        s.pair.forked.deinit();
+        s.pair.stream.deinit();
+    }
+};
+
+test "TF_GLM_SIDE is 0 or 1, unset is off" {
+    try std.testing.expect(!try parse(null));
+    try std.testing.expect(!try parse(""));
+    try std.testing.expect(!try parse(" 0 "));
+    try std.testing.expect(try parse("1"));
+    try std.testing.expectError(error.BadSideSetting, parse("2"));
+    try std.testing.expectError(error.BadSideSetting, parse("true"));
+}
+
+const Log = struct {
+    items: [16][]const u8 = undefined,
+    n: usize = 0,
+    fn add(l: *Log, s: []const u8) void {
+        l.items[l.n] = std.testing.allocator.dupe(u8, s) catch unreachable;
+        l.n += 1;
+    }
+};
+const FakeStream = struct {
+    name: []const u8,
+    log: *Log,
+    fn wait(s: FakeStream, e: FakeEvent) !void {
+        var b: [64]u8 = undefined;
+        s.log.add(std.fmt.bufPrint(&b, "{s} waits {s}", .{ s.name, e.name }) catch unreachable);
+    }
+};
+const FakeEvent = struct {
+    name: []const u8,
+    fn record(e: FakeEvent, s: FakeStream) !void {
+        var b: [64]u8 = undefined;
+        s.log.add(std.fmt.bufPrint(&b, "{s} records {s}", .{ s.name, e.name }) catch unreachable);
+    }
+};
+
+test "fork then join order: the side stream starts after main's work and main resumes after the side's" {
+    var log: Log = .{};
+    defer for (log.items[0..log.n]) |s| std.testing.allocator.free(s);
+    const main: FakeStream = .{ .name = "main", .log = &log };
+    const p: Pair(FakeStream, FakeEvent) = .{ .stream = .{ .name = "side", .log = &log }, .forked = .{ .name = "fork" }, .joined = .{ .name = "join" } };
+    try p.fork(main);
+    log.add("(side kernels)");
+    try p.join(main);
+    const want = [_][]const u8{ "main records fork", "side waits fork", "(side kernels)", "side records join", "main waits join" };
+    try std.testing.expectEqual(want.len, log.n);
+    for (want, log.items[0..log.n]) |w, g| try std.testing.expectEqualStrings(w, g);
+}
diff --git a/zig/src/families/glm_cuda/cuda_snapshot.zig b/zig/src/families/glm_cuda/cuda_snapshot.zig
new file mode 100644
index 00000000..08f32ad2
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_snapshot.zig
@@ -0,0 +1,297 @@
+//! A kept prompt state of the GLM CUDA engine (the recipe's decode.Snapshot / take_snapshot / save_rows / restore):
+//! one device buffer that holds a sequence's state after `at` prompt tokens, so a later request of any slot resumes
+//! it and prefills the rest with the bits a cold prefill gives.
+//!
+//! What the state is (glm5_next/cuda/decode.py `_row_views`, `_ring_tail`, `restore`; multi.py `draft_window`):
+//!   latent   the 11 MLA layers' fp8 latent rows [0, at)                      (G.latent_row bytes a row)
+//!   pooled   their indexer pools [0, at/4 + 1)                               (G.pool_row bytes a row)
+//!   rings    their indexer key and gate rings, whole (the recipe keeps only the n % 4 tail; the whole ring is a
+//!            superset a few MiB big, and the grid keeps `at` a multiple of 64, so the tail is empty anyway)
+//!   rec      the 34 KDA layers' recurrent states, the parity each layer's chunk wrote last
+//!   conv     the 34 layers' conv windows
+//!   draft    DFlash2's per-slot K and V rings (5 layers), whole, when a drafter runs
+//! Nothing else carries over a chunk boundary: the HC streams, the router, the selections are chunk-local, and
+//! `pos_dev` is written by every chunk. Pure arithmetic and copies: tests run on host memory standing in for the
+//! device (`Copier`).
+const std = @import("std");
+const state = @import("cuda_state.zig");
+const G = state.Geometry;
+
+/// How a snapshot copies bytes between device addresses (one stream, in order).
+pub const Copier = struct {
+    ptr: *anyopaque,
+    copy: *const fn (ptr: *anyopaque, dst: u64, src: u64, bytes: usize) anyerror!void,
+
+    fn go(c: Copier, dst: u64, src: u64, bytes: usize) !void {
+        if (bytes == 0) return;
+        try c.copy(c.ptr, dst, src, bytes);
+    }
+};
+
+/// DFlash2's K and V rings of one stream slot: `layers` each, `kv` heads, `ring` rows of 128 bf16 per head, in a
+/// cache of `cap` rows per head (the slot's rows start at slot * ring).
+pub const Draft = struct {
+    kc: [5]u64,
+    vc: [5]u64,
+    kv: usize,
+    ring: usize,
+    cap: usize,
+    slot: usize,
+
+    pub fn bytes(d: Draft) usize {
+        return 10 * d.kv * d.ring * 128 * 2;
+    }
+};
+
+pub const Sections = struct {
+    at: usize,
+    ring: usize,
+    latent: usize,
+    pooled: usize,
+    rings: usize,
+    rec: usize,
+    conv: usize,
+    draft: usize,
+    total: usize,
+
+    pub fn latentBytes(s: Sections) usize {
+        return s.at * G.latent_row;
+    }
+    pub fn pooledBytes(s: Sections) usize {
+        return (s.at / 4 + 1) * G.pool_row;
+    }
+    pub fn ringBytes(s: Sections) usize {
+        return s.ring * 128 * 2;
+    }
+};
+
+pub fn recLayerBytes(g: G) usize {
+    return g.lin_heads * 128 * 128 * 4;
+}
+
+pub fn convLayerBytes(g: G) usize {
+    return 3 * g.convDim() * 2;
+}
+
+/// The buffer's sections for a state of `at` tokens; `draft_bytes` 0 without a drafter. Every section 256-aligned.
+pub fn sections(g: G, at: usize, ring: usize, draft_bytes: usize) Sections {
+    var s: Sections = .{ .at = at, .ring = ring, .latent = 0, .pooled = 0, .rings = 0, .rec = 0, .conv = 0, .draft = 0, .total = 0 };
+    var off: usize = 0;
+    s.latent = off;
+    off += std.mem.alignForward(usize, G.dsa_layers * s.latentBytes(), 256);
+    s.pooled = off;
+    off += std.mem.alignForward(usize, G.dsa_layers * s.pooledBytes(), 256);
+    s.rings = off;
+    off += std.mem.alignForward(usize, G.dsa_layers * 2 * s.ringBytes(), 256);
+    s.rec = off;
+    off += std.mem.alignForward(usize, G.kda_layers * recLayerBytes(g), 256);
+    s.conv = off;
+    off += std.mem.alignForward(usize, G.kda_layers * convLayerBytes(g), 256);
+    s.draft = off;
+    off += std.mem.alignForward(usize, draft_bytes, 256);
+    s.total = off;
+    return s;
+}
+
+/// Copy a sequence's state out of its live caches into `buf` (a device buffer of `s.total` bytes).
+pub fn save(c: Copier, g: G, s: Sections, buf: u64, st: *const state.State, draft: ?Draft) !void {
+    for (0..G.dsa_layers) |i| {
+        try c.go(buf + s.latent + i * s.latentBytes(), st.cache.latent[i], s.latentBytes());
+        try c.go(buf + s.pooled + i * s.pooledBytes(), st.cache.pooled[i], s.pooledBytes());
+        try c.go(buf + s.rings + (2 * i) * s.ringBytes(), st.cache.keys[i], s.ringBytes());
+        try c.go(buf + s.rings + (2 * i + 1) * s.ringBytes(), st.cache.gates[i], s.ringBytes());
+    }
+    for (0..G.kda_layers) |l| {
+        try c.go(buf + s.rec + l * recLayerBytes(g), st.recurrent(g, l, st.cur[l]), recLayerBytes(g));
+        try c.go(buf + s.conv + l * convLayerBytes(g), st.fixed.conv + l * convLayerBytes(g), convLayerBytes(g));
+    }
+    if (draft) |d| try draftCopy(c, d, buf + s.draft, true);
+}
+
+/// Put a saved state into a sequence's caches. The recurrent states go to the parity each layer holds now.
+pub fn restore(c: Copier, g: G, s: Sections, buf: u64, st: *const state.State, draft: ?Draft) !void {
+    for (0..G.dsa_layers) |i| {
+        try c.go(st.cache.latent[i], buf + s.latent + i * s.latentBytes(), s.latentBytes());
+        try c.go(st.cache.pooled[i], buf + s.pooled + i * s.pooledBytes(), s.pooledBytes());
+        try c.go(st.cache.keys[i], buf + s.rings + (2 * i) * s.ringBytes(), s.ringBytes());
+        try c.go(st.cache.gates[i], buf + s.rings + (2 * i + 1) * s.ringBytes(), s.ringBytes());
+    }
+    for (0..G.kda_layers) |l| {
+        try c.go(st.recurrent(g, l, st.cur[l]), buf + s.rec + l * recLayerBytes(g), recLayerBytes(g));
+        try c.go(st.fixed.conv + l * convLayerBytes(g), buf + s.conv + l * convLayerBytes(g), convLayerBytes(g));
+    }
+    if (draft) |d| try draftCopy(c, d, buf + s.draft, false);
+}
+
+/// K then V of each drafter layer, head by head: the slot's ring rows of the cache <-> the buffer.
+fn draftCopy(c: Copier, d: Draft, buf: u64, out: bool) !void {
+    const row = 128 * 2;
+    var at: u64 = buf;
+    for (0..5) |i| for ([_]u64{ d.kc[i], d.vc[i] }) |base| for (0..d.kv) |h| {
+        const live = base + ((h * d.cap + d.slot * d.ring) * row);
+        if (out) try c.go(at, live, d.ring * row) else try c.go(live, at, d.ring * row);
+        at += d.ring * row;
+    };
+}
+
+// -- tests: host memory stands in for the device ---------------------------------------------------------------------
+
+const HostCopy = struct {
+    fn copy(_: *anyopaque, dst: u64, src: u64, n: usize) anyerror!void {
+        const d: [*]u8 = @ptrFromInt(dst);
+        const s: [*]const u8 = @ptrFromInt(src);
+        @memcpy(d[0..n], s[0..n]);
+    }
+    fn copier() Copier {
+        return .{ .ptr = undefined, .copy = copy };
+    }
+};
+
+const Fake = struct {
+    gpa: std.mem.Allocator,
+    g: G,
+    rec: []u8,
+    conv: []u8,
+    latent: [11][]u8,
+    pooled: [11][]u8,
+    keys: [11][]u8,
+    gates: [11][]u8,
+    kc: [5][]u8,
+    vc: [5][]u8,
+    rows: usize,
+    ring: usize,
+    kv: usize,
+    cap: usize,
+    st: state.State,
+
+    fn init(gpa: std.mem.Allocator, rows: usize, ring: usize, slot: usize) !Fake {
+        const g = try G.init(2, 0);
+        var f: Fake = undefined;
+        f.gpa = gpa;
+        f.g = g;
+        f.rows = rows;
+        f.ring = ring;
+        f.kv = 2;
+        f.cap = 2 * 16 + 64;
+        f.rec = try gpa.alloc(u8, 2 * 34 * recLayerBytes(g));
+        f.conv = try gpa.alloc(u8, 34 * convLayerBytes(g));
+        for (0..11) |i| {
+            f.latent[i] = try gpa.alloc(u8, rows * G.latent_row);
+            f.pooled[i] = try gpa.alloc(u8, (rows / 4 + 2) * G.pool_row);
+            f.keys[i] = try gpa.alloc(u8, ring * 256);
+            f.gates[i] = try gpa.alloc(u8, ring * 256);
+        }
+        for (0..5) |i| {
+            f.kc[i] = try gpa.alloc(u8, f.kv * f.cap * 256);
+            f.vc[i] = try gpa.alloc(u8, f.kv * f.cap * 256);
+        }
+        var cache: state.CacheView = .{ .latent = undefined, .pooled = undefined, .keys = undefined, .gates = undefined, .ring_base = 0, .capacity = rows };
+        for (0..11) |i| {
+            cache.latent[i] = @intFromPtr(f.latent[i].ptr);
+            cache.pooled[i] = @intFromPtr(f.pooled[i].ptr);
+            cache.keys[i] = @intFromPtr(f.keys[i].ptr);
+            cache.gates[i] = @intFromPtr(f.gates[i].ptr);
+        }
+        f.st = .{ .slot = slot, .base = 0, .capacity = rows, .fixed = undefined, .cache = cache };
+        f.st.fixed.rec = @intFromPtr(f.rec.ptr);
+        f.st.fixed.conv = @intFromPtr(f.conv.ptr);
+        return f;
+    }
+    fn deinit(f: *Fake) void {
+        f.gpa.free(f.rec);
+        f.gpa.free(f.conv);
+        for (0..11) |i| {
+            f.gpa.free(f.latent[i]);
+            f.gpa.free(f.pooled[i]);
+            f.gpa.free(f.keys[i]);
+            f.gpa.free(f.gates[i]);
+        }
+        for (0..5) |i| {
+            f.gpa.free(f.kc[i]);
+            f.gpa.free(f.vc[i]);
+        }
+    }
+    fn draft(f: *const Fake, slot: usize) Draft {
+        var d: Draft = .{ .kc = undefined, .vc = undefined, .kv = f.kv, .ring = 16, .cap = f.cap, .slot = slot };
+        for (0..5) |i| {
+            d.kc[i] = @intFromPtr(f.kc[i].ptr);
+            d.vc[i] = @intFromPtr(f.vc[i].ptr);
+        }
+        return d;
+    }
+    fn fill(f: *Fake, seed: u8) void {
+        var prng = std.Random.DefaultPrng.init(seed);
+        const r = prng.random();
+        r.bytes(f.rec);
+        r.bytes(f.conv);
+        for (0..11) |i| {
+            r.bytes(f.latent[i]);
+            r.bytes(f.pooled[i]);
+            r.bytes(f.keys[i]);
+            r.bytes(f.gates[i]);
+        }
+        for (0..5) |i| {
+            r.bytes(f.kc[i]);
+            r.bytes(f.vc[i]);
+        }
+    }
+};
+
+test "a saved state restores the rows, rings, recurrent parity and drafter ring of its prefix, nothing past it" {
+    const gpa = std.testing.allocator;
+    var a = try Fake.init(gpa, 256, 64, 1);
+    defer a.deinit();
+    var b = try Fake.init(gpa, 256, 64, 0);
+    defer b.deinit();
+    a.fill(1);
+    b.fill(2);
+    // a holds odd parities on some layers; b's parities differ: the restore goes to b's own
+    a.st.cur[3] = 1;
+    a.st.cur[33] = 1;
+    b.st.cur[3] = 0;
+    b.st.cur[5] = 1;
+    const at = 192;
+    const s = sections(a.g, at, 64, a.draft(1).bytes());
+    const buf = try gpa.alloc(u8, s.total);
+    defer gpa.free(buf);
+    const c = HostCopy.copier();
+    try save(c, a.g, s, @intFromPtr(buf.ptr), &a.st, a.draft(1));
+    const before = try gpa.dupe(u8, b.latent[4]);
+    defer gpa.free(before);
+    try restore(c, a.g, s, @intFromPtr(buf.ptr), &b.st, b.draft(0));
+    for (0..11) |i| {
+        try std.testing.expectEqualSlices(u8, a.latent[i][0 .. at * G.latent_row], b.latent[i][0 .. at * G.latent_row]);
+        try std.testing.expectEqualSlices(u8, a.pooled[i][0 .. (at / 4 + 1) * G.pool_row], b.pooled[i][0 .. (at / 4 + 1) * G.pool_row]);
+        try std.testing.expectEqualSlices(u8, a.keys[i][0 .. 64 * 256], b.keys[i][0 .. 64 * 256]);
+        try std.testing.expectEqualSlices(u8, a.gates[i][0 .. 64 * 256], b.gates[i][0 .. 64 * 256]);
+    }
+    // rows past the prefix are b's own
+    try std.testing.expect(!std.mem.eql(u8, a.latent[4][at * G.latent_row ..], b.latent[4][at * G.latent_row ..]));
+    try std.testing.expectEqualSlices(u8, before[at * G.latent_row ..], b.latent[4][at * G.latent_row ..]);
+    const rl = recLayerBytes(a.g);
+    for (0..34) |l| {
+        const from = a.st.recurrent(a.g, l, a.st.cur[l]);
+        const into = b.st.recurrent(b.g, l, b.st.cur[l]);
+        const x: [*]const u8 = @ptrFromInt(from);
+        const y: [*]const u8 = @ptrFromInt(into);
+        try std.testing.expectEqualSlices(u8, x[0..rl], y[0..rl]);
+    }
+    try std.testing.expectEqualSlices(u8, a.conv, b.conv);
+    // the drafter ring of slot 0 now holds slot 1's, head by head
+    for (0..5) |i| for (0..a.kv) |h| {
+        try std.testing.expectEqualSlices(u8, a.kc[i][(h * a.cap + 16) * 256 ..][0 .. 16 * 256], b.kc[i][(h * b.cap) * 256 ..][0 .. 16 * 256]);
+        try std.testing.expectEqualSlices(u8, a.vc[i][(h * a.cap + 16) * 256 ..][0 .. 16 * 256], b.vc[i][(h * b.cap) * 256 ..][0 .. 16 * 256]);
+    };
+}
+
+test "section sizes follow the geometry and stay 256-aligned" {
+    const g = try G.init(2, 0);
+    const s = sections(g, 4096, 2112, 22 << 20);
+    try std.testing.expectEqual(@as(usize, 0), s.total % 256);
+    try std.testing.expectEqual(@as(usize, 11 * 4096 * 528), s.pooled - s.latent);
+    try std.testing.expect(s.total > 34 * recLayerBytes(g));
+    // a prompt twice as long holds twice the rows and the same fixed state
+    const t = sections(g, 8192, 2112, 22 << 20);
+    try std.testing.expectEqual(t.pooled - t.latent, 2 * (s.pooled - s.latent));
+    try std.testing.expect(t.total > s.total);
+}
diff --git a/zig/src/families/glm_cuda/cuda_spill.zig b/zig/src/families/glm_cuda/cuda_spill.zig
new file mode 100644
index 00000000..f58f781f
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_spill.zig
@@ -0,0 +1,855 @@
+//! The spill tier's disk side for the GLM CUDA engine: kept prompt states written to local disk when they leave memory and
+//! read back when a later request extends the same tokens, also after a restart. Host only (no CUDA): the engine copies
+//! a state's device buffer through `Writer.put` / `Reader.read` in pieces.
+//!
+//! Behaviour follows the recipe's spill tier (patch 0088-glm-spill-tier, by Robert Wojciechowski, https://github.com/wojo,
+//! with the multi-rank design of Jay Leaton's patch 0250 of jayleaton/glm53-tensorfold-spark): SPILL_GIB caps the bytes
+//! a rank keeps (the oldest files go first), no write leaves less than SPILL_MIN_FREE_GIB of the disk free (the spill
+//! floor: old files are dropped to make that room, else the write is skipped), prompts under SPILL_MIN_TOKENS are not
+//! written, a file is written to `.partial`, fsynced and renamed, every read checks a CRC-32 for each 8 MiB, and a file
+//! whose size does not match its header is dropped at start. One directory per compatibility hash and per rank; other
+//! hashes (our `tfspill-` directories only) are pruned at open. The file format is this engine's own.
+const std = @import("std");
+const lanes = @import("lanes");
+
+pub const block: usize = 8 << 20;
+const head_len = 48;
+const page = 4096;
+const foot_len = 16;
+const magic = "TFSPILL1";
+const foot_magic = "TFSPEND1";
+
+pub const Config = struct {
+    /// the spill folder (SPILL_DIR; the same absolute path on every rank's machine)
+    root: []const u8,
+    /// compatibility hash of everything a stored state depends on (weights, drafter, kernels, geometry, settings)
+    build: u64,
+    rank: u32 = 0,
+    /// bytes this rank's files may take (SPILL_GIB)
+    cap: u64,
+    /// SPILL_MIN_TOKENS: shorter states are not written
+    min_tokens: u32 = 8192,
+    /// SPILL_MIN_FREE_GIB in bytes: no write leaves less of the disk free
+    min_free: u64 = 50 << 30,
+    /// the free bytes of the disk holding a folder (tests give their own)
+    free: *const fn ([:0]const u8) ?u64 = lanes.learned_disk.available,
+};
+
+pub const Stats = struct {
+    entries: u32 = 0,
+    bytes: u64 = 0,
+    writes: u64 = 0,
+    write_bytes: u64 = 0,
+    reads: u64 = 0,
+    read_bytes: u64 = 0,
+    skipped_short: u64 = 0,
+    skipped_exists: u64 = 0,
+    skipped_floor: u64 = 0,
+    skipped_cap: u64 = 0,
+    pruned: u64 = 0,
+    failed: u64 = 0,
+    crc_failures: u64 = 0,
+};
+
+pub const Meta = struct { key: u64, at: u32, tokens: []u32, payload: u64, size: u64, used: u64 };
+
+pub const Error = error{ SpillWrite, SpillRead, SpillCrc, SpillNoRoom, SpillShort, SpillExists, SpillDir };
+
+pub fn keyOf(tokens: []const u32) u64 {
+    return std.hash.Wyhash.hash(0x5911, std.mem.sliceAsBytes(tokens));
+}
+
+fn blocksOf(payload: u64) u32 {
+    return @intCast((payload + block - 1) / block);
+}
+
+fn payloadOffset(ntokens: usize) u64 {
+    return std.mem.alignForward(u64, head_len + 4 * @as(u64, ntokens), page);
+}
+
+fn fileSize(ntokens: usize, payload: u64) u64 {
+    return payloadOffset(ntokens) + payload + 4 * @as(u64, blocksOf(payload)) + foot_len;
+}
+
+pub const Tier = struct {
+    gpa: std.mem.Allocator,
+    cfg: Config,
+    dir: [:0]u8,
+    metas: std.ArrayList(Meta) = .empty,
+    clock: u64 = 0,
+    stats: Stats = .{},
+    /// The index, the counters and the folder's files are shared by the lane thread (lookups, drops) and the writer
+    /// thread (stores): every public call takes this; file bytes move outside it.
+    mu: std.atomic.Mutex = .unlocked,
+    /// keys being written now
+    inflight: std.ArrayList(u64) = .empty,
+
+    fn lock(t: *Tier) void {
+        while (!t.mu.tryLock()) std.Thread.yield() catch {};
+    }
+
+    fn unlock(t: *Tier) void {
+        t.mu.unlock();
+    }
+
+    /// The tier's folder for this build and rank (made when missing), its stored states indexed, damaged or foreign files
+    /// and other builds' `tfspill-` folders removed.
+    pub fn open(gpa: std.mem.Allocator, cfg: Config) !Tier {
+        const dir = try std.fmt.allocPrintSentinel(gpa, "{s}/tfspill-{x:0>16}/rank{d}", .{ cfg.root, cfg.build, cfg.rank }, 0);
+        errdefer gpa.free(dir);
+        try makePath(dir);
+        var t: Tier = .{ .gpa = gpa, .cfg = cfg, .dir = dir };
+        errdefer t.deinit();
+        t.pruneBuilds();
+        t.scan();
+        return t;
+    }
+
+    pub fn deinit(t: *Tier) void {
+        for (t.metas.items) |m| t.gpa.free(m.tokens);
+        t.metas.deinit(t.gpa);
+        t.inflight.deinit(t.gpa);
+        t.gpa.free(t.dir);
+    }
+
+    fn path(t: *const Tier, buf: []u8, key: u64, partial: bool) ![:0]const u8 {
+        return std.fmt.bufPrintSentinel(buf, "{s}/{x:0>16}.{s}", .{ t.dir, key, if (partial) "partial" else "state" }, 0);
+    }
+
+    fn find(t: *const Tier, key: u64) ?usize {
+        for (t.metas.items, 0..) |m, i| if (m.key == key) return i;
+        return null;
+    }
+
+    fn hasLocked(t: *const Tier, key: u64) bool {
+        return t.find(key) != null or std.mem.indexOfScalar(u64, t.inflight.items, key) != null;
+    }
+
+    pub fn has(t: *Tier, key: u64) bool {
+        t.lock();
+        defer t.unlock();
+        return t.hasLocked(key);
+    }
+
+    pub fn total(t: *const Tier) u64 {
+        var n: u64 = 0;
+        for (t.metas.items) |m| n += m.size;
+        return n;
+    }
+
+    pub fn snapshot(t: *Tier) Stats {
+        t.lock();
+        defer t.unlock();
+        var s = t.stats;
+        s.entries = @intCast(t.metas.items.len);
+        s.bytes = t.total();
+        return s;
+    }
+
+    /// The longest stored state whose tokens are a prefix of `prompt` and that leaves a row (strictly shorter), longer than
+    /// `longer_than`; with `grid` set only a state on the grid.
+    pub fn best(t: *Tier, prompt: []const u32, longer_than: u32, grid: u32) ?*const Meta {
+        t.lock();
+        defer t.unlock();
+        return t.bestLocked(prompt, longer_than, grid);
+    }
+
+    /// `best`, its tokens copied into `buf` (the index may drop them as soon as the lock is gone): (position, key).
+    pub fn bestInto(t: *Tier, prompt: []const u32, longer_than: u32, grid: u32, buf: *std.ArrayList(u32), min_payload_ok: *const fn (ctx: *anyopaque, at: u32, payload: u64) bool, ctx: *anyopaque) ?struct { at: u32, key: u64 } {
+        t.lock();
+        defer t.unlock();
+        var from = longer_than;
+        while (t.bestLocked(prompt, from, grid)) |m| {
+            if (min_payload_ok(ctx, m.at, m.payload)) {
+                buf.clearRetainingCapacity();
+                buf.appendSlice(t.gpa, m.tokens) catch return null;
+                return .{ .at = m.at, .key = m.key };
+            }
+            from = m.at;
+        }
+        return null;
+    }
+
+    fn bestLocked(t: *const Tier, prompt: []const u32, longer_than: u32, grid: u32) ?*const Meta {
+        var out: ?*const Meta = null;
+        for (t.metas.items) |*m| {
+            if (m.at <= longer_than or m.tokens.len > prompt.len or m.at >= prompt.len) continue;
+            if (grid > 0 and m.at % grid != 0) continue;
+            if (out != null and m.at <= out.?.at) continue;
+            if (!std.mem.eql(u32, prompt[0..m.tokens.len], m.tokens)) continue;
+            out = m;
+        }
+        return out;
+    }
+
+    pub fn touch(t: *Tier, key: u64) void {
+        t.lock();
+        defer t.unlock();
+        t.touchLocked(key);
+    }
+
+    fn touchLocked(t: *Tier, key: u64) void {
+        const i = t.find(key) orelse return;
+        t.clock += 1;
+        t.metas.items[i].used = t.clock;
+    }
+
+    /// Whether a state of `tokens` and `payload` bytes would be written now (not short, not stored): the tier's gate before
+    /// the engine copies anything off the device.
+    pub fn wants(t: *Tier, tokens: []const u32, payload: u64) bool {
+        t.lock();
+        defer t.unlock();
+        return t.wantsLocked(tokens, payload);
+    }
+
+    fn wantsLocked(t: *Tier, tokens: []const u32, payload: u64) bool {
+        if (tokens.len < t.cfg.min_tokens) {
+            t.stats.skipped_short += 1;
+            return false;
+        }
+        if (t.hasLocked(keyOf(tokens))) {
+            t.stats.skipped_exists += 1;
+            return false;
+        }
+        if (fileSize(tokens.len, payload) > t.cfg.cap) {
+            t.stats.skipped_cap += 1;
+            return false;
+        }
+        return true;
+    }
+
+    /// The oldest stored state's key (the next the cap or the floor drops).
+    fn oldest(t: *const Tier) ?u64 {
+        var out: ?*const Meta = null;
+        for (t.metas.items) |*m| if (out == null or m.used < out.?.used) {
+            out = m;
+        };
+        return if (out) |m| m.key else null;
+    }
+
+    /// Room for a file of `size` bytes: the oldest files go until the cap holds and the disk keeps its floor. When dropping
+    /// every file would not leave the floor either, nothing goes and the write is skipped (false).
+    fn room(t: *Tier, size: u64) bool {
+        while (t.total() + size > t.cfg.cap) {
+            const k = t.oldest() orelse return false;
+            t.forgetLocked(k);
+            t.stats.pruned += 1;
+        }
+        const free = t.cfg.free(t.dir) orelse return false;
+        const need = t.cfg.min_free +| size;
+        if (free +| t.total() < need) return false;
+        var freed: u64 = 0;
+        while (free +| freed < need) {
+            const k = t.oldest() orelse return false;
+            freed += t.metas.items[t.find(k).?].size;
+            t.forgetLocked(k);
+            t.stats.pruned += 1;
+        }
+        return true;
+    }
+
+    pub const Writer = struct {
+        tier: *Tier,
+        fd: c_int,
+        key: u64,
+        tokens: []u32,
+        at: u32,
+        payload: u64,
+        written: u64 = 0,
+        crc: std.hash.Crc32 = .init(),
+        in_block: usize = 0,
+        crcs: std.ArrayList(u32) = .empty,
+        partial: [1100]u8 = undefined,
+        partial_len: usize = 0,
+
+        /// The next bytes of the payload, in order; the CRC of each 8 MiB is kept.
+        pub fn put(w: *Writer, bytes: []const u8) Error!void {
+            if (w.written + bytes.len > w.payload) return error.SpillWrite;
+            var rest = bytes;
+            while (rest.len > 0) {
+                const n = @min(rest.len, block - w.in_block);
+                w.crc.update(rest[0..n]);
+                try putAll(w.fd, rest[0..n]);
+                w.in_block += n;
+                w.written += n;
+                rest = rest[n..];
+                if (w.in_block == block) try w.closeBlock();
+            }
+        }
+
+        fn closeBlock(w: *Writer) Error!void {
+            w.crcs.append(w.tier.gpa, w.crc.final()) catch return error.SpillWrite;
+            w.crc = .init();
+            w.in_block = 0;
+        }
+
+        /// The CRC table, a footer, an fsync and the rename: the state is stored (or an error, and nothing is).
+        pub fn finish(w: *Writer) Error!void {
+            errdefer w.abort();
+            if (w.written != w.payload) return error.SpillWrite;
+            if (w.in_block > 0) try w.closeBlock();
+            const table = std.mem.sliceAsBytes(w.crcs.items);
+            try putAll(w.fd, table);
+            var foot: [foot_len]u8 = undefined;
+            @memcpy(foot[0..8], foot_magic);
+            std.mem.writeInt(u32, foot[8..12], std.hash.Crc32.hash(table), .little);
+            std.mem.writeInt(u32, foot[12..16], headCrc(w.at, w.tokens, w.payload, w.tier.cfg.build, w.tier.cfg.rank), .little);
+            try putAll(w.fd, &foot);
+            if (std.c.fsync(w.fd) != 0) return error.SpillWrite;
+            _ = std.c.close(w.fd);
+            w.fd = -1;
+            var dest: [1100]u8 = undefined;
+            const final = w.tier.path(&dest, w.key, false) catch return error.SpillWrite;
+            if (std.c.rename(@ptrCast(w.partial[0..w.partial_len :0]), final) != 0) return error.SpillWrite;
+            w.tier.lock();
+            defer w.tier.unlock();
+            w.tier.dropInflight(w.key);
+            const meta: Meta = .{ .key = w.key, .at = w.at, .tokens = w.tokens, .payload = w.payload, .size = fileSize(w.tokens.len, w.payload), .used = 0 };
+            w.tier.clock += 1;
+            var m = meta;
+            m.used = w.tier.clock;
+            w.tier.metas.append(w.tier.gpa, m) catch {
+                _ = std.c.unlink(final);
+                return error.SpillWrite;
+            };
+            w.tokens = &.{}; // the index owns them now
+            w.tier.stats.writes += 1;
+            w.tier.stats.write_bytes += m.size;
+            w.crcs.deinit(w.tier.gpa);
+        }
+
+        /// Give up: the partial file goes.
+        pub fn abort(w: *Writer) void {
+            w.tier.lock();
+            defer w.tier.unlock();
+            w.abortLocked();
+        }
+
+        fn abortLocked(w: *Writer) void {
+            w.tier.dropInflight(w.key);
+            if (w.fd >= 0) _ = std.c.close(w.fd);
+            w.fd = -1;
+            _ = std.c.unlink(@ptrCast(w.partial[0..w.partial_len :0]));
+            w.tier.gpa.free(w.tokens);
+            w.tokens = &.{};
+            w.crcs.deinit(w.tier.gpa);
+            w.tier.stats.failed += 1;
+        }
+    };
+
+    /// Start storing the state of `tokens` (`at` of them the position) with `payload` bytes: room is made first. After
+    /// `finish` the state is indexed.
+    pub fn begin(t: *Tier, tokens: []const u32, at: u32, payload: u64) Error!Writer {
+        t.lock();
+        defer t.unlock();
+        return t.beginLocked(tokens, at, payload);
+    }
+
+    fn dropInflight(t: *Tier, key: u64) void {
+        if (std.mem.indexOfScalar(u64, t.inflight.items, key)) |i| _ = t.inflight.swapRemove(i);
+    }
+
+    fn beginLocked(t: *Tier, tokens: []const u32, at: u32, payload: u64) Error!Writer {
+        if (!t.wantsLocked(tokens, payload)) return if (tokens.len < t.cfg.min_tokens) error.SpillShort else if (t.hasLocked(keyOf(tokens))) error.SpillExists else error.SpillNoRoom;
+        const size = fileSize(tokens.len, payload);
+        if (!t.room(size)) {
+            t.stats.skipped_floor += 1;
+            return error.SpillNoRoom;
+        }
+        const key = keyOf(tokens);
+        t.inflight.append(t.gpa, key) catch return error.SpillWrite;
+        errdefer t.dropInflight(key);
+        var w: Writer = .{ .tier = t, .fd = -1, .key = key, .tokens = &.{}, .at = at, .payload = payload };
+        const final_len = (std.fmt.bufPrint(&w.partial, "{s}/{x:0>16}.partial", .{ t.dir, key }) catch return error.SpillWrite).len;
+        w.partial[final_len] = 0;
+        w.partial_len = final_len;
+        w.fd = std.c.open(@ptrCast(w.partial[0..w.partial_len :0]), .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true, .NOFOLLOW = true }, @as(std.c.mode_t, 0o600));
+        if (w.fd < 0) {
+            t.stats.failed += 1;
+            return error.SpillWrite;
+        }
+        w.tokens = t.gpa.dupe(u32, tokens) catch {
+            _ = std.c.close(w.fd);
+            return error.SpillWrite;
+        };
+        errdefer w.abortLocked();
+        // header, tokens, padding to the payload's page
+        var head: [head_len]u8 = @splat(0);
+        @memcpy(head[0..8], magic);
+        std.mem.writeInt(u32, head[8..12], 1, .little);
+        std.mem.writeInt(u32, head[12..16], at, .little);
+        std.mem.writeInt(u32, head[16..20], @intCast(tokens.len), .little);
+        std.mem.writeInt(u32, head[20..24], blocksOf(payload), .little);
+        std.mem.writeInt(u64, head[24..32], payload, .little);
+        std.mem.writeInt(u64, head[32..40], t.cfg.build, .little);
+        std.mem.writeInt(u32, head[40..44], t.cfg.rank, .little);
+        try putAll(w.fd, &head);
+        try putAll(w.fd, std.mem.sliceAsBytes(tokens));
+        const pad = payloadOffset(tokens.len) - head_len - 4 * @as(u64, tokens.len);
+        var zeros: [page]u8 = @splat(0);
+        try putAll(w.fd, zeros[0..@intCast(pad)]);
+        return w;
+    }
+
+    pub const Reader = struct {
+        tier: *Tier,
+        fd: c_int,
+        meta: Meta,
+        offset: u64 = 0,
+        crc: std.hash.Crc32 = .init(),
+        in_block: usize = 0,
+        crcs: []u32,
+        block_index: usize = 0,
+        ntokens: usize,
+        bad: bool = false,
+        /// the state's tokens, a copy of its own (the index may drop its)
+        tokens: []u32 = &.{},
+
+        /// The tokens, handed over to the caller (freed with its allocator, `tier.gpa`).
+        pub fn takeTokens(r: *Reader) []u32 {
+            defer r.tokens = &.{};
+            return r.tokens;
+        }
+
+        /// The next `dest.len` payload bytes; each 8 MiB is checked against its CRC as the block completes.
+        pub fn read(r: *Reader, dest: []u8) Error!void {
+            if (r.offset + dest.len > r.meta.payload) return error.SpillRead;
+            var done: usize = 0;
+            while (done < dest.len) {
+                const n = @min(dest.len - done, block - r.in_block);
+                const at = payloadOffset(r.ntokens) + r.offset + done;
+                if (!getAll(r.fd, dest[done..][0..n], at)) return error.SpillRead;
+                r.crc.update(dest[done..][0..n]);
+                r.in_block += n;
+                done += n;
+                const left = r.meta.payload - (r.offset + done);
+                if (r.in_block == block or left == 0) {
+                    if (r.crc.final() != r.crcs[r.block_index]) {
+                        r.tier.lock();
+                        r.tier.stats.crc_failures += 1;
+                        r.tier.unlock();
+                        r.bad = true;
+                        return error.SpillCrc;
+                    }
+                    r.crc = .init();
+                    r.in_block = 0;
+                    r.block_index += 1;
+                }
+            }
+            r.offset += dest.len;
+        }
+
+        /// Close; the read counts when every byte came and checked.
+        pub fn close(r: *Reader) void {
+            _ = std.c.close(r.fd);
+            r.tier.gpa.free(r.crcs);
+            r.tier.gpa.free(r.tokens);
+            r.tokens = &.{};
+            if (r.bad) return r.tier.forget(r.meta.key); // a block that fails its CRC: the state goes
+            if (r.offset == r.meta.payload) {
+                r.tier.lock();
+                defer r.tier.unlock();
+                r.tier.stats.reads += 1;
+                r.tier.stats.read_bytes += r.meta.size;
+                r.tier.touchLocked(r.meta.key);
+            }
+        }
+    };
+
+    /// Open the stored state `key` for reading; a file that fails its checks is forgotten.
+    pub fn reader(t: *Tier, key: u64) Error!Reader {
+        t.lock();
+        defer t.unlock();
+        const i = t.find(key) orelse return error.SpillRead;
+        const m = t.metas.items[i];
+        var buf: [1100]u8 = undefined;
+        const p = t.path(&buf, key, false) catch return error.SpillRead;
+        const fd = std.c.open(p, .{ .ACCMODE = .RDONLY, .NOFOLLOW = true }, @as(std.c.mode_t, 0));
+        if (fd < 0) {
+            t.forgetLocked(key);
+            return error.SpillRead;
+        }
+        errdefer _ = std.c.close(fd);
+        const nblocks = blocksOf(m.payload);
+        const crcs = t.gpa.alloc(u32, nblocks) catch return error.SpillRead;
+        errdefer t.gpa.free(crcs);
+        const table_at = payloadOffset(m.tokens.len) + m.payload;
+        if (!getAll(fd, std.mem.sliceAsBytes(crcs), table_at)) {
+            t.forgetLocked(key);
+            return error.SpillRead;
+        }
+        var foot: [foot_len]u8 = undefined;
+        if (!getAll(fd, &foot, table_at + 4 * @as(u64, nblocks)) or !std.mem.eql(u8, foot[0..8], foot_magic) or
+            std.mem.readInt(u32, foot[8..12], .little) != std.hash.Crc32.hash(std.mem.sliceAsBytes(crcs)))
+        {
+            t.forgetLocked(key);
+            return error.SpillRead;
+        }
+        const tokens = t.gpa.dupe(u32, m.tokens) catch return error.SpillRead;
+        return .{ .tier = t, .fd = fd, .meta = m, .crcs = crcs, .ntokens = m.tokens.len, .tokens = tokens };
+    }
+
+    /// Drop a stored state: its file and its index entry.
+    pub fn forget(t: *Tier, key: u64) void {
+        t.lock();
+        defer t.unlock();
+        t.forgetLocked(key);
+    }
+
+    fn forgetLocked(t: *Tier, key: u64) void {
+        const i = t.find(key) orelse return;
+        var buf: [1100]u8 = undefined;
+        if (t.path(&buf, key, false)) |p| _ = std.c.unlink(p) else |_| {}
+        const m = t.metas.orderedRemove(i);
+        t.gpa.free(m.tokens);
+    }
+
+    /// Start up: a state is indexed only when its file's size matches its header and its header its name.
+    fn scan(t: *Tier) void {
+        const d = std.c.opendir(t.dir.ptr) orelse return;
+        defer _ = std.c.closedir(d);
+        while (std.c.readdir(d)) |ent| {
+            const name = std.mem.sliceTo(&ent.name, 0);
+            if (std.mem.eql(u8, name, ".") or std.mem.eql(u8, name, "..")) continue;
+            var buf: [1100]u8 = undefined;
+            const file = std.fmt.bufPrintSentinel(&buf, "{s}/{s}", .{ t.dir, name }, 0) catch continue;
+            if (!std.mem.endsWith(u8, name, ".state") or name.len != 22) {
+                _ = std.c.unlink(file); // a partial write or a stranger
+                continue;
+            }
+            if (t.load(file, name[0..16])) |m| {
+                t.metas.append(t.gpa, m) catch t.gpa.free(m.tokens);
+            } else {
+                _ = std.c.unlink(file);
+                t.stats.failed += 1;
+            }
+        }
+        // the oldest first in the index's order: files carry no time, so the clock follows the directory's order
+        for (t.metas.items) |*m| {
+            t.clock += 1;
+            m.used = t.clock;
+        }
+    }
+
+    fn load(t: *Tier, file: [:0]const u8, hex: []const u8) ?Meta {
+        const name_key = std.fmt.parseInt(u64, hex, 16) catch return null;
+        const fd = std.c.open(file, .{ .ACCMODE = .RDONLY, .NOFOLLOW = true }, @as(std.c.mode_t, 0));
+        if (fd < 0) return null;
+        defer _ = std.c.close(fd);
+        var head: [head_len]u8 = undefined;
+        if (!getAll(fd, &head, 0) or !std.mem.eql(u8, head[0..8], magic) or std.mem.readInt(u32, head[8..12], .little) != 1) return null;
+        const at = std.mem.readInt(u32, head[12..16], .little);
+        const n = std.mem.readInt(u32, head[16..20], .little);
+        const payload = std.mem.readInt(u64, head[24..32], .little);
+        if (std.mem.readInt(u64, head[32..40], .little) != t.cfg.build or std.mem.readInt(u32, head[40..44], .little) != t.cfg.rank) return null;
+        if (n == 0 or n > 1 << 24 or at == 0 or at > n or std.mem.readInt(u32, head[20..24], .little) != blocksOf(payload)) return null;
+        const size = fileSize(n, payload);
+        const end = std.c.lseek(fd, 0, std.c.SEEK.END);
+        if (end < 0 or @as(u64, @intCast(end)) != size) return null;
+        const tokens = t.gpa.alloc(u32, n) catch return null;
+        if (!getAll(fd, std.mem.sliceAsBytes(tokens), head_len) or keyOf(tokens) != name_key) {
+            t.gpa.free(tokens);
+            return null;
+        }
+        return .{ .key = name_key, .at = at, .tokens = tokens, .payload = payload, .size = size, .used = 0 };
+    }
+
+    /// Other builds' folders under the root go (ours only: a `tfspill-<16 hex>` name).
+    fn pruneBuilds(t: *Tier) void {
+        var keep_buf: [40]u8 = undefined;
+        const keep = std.fmt.bufPrint(&keep_buf, "tfspill-{x:0>16}", .{t.cfg.build}) catch return;
+        var rootz: [1100]u8 = undefined;
+        const root = std.fmt.bufPrintSentinel(&rootz, "{s}", .{t.cfg.root}, 0) catch return;
+        const d = std.c.opendir(root.ptr) orelse return;
+        defer _ = std.c.closedir(d);
+        while (std.c.readdir(d)) |ent| {
+            const name = std.mem.sliceTo(&ent.name, 0);
+            if (name.len != 24 or !std.mem.startsWith(u8, name, "tfspill-") or std.mem.eql(u8, name, keep)) continue;
+            if (!allHex(name[8..])) continue;
+            var sub: [1100]u8 = undefined;
+            const p = std.fmt.bufPrintSentinel(&sub, "{s}/{s}", .{ t.cfg.root, name }, 0) catch continue;
+            removeTree(p);
+        }
+    }
+};
+
+fn allHex(text: []const u8) bool {
+    for (text) |c| if (!std.ascii.isHex(c)) return false;
+    return true;
+}
+
+/// A folder of ours and its files and rank folders, removed (no links followed).
+fn removeTree(p: [:0]const u8) void {
+    const d = std.c.opendir(p.ptr) orelse return;
+    defer _ = std.c.closedir(d);
+    while (std.c.readdir(d)) |ent| {
+        const name = std.mem.sliceTo(&ent.name, 0);
+        if (std.mem.eql(u8, name, ".") or std.mem.eql(u8, name, "..")) continue;
+        var buf: [1100]u8 = undefined;
+        const child = std.fmt.bufPrintSentinel(&buf, "{s}/{s}", .{ p, name }, 0) catch continue;
+        if (ent.type == std.c.DT.DIR) removeTree(child) else _ = std.c.unlink(child);
+    }
+    _ = std.c.rmdir(p.ptr);
+}
+
+fn headCrc(at: u32, tokens: []const u32, payload: u64, build: u64, rank: u32) u32 {
+    var h = std.hash.Crc32.init();
+    h.update(std.mem.asBytes(&at));
+    h.update(std.mem.sliceAsBytes(tokens));
+    h.update(std.mem.asBytes(&payload));
+    h.update(std.mem.asBytes(&build));
+    h.update(std.mem.asBytes(&rank));
+    return h.final();
+}
+
+fn makePath(dir: [:0]const u8) !void {
+    var buf: [1100]u8 = undefined;
+    var i: usize = 1;
+    while (i <= dir.len) : (i += 1) {
+        if (i < dir.len and dir[i] != '/') continue;
+        const part = std.fmt.bufPrintSentinel(&buf, "{s}", .{dir[0..i]}, 0) catch return error.SpillDir;
+        const rc = std.c.mkdir(part, 0o700);
+        if (rc != 0 and std.c.errno(rc) != .EXIST) return error.SpillDir;
+    }
+}
+
+fn putAll(fd: c_int, bytes: []const u8) Error!void {
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = std.c.write(fd, bytes.ptr + done, @min(bytes.len - done, 1 << 30));
+        if (n <= 0) return error.SpillWrite;
+        done += @intCast(n);
+    }
+}
+
+fn getAll(fd: c_int, bytes: []u8, at: u64) bool {
+    var done: usize = 0;
+    while (done < bytes.len) {
+        const n = std.c.pread(fd, bytes.ptr + done, @min(bytes.len - done, 1 << 30), @intCast(at + done));
+        if (n <= 0) return false;
+        done += @intCast(n);
+    }
+    return true;
+}
+
+// -- tests ---------------------------------------------------------------------------------------------------------------
+
+fn unlimited(_: [:0]const u8) ?u64 {
+    return 1 << 50;
+}
+
+var fake_free: u64 = 0;
+fn fakeFree(_: [:0]const u8) ?u64 {
+    return fake_free;
+}
+
+fn testRoot(buf: []u8, tag: []const u8) [:0]const u8 {
+    return std.fmt.bufPrintSentinel(buf, "/tmp/tf-spill-test-{d}-{s}", .{ std.c.getpid(), tag }, 0) catch unreachable;
+}
+
+fn cleanup(root: [:0]const u8) void {
+    removeTree(root);
+}
+
+fn store(t: *Tier, tokens: []const u32, at: u32, payload: []const u8) !void {
+    var w = try t.begin(tokens, at, payload.len);
+    var i: usize = 0;
+    while (i < payload.len) : (i += 5000) try w.put(payload[i..@min(payload.len, i + 5000)]);
+    try w.finish();
+}
+
+fn toks(buf: []u32, seed: u32) []u32 {
+    for (buf, 0..) |*t, i| t.* = seed *% 7919 +% @as(u32, @intCast(i));
+    return buf;
+}
+
+test "a state is written, indexed, found by a longer prompt and read back with its CRCs" {
+    const gpa = std.testing.allocator;
+    var rb: [200]u8 = undefined;
+    const root = testRoot(&rb, "a");
+    defer cleanup(root);
+    var t = try Tier.open(gpa, .{ .root = root, .build = 0xabc, .cap = 1 << 30, .min_tokens = 16, .min_free = 0, .free = unlimited });
+    defer t.deinit();
+    var tb: [64]u32 = undefined;
+    const tokens = toks(&tb, 1);
+    const payload = try gpa.alloc(u8, 3 * block + 12345);
+    defer gpa.free(payload);
+    var prng = std.Random.DefaultPrng.init(7);
+    prng.random().bytes(payload);
+    try store(&t, tokens, 64, payload);
+    try std.testing.expect(t.has(keyOf(tokens)));
+    var longer: [80]u32 = undefined;
+    @memcpy(longer[0..64], tokens);
+    for (longer[64..], 0..) |*x, i| x.* = 50000 + @as(u32, @intCast(i));
+    const hit = t.best(&longer, 0, 64).?;
+    try std.testing.expectEqual(@as(u32, 64), hit.at);
+    try std.testing.expect(t.best(tokens, 0, 64) == null); // a prompt of exactly its tokens leaves no row
+    try std.testing.expect(t.best(&longer, 64, 64) == null); // nothing longer than a kept one
+    var r = try t.reader(hit.key);
+    const back = try gpa.alloc(u8, payload.len);
+    defer gpa.free(back);
+    var off: usize = 0;
+    while (off < back.len) : (off += 1 << 20) try r.read(back[off..@min(back.len, off + (1 << 20))]);
+    r.close();
+    try std.testing.expectEqualSlices(u8, payload, back);
+    const s = t.snapshot();
+    try std.testing.expectEqual(@as(u64, 1), s.writes);
+    try std.testing.expectEqual(@as(u64, 1), s.reads);
+    try std.testing.expectEqual(@as(u32, 1), s.entries);
+}
+
+test "a restart finds what a clean write left, and drops a truncated file, a partial one and a stranger" {
+    const gpa = std.testing.allocator;
+    var rb: [200]u8 = undefined;
+    const root = testRoot(&rb, "b");
+    defer cleanup(root);
+    const cfg: Config = .{ .root = root, .build = 0x77, .cap = 1 << 30, .min_tokens = 16, .min_free = 0, .free = unlimited };
+    var dir_copy: [400]u8 = undefined;
+    {
+        var t = try Tier.open(gpa, cfg);
+        defer t.deinit();
+        var tb: [40]u32 = undefined;
+        var tb2: [48]u32 = undefined;
+        const payload: [10000]u8 = @splat(9);
+        try store(&t, toks(&tb, 1), 40, &payload);
+        try store(&t, toks(&tb2, 2), 48, &payload);
+        @memcpy(dir_copy[0..t.dir.len], t.dir);
+        dir_copy[t.dir.len] = 0;
+        // damage the second: a few bytes short
+        var f: [1100]u8 = undefined;
+        const p = try t.path(&f, keyOf(toks(&tb2, 2)), false);
+        const tfd = std.c.open(p, .{ .ACCMODE = .WRONLY }, @as(std.c.mode_t, 0));
+        try std.testing.expectEqual(@as(c_int, 0), std.c.ftruncate(tfd, @intCast(fileSize(48, 10000) - 3)));
+        _ = std.c.close(tfd);
+        // and a partial write and a stranger
+        const part = try std.fmt.bufPrintSentinel(&f, "{s}/0000000000000001.partial", .{t.dir}, 0);
+        const fd = std.c.open(part, .{ .ACCMODE = .WRONLY, .CREAT = true }, @as(std.c.mode_t, 0o600));
+        _ = std.c.close(fd);
+    }
+    var t = try Tier.open(gpa, cfg);
+    defer t.deinit();
+    try std.testing.expectEqual(@as(usize, 1), t.metas.items.len);
+    try std.testing.expectEqual(@as(u32, 40), t.metas.items[0].at);
+    try std.testing.expect(t.stats.failed >= 1);
+    var one: [40]u32 = undefined;
+    _ = toks(&one, 1);
+    try std.testing.expect(t.has(keyOf(&one)));
+    // a build with another hash prunes ours at open
+    var t2 = try Tier.open(gpa, .{ .root = root, .build = 0x78, .cap = 1 << 30, .min_tokens = 16, .min_free = 0, .free = unlimited });
+    defer t2.deinit();
+    try std.testing.expectEqual(@as(usize, 0), t2.metas.items.len);
+    const gone = std.c.opendir(@ptrCast(dir_copy[0..t.dir.len :0]));
+    try std.testing.expect(gone == null);
+}
+
+test "a flipped payload byte fails its block's CRC and the short, the stored and the over-cap are refused" {
+    const gpa = std.testing.allocator;
+    var rb: [200]u8 = undefined;
+    const root = testRoot(&rb, "c");
+    defer cleanup(root);
+    var t = try Tier.open(gpa, .{ .root = root, .build = 1, .cap = 100000, .min_tokens = 16, .min_free = 0, .free = unlimited });
+    defer t.deinit();
+    var tb: [32]u32 = undefined;
+    const tokens = toks(&tb, 3);
+    const payload: [20000]u8 = @splat(5);
+    try store(&t, tokens, 32, &payload);
+    var f: [1100]u8 = undefined;
+    const p = try t.path(&f, keyOf(tokens), false);
+    const fd = std.c.open(p, .{ .ACCMODE = .RDWR }, @as(std.c.mode_t, 0));
+    try std.testing.expectEqual(@as(isize, 1), std.c.pwrite(fd, "X", 1, @intCast(payloadOffset(32) + 100)));
+    _ = std.c.close(fd);
+    var r = try t.reader(keyOf(tokens));
+    var back: [20000]u8 = undefined;
+    try std.testing.expectError(error.SpillCrc, r.read(&back));
+    r.close();
+    try std.testing.expectEqual(@as(u64, 1), t.stats.crc_failures);
+    try std.testing.expect(!t.has(keyOf(tokens))); // forgotten
+    try std.testing.expectError(error.SpillShort, t.begin(tokens[0..8], 8, 10));
+    try store(&t, tokens, 32, &payload);
+    try std.testing.expectError(error.SpillExists, t.begin(tokens, 32, 20000));
+    var short: [8]u32 = undefined;
+    try std.testing.expectError(error.SpillShort, t.begin(toks(&short, 4), 8, 100));
+    var big: [32]u32 = undefined;
+    try std.testing.expectError(error.SpillNoRoom, t.begin(toks(&big, 5), 32, 200000)); // past the cap altogether
+}
+
+test "the cap drops the oldest files, and the free-disk floor drops more or skips the write" {
+    const gpa = std.testing.allocator;
+    var rb: [200]u8 = undefined;
+    const root = testRoot(&rb, "d");
+    defer cleanup(root);
+    const payload: [20000]u8 = @splat(1);
+    const size = fileSize(32, 20000);
+    var t = try Tier.open(gpa, .{ .root = root, .build = 2, .cap = 2 * size + 10, .min_tokens = 16, .min_free = 1000, .free = fakeFree });
+    defer t.deinit();
+    fake_free = 1 << 40;
+    var a: [32]u32 = undefined;
+    var b: [32]u32 = undefined;
+    var c: [32]u32 = undefined;
+    try store(&t, toks(&a, 1), 32, &payload);
+    try store(&t, toks(&b, 2), 32, &payload);
+    t.touch(keyOf(toks(&a, 1))); // a is now the newer
+    try store(&t, toks(&c, 3), 32, &payload); // the cap holds two: b, the oldest, goes
+    try std.testing.expect(t.has(keyOf(toks(&a, 1))) and t.has(keyOf(toks(&c, 3))) and !t.has(keyOf(toks(&b, 2))));
+    try std.testing.expectEqual(@as(u64, 1), t.stats.pruned);
+    // the cap keeps two files, so the new one drops the older of a and c; then the disk would be left under the floor, so the
+    // last old one goes too, and the write is made
+    fake_free = size + 500;
+    var d: [32]u32 = undefined;
+    try store(&t, toks(&d, 4), 32, &payload);
+    try std.testing.expectEqual(@as(usize, 1), t.metas.items.len);
+    try std.testing.expect(t.has(keyOf(toks(&d, 4))));
+    // when dropping everything would not leave the floor, nothing is dropped and nothing written
+    fake_free = 100;
+    var e: [32]u32 = undefined;
+    const before = t.metas.items.len;
+    try std.testing.expectError(error.SpillNoRoom, t.begin(toks(&e, 5), 32, 20000));
+    try std.testing.expectEqual(before, t.metas.items.len);
+    try std.testing.expect(t.stats.skipped_floor >= 1);
+}
+
+test "a writer thread stores while the lane thread looks up, reads and forgets: the index stays whole" {
+    const gpa = std.testing.allocator;
+    var rb: [200]u8 = undefined;
+    const root = testRoot(&rb, "e");
+    defer cleanup(root);
+    var t = try Tier.open(gpa, .{ .root = root, .build = 5, .cap = 1 << 30, .min_tokens = 16, .min_free = 0, .free = unlimited });
+    defer t.deinit();
+    const Job = struct {
+        fn run(tier: *Tier, done: *std.atomic.Value(bool)) void {
+            const payload: [30000]u8 = @splat(7);
+            var i: u32 = 0;
+            while (i < 40) : (i += 1) {
+                var tb: [32]u32 = undefined;
+                store(tier, toks(&tb, 100 + i), 32, &payload) catch {};
+            }
+            done.store(true, .release);
+        }
+    };
+    var done: std.atomic.Value(bool) = .init(false);
+    const th = try std.Thread.spawn(.{}, Job.run, .{ &t, &done });
+    var forgotten: u32 = 0;
+    while (!done.load(.acquire)) {
+        var q: [64]u32 = undefined;
+        _ = toks(&q, 100);
+        if (t.best(&q, 0, 0)) |m| {
+            const key = m.key;
+            if (t.reader(key)) |r0| {
+                var r = r0;
+                var back: [30000]u8 = undefined;
+                r.read(&back) catch {};
+                r.close();
+            } else |_| {}
+        }
+        const s = t.snapshot();
+        if (s.entries > 10) {
+            var tb: [32]u32 = undefined;
+            t.forget(keyOf(toks(&tb, 100 + forgotten % 40)));
+            forgotten += 1;
+        }
+    }
+    th.join();
+    const s = t.snapshot();
+    try std.testing.expect(s.writes + s.failed >= 1);
+    try std.testing.expectEqual(@as(usize, 0), t.inflight.items.len);
+}
diff --git a/zig/src/families/glm_cuda/cuda_stage.zig b/zig/src/families/glm_cuda/cuda_stage.zig
new file mode 100644
index 00000000..60abcfa8
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_stage.zig
@@ -0,0 +1,85 @@
+//! Stream-ordered host-to-device staging for the decode hot path (glm5_next/cuda/verify.py's pinned metadata copies and
+//! segments.py's event-guarded staging, as one ring). A put copies the bytes into pinned memory and queues an async
+//! copy on the engine stream: it waits for nothing and drains nothing, because the copy runs after whatever the stream
+//! already holds (the previous graph included). Pinned bytes are reused only after an event says every copy before has
+//! run. This is a hot-path tool: the core DeviceBuffer.upload keeps its synchronous contract.
+const std = @import("std");
+const cuda = @import("cuda");
+
+/// Where a put of `n` bytes lands in a ring of `cap` bytes already filled to `used`; `wrap` when the ring starts over
+/// (the caller then waits for the copies in flight first). Puts are 16-byte aligned.
+pub fn place(used: usize, n: usize, cap: usize) error{TooBig}!struct { at: usize, wrap: bool } {
+    if (n > cap) return error.TooBig;
+    const at = std.mem.alignForward(usize, used, 16);
+    if (at + n <= cap) return .{ .at = at, .wrap = false };
+    return .{ .at = 0, .wrap = true };
+}
+
+/// Run-time A/B switch (TF_GLM_AB=stage: cuda_native alternates it between generations): true makes every hot-path user
+/// take its blocking path.
+pub var sync_mode: bool = false;
+
+pub const Stager = struct {
+    stream: ?cuda.Stream = null,
+    host: ?cuda.HostBuffer = null,
+    event: ?cuda.Event = null,
+    used: usize = 0,
+    wraps: usize = 0,
+
+    pub fn init(d: *const cuda.Driver, stream: cuda.Stream, bytes: usize) !Stager {
+        var host = try cuda.HostBuffer.alloc(d, bytes);
+        errdefer host.free();
+        const event = try cuda.Event.init(d, false);
+        return .{ .stream = stream, .host = host, .event = event };
+    }
+    pub fn deinit(s: *Stager) void {
+        if (s.host) |*h| {
+            if (s.stream) |st| st.synchronize() catch {};
+            h.free();
+        }
+        if (s.event) |*e| e.deinit();
+        s.* = .{};
+    }
+    pub fn ready(s: *const Stager) bool {
+        return s.host != null and !sync_mode;
+    }
+    /// Queue `bytes` for `dst` (a device address) on the stream.
+    pub fn put(s: *Stager, dst: u64, bytes: []const u8) !void {
+        const host = s.host orelse return error.StagerNotReady;
+        if (bytes.len == 0) return;
+        const p = try place(s.used, bytes.len, host.bytes.len);
+        if (p.wrap) {
+            // every copy queued so far must have run before its pinned bytes are overwritten
+            try s.event.?.record(s.stream.?);
+            try s.event.?.synchronize();
+            s.wraps += 1;
+        }
+        @memcpy(host.bytes[p.at..][0..bytes.len], bytes);
+        s.used = p.at + bytes.len;
+        const view: cuda.DeviceBuffer = .{ .d = host.d, .ptr = dst, .len = bytes.len };
+        try view.uploadAsync(0, host.bytes[p.at..][0..bytes.len], s.stream.?.handle);
+    }
+    /// A single i32 or other small value.
+    pub fn putValue(s: *Stager, dst: u64, value: anytype) !void {
+        const v = value;
+        try s.put(dst, std.mem.asBytes(&v));
+    }
+};
+
+test "ring placement aligns, wraps and refuses an oversized put" {
+    var p = try place(0, 5, 64);
+    try std.testing.expectEqual(@as(usize, 0), p.at);
+    try std.testing.expect(!p.wrap);
+    p = try place(5, 10, 64);
+    try std.testing.expectEqual(@as(usize, 16), p.at);
+    p = try place(26, 38, 64);
+    try std.testing.expectEqual(@as(usize, 0), p.at);
+    try std.testing.expect(p.wrap);
+    p = try place(32, 32, 64);
+    try std.testing.expectEqual(@as(usize, 32), p.at);
+    try std.testing.expect(!p.wrap);
+    try std.testing.expectError(error.TooBig, place(0, 65, 64));
+    var s: Stager = .{};
+    try std.testing.expect(!s.ready());
+    try std.testing.expectError(error.StagerNotReady, s.put(0, "x"));
+}
diff --git a/zig/src/families/glm_cuda/cuda_state.zig b/zig/src/families/glm_cuda/cuda_state.zig
new file mode 100644
index 00000000..7875209f
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_state.zig
@@ -0,0 +1,254 @@
+//! Device layouts from glm5_next/cuda/forward.py: Slots, Caches, State; kda.py: KDAScratchSet.
+//! FP8 cache rows follow glm5_next/cuda/kv8.py. No arithmetic or quantization is performed here.
+const std = @import("std");
+const cuda = @import("cuda");
+pub const Geometry = @import("cuda_geometry.zig").Geometry;
+const G = Geometry;
+const display = @import("cuda_display_kv.zig");
+pub fn aligned(sizes: []const usize) usize {
+    var n: usize = 0;
+    for (sizes) |size| n += std.mem.alignForward(usize, size, 256);
+    return n;
+}
+pub const Arena = struct {
+    buf: cuda.DeviceBuffer,
+    offset: usize = 0,
+    pub fn init(d: *const cuda.Driver, sizes: []const usize) !Arena {
+        var a: Arena = .{ .buf = try cuda.DeviceBuffer.alloc(d, aligned(sizes)) };
+        errdefer a.buf.free();
+        try a.buf.fill8(0, null);
+        return a;
+    }
+    pub fn take(a: *Arena, n: usize) u64 {
+        if (n == 0) return 0;
+        const at = a.offset;
+        a.offset += std.mem.alignForward(usize, n, 256);
+        std.debug.assert(a.offset <= a.buf.len);
+        return a.buf.ptr + at;
+    }
+    pub fn deinit(a: *Arena) void {
+        a.buf.free();
+    }
+};
+pub const Slot = struct { rec: u64, conv: u64, proj: u64, out: u64, k: u64, v: u64, g: u64, b: u64, pos_dev: u64, mtp_pos_dev: u64 };
+pub const Slots = struct {
+    arena: Arena,
+    g: Geometry,
+    count: usize,
+    rows: usize,
+    rec: u64,
+    conv: u64,
+    proj: u64,
+    out: u64,
+    k: u64,
+    v: u64,
+    gates: u64,
+    b: u64,
+    pos_dev: u64,
+    pub fn layout(g: Geometry, count: usize, rows: usize) [9]usize {
+        const h = g.lin_heads;
+        const l = G.kda_layers;
+        const r = count * l * rows;
+        // pos_dev and mtp_pos_dev, one int32 each, on their own 16-byte stride: the captured Triton kernels are specialised on 16-byte-aligned pointers (mtp at +4 missed _dense_chunks).
+        return .{ count * 2 * l * h * 128 * 128 * 4, count * l * 3 * g.convDim() * 2, r * g.projWidth() * 2, r * h * 128 * 2, r * h * 128 * 4, r * h * 128 * 2, r * h * 128 * 4, r * h * 4, count * 32 };
+    }
+    pub fn bytes(g: Geometry, count: usize, rows: usize) usize {
+        return aligned(&layout(g, count, rows));
+    }
+    pub fn init(d: *const cuda.Driver, g: Geometry, count: usize, rows: usize) !Slots {
+        if (count < 1 or count > 8 or rows < 1) return error.BadSlots;
+        const sizes = layout(g, count, rows);
+        var a = try Arena.init(d, &sizes);
+        errdefer a.deinit();
+        var slots: Slots = .{ .arena = undefined, .g = g, .count = count, .rows = rows, .rec = a.take(sizes[0]), .conv = a.take(sizes[1]), .proj = a.take(sizes[2]), .out = a.take(sizes[3]), .k = a.take(sizes[4]), .v = a.take(sizes[5]), .gates = a.take(sizes[6]), .b = a.take(sizes[7]), .pos_dev = a.take(sizes[8]) };
+        slots.arena = a;
+        return slots;
+    }
+    pub fn deinit(s: *Slots) void {
+        s.arena.deinit();
+    }
+    pub fn view(s: Slots, slot: usize) !Slot {
+        if (slot >= s.count) return error.BadSlot;
+        const n = layout(s.g, 1, s.rows);
+        const pos = s.pos_dev + slot * 32;
+        return .{ .rec = s.rec + slot * n[0], .conv = s.conv + slot * n[1], .proj = s.proj + slot * n[2], .out = s.out + slot * n[3], .k = s.k + slot * n[4], .v = s.v + slot * n[5], .g = s.gates + slot * n[6], .b = s.b + slot * n[7], .pos_dev = pos, .mtp_pos_dev = pos + 16 };
+    }
+};
+pub const CacheView = struct { latent: [11]u64, pooled: [11]u64, keys: [11]u64, gates: [11]u64, ring_base: usize, capacity: usize };
+/// Shared token arena plus per-stream index rings. Cache bytes are replicated on every TP rank.
+pub const Caches = struct {
+    arena: Arena,
+    span: ?display.Span = null,
+    rows: usize,
+    streams: usize,
+    ring: usize,
+    latent: [11]u64,
+    pooled: [11]u64,
+    keys: [11]u64,
+    gates: [11]u64,
+    pub fn layout(rows: usize, streams: usize, ring: usize) [44]usize {
+        var sizes: [44]usize = undefined;
+        for (0..11) |i| {
+            sizes[4 * i ..][0..4].* = .{ rows * G.latent_row, (rows / 4 + 2) * G.pool_row, streams * ring * 128 * 2, streams * ring * 128 * 2 };
+        }
+        return sizes;
+    }
+    pub fn bytes(rows: usize, streams: usize, ring: usize) usize {
+        return aligned(&layout(rows, streams, ring));
+    }
+    pub fn init(d: *const cuda.Driver, rows: usize, streams: usize, window: usize) !Caches {
+        return initDisplay(std.heap.c_allocator, std.Io.Threaded.global_single_threaded.io(), d, 0, rows, streams, window, .{});
+    }
+    pub fn initDisplay(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, device: c_int, rows: usize, streams: usize, window: usize, cfg: display.Config) !Caches {
+        if (rows == 0 or rows % G.extent != 0 or streams < 1 or streams > 8 or window == 0) return error.BadCaches;
+        const ring = G.indexRing(rows, window);
+        if (ring < window + 3) return error.BadRing;
+        var sizes = layout(rows, streams, ring);
+        const plane = rows * G.latent_row;
+        const count = if (cfg.bytes == 0) 0 else try display.planes(11, plane, cfg.bytes);
+        var span: ?display.Span = if (count == 0) null else try display.map(gpa, io, d, device, cfg, count * plane - cfg.bytes);
+        errdefer if (span) |*v| v.deinit();
+        for (0..count) |i| sizes[4 * i] = 0;
+        var a = try Arena.init(d, &sizes);
+        errdefer a.deinit();
+        var c: Caches = .{ .arena = undefined, .rows = rows, .streams = streams, .ring = ring, .latent = undefined, .pooled = undefined, .keys = undefined, .gates = undefined };
+        for (0..11) |i| {
+            c.latent[i] = if (i < count) span.?.ptr + i * plane else a.take(sizes[4 * i]);
+            if (i < count) {
+                const plane_view: cuda.DeviceBuffer = .{ .d = d, .ptr = c.latent[i], .len = plane };
+                try plane_view.fill8(0, null);
+            }
+            c.pooled[i] = a.take(sizes[4 * i + 1]);
+            c.keys[i] = a.take(sizes[4 * i + 2]);
+            c.gates[i] = a.take(sizes[4 * i + 3]);
+        }
+        c.arena = a;
+        c.span = span;
+        return c;
+    }
+    /// One independent DSA plane for the checkpoint MTP head; no target cache aliases.
+    pub fn initMtp(d: *const cuda.Driver, rows: usize, window: usize) !Caches {
+        const ring = G.indexRing(rows, window);
+        const sizes = [_]usize{ rows * G.latent_row, (rows / 4 + 2) * G.pool_row, ring * 128 * 2, ring * 128 * 2 };
+        var a = try Arena.init(d, &sizes);
+        errdefer a.deinit();
+        const latent = a.take(sizes[0]);
+        const pooled = a.take(sizes[1]);
+        const keys = a.take(sizes[2]);
+        const gates = a.take(sizes[3]);
+        return .{ .arena = a, .rows = rows, .streams = 1, .ring = ring, .latent = @splat(latent), .pooled = @splat(pooled), .keys = @splat(keys), .gates = @splat(gates) };
+    }
+    pub fn deinit(c: *Caches) void {
+        c.arena.deinit();
+        if (c.span) |*v| v.deinit();
+    }
+    pub fn view(c: Caches, base: usize, size: usize, slot: usize) !CacheView {
+        if (base % G.extent != 0 or size == 0 or size % G.extent != 0 or base > c.rows or size > c.rows - base or slot >= c.streams) return error.BadExtent;
+        var v: CacheView = .{ .latent = undefined, .pooled = undefined, .keys = undefined, .gates = undefined, .ring_base = slot * c.ring, .capacity = size };
+        for (0..11) |i| {
+            v.latent[i] = c.latent[i] + base * G.latent_row;
+            v.pooled[i] = c.pooled[i] + base / 4 * G.pool_row;
+            v.keys[i] = c.keys[i] + slot * c.ring * 128 * 2;
+            v.gates[i] = c.gates[i] + slot * c.ring * 128 * 2;
+        }
+        return v;
+    }
+};
+/// Host commit metadata plus views; ownership belongs to Slots/Caches. Parity flips only after accepted replay.
+pub const State = struct {
+    slot: usize,
+    base: usize,
+    capacity: usize,
+    pos: usize = 0,
+    cur: [34]u1 = @splat(0),
+    fixed: Slot,
+    cache: CacheView,
+    pub fn bind(slots: Slots, caches: Caches, slot: usize, base: usize, size: usize) !State {
+        return .{ .slot = slot, .base = base, .capacity = size, .fixed = try slots.view(slot), .cache = try caches.view(base, size, slot) };
+    }
+    pub fn recurrent(s: State, g: Geometry, layer: usize, parity: u1) u64 {
+        std.debug.assert(layer < 34);
+        return s.fixed.rec + (@as(usize, parity) * 34 + layer) * g.lin_heads * 128 * 128 * 4;
+    }
+};
+/// P0's stable common forward scratch; matmul/selection packages add their own shape-dependent workspaces.
+pub const Buffers = struct {
+    arena: Arena,
+    rows: usize,
+    ids: u64,
+    x: u64,
+    normed: u64,
+    hc_part: u64,
+    xs: u64,
+    post: u64,
+    comb: u64,
+    part: u64,
+    gathered: u64,
+    hidden: u64,
+    taps: u64,
+    logits: u64,
+    q_tmp: u64,
+    y_tmp: u64,
+    pub fn layout(g: Geometry, rows: usize, prefill: bool) [14]usize {
+        const r = rows;
+        return .{ r * 4, r * g.wide() * 2, r * 4096 * 2, r * 16 * 32 * 4, r * 64 * 4, r * 4 * 4, r * 16 * 4, r * 4096 * 4, g.world * r * 4096 * 4, r * 4096 * 2, 5 * r * 4096 * 2, (if (prefill) @as(usize, 1) else r) * g.vocab * 2, r * g.lin_heads * 128 * 4, r * g.lin_heads * 128 * 2 };
+    }
+    pub fn bytes(g: Geometry, rows: usize, prefill: bool) usize {
+        return aligned(&layout(g, rows, prefill));
+    }
+    pub fn init(d: *const cuda.Driver, g: Geometry, rows: usize, prefill: bool) !Buffers {
+        if (rows == 0) return error.BadRows;
+        const sizes = layout(g, rows, prefill);
+        var a = try Arena.init(d, &sizes);
+        errdefer a.deinit();
+        var b: Buffers = undefined;
+        b.rows = rows;
+        const ptrs = [_]*u64{ &b.ids, &b.x, &b.normed, &b.hc_part, &b.xs, &b.post, &b.comb, &b.part, &b.gathered, &b.hidden, &b.taps, &b.logits, &b.q_tmp, &b.y_tmp };
+        for (ptrs, sizes) |p, n| p.* = a.take(n);
+        b.arena = a;
+        return b;
+    }
+    pub fn deinit(b: *Buffers) void {
+        b.arena.deinit();
+    }
+};
+test "TP2 slots retain both recurrent parities and all replay inputs" {
+    const g = try G.init(2, 0);
+    const n = Slots.layout(g, 1, 32);
+    try std.testing.expectEqual(@as(usize, 142606336), n[0]);
+    try std.testing.expectEqual(@as(usize, 34 * 3 * 12288 * 2), n[1]);
+    try std.testing.expectEqual(@as(usize, 34 * 32 * 12576 * 2), n[2]);
+    try std.testing.expectEqual(@as(usize, 32), n[8]);
+    const c = Caches.layout(4096, 2, 64);
+    try std.testing.expectEqual(@as(usize, 4096 * 528), c[0]);
+    try std.testing.expectEqual(@as(usize, 1026 * 144), c[1]);
+    try std.testing.expectEqual(@as(usize, 2 * 64 * 128 * 2), c[2]);
+    try std.testing.expect(Buffers.bytes(g, 2048, true) > Buffers.bytes(g, 32, false));
+}
+
+test "every slot's position pair is 16-byte aligned (captured Triton kernels are specialised on it)" {
+    const g = try G.init(2, 0);
+    const slots: Slots = .{ .arena = undefined, .g = g, .count = 8, .rows = 32, .rec = 0x1000, .conv = 0x2000, .proj = 0x3000, .out = 0x4000, .k = 0x5000, .v = 0x6000, .gates = 0x7000, .b = 0x8000, .pos_dev = 0x9000 };
+    for (0..8) |i| {
+        const v = try slots.view(i);
+        try std.testing.expectEqual(@as(u64, 0), v.pos_dev % 16);
+        try std.testing.expectEqual(@as(u64, 0), v.mtp_pos_dev % 16);
+        try std.testing.expect(v.mtp_pos_dev == v.pos_dev + 16);
+    }
+}
+
+test "slot, parity and extent views use reference strides without device allocation" {
+    const g = try G.init(2, 0);
+    const slots: Slots = .{ .arena = undefined, .g = g, .count = 2, .rows = 32, .rec = 0x1000, .conv = 0x2000, .proj = 0x3000, .out = 0x4000, .k = 0x5000, .v = 0x6000, .gates = 0x7000, .b = 0x8000, .pos_dev = 0x9000 };
+    const caches: Caches = .{ .arena = undefined, .rows = 8192, .streams = 2, .ring = 64, .latent = @splat(0x100000), .pooled = @splat(0x200000), .keys = @splat(0x300000), .gates = @splat(0x400000) };
+    const s = try State.bind(slots, caches, 1, 2048, 4096);
+    try std.testing.expectEqual(@as(u64, 0x1000 + 142606336), s.fixed.rec);
+    try std.testing.expectEqual(@as(u64, 0x9000 + 32), s.fixed.pos_dev);
+    try std.testing.expectEqual(@as(u64, 0x9000 + 48), s.fixed.mtp_pos_dev);
+    try std.testing.expectEqual(@as(u64, 0x100000 + 2048 * 528), s.cache.latent[0]);
+    try std.testing.expectEqual(@as(u64, 0x200000 + 512 * 144), s.cache.pooled[0]);
+    try std.testing.expectEqual(@as(u64, 0x300000 + 64 * 256), s.cache.keys[0]);
+    try std.testing.expectEqual(s.fixed.rec + 34 * 32 * 128 * 128 * 4, s.recurrent(g, 0, 1));
+    try std.testing.expectError(error.BadExtent, caches.view(1, 2048, 0));
+    try std.testing.expectError(error.BadExtent, caches.view(6144, 4096, 0));
+}
diff --git a/zig/src/families/glm_cuda/cuda_torch_ops.zig b/zig/src/families/glm_cuda/cuda_torch_ops.zig
new file mode 100644
index 00000000..f739891b
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_torch_ops.zig
@@ -0,0 +1,160 @@
+//! glm5_next/cuda/{multi_tune,dflash2,dflash2_multi}.py torch operations.
+//! Shared copies/conversions/radix selection use Flash Next's qualified operators.
+const std = @import("std");
+const cuda = @import("cuda");
+pub const shared = @import("flashnext").torch_ops;
+/// Blocks a greedy row is scanned by (GREEDY_SPLIT in glm_ops.cu); `part` holds greedy_split * 2 words a row.
+pub const greedy_split = 16;
+pub const Ops = struct {
+    module: cuda.Module,
+    base: shared.Ops,
+    sort: cuda.Function,
+    pack: cuda.Function,
+    index_copy: cuda.Function,
+    rotary: cuda.Function,
+    ring: cuda.Function,
+    rank_add: cuda.Function,
+    int_add: cuda.Function,
+    scaled_max: cuda.Function,
+    mass_pack: cuda.Function,
+    greedy_part: cuda.Function,
+    greedy_pick: cuda.Function,
+    l2pf: cuda.Function,
+    media_rows: cuda.Function,
+    pub fn load(ctx: *const cuda.Context) !Ops {
+        var base = try shared.Ops.load(ctx);
+        errdefer base.deinit();
+        var m = try cuda.Module.load(ctx.d, cuda.kernels.glm_ops);
+        errdefer m.unload();
+        return .{ .module = m, .base = base, .sort = try m.function("glm_sort"), .pack = try m.function("glm_pack"), .index_copy = try m.function("glm_index_copy"), .rotary = try m.function("glm_rotary"), .ring = try m.function("glm_ring"), .rank_add = try m.function("glm_rank_add"), .int_add = try m.function("glm_int_add"), .scaled_max = try m.function("glm_scaled_max"), .mass_pack = try m.function("glm_mass_pack"), .greedy_part = try m.function("glm_greedy_part"), .greedy_pick = try m.function("glm_greedy_pick"), .l2pf = try m.function("glm_l2pf"), .media_rows = try m.function("glm_media_rows") };
+    }
+    pub fn deinit(o: *Ops) void {
+        o.module.unload();
+        o.base.deinit();
+    }
+    pub fn on(o: *const Ops, s: cuda.Stream) Torch {
+        return .{ .ops = o, .s = s, .base = o.base.on(s) };
+    }
+};
+pub const Torch = struct {
+    ops: *const Ops,
+    s: cuda.Stream,
+    base: shared.Torch,
+    fn go(t: Torch, f: cuda.Function, rows: usize, args: *cuda.Args) !void {
+        if (rows == 0) return;
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, t.s, args);
+    }
+    /// Selection membership follows the existing radix compaction. Sorted equal-value
+    /// permutations are not yet qualified against ATen (host draws lexsort by id).
+    pub fn topkSorted(t: Torch, input: u64, columns: usize, rows: usize, k: usize, vals: u64, ids: u64, scratch: u64) !void {
+        if (k == 0 or k > columns or k > 16384 or rows > 65535) return error.TopkShape;
+        try t.base.topk(input, columns, rows, k, vals, ids, scratch);
+        var a: cuda.Args = .{};
+        a.add(vals);
+        a.add(ids);
+        a.add(@as(u32, @intCast(k)));
+        try t.go(t.ops.sort, rows, &a);
+    }
+    /// Greedy top-1 of `rows` rows of bf16 logits (`columns` wide, contiguous) packed [value | int32 id] per row into `out`
+    /// (2 words a row): what to_f32 + topkSorted(k=1) + pack write. Two launches: 16 blocks a row leave their best in `part`
+    /// (greedy_split * 2 words a row), then one warp a row picks among them.
+    pub fn greedyPick(t: Torch, logits: u64, part: u64, out: u64, rows: usize, columns: usize, offset: i64) !void {
+        if (columns == 0 or columns > std.math.maxInt(u32) or rows > 65535) return error.TopkShape;
+        if (rows == 0) return;
+        var a: cuda.Args = .{};
+        a.add(logits);
+        a.add(part);
+        a.add(@as(u64, columns));
+        try cuda.launch.launch(t.ops.greedy_part, .{ .grid = .{ .x = greedy_split, .y = @intCast(rows) }, .block = .{ .x = 256 } }, t.s, &a);
+        var b: cuda.Args = .{};
+        b.add(logits);
+        b.add(part);
+        b.add(out);
+        b.add(@as(u64, columns));
+        b.add(offset);
+        try cuda.launch.launch(t.ops.greedy_pick, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 32 } }, t.s, &b);
+    }
+    pub fn pack(t: Torch, vals: u64, ids: u64, out: u64, rows: usize, k: usize, offset: i64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ vals, ids, out }) |x| a.add(x);
+        a.add(@as(u32, @intCast(k)));
+        a.add(offset);
+        try t.go(t.ops.pack, rows, &a);
+    }
+    pub fn indexCopy(t: Torch, src: u64, dst: u64, ids: u64, rows: usize, dest_rows: usize, inner_bytes: usize, outer: usize, invalid: u64) !void {
+        if (rows == 0 or outer == 0 or inner_bytes == 0) return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ src, dst, ids, rows, dest_rows, inner_bytes, outer, invalid }) |x| a.add(x);
+        try cuda.launch.launch(t.ops.index_copy, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(@min(outer, 65535)) }, .block = .{ .x = 256 } }, t.s, &a);
+    }
+    pub fn rotary(t: Torch, pos: u64, inv: u64, cos: u64, sin: u64, rows: usize, half: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ pos, inv, cos, sin, rows, half }) |x| a.add(x);
+        if (rows * half != 0) try t.go(t.ops.rotary, blocks(rows * half), &a);
+    }
+    pub fn ring(t: Torch, pos: u64, slots: u64, out: u64, rows: usize, cap: i64) !void {
+        if (cap <= 0) return error.BadRing;
+        var a: cuda.Args = .{};
+        for ([_]u64{ pos, slots, out, rows }) |x| a.add(x);
+        a.add(cap);
+        if (rows != 0) try t.go(t.ops.ring, blocks(rows), &a);
+    }
+    pub fn intAdd(t: Torch, src: u64, dst: u64, count: usize, value: i64, bytes: usize) !void {
+        if (bytes != 4 and bytes != 8) return error.BadIntegerType;
+        var a: cuda.Args = .{};
+        for ([_]u64{ src, dst, count }) |x| a.add(x);
+        a.add(value);
+        a.add(@as(u32, @intCast(bytes)));
+        if (count != 0) try t.go(t.ops.int_add, blocks(count), &a);
+    }
+    pub fn rankAdd(t: Torch, ranks: u64, out: u64, count: usize, world: usize) !void {
+        if (world < 1 or world > 4) return error.UnsupportedTp;
+        var a: cuda.Args = .{};
+        for ([_]u64{ ranks, out, count }) |x| a.add(x);
+        a.add(@as(u32, @intCast(world)));
+        if (count != 0) try t.go(t.ops.rank_add, blocks(count), &a);
+    }
+    pub fn scaledMax(t: Torch, logits: u64, out: u64, rows: usize, columns: usize, temp: f64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ logits, out, columns }) |x| a.add(x);
+        a.add(temp);
+        try t.go(t.ops.scaled_max, rows, &a);
+    }
+    /// Feature rows `rows[i]` (absolute prompt rows, u32 on the device) over the chunk starting at `pos`: x is the
+    /// chunk's [rows, streams * width] bf16 hidden state, `feats` bf16 [count, width].
+    pub fn mediaRows(t: Torch, rows: u64, feats: u64, x: u64, count: usize, pos: usize, width: usize, streams: usize) !void {
+        if (count == 0) return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ rows, feats, x }) |v| a.add(v);
+        a.add(@as(u32, @intCast(pos)));
+        a.add(@as(u32, @intCast(width)));
+        a.add(@as(u32, @intCast(streams)));
+        try t.go(t.ops.media_rows, count, &a);
+    }
+    pub fn massPack(t: Torch, vals: u64, ids: u64, mass: u64, sums: u64, out: u64, rows: usize, columns: usize, selected: usize, count: usize, offset: i64, temp: f64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ vals, ids, mass, sums, out, columns }) |x| a.add(x);
+        a.add(@as(u32, @intCast(selected)));
+        a.add(@as(u32, @intCast(count)));
+        a.add(offset);
+        a.add(temp);
+        try t.go(t.ops.mass_pack, rows, &a);
+    }
+};
+fn blocks(n: usize) usize {
+    return @min((n + 255) / 256, 65535);
+}
+test "analyze GLM launch ABI without a device" {
+    _ = Ops.load;
+    _ = Torch.topkSorted;
+    _ = Torch.pack;
+    _ = Torch.greedyPick;
+    _ = Torch.indexCopy;
+    _ = Torch.rotary;
+    _ = Torch.ring;
+    _ = Torch.rankAdd;
+    _ = Torch.intAdd;
+    _ = Torch.scaledMax;
+    _ = Torch.massPack;
+    _ = Torch.mediaRows;
+}
