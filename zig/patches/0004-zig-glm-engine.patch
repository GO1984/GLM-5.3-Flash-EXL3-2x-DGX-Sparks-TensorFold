new file mode 100644
index 00000000..c126e2ff
--- /dev/null
+++ b/zig/src/families/glm_cuda/glm_cuda.zig
@@ -0,0 +1,13 @@
+//! GLM-5.3-Flash on CUDA in Zig: config, EXL3 weight-loading plan and TP layouts matching the Python
+//! glm5_next CUDA engine (families/glm5_next/cuda/weights.py, split.py, tp.py). No GPU upload yet.
+
+pub const config = @import("cuda_config.zig");
+pub const layouts = @import("cuda_layouts.zig");
+pub const weights = @import("cuda_weights.zig");
+
+test {
+    _ = config;
+    _ = layouts;
+    _ = weights;
+    _ = @import("plan_test.zig");
+}
diff --git a/zig/src/families/glm_cuda/p9_test.zig b/zig/src/families/glm_cuda/p9_test.zig
new file mode 100644
index 00000000..4289c35a
--- /dev/null
+++ b/zig/src/families/glm_cuda/p9_test.zig
@@ -0,0 +1,142 @@
+//! CPU oracles from TensorFold dflash2.py:Drafter.chain and copy_drafts.py.
+const std = @import("std");
+const policy = @import("cuda_draft_policy.zig");
+const Copy = @import("cuda_copy_drafts.zig").Copy;
+fn number(v: std.json.Value) f64 {
+    return switch (v) {
+        .float => v.float,
+        .integer => @floatFromInt(v.integer),
+        else => unreachable,
+    };
+}
+fn floats(v: std.json.Value, out: []f32) void {
+    for (v.array.items, out) |x, *y| y.* = @floatCast(number(x));
+}
+fn ids(v: std.json.Value, out: []u32) void {
+    for (v.array.items, out) |x, *y| y.* = @intFromFloat(number(x));
+}
+fn get(v: std.json.Value, key: []const u8) std.json.Value {
+    return v.object.get(key).?;
+}
+test "32 Python fnc chains, keyed noise, selector edges and cost cutoffs" {
+    const parsed = try std.json.parseFromSlice(std.json.Value, std.testing.allocator, @embedFile("fixtures_p9.json"), .{});
+    defer parsed.deinit();
+    const root = parsed.value;
+    var pred: [32 * 3]f32 = undefined;
+    var succ: [32 * 3]f32 = undefined;
+    floats(get(root, "pred"), &pred);
+    floats(get(root, "succ"), &succ);
+    for (get(root, "chains").array.items) |c| {
+        var cs: [7 * 16]policy.Candidate = undefined;
+        for (&cs, get(c, "ids").array.items, get(c, "values").array.items) |*cand, id, val| cand.* = .{ .id = @intFromFloat(number(id)), .value = number(val) };
+        var proj: [7 * 3]f32 = undefined;
+        floats(get(c, "projection"), &proj);
+        var costs: [8]f64 = undefined;
+        const cost = get(c, "costs");
+        if (cost != .null) for (cost.array.items, &costs) |x, *y| {
+            y.* = number(x);
+        };
+        var out: [7]u32 = undefined;
+        const n = try policy.chain(&cs, &proj, .{ .pred = &pred, .succ = &succ, .rank = 3 }, @intFromFloat(number(get(c, "anchor"))), @intFromFloat(number(get(c, "first"))), .{ .seed = @intFromFloat(number(get(c, "seed"))), .temperature = number(get(c, "temperature")) }, .{ .threshold = number(get(c, "threshold")) }, &out, if (cost == .null) null else &costs);
+        const want = get(c, "want");
+        var expected: [7]u32 = undefined;
+        ids(want, expected[0..want.array.items.len]);
+        try std.testing.expectEqualSlices(u32, expected[0..want.array.items.len], out[0..n]);
+    }
+}
+test "32 Python prompt lookup transcripts including partial keeps and reply match" {
+    const parsed = try std.json.parseFromSlice(std.json.Value, std.testing.allocator, @embedFile("fixtures_p9.json"), .{});
+    defer parsed.deinit();
+    for (get(parsed.value, "copies").array.items) |case| {
+        var initial: [32]u32 = undefined;
+        ids(get(case, "context"), &initial);
+        var c = try Copy.init(std.testing.allocator, &initial, .{ .reply_match = @intFromFloat(number(get(case, "reply"))), .miss_most = @intFromFloat(number(get(case, "miss"))) });
+        defer c.deinit();
+        var out: [15]u32 = undefined;
+        for (get(case, "actions").array.items) |act| {
+            const got = c.propose(out[0..@intFromFloat(number(get(act, "room")))]);
+            const want = get(act, "want");
+            var expected: [15]u32 = undefined;
+            ids(want, expected[0..want.array.items.len]);
+            try std.testing.expectEqualSlices(u32, expected[0..want.array.items.len], got);
+            const draws = get(act, "draws");
+            var tokens: [16]u32 = undefined;
+            ids(draws, tokens[0..draws.array.items.len]);
+            try c.extend(tokens[0..draws.array.items.len]);
+        }
+    }
+}
+test "arbitrary proposed drafts preserve the serial target draws through P7 acceptance" {
+    const rounds = @import("cuda_rounds.zig");
+    var rng = std.Random.DefaultPrng.init(77);
+    const random = rng.random();
+    for (0..100) |_| {
+        var pos: usize = 0;
+        while (pos < 100) {
+            var input: [16]u32 = undefined;
+            var draws: [16]u32 = undefined;
+            const rows = @min(100 - pos, 16);
+            input[0] = @intCast(pos);
+            for (0..rows) |i| {
+                draws[i] = @intCast(pos + i + 1);
+                if (i > 0) input[i] = if (random.boolean()) @intCast(pos + i) else 999;
+            }
+            const keep = try rounds.accept(input[0..rows], draws[0..rows], &.{});
+            for (draws[0..keep], 0..) |draw, i| try std.testing.expectEqual(@as(u32, @intCast(pos + i + 1)), draw);
+            pos += keep;
+        }
+    }
+}
+test "Tri DFlash2 reference signatures cover KV-group ranks and tap buckets" {
+    const tr = @import("cuda_triton.zig");
+    const Rank = @import("cuda_dflash_config.zig").Rank;
+    for (1..5) |world| for (0..world) |rank| {
+        const g = try Rank.init(world, rank);
+        var rec: tr.Recorder = .{};
+        const t: tr.Tri = .{ .rec = &rec };
+        try t.draftConv(16, 32, 48, null, 64, 8, 0, 8);
+        try t.draftConv(16, 32, 48, 80, 64, 8, 1, 8);
+        try t.draftPrep(16, 32, 48, 64, 80, 96, 112, 128, 8, g.heads, g.kv, 1e-5);
+        try t.draftPrep(16, 32, 48, 64, 80, 96, 112, 128, 64, 0, g.kv, 1e-5);
+        try t.draftAttention(16, 32, 48, 64, 80, 96, 3, g.heads, g.kv, 3 * 2176 + 64);
+        const attn = rec.launches[4];
+        try std.testing.expectEqual(@as([3]u32, .{ 8, @intCast(g.heads + 2 * g.kv), 1 }), rec.launches[2].grid);
+        try std.testing.expectEqual(@as([3]u32, .{ @intCast(g.kv), 3, 1 }), attn.grid);
+        try std.testing.expectEqualStrings("L", attn.args[8].name);
+        try std.testing.expectEqual(@as(i32, 24), attn.args[8].value.i32);
+        try std.testing.expectEqual(@as(?i64, 2176), attn.consts[4].int);
+        try std.testing.expectEqual(@as(?i64, @intCast(g.heads / g.kv)), attn.consts[1].int);
+        try std.testing.expectEqual(@as(?i64, 1), rec.launches[1].consts[4].int);
+        try std.testing.expectEqual(@as(i32, 64), rec.launches[3].args[8].value.i32);
+        rec.n = 0;
+    };
+}
+test "DFlash checkpoint config accepts shipped geometry and rejects causal change" {
+    const cfg = @import("cuda_dflash_config.zig").Config;
+    const json = @embedFile("fixtures_dflash_config.json");
+    const c = try cfg.parse(std.testing.allocator, json);
+    try std.testing.expectEqual(@as(u32, 154856), c.mask);
+    const changed = try std.mem.replaceOwned(u8, std.testing.allocator, json, "\"is_causal\": false", "\"is_causal\": true");
+    defer std.testing.allocator.free(changed);
+    try std.testing.expectError(error.UnsupportedDraftConfig, cfg.parse(std.testing.allocator, changed));
+}
+test "lane adapter compiles E.DraftReq and validates requests before device work" {
+    const df = @import("cuda_dflash.zig");
+    const Toy = struct {
+        pub const Req = struct { seq: usize, next: []const u32, count: usize, sampling: ?policy.Sampling = null, out: []u32, drafted: usize = 0 };
+        pub fn draftSlot(_: *@This(), seq: usize) !usize {
+            return seq;
+        }
+        fn adapt(m: *df.Multi, e: *@This(), qs: []Req) !void {
+            try df.draftMany(m, e, qs);
+        }
+    };
+    std.mem.doNotOptimizeAway(&Toy.adapt);
+    var engine: Toy = .{};
+    var m: df.Multi = undefined;
+    var empty: [0]Toy.Req = .{};
+    try std.testing.expectError(error.BadDraftStreams, Toy.adapt(&m, &engine, &empty));
+    var out: [7]u32 = undefined;
+    var req = [_]Toy.Req{.{ .seq = 0, .next = &.{}, .count = 7, .out = &out }};
+    try std.testing.expectError(error.BadDraftRequest, Toy.adapt(&m, &engine, &req));
+}
diff --git a/zig/src/families/glm_cuda/plan_test.zig b/zig/src/families/glm_cuda/plan_test.zig
new file mode 100644
index 00000000..56cf8c9c
--- /dev/null
+++ b/zig/src/families/glm_cuda/plan_test.zig
@@ -0,0 +1,136 @@
+//! Compare the Zig EXL3 weight plan against tools/zig/glm_weight_plan.py's JSON fixture (the Python
+//! engine's split rules, computed from safetensors JSON headers only).
+const std = @import("std");
+const cfgs = @import("cuda_config.zig");
+const lay = @import("cuda_layouts.zig");
+const W = @import("cuda_weights.zig");
+
+const fixture_text = @embedFile("fixtures_weight_plan.json");
+const io = std.testing.io;
+
+fn asInt(v: std.json.Value) i64 {
+    return switch (v) {
+        .integer => |i| i,
+        .float => |f| @intFromFloat(f),
+        else => 0,
+    };
+}
+
+fn asU32(v: std.json.Value) u32 {
+    return @intCast(asInt(v));
+}
+
+fn asU64(v: std.json.Value) u64 {
+    return @intCast(asInt(v));
+}
+
+test "fixture shares match Layout.split_sizes and draft_parts" {
+    const parsed = try std.json.parseFromSlice(std.json.Value, std.testing.allocator, fixture_text, .{});
+    defer parsed.deinit();
+    const root = parsed.value.object;
+    const cfg_o = root.get("config").?.object;
+    var why: cfgs.Why = .{};
+    var cfg = try cfgs.parse(std.testing.allocator, @embedFile("fixtures_config.json"), @embedFile("fixtures_generation_config.json"), .{ .assistant_end = 154828 }, &why);
+    defer cfg.deinit();
+    try std.testing.expectEqual(asU32(cfg_o.get("hidden").?), cfg.hidden);
+    try std.testing.expectEqual(asU32(cfg_o.get("layers").?), cfg.layers);
+    try std.testing.expectEqual(asU32(cfg_o.get("vocab").?), cfg.vocab);
+    try std.testing.expectEqual(asU32(cfg_o.get("heads").?), cfg.heads);
+    try std.testing.expectEqual(asU32(cfg_o.get("moe_width").?), cfg.moe_width);
+    try std.testing.expectEqual(asU32(cfg_o.get("experts").?), cfg.experts);
+    try std.testing.expectEqual(cfgs.Quant.exl3, cfg.quant);
+
+    const shares = root.get("shares").?.object;
+    inline for (.{ 1, 2, 3, 4 }) |world| {
+        const wobj = shares.get(std.fmt.comptimePrint("{d}", .{world})).?.object;
+        const layout = try lay.Layout.fromConfig(&cfg, 0, world);
+        var buf: [8]u32 = undefined;
+        inline for (.{ .heads, .lin, .dense, .moe, .shared, .vocab }) |fam| {
+            const got = try layout.sizes(fam, &buf);
+            const want = wobj.get(@tagName(fam)).?.array.items;
+            try std.testing.expectEqual(want.len, got.len);
+            for (want, got) |wv, gv| try std.testing.expectEqual(asU32(wv), gv);
+        }
+        if (wobj.get("dflash_q")) |q| {
+            var qs: [8]u32 = undefined;
+            var kvs: [8]u32 = undefined;
+            var mlps: [8]u32 = undefined;
+            try lay.draftParts(32, 8, 12288, world, &qs, &kvs, &mlps);
+            for (q.array.items, 0..) |wv, i| try std.testing.expectEqual(asU32(wv), qs[i]);
+            for (wobj.get("dflash_kv").?.array.items, 0..) |wv, i| try std.testing.expectEqual(asU32(wv), kvs[i]);
+            for (wobj.get("dflash_mlp").?.array.items, 0..) |wv, i| try std.testing.expectEqual(asU32(wv), mlps[i]);
+        }
+    }
+}
+
+test "Zig plan matches the Python fixture against the real checkpoint headers" {
+    const parsed = try std.json.parseFromSlice(std.json.Value, std.testing.allocator, fixture_text, .{});
+    defer parsed.deinit();
+    const root = parsed.value.object;
+    const ckpt = root.get("checkpoint").?.string;
+    std.Io.Dir.cwd().access(io, ckpt, .{}) catch return error.SkipZigTest;
+    const dflash_v = root.get("dflash2").?;
+    const dflash: ?[]const u8 = if (dflash_v == .string) dflash_v.string else null;
+
+    var why: cfgs.Why = .{};
+    var cfg = try cfgs.Config.read(std.testing.allocator, io, ckpt, .{}, &why);
+    defer cfg.deinit();
+    try cfg.check(&why);
+
+    var cat = try W.loadCatalog(std.testing.allocator, io, ckpt, dflash);
+    defer cat.deinit();
+
+    const ranks = root.get("ranks").?.object;
+    inline for (.{ 1, 2, 3, 4 }) |world| {
+        const wkey = std.fmt.comptimePrint("{d}", .{world});
+        const want_ranks = ranks.get(wkey).?.array.items;
+        for (want_ranks, 0..) |wr, r| {
+            const wo = wr.object;
+            var p = try W.plan(std.testing.allocator, &cfg, &cat, .{ .rank = @intCast(r), .world = world, .dflash2_dir = dflash });
+            defer p.deinit();
+            try std.testing.expectEqual(asU32(wo.get("count").?), @as(u32, @intCast(p.items.items.len)));
+            try std.testing.expectEqual(asU32(wo.get("dropped").?), p.dropped);
+            try std.testing.expectEqual(asU64(wo.get("file_bytes").?), p.file_bytes);
+            try std.testing.expectEqual(asU64(wo.get("device_bytes").?), p.device_bytes);
+            var hex: [64]u8 = undefined;
+            try std.testing.expectEqualStrings(wo.get("sha256").?.string, p.hex(&hex));
+        }
+    }
+
+    const sample = root.get("sample").?.array.items;
+    var last_world: u32 = 0;
+    var last_rank: u32 = 0;
+    var plan_hold: ?W.Plan = null;
+    defer if (plan_hold) |*p| p.deinit();
+    for (sample) |sv| {
+        const so = sv.object;
+        const world = asU32(so.get("world").?);
+        const rank = asU32(so.get("rank").?);
+        if (plan_hold == null or world != last_world or rank != last_rank) {
+            if (plan_hold) |*p| p.deinit();
+            plan_hold = try W.plan(std.testing.allocator, &cfg, &cat, .{ .rank = rank, .world = world, .dflash2_dir = dflash });
+            last_world = world;
+            last_rank = rank;
+        }
+        const name = so.get("name").?.string;
+        const it = W.find(&plan_hold.?, name) orelse {
+            std.debug.print("missing sample {s} tp={d} rank={d}\n", .{ name, world, rank });
+            return error.MissingSample;
+        };
+        try std.testing.expectEqualStrings(so.get("file").?.string, it.src.file);
+        try std.testing.expectEqual(asU64(so.get("file_begin").?), it.slice.file_begin);
+        try std.testing.expectEqual(asU64(so.get("file_end").?), it.slice.file_end);
+        try std.testing.expectEqual(asU64(so.get("device_offset").?), it.device_offset);
+        try std.testing.expectEqualStrings(so.get("dtype").?.string, it.src.dtype);
+        try std.testing.expectEqualStrings(so.get("kind").?.string, it.slice.kind.text());
+        var slbuf: [64]u8 = undefined;
+        try std.testing.expectEqualStrings(so.get("slice").?.string, it.slice.text(&slbuf));
+        try std.testing.expectEqualStrings(so.get("device_dtype").?.string, it.slice.device_dtype);
+        const want_shape = so.get("shape").?.array.items;
+        try std.testing.expectEqual(want_shape.len, it.slice.rank);
+        for (want_shape, 0..) |d, i| try std.testing.expectEqual(asU32(d), it.slice.shape[i]);
+        const want_ds = so.get("device_shape").?.array.items;
+        try std.testing.expectEqual(want_ds.len, it.slice.device_rank);
+        for (want_ds, 0..) |d, i| try std.testing.expectEqual(asU32(d), it.slice.device_shape[i]);
+    }
+}
