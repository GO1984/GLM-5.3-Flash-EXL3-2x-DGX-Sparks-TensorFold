+//! The tower's two convolutions through cuDNN's backend (graph) API, called the way PyTorch 2.13 calls it, so that cuDNN's
+//! heuristics pick the kernel PyTorch's `F.conv3d` / `F.conv2d` run -- and with it the accumulation order, which varies
+//! with the number of rows (split-K for some, plain chains for others) and cannot be reproduced by one fixed kernel.
+//!
+//! PyTorch (aten/src/ATen/native/cudnn/Conv_v8.cpp) builds, per call shape: tensor descriptors (data type bf16, the dims
+//! and strides of the tensors it passes, byte alignment 32), a convolution descriptor (fp32 compute, cross-correlation),
+//! a forward-convolution operation (alpha 1, beta 0), an operation graph, asks the INSTANT heuristic for engine
+//! configurations, builds an execution plan for the first and runs it with a variant pack. cuDNN's own API trace
+//! (CUDNN_LOGINFO_DBG) shows exactly these calls for the shapes of the tower; this file issues the same ones. The
+//! convolution's bias is not part of the cuDNN call: torch adds it in a separate bf16 add (see vis_bias_add).
+//!
+//! libcudnn.so.9 is opened at run time like cuBLASLt (the Zig side has no build dependency on it).
+
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Error = error{ LibraryUnavailable, MissingSymbol, CudnnFailed, NoPlan, Invalid, OutOfMemory };
+
+const Status = c_int;
+const Handle = ?*anyopaque;
+const Desc = ?*anyopaque;
+
+// cudnn_graph_v9.h values
+const T_HANDLE: c_int = 0;
+const T_DATA_TYPE: c_int = 1;
+const T_INT64: c_int = 3;
+const T_FLOAT: c_int = 4;
+const T_VOID_PTR: c_int = 6;
+const T_CONV_MODE: c_int = 7;
+const T_HEUR_MODE: c_int = 8;
+const T_DESC: c_int = 15;
+
+const D_CONV: c_int = 1;
+const D_ENGINE: c_int = 2;
+const D_ENGINECFG: c_int = 3;
+const D_HEUR: c_int = 4;
+const D_PLAN: c_int = 5;
+const D_OP_CONV_FWD: c_int = 10;
+const D_GRAPH: c_int = 15;
+const D_VARPACK: c_int = 16;
+const D_TENSOR: c_int = 17;
+
+const A_TENSOR_ALIGN: c_int = 900;
+const A_TENSOR_DTYPE: c_int = 901;
+const A_TENSOR_DIMS: c_int = 902;
+const A_TENSOR_STRIDES: c_int = 903;
+const A_TENSOR_UID: c_int = 906;
+const A_CONV_COMP: c_int = 100;
+const A_CONV_MODE: c_int = 101;
+const A_CONV_DILATIONS: c_int = 102;
+const A_CONV_FSTRIDES: c_int = 103;
+const A_CONV_POST: c_int = 104;
+const A_CONV_PRE: c_int = 105;
+const A_CONV_SPATIAL: c_int = 106;
+const A_OP_ALPHA: c_int = 700;
+const A_OP_BETA: c_int = 701;
+const A_OP_CONV: c_int = 702;
+const A_OP_W: c_int = 703;
+const A_OP_X: c_int = 704;
+const A_OP_Y: c_int = 705;
+const A_GRAPH_HANDLE: c_int = 800;
+const A_GRAPH_OPS: c_int = 801;
+const A_HEUR_MODE: c_int = 200;
+const A_HEUR_GRAPH: c_int = 201;
+const A_HEUR_RESULTS: c_int = 202;
+const A_CFG_ENGINE: c_int = 300;
+const A_ENGINE_INDEX: c_int = 1301;
+const A_PLAN_CFG: c_int = 401;
+const A_PLAN_WORKSPACE: c_int = 402;
+const A_VP_UIDS: c_int = 1000;
+const A_VP_PTRS: c_int = 1001;
+const A_VP_WORKSPACE: c_int = 1003;
+
+const data_bf16: c_int = 9;
+const data_f32: c_int = 0;
+const cross_correlation: c_int = 1;
+const heur_instant: c_int = 0;
+
+const Api = struct {
+    cudnnCreate: *const fn (*Handle) callconv(.c) Status,
+    cudnnDestroy: *const fn (Handle) callconv(.c) Status,
+    cudnnSetStream: *const fn (Handle, cuda.abi.Stream) callconv(.c) Status,
+    cudnnGetVersion: *const fn () callconv(.c) usize,
+    cudnnBackendCreateDescriptor: *const fn (c_int, *Desc) callconv(.c) Status,
+    cudnnBackendDestroyDescriptor: *const fn (Desc) callconv(.c) Status,
+    cudnnBackendSetAttribute: *const fn (Desc, c_int, c_int, i64, ?*const anyopaque) callconv(.c) Status,
+    cudnnBackendGetAttribute: *const fn (Desc, c_int, c_int, i64, *i64, ?*anyopaque) callconv(.c) Status,
+    cudnnBackendFinalize: *const fn (Desc) callconv(.c) Status,
+    cudnnBackendExecute: *const fn (Handle, Desc, Desc) callconv(.c) Status,
+};
+
+/// A convolution as PyTorch describes it to cuDNN: x [N, C, spatial...], w [K, C, filter...], y [N, K, 1...].
+pub const Spec = struct {
+    rank: u8, // 5 (conv3d) or 4 (conv2d)
+    xdims: [5]i64,
+    xstr: [5]i64,
+    wdims: [5]i64,
+    wstr: [5]i64,
+    ydims: [5]i64,
+    ystr: [5]i64,
+    fstride: [3]i64,
+
+    /// conv3d patch embedding: [rows, 3, 2, 14, 14] * [1024, 3, 2, 14, 14], stride (2, 14, 14), contiguous tensors.
+    pub fn embed(rows: usize) Spec {
+        const r: i64 = @intCast(rows);
+        return .{ .rank = 5, .xdims = .{ r, 3, 2, 14, 14 }, .xstr = .{ 1176, 392, 196, 14, 1 }, .wdims = .{ 1024, 3, 2, 14, 14 }, .wstr = .{ 1176, 392, 196, 14, 1 }, .ydims = .{ r, 1024, 1, 1, 1 }, .ystr = .{ 1024, 1, 1, 1, 1 }, .fstride = .{ 2, 14, 14 } };
+    }
+    /// conv2d downsample: channels-last [rows, 1024, 2, 2] * channels-last [4096, 1024, 2, 2], stride 2.
+    pub fn downsample(rows: usize) Spec {
+        const r: i64 = @intCast(rows);
+        return .{ .rank = 4, .xdims = .{ r, 1024, 2, 2, 1 }, .xstr = .{ 4096, 1, 2048, 1024, 1 }, .wdims = .{ 4096, 1024, 2, 2, 1 }, .wstr = .{ 4096, 1, 2048, 1024, 1 }, .ydims = .{ r, 4096, 1, 1, 1 }, .ystr = .{ 4096, 1, 4096, 4096, 1 }, .fstride = .{ 2, 2, 1 } };
+    }
+};
+
+pub const Plan = struct {
+    plan: Desc,
+    workspace: usize,
+    engine: i64,
+    spec: Spec,
+};
+
+pub const Cudnn = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    lib: std.DynLib,
+    api: Api,
+    handle: Handle,
+    plans: std.AutoHashMapUnmanaged(Key, Plan) = .empty,
+    workspace: ?cuda.DeviceBuffer = null,
+    keep: std.ArrayList(Desc) = .empty, // graphs, heuristics and configurations the plans refer to
+    version: usize,
+
+    const Key = struct { rank: u8, rows: i64 };
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream) Error!Cudnn {
+        var self: Cudnn = undefined;
+        self.gpa = gpa;
+        self.d = d;
+        self.plans = .empty;
+        self.keep = .empty;
+        self.workspace = null;
+        self.lib = std.DynLib.open("libcudnn.so.9") catch std.DynLib.open("libcudnn.so") catch return error.LibraryUnavailable;
+        errdefer self.lib.close();
+        inline for (@typeInfo(Api).@"struct".field_names, @typeInfo(Api).@"struct".field_types) |name, T| {
+            @field(self.api, name) = self.lib.lookup(T, name) orelse return error.MissingSymbol;
+        }
+        self.version = self.api.cudnnGetVersion();
+        if (self.api.cudnnCreate(&self.handle) != 0) return error.CudnnFailed;
+        errdefer _ = self.api.cudnnDestroy(self.handle);
+        if (self.api.cudnnSetStream(self.handle, stream.handle) != 0) return error.CudnnFailed;
+        return self;
+    }
+
+    pub fn deinit(self: *Cudnn) void {
+        var it = self.plans.valueIterator();
+        while (it.next()) |p| _ = self.api.cudnnBackendDestroyDescriptor(p.plan);
+        self.plans.deinit(self.gpa);
+        for (self.keep.items) |k| _ = self.api.cudnnBackendDestroyDescriptor(k);
+        self.keep.deinit(self.gpa);
+        if (self.workspace) |*w| w.free();
+        _ = self.api.cudnnDestroy(self.handle);
+        self.lib.close();
+        self.* = undefined;
+    }
+
+    fn ck(self: *const Cudnn, s: Status, what: []const u8) Error!void {
+        _ = self;
+        if (s == 0) return;
+        std.log.err("cuDNN {s}: status {d}", .{ what, s });
+        return error.CudnnFailed;
+    }
+
+    fn create(self: *Cudnn, kind: c_int) Error!Desc {
+        var d: Desc = null;
+        try self.ck(self.api.cudnnBackendCreateDescriptor(kind, &d), "create descriptor");
+        return d;
+    }
+    fn destroy(self: *Cudnn, d: Desc) void {
+        _ = self.api.cudnnBackendDestroyDescriptor(d);
+    }
+    fn set(self: *Cudnn, d: Desc, attr: c_int, ty: c_int, count: i64, p: anytype) Error!void {
+        const ptr: ?*const anyopaque = @ptrCast(p);
+        try self.ck(self.api.cudnnBackendSetAttribute(d, attr, ty, count, ptr), "set attribute");
+    }
+    fn fin(self: *Cudnn, d: Desc) Error!void {
+        try self.ck(self.api.cudnnBackendFinalize(d), "finalize");
+    }
+
+    fn tensor(self: *Cudnn, dims: []const i64, strides: []const i64, uid: i64) Error!Desc {
+        const t = try self.create(D_TENSOR);
+        errdefer self.destroy(t);
+        const dt: c_int = data_bf16;
+        const align_: i64 = 32;
+        try self.set(t, A_TENSOR_DTYPE, T_DATA_TYPE, 1, &dt);
+        try self.set(t, A_TENSOR_DIMS, T_INT64, @intCast(dims.len), dims.ptr);
+        try self.set(t, A_TENSOR_STRIDES, T_INT64, @intCast(strides.len), strides.ptr);
+        try self.set(t, A_TENSOR_UID, T_INT64, 1, &uid);
+        try self.set(t, A_TENSOR_ALIGN, T_INT64, 1, &align_);
+        try self.fin(t);
+        return t;
+    }
+
+    const uid_x: i64 = 120;
+    const uid_w: i64 = 119;
+    const uid_y: i64 = 121;
+
+    /// The plan for a convolution shape, built once (graph, INSTANT heuristic, first configuration that builds).
+    pub fn plan(self: *Cudnn, spec: Spec) Error!*Plan {
+        const key: Key = .{ .rank = spec.rank, .rows = spec.xdims[0] };
+        if (self.plans.getPtr(key)) |p| return p;
+        const n: usize = spec.rank;
+        const nsp: usize = n - 2;
+        const x = try self.tensor(spec.xdims[0..n], spec.xstr[0..n], uid_x);
+        defer self.destroy(x);
+        const y = try self.tensor(spec.ydims[0..n], spec.ystr[0..n], uid_y);
+        defer self.destroy(y);
+        const w = try self.tensor(spec.wdims[0..n], spec.wstr[0..n], uid_w);
+        defer self.destroy(w);
+
+        const conv = try self.create(D_CONV);
+        defer self.destroy(conv);
+        {
+            const comp: c_int = data_f32;
+            const mode: c_int = cross_correlation;
+            const sp: i64 = @intCast(nsp);
+            const zeros = [3]i64{ 0, 0, 0 };
+            const ones = [3]i64{ 1, 1, 1 };
+            try self.set(conv, A_CONV_COMP, T_DATA_TYPE, 1, &comp);
+            try self.set(conv, A_CONV_MODE, T_CONV_MODE, 1, &mode);
+            try self.set(conv, A_CONV_SPATIAL, T_INT64, 1, &sp);
+            try self.set(conv, A_CONV_PRE, T_INT64, @intCast(nsp), &zeros);
+            try self.set(conv, A_CONV_POST, T_INT64, @intCast(nsp), &zeros);
+            try self.set(conv, A_CONV_DILATIONS, T_INT64, @intCast(nsp), &ones);
+            try self.set(conv, A_CONV_FSTRIDES, T_INT64, @intCast(nsp), &spec.fstride);
+            try self.fin(conv);
+        }
+        const op = try self.create(D_OP_CONV_FWD);
+        defer self.destroy(op);
+        {
+            const one: f32 = 1;
+            const zero: f32 = 0;
+            try self.set(op, A_OP_X, T_DESC, 1, &x);
+            try self.set(op, A_OP_W, T_DESC, 1, &w);
+            try self.set(op, A_OP_Y, T_DESC, 1, &y);
+            try self.set(op, A_OP_CONV, T_DESC, 1, &conv);
+            try self.set(op, A_OP_ALPHA, T_FLOAT, 1, &one);
+            try self.set(op, A_OP_BETA, T_FLOAT, 1, &zero);
+            try self.fin(op);
+        }
+        const graph = try self.create(D_GRAPH);
+        try self.keep.append(self.gpa, graph);
+        {
+            try self.set(graph, A_GRAPH_OPS, T_DESC, 1, &op);
+            try self.set(graph, A_GRAPH_HANDLE, T_HANDLE, 1, &self.handle);
+            try self.fin(graph);
+        }
+        const heur = try self.create(D_HEUR);
+        try self.keep.append(self.gpa, heur);
+        {
+            const mode: c_int = heur_instant;
+            try self.set(heur, A_HEUR_GRAPH, T_DESC, 1, &graph);
+            try self.set(heur, A_HEUR_MODE, T_HEUR_MODE, 1, &mode);
+            try self.fin(heur);
+        }
+        var count: i64 = 0;
+        try self.ck(self.api.cudnnBackendGetAttribute(heur, A_HEUR_RESULTS, T_DESC, 0, &count, null), "heuristic count");
+        if (count <= 0) return error.NoPlan;
+        const cfgs = try self.gpa.alloc(Desc, @intCast(count));
+        defer self.gpa.free(cfgs);
+        for (cfgs) |*c| c.* = try self.create(D_ENGINECFG);
+        // every configuration descriptor stays with the plans (the plan refers to its configuration)
+        for (cfgs) |c| try self.keep.append(self.gpa, c);
+        var got: i64 = 0;
+        try self.ck(self.api.cudnnBackendGetAttribute(heur, A_HEUR_RESULTS, T_DESC, count, &got, @ptrCast(cfgs.ptr)), "heuristic results");
+        for (cfgs[0..@intCast(got)]) |cfg| {
+            const p = try self.create(D_PLAN);
+            self.set(p, A_PLAN_CFG, T_DESC, 1, &cfg) catch {
+                self.destroy(p);
+                continue;
+            };
+            self.fin(p) catch {
+                self.destroy(p);
+                continue;
+            };
+            var ws: i64 = 0;
+            var c1: i64 = 0;
+            try self.ck(self.api.cudnnBackendGetAttribute(p, A_PLAN_WORKSPACE, T_INT64, 1, &c1, @ptrCast(&ws)), "workspace size");
+            const eng = self.engineIndex(cfg) catch -1;
+            try self.plans.put(self.gpa, key, .{ .plan = p, .workspace = @intCast(@max(ws, 0)), .engine = eng, .spec = spec });
+            return self.plans.getPtr(key).?;
+        }
+        return error.NoPlan;
+    }
+
+    fn engineIndex(self: *Cudnn, cfg: Desc) Error!i64 {
+        const e = try self.create(D_ENGINE);
+        defer self.destroy(e);
+        var n: i64 = 0;
+        var arr = [1]Desc{e};
+        try self.ck(self.api.cudnnBackendGetAttribute(cfg, A_CFG_ENGINE, T_DESC, 1, &n, @ptrCast(&arr)), "engine of config");
+        var idx: i64 = 0;
+        try self.ck(self.api.cudnnBackendGetAttribute(e, A_ENGINE_INDEX, T_INT64, 1, &n, @ptrCast(&idx)), "engine index");
+        return idx;
+    }
+
+    /// y = conv(x, w) on the stream given to `init`.
+    pub fn run(self: *Cudnn, spec: Spec, x: u64, w: u64, y: u64) Error!void {
+        const p = try self.plan(spec);
+        if (p.workspace > 0) {
+            if (self.workspace == null or self.workspace.?.len < p.workspace) {
+                if (self.workspace) |*old| old.free();
+                self.workspace = cuda.DeviceBuffer.alloc(self.d, p.workspace) catch return error.CudnnFailed;
+            }
+        }
+        const vp = try self.create(D_VARPACK);
+        defer self.destroy(vp);
+        const uids = [3]i64{ uid_x, uid_y, uid_w };
+        const ptrs = [3]u64{ x, y, w };
+        const ws: u64 = if (self.workspace) |b| b.ptr else 0;
+        try self.set(vp, A_VP_UIDS, T_INT64, 3, &uids);
+        try self.set(vp, A_VP_PTRS, T_VOID_PTR, 3, &ptrs);
+        try self.set(vp, A_VP_WORKSPACE, T_VOID_PTR, 1, &ws);
+        try self.fin(vp);
+        try self.ck(self.api.cudnnBackendExecute(self.handle, p.plan, vp), "execute");
+    }
+};
diff --git a/zig/src/families/glm_cuda/cuda_weights.zig b/zig/src/families/glm_cuda/cuda_weights.zig
new file mode 100644
index 00000000..82e31e39
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_weights.zig
@@ -0,0 +1,514 @@
+//! GLM-5.3-Flash's EXL3 weight-loading plan on the host: config.json plus each safetensors JSON header (never the
+//! weight bytes) -> per-rank list of (tensor name, file, byte range, device buffer offset, dtype, shape, slice).
+//!
+//! Rank `rank` of `world` takes Python's rank slices (glm5_next/cuda/split.py RankReader._span, tp.Layout.cut,
+//! weights.load's vocabulary rows of lm_head, dflash2.Drafter's KV-group split). Device buffers are packed in
+//! checkpoint order with 256-byte alignment (cuda_layouts.align_bytes). A 4-bit trellis is stored int16 [..., 64]
+//! and held as int32 [..., 32], the same bytes (exl3_mm.words). Vision tensors are dropped.
+//!
+//! Python source (TensorFold, https://github.com/ashhart/TensorFold): glm5_next/cuda/weights.py load, split.py
+//! RankReader._span / rule / rank_cut, tp.Layout, dflash2.Drafter, cuda/exl3/format.py, exl3_mm.words.
+const std = @import("std");
+const core = @import("core");
+const cfgs = @import("cuda_config.zig");
+const lay = @import("cuda_layouts.zig");
+
+const st = core.safetensors;
+const Config = cfgs.Config;
+const Layout = lay.Layout;
+const Kind = lay.Kind;
+const Family = lay.Family;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+pub const max_shape = 8;
+pub const device_align = lay.align_bytes;
+pub const Source = enum { model, dflash2 };
+
+pub const Options = struct {
+    rank: u32 = 0,
+    world: u32 = 1,
+    mtp: bool = true,
+    /// include DFlash2 tensors from this directory (its model.safetensors header)
+    dflash2_dir: ?[]const u8 = null,
+};
+
+pub const TensorSrc = struct {
+    name: []const u8,
+    file: []const u8,
+    dtype: []const u8,
+    dtype_size: u32,
+    rank: u8,
+    shape: [max_shape]u32 = @splat(1),
+    /// byte offsets from the start of the data region (header["data_offsets"])
+    data_begin: u64,
+    data_end: u64,
+    /// 8 + JSON header length
+    header_base: u64,
+    source: Source = .model,
+};
+
+pub const Catalog = struct {
+    gpa: std.mem.Allocator,
+    arena: std.heap.ArenaAllocator,
+    tensors: std.ArrayList(TensorSrc) = .empty,
+
+    pub fn deinit(c: *Catalog) void {
+        c.tensors.deinit(c.gpa);
+        c.arena.deinit();
+        c.* = undefined;
+    }
+};
+
+pub const Slice = struct {
+    kind: Kind,
+    family: ?Family = null,
+    axis: ?u8 = null,
+    start: u32 = 0,
+    stop: u32 = 0,
+    /// shape after the rank's slice
+    shape: [max_shape]u32 = @splat(1),
+    rank: u8 = 0,
+    /// absolute file offsets of the bytes this rank reads (row splits trim; col/dim1 read the whole tensor)
+    file_begin: u64 = 0,
+    file_end: u64 = 0,
+    device_dtype: []const u8,
+    device_shape: [max_shape]u32 = @splat(1),
+    device_rank: u8 = 0,
+    device_bytes: u64 = 0,
+
+    pub fn text(self: Slice, buf: []u8) []const u8 {
+        if (self.kind == .rep or self.kind == .drop) return self.kind.text();
+        return std.fmt.bufPrint(buf, "{s}:{d}:{d}", .{ self.kind.text(), self.start, self.stop }) catch self.kind.text();
+    }
+};
+
+pub const Item = struct {
+    src: TensorSrc,
+    slice: Slice,
+    device_offset: u64,
+};
+
+pub const Plan = struct {
+    mtp: bool = false,
+    gpa: std.mem.Allocator,
+    rank: u32,
+    world: u32,
+    items: std.ArrayList(Item) = .empty,
+    dropped: u32 = 0,
+    file_bytes: u64 = 0,
+    device_bytes: u64 = 0,
+    sha256: [32]u8 = @splat(0),
+
+    pub fn deinit(p: *Plan) void {
+        p.items.deinit(p.gpa);
+        p.* = undefined;
+    }
+
+    pub fn hex(self: Plan, buf: *[64]u8) []const u8 {
+        const digits = "0123456789abcdef";
+        for (self.sha256, 0..) |b, i| {
+            buf[2 * i] = digits[b >> 4];
+            buf[2 * i + 1] = digits[b & 0xF];
+        }
+        return buf;
+    }
+};
+
+fn intern(a: std.mem.Allocator, s: []const u8) ![]const u8 {
+    return a.dupe(u8, s);
+}
+
+/// Read only the safetensors JSON header (the first 8 + n bytes). Never maps the weight payload.
+pub fn readHeader(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !struct { json: []u8, base: u64, file_len: u64 } {
+    var file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    const file_len: u64 = @intCast(try file.length(io));
+    if (file_len < 8) return error.BadSafetensors;
+    var head: [8]u8 = undefined;
+    if (try file.readPositionalAll(io, &head, 0) != 8) return error.BadSafetensors;
+    const n = std.mem.readInt(u64, &head, .little);
+    if (n > 1 << 30 or 8 + n > file_len) return error.BadSafetensors;
+    const json = try gpa.alloc(u8, n);
+    errdefer gpa.free(json);
+    if (try file.readPositionalAll(io, json, 8) != json.len) return error.BadSafetensors;
+    return .{ .json = json, .base = 8 + n, .file_len = file_len };
+}
+
+fn appendHeaderTensors(cat: *Catalog, json: []const u8, file_name: []const u8, base: u64, file_len: u64, source: Source) !void {
+    const a = cat.arena.allocator();
+    const data_len = file_len - base;
+    const header = try st.parseHeader(a, json, data_len);
+    var it = header.iterator();
+    while (it.next()) |kv| {
+        try cat.tensors.append(cat.gpa, try srcOf(a, kv.key_ptr.*, file_name, kv.value_ptr.*, base, source));
+    }
+}
+
+fn srcOf(a: std.mem.Allocator, name: []const u8, file_name: []const u8, e: st.Entry, base: u64, source: Source) !TensorSrc {
+    var shape: [max_shape]u32 = @splat(1);
+    const r = @min(e.rank, max_shape);
+    var i: u8 = 0;
+    while (i < r) : (i += 1) shape[i] = @intCast(e.shape[i]);
+    const dt = switch (e.dtype) {
+        .bool => "BOOL",
+        .u8 => "U8",
+        .i8 => "I8",
+        .u16 => "U16",
+        .i16 => "I16",
+        .f16 => "F16",
+        .bf16 => "BF16",
+        .u32 => "U32",
+        .i32 => "I32",
+        .f32 => "F32",
+        .u64 => "U64",
+        .i64 => "I64",
+        .f64 => "F64",
+        .f8_e4m3 => "F8_E4M3",
+        .f8_e5m2 => "F8_E5M2",
+        .f8_e8m0 => "F8_E8M0",
+    };
+    return .{
+        .name = try intern(a, name),
+        .file = try intern(a, file_name),
+        .dtype = dt,
+        .dtype_size = @intCast(e.dtype.size()),
+        .rank = r,
+        .shape = shape,
+        .data_begin = e.begin,
+        .data_end = e.end,
+        .header_base = base,
+        .source = source,
+    };
+}
+
+/// Enumerate the checkpoint's tensors from model.safetensors.index.json and each shard's JSON header.
+pub fn loadCatalog(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, dflash2_dir: ?[]const u8) !Catalog {
+    var cat: Catalog = .{ .gpa = gpa, .arena = std.heap.ArenaAllocator.init(gpa) };
+    errdefer cat.deinit();
+    const a = cat.arena.allocator();
+    const index_path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors.index.json" });
+    defer gpa.free(index_path);
+    const index_text = try std.Io.Dir.cwd().readFileAlloc(io, index_path, gpa, .limited(1 << 26));
+    defer gpa.free(index_text);
+    const parsed = try std.json.parseFromSlice(std.json.Value, gpa, index_text, .{});
+    defer parsed.deinit();
+    const weight_map = parsed.value.object.get("weight_map") orelse return error.BadIndex;
+    if (weight_map != .object) return error.BadIndex;
+
+    var files: std.StringArrayHashMapUnmanaged(void) = .empty;
+    defer files.deinit(gpa);
+    {
+        var it = weight_map.object.iterator();
+        while (it.next()) |kv| {
+            const file = kv.value_ptr.string;
+            const gop = try files.getOrPut(gpa, file);
+            if (!gop.found_existing) gop.key_ptr.* = try intern(a, file);
+        }
+    }
+
+    const ParsedFile = struct { json: []u8, base: u64, file_len: u64, header: st.Header };
+    var headers: std.StringHashMapUnmanaged(ParsedFile) = .empty;
+    defer {
+        var hit = headers.iterator();
+        while (hit.next()) |kv| gpa.free(kv.value_ptr.json);
+        headers.deinit(gpa);
+    }
+    var fit = files.iterator();
+    while (fit.next()) |e| {
+        const path = try std.fs.path.join(gpa, &.{ dir, e.key_ptr.* });
+        defer gpa.free(path);
+        const h = try readHeader(gpa, io, path);
+        const header = try st.parseHeader(a, h.json, h.file_len - h.base);
+        try headers.put(gpa, e.key_ptr.*, .{ .json = h.json, .base = h.base, .file_len = h.file_len, .header = header });
+    }
+
+    var it = weight_map.object.iterator();
+    while (it.next()) |kv| {
+        const name = kv.key_ptr.*;
+        const file = kv.value_ptr.string;
+        const h = headers.get(file).?;
+        const e = h.header.get(name) orelse return error.MissingTensor;
+        try cat.tensors.append(gpa, try srcOf(a, name, file, e, h.base, .model));
+    }
+
+    if (dflash2_dir) |dd| {
+        const path = try std.fs.path.join(gpa, &.{ dd, "model.safetensors" });
+        defer gpa.free(path);
+        const h = try readHeader(gpa, io, path);
+        defer gpa.free(h.json);
+        try appendHeaderTensors(&cat, h.json, "dflash2:model.safetensors", h.base, h.file_len, .dflash2);
+    }
+    return cat;
+}
+
+fn numel(shape: []const u32) u64 {
+    var n: u64 = 1;
+    for (shape) |d| n *= d;
+    return n;
+}
+
+fn copyShape(rank: u8, src: [max_shape]u32) [max_shape]u32 {
+    var o: [max_shape]u32 = @splat(1);
+    var i: u8 = 0;
+    while (i < rank) : (i += 1) o[i] = src[i];
+    return o;
+}
+
+fn dflash2Slice(name: []const u8, src: TensorSrc, q0: u32, qn: u32, kv0: u32, kvn: u32, m0: u32, mn: u32, hd: u32) ?struct { kind: Kind, start: u32, stop: u32 } {
+    if (std.mem.indexOf(u8, name, ".self_attn.q_proj.weight") != null) {
+        return .{ .kind = .row, .start = q0 * hd, .stop = (q0 + qn) * hd };
+    }
+    if (std.mem.indexOf(u8, name, ".self_attn.k_proj.weight") != null or std.mem.indexOf(u8, name, ".self_attn.v_proj.weight") != null) {
+        return .{ .kind = .row, .start = kv0 * hd, .stop = (kv0 + kvn) * hd };
+    }
+    if (std.mem.indexOf(u8, name, ".self_attn.o_proj.weight") != null) {
+        return .{ .kind = .col, .start = q0 * hd, .stop = (q0 + qn) * hd };
+    }
+    if (std.mem.indexOf(u8, name, ".mlp.gate_proj.weight") != null or std.mem.indexOf(u8, name, ".mlp.up_proj.weight") != null) {
+        return .{ .kind = .row, .start = m0, .stop = m0 + mn };
+    }
+    if (std.mem.indexOf(u8, name, ".mlp.down_proj.weight") != null) {
+        return .{ .kind = .col, .start = m0, .stop = m0 + mn };
+    }
+    _ = src;
+    return null;
+}
+
+fn applyCut(src: TensorSrc, kind: Kind, a: u32, b: u32, file_full: bool) Slice {
+    var shape = copyShape(src.rank, src.shape);
+    const axis = kind.axis() orelse 0;
+    if (kind != .rep and kind != .drop) shape[axis] = b - a;
+    const stored_bytes = numel(src.shape[0..src.rank]) * src.dtype_size;
+    const sliced_n = numel(shape[0..src.rank]) * src.dtype_size;
+    var file_begin = src.header_base + src.data_begin;
+    var file_end = src.header_base + src.data_end;
+    if (!file_full and kind == .row) {
+        const per = stored_bytes / src.shape[0];
+        file_begin = src.header_base + src.data_begin + @as(u64, a) * per;
+        file_end = src.header_base + src.data_begin + @as(u64, b) * per;
+    }
+    var device_dtype = src.dtype;
+    var device_shape = shape;
+    var device_rank = src.rank;
+    var device_bytes = sliced_n;
+    if (std.mem.endsWith(u8, src.name, ".trellis")) {
+        if (lay.trellisDeviceLast(shape[src.rank - 1], src.dtype_size)) |w| {
+            device_dtype = "I32";
+            device_shape[src.rank - 1] = @intCast(w.last);
+            device_rank = src.rank;
+            device_bytes = numel(device_shape[0..device_rank]) * w.item;
+        }
+    }
+    return .{
+        .kind = kind,
+        .axis = kind.axis(),
+        .start = a,
+        .stop = b,
+        .shape = shape,
+        .rank = src.rank,
+        .file_begin = file_begin,
+        .file_end = file_end,
+        .device_dtype = device_dtype,
+        .device_shape = device_shape,
+        .device_rank = device_rank,
+        .device_bytes = device_bytes,
+    };
+}
+
+fn skipMtp(src: TensorSrc, cfg: *const Config, mtp: bool) bool {
+    if (mtp) return false;
+    const i = lay.layerIndex(src.name) orelse return false;
+    return i >= cfg.layers;
+}
+
+/// One rank's load plan: every kept tensor's file range and packed device offset.
+pub fn plan(gpa: std.mem.Allocator, cfg: *const Config, cat: *const Catalog, o: Options) !Plan {
+    if (o.world < 1 or o.rank >= o.world) return error.BadWorld;
+    const layout = try Layout.fromConfig(cfg, o.rank, o.world);
+    var q: [8]u32 = undefined;
+    var kv: [8]u32 = undefined;
+    var mlp: [8]u32 = undefined;
+    var dflash = false;
+    var q0: u32 = 0;
+    var qn: u32 = 0;
+    var kv0: u32 = 0;
+    var kvn: u32 = 0;
+    var m0: u32 = 0;
+    var mn: u32 = 0;
+    const hd: u32 = 128;
+    for (cat.tensors.items) |t| if (t.source == .dflash2) {
+        dflash = true;
+        break;
+    };
+    if (dflash) {
+        // DFlash2 config is not in cfg; query/KV/MLP shares come from the first q_proj / k_proj / gate_proj shapes.
+        var heads: u32 = 32;
+        var kv_heads: u32 = 8;
+        var inter: u32 = 12288;
+        var got_h = false;
+        var got_k = false;
+        var got_m = false;
+        for (cat.tensors.items) |t| {
+            if (t.source != .dflash2) continue;
+            if (!got_h and std.mem.indexOf(u8, t.name, ".self_attn.q_proj.weight") != null) {
+                heads = t.shape[0] / hd;
+                got_h = true;
+            }
+            if (!got_k and std.mem.indexOf(u8, t.name, ".self_attn.k_proj.weight") != null) {
+                kv_heads = t.shape[0] / hd;
+                got_k = true;
+            }
+            if (!got_m and std.mem.indexOf(u8, t.name, ".mlp.gate_proj.weight") != null) {
+                inter = t.shape[0];
+                got_m = true;
+            }
+        }
+        try lay.draftParts(heads, kv_heads, inter, o.world, &q, &kv, &mlp);
+        const qs = lay.shareOf(q[0..o.world], o.rank);
+        const kvs = lay.shareOf(kv[0..o.world], o.rank);
+        const ms = lay.shareOf(mlp[0..o.world], o.rank);
+        q0 = qs.start;
+        qn = qs.stop - qs.start;
+        kv0 = kvs.start;
+        kvn = kvs.stop - kvs.start;
+        m0 = ms.start;
+        mn = ms.stop - ms.start;
+    }
+
+    var p: Plan = .{ .gpa = gpa, .rank = o.rank, .world = o.world, .mtp = o.mtp and cfg.mtp_layers != 0 };
+    errdefer p.deinit();
+    var offset: u64 = 0;
+    var hasher = Sha256.init(.{});
+    var line_buf: [1024]u8 = undefined;
+
+    for (cat.tensors.items) |src| {
+        if (src.source == .model) {
+            const kind = lay.rule(src.name) catch {
+                return error.AmbiguousSplit;
+            };
+            if (kind == .drop) {
+                p.dropped += 1;
+                continue;
+            }
+            if (skipMtp(src, cfg, o.mtp)) {
+                p.dropped += 1;
+                continue;
+            }
+            var sl: Slice = undefined;
+            if (std.mem.startsWith(u8, src.name, "lm_head.")) {
+                const cut = try layout.cut(.vocab, src.shape[0]);
+                sl = applyCut(src, .row, cut.a, cut.b, false);
+                sl.family = .vocab;
+            } else if (kind == .rep) {
+                sl = applyCut(src, .rep, 0, if (src.rank > 0) src.shape[0] else 1, true);
+            } else {
+                const fam = layout.familyOf(src.name) orelse return error.MissingFamily;
+                const axis = kind.axis().?;
+                const length = src.shape[axis];
+                const cut = try layout.cut(fam, length);
+                const file_full = kind != .row;
+                sl = applyCut(src, kind, cut.a, cut.b, file_full);
+                sl.family = fam;
+            }
+            try appendItem(&p, src, sl, &offset, &hasher, &line_buf);
+        } else {
+            const spec = dflash2Slice(src.name, src, q0, qn, kv0, kvn, m0, mn, hd);
+            var sl: Slice = undefined;
+            if (spec) |s| {
+                sl = applyCut(src, s.kind, s.start, s.stop, s.kind != .row);
+            } else {
+                sl = applyCut(src, .rep, 0, if (src.rank > 0) src.shape[0] else 1, true);
+            }
+            try appendItem(&p, src, sl, &offset, &hasher, &line_buf);
+        }
+    }
+    p.device_bytes = offset;
+    hasher.final(&p.sha256);
+    return p;
+}
+
+fn appendItem(p: *Plan, src: TensorSrc, sl: Slice, offset: *u64, hasher: *Sha256, line_buf: *[1024]u8) !void {
+    const item = Item{ .src = src, .slice = sl, .device_offset = offset.* };
+    try p.items.append(p.gpa, item);
+    p.file_bytes += sl.file_end - sl.file_begin;
+    const line = canonical(item, line_buf);
+    hasher.update(line);
+    offset.* = lay.alignUp(offset.* + sl.device_bytes);
+}
+
+fn writeShape(w: *std.Io.Writer, rank: u8, shape: [max_shape]u32) void {
+    var i: u8 = 0;
+    while (i < rank) : (i += 1) {
+        if (i != 0) w.writeByte('x') catch {};
+        w.print("{d}", .{shape[i]}) catch {};
+    }
+}
+
+pub fn canonical(item: Item, buf: []u8) []const u8 {
+    var w: std.Io.Writer = .fixed(buf);
+    var slbuf: [64]u8 = undefined;
+    w.print("{s}\t{s}\t{d}\t{d}\t{d}\t{s}\t", .{
+        item.src.name,
+        item.src.file,
+        item.slice.file_begin,
+        item.slice.file_end,
+        item.device_offset,
+        item.src.dtype,
+    }) catch {};
+    writeShape(&w, item.slice.rank, item.slice.shape);
+    w.print("\t{s}\t{s}\t{s}\t", .{ item.slice.kind.text(), item.slice.text(&slbuf), item.slice.device_dtype }) catch {};
+    writeShape(&w, item.slice.device_rank, item.slice.device_shape);
+    w.writeByte('\n') catch {};
+    return buf[0..w.end];
+}
+
+pub fn find(p: *const Plan, name: []const u8) ?Item {
+    for (p.items.items) |it| if (std.mem.eql(u8, it.src.name, name)) return it;
+    return null;
+}
+
+test "canonical line format is stable" {
+    const src = TensorSrc{
+        .name = "lm_head.weight",
+        .file = "model-00001-of-00083.safetensors",
+        .dtype = "BF16",
+        .dtype_size = 2,
+        .rank = 2,
+        .shape = .{ 154880, 4096, 1, 1, 1, 1, 1, 1 },
+        .data_begin = 0,
+        .data_end = 10,
+        .header_base = 128,
+    };
+    var sl = applyCut(src, .row, 0, 77440, false);
+    sl.family = .vocab;
+    const item = Item{ .src = src, .slice = sl, .device_offset = 0 };
+    var buf: [512]u8 = undefined;
+    const line = canonical(item, &buf);
+    try std.testing.expect(std.mem.startsWith(u8, line, "lm_head.weight\tmodel-00001-of-00083.safetensors\t"));
+    try std.testing.expect(std.mem.indexOf(u8, line, "\trow:0:77440\t") != null);
+}
+
+test "MTP checkpoint plan includes replicated EH/norms and TP-sliced DSA/MoE; auto-off drops layer 45" {
+    const gpa = std.testing.allocator;
+    var why: cfgs.Why = .{};
+    var cfg = try cfgs.parse(gpa, @embedFile("fixtures_config.json"), @embedFile("fixtures_generation_config.json"), .{}, &why);
+    defer cfg.deinit();
+    var cat: Catalog = .{ .gpa = gpa, .arena = std.heap.ArenaAllocator.init(gpa) };
+    defer cat.deinit();
+    const names = [_][]const u8{ "model.language_model.layers.45.enorm.weight", "model.language_model.layers.45.eh_proj.weight", "model.language_model.layers.45.self_attn.q_b_proj.weight", "model.language_model.layers.45.mlp.shared_experts.down_proj.weight" };
+    const shapes = [_][2]u32{ .{ 4096, 1 }, .{ 4096, 8192 }, .{ 16384, 1536 }, .{ 4096, 2048 } };
+    for (names, shapes, 0..) |name, shape, i| {
+        try cat.tensors.append(gpa, .{ .name = name, .file = "fixture.safetensors", .dtype = "BF16", .dtype_size = 2, .rank = if (i == 0) 1 else 2, .shape = .{ shape[0], shape[1], 1, 1, 1, 1, 1, 1 }, .data_begin = 0, .data_end = @as(u64, shape[0]) * shape[1] * 2, .header_base = 128 });
+    }
+    var off = try plan(gpa, &cfg, &cat, .{ .world = 2, .rank = 1, .mtp = false });
+    defer off.deinit();
+    try std.testing.expect(!off.mtp);
+    try std.testing.expectEqual(@as(usize, 0), off.items.items.len);
+    var on = try plan(gpa, &cfg, &cat, .{ .world = 2, .rank = 1, .mtp = true });
+    defer on.deinit();
+    try std.testing.expect(on.mtp);
+    try std.testing.expectEqual(@as(usize, 4), on.items.items.len);
+    try std.testing.expectEqual(@as(u32, 8192), find(&on, names[1]).?.slice.shape[1]);
+    try std.testing.expectEqual(@as(u32, 8192), find(&on, names[2]).?.slice.shape[0]);
+    try std.testing.expectEqual(@as(u32, 1024), find(&on, names[3]).?.slice.shape[1]);
+}
