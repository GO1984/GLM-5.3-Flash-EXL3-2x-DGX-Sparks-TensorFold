@@ -0,0 +1,330 @@
+//! Ports glm5_next/cuda/display_kv.py: parsing, span_planes and map_span.
+//! TensorFold by Ash Hart and contributors; recipe display support by MiaAI-Lab.
+//! dispram uses the installed kindling Python client in this process; no client code is vendored.
+const std = @import("std");
+const cuda = @import("cuda");
+extern "c" fn mmap(?*anyopaque, usize, c_int, c_int, c_int, i64) ?*anyopaque;
+extern "c" fn munmap(?*anyopaque, usize) c_int;
+extern "c" fn ioctl(c_int, c_ulong, ...) c_int;
+extern "c" fn open([*:0]const u8, c_int, ...) c_int;
+extern "c" fn dlopen([*:0]const u8, c_int) ?*anyopaque;
+extern "c" fn dlsym(*anyopaque, [*:0]const u8) ?*anyopaque;
+
+pub const Backend = enum { drm, dispram };
+var claimed: std.atomic.Value(bool) = .init(false);
+pub fn env(name: [:0]const u8) ?[]const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+}
+pub fn mib(raw: ?[]const u8) !usize {
+    const t = std.mem.trim(u8, raw orelse "", " \t\r\n");
+    if (t.len == 0) return 0;
+    const n = std.fmt.parseInt(i64, t, 10) catch return error.InvalidDisplayMiB;
+    if (n < 0 or n > 2032 or @mod(n, 16) != 0) return error.InvalidDisplayMiB;
+    return @intCast(n);
+}
+pub fn backend(raw: ?[]const u8) !Backend {
+    const t = std.mem.trim(u8, if (raw == null or raw.?.len == 0) "drm" else raw.?, " \t\r\n");
+    if (std.ascii.eqlIgnoreCase(t, "drm")) return .drm;
+    if (std.ascii.eqlIgnoreCase(t, "dispram")) return .dispram;
+    return error.InvalidDisplayBackend;
+}
+pub fn planes(count: usize, plane: usize, display: usize) !usize {
+    if (plane == 0) return error.DisplayTooLarge;
+    const k = @max(1, display / plane + @intFromBool(display % plane != 0));
+    if (k > count) return error.DisplayTooLarge;
+    return k;
+}
+pub const Config = struct {
+    bytes: usize = 0,
+    kind: Backend = .drm,
+    card: []const u8 = "/dev/dri/card0",
+    pub fn read() !Config {
+        const bytes = (try mib(env("TF_GLM_DISPLAY_KV_MIB") orelse env("DISPLAY_KV_MIB"))) << 20;
+        return .{ .bytes = bytes, .kind = if (bytes == 0) .drm else try backend(env("TF_GLM_DISPLAY_KV_BACKEND") orelse env("DISPLAY_KV_BACKEND")), .card = env("TF_GLM_DISPLAY_KV_CARD") orelse "/dev/dri/card0" };
+    }
+};
+pub fn headless(gpa: std.mem.Allocator, io: std.Io, sysfs: []const u8, card_path: []const u8) !void {
+    var dir = try std.Io.Dir.cwd().openDir(io, sysfs, .{ .iterate = true });
+    defer dir.close(io);
+    const prefix = try std.fmt.allocPrint(gpa, "{s}-", .{std.fs.path.basename(card_path)});
+    defer gpa.free(prefix);
+    var it = dir.iterate();
+    while (try it.next(io)) |entry| {
+        if (!std.mem.startsWith(u8, entry.name, prefix)) continue;
+        const path = try std.fmt.allocPrint(gpa, "{s}/status", .{entry.name});
+        defer gpa.free(path);
+        var f = try dir.openFile(io, path, .{});
+        defer f.close(io);
+        var buf: [128]u8 = undefined;
+        var r = f.readerStreaming(io, &buf);
+        const text = try r.interface.allocRemaining(gpa, .limited(128));
+        defer gpa.free(text);
+        if (std.mem.eql(u8, std.mem.trim(u8, text, " \t\r\n"), "connected")) return error.DisplayConnected;
+    }
+}
+pub const Span = struct {
+    ptr: u64,
+    base: usize = 0,
+    ordinary: usize = 0,
+    display: usize = 0,
+    fd: c_int = -1,
+    handle: u32 = 0,
+    ordinary_registered: bool = false,
+    display_registered: bool = false,
+    d: *const cuda.Driver,
+    owns_claim: bool = false,
+    pub fn deinit(s: *Span) void {
+        if (s.base == 0) return; // dispram's client retains its CUDA VMM allocation for the process lifetime.
+        if (s.display_registered) _ = s.d.api.cuMemHostUnregister(@ptrFromInt(s.base + s.ordinary));
+        if (s.ordinary_registered) _ = s.d.api.cuMemHostUnregister(@ptrFromInt(s.base));
+        _ = munmap(@ptrFromInt(s.base), s.ordinary + s.display);
+        var close_gem = [_]u32{ s.handle, 0 };
+        _ = ioctl(s.fd, 0x40086409, &close_gem);
+        _ = std.c.close(s.fd);
+        s.base = 0;
+        if (s.owns_claim) claimed.store(false, .release);
+        s.owns_claim = false;
+    }
+};
+fn mapped(address: usize, size: usize, prot: c_int, flags: c_int, fd: c_int, offset: u64) !usize {
+    const p = mmap(if (address == 0) null else @ptrFromInt(address), size, prot, flags, fd, @intCast(offset)) orelse return error.DisplayMmap;
+    const at = @intFromPtr(p);
+    if (at == std.math.maxInt(usize) or (address != 0 and at != address)) return error.DisplayMmap;
+    return at;
+}
+pub fn map(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, device: c_int, cfg: Config, ordinary: usize) !Span {
+    if (claimed.cmpxchgStrong(false, true, .acq_rel, .acquire) != null) return error.DisplayAlreadyAllocated;
+    errdefer claimed.store(false, .release);
+    try headless(gpa, io, "/sys/class/drm", cfg.card);
+    if (cfg.kind == .dispram) {
+        var span = try dispram(gpa, d, device, ordinary + cfg.bytes, cfg.bytes);
+        span.owns_claim = true;
+        return span;
+    }
+    const card = try gpa.dupeSentinel(u8, cfg.card, 0);
+    defer gpa.free(card);
+    var system: System = .{ .d = d, .card = card };
+    var span = try mapDrm(&system, ordinary, cfg.bytes);
+    span.owns_claim = true;
+    return span;
+}
+
+const System = struct {
+    d: *const cuda.Driver,
+    card: [:0]const u8,
+    fn openCard(s: *System) !c_int {
+        const fd = open(s.card, 2 | 0x80000);
+        if (fd < 0) return error.DisplayCardUnavailable;
+        return fd;
+    }
+    fn create(_: *System, fd: c_int, size: usize) !struct { handle: u32, size: usize } {
+        var dumb: extern struct { height: u32, width: u32 = 4096, bpp: u32 = 32, flags: u32 = 0, handle: u32 = 0, pitch: u32 = 0, size: u64 = 0 } = .{ .height = @intCast(std.math.divCeil(usize, size, 16384) catch unreachable) };
+        if (ioctl(fd, 0xC02064B2, &dumb) != 0) return error.DisplayCreateDumb;
+        return .{ .handle = dumb.handle, .size = @intCast(dumb.size) };
+    }
+    fn offset(_: *System, fd: c_int, handle: u32) !u64 {
+        var out: extern struct { handle: u32, pad: u32 = 0, offset: u64 = 0 } = .{ .handle = handle };
+        if (ioctl(fd, 0xC01064B3, &out) != 0) return error.DisplayMapDumb;
+        return out.offset;
+    }
+    fn reserve(_: *System, size: usize) !usize {
+        return mapped(0, size, 0, 0x4022, -1, 0);
+    }
+    fn ordinary(_: *System, base: usize, size: usize) !void {
+        _ = try mapped(base, size, 3, 0x32, -1, 0);
+    }
+    fn display(_: *System, base: usize, size: usize, fd: c_int, offset_value: u64) !void {
+        _ = try mapped(base, size, 3, 0x11, fd, offset_value);
+    }
+    fn register(s: *System, base: usize, size: usize, is_io: bool) !void {
+        try s.d.check(s.d.api.cuMemHostRegister_v2(@ptrFromInt(base), size, if (is_io) 6 else 2), "display register");
+    }
+    fn pointer(s: *System, base: usize) !u64 {
+        var out: u64 = 0;
+        try s.d.check(s.d.api.cuMemHostGetDevicePointer_v2(&out, @ptrFromInt(base), 0), "display device pointer");
+        return out;
+    }
+    fn unregister(s: *System, base: usize) void {
+        _ = s.d.api.cuMemHostUnregister(@ptrFromInt(base));
+    }
+    fn unmap(_: *System, base: usize, size: usize) void {
+        _ = munmap(@ptrFromInt(base), size);
+    }
+    fn closeGem(_: *System, fd: c_int, handle: u32) void {
+        var gem = [_]u32{ handle, 0 };
+        _ = ioctl(fd, 0x40086409, &gem);
+    }
+    fn closeFd(_: *System, fd: c_int) void {
+        _ = std.c.close(fd);
+    }
+};
+/// The same call seam as Python's SYSTEM: tests exercise every failure without DRM or CUDA.
+fn mapDrm(system: anytype, ordinary: usize, display_bytes: usize) !Span {
+    const fd = try system.openCard();
+    errdefer system.closeFd(fd);
+    const dumb = try system.create(fd, display_bytes);
+    errdefer system.closeGem(fd, dumb.handle);
+    if (dumb.size < display_bytes) return error.DisplayShort;
+    const offset = try system.offset(fd, dumb.handle);
+    const base = try system.reserve(ordinary + display_bytes);
+    errdefer system.unmap(base, ordinary + display_bytes);
+    if (ordinary > 0) try system.ordinary(base, ordinary);
+    try system.display(base + ordinary, display_bytes, fd, offset);
+    if (ordinary > 0) try system.register(base, ordinary, false);
+    errdefer if (ordinary > 0) system.unregister(base);
+    try system.register(base + ordinary, display_bytes, true);
+    errdefer system.unregister(base + ordinary);
+    const ptr = try system.pointer(base);
+    const top = try system.pointer(base + ordinary);
+    if (top < ptr or top - ptr != ordinary) return error.DisplayNotContiguous;
+    return .{ .ptr = ptr, .base = base, .ordinary = ordinary, .display = display_bytes, .fd = fd, .handle = dumb.handle, .d = system.d, .ordinary_registered = ordinary > 0, .display_registered = true };
+}
+
+fn symbol(comptime T: type, lib: *anyopaque, name: [:0]const u8) !T {
+    return @ptrCast(@alignCast(dlsym(lib, name) orelse return error.DispramPythonSymbol));
+}
+fn dispram(gpa: std.mem.Allocator, d: *const cuda.Driver, device: c_int, total: usize, display: usize) !Span {
+    try d.check(d.api.cuCtxSynchronize(), "dispram synchronize");
+    // RTLD_GLOBAL is necessary for extension modules loaded by the installed Python client.
+    var lib: ?*anyopaque = null;
+    for ([_][:0]const u8{ "libpython3.13.so.1.0", "libpython3.12.so.1.0", "libpython3.11.so.1.0", "libpython3.10.so.1.0" }) |name| {
+        lib = dlopen(name, 0x102);
+        if (lib != null) break;
+    }
+    const l = lib orelse return error.DispramPythonUnavailable;
+    const initialized = try symbol(*const fn () callconv(.c) c_int, l, "Py_IsInitialized");
+    if (initialized() == 0) {
+        (try symbol(*const fn () callconv(.c) void, l, "Py_Initialize"))();
+        _ = (try symbol(*const fn () callconv(.c) ?*anyopaque, l, "PyEval_SaveThread"))();
+    }
+    const ensure = try symbol(*const fn () callconv(.c) c_int, l, "PyGILState_Ensure");
+    const release = try symbol(*const fn (c_int) callconv(.c) void, l, "PyGILState_Release");
+    const gil = ensure();
+    defer release(gil);
+    const module = (try symbol(*const fn ([*:0]const u8) callconv(.c) ?*anyopaque, l, "PyImport_AddModule"))("__main__") orelse return error.DispramClient;
+    const dict = (try symbol(*const fn (*anyopaque) callconv(.c) *anyopaque, l, "PyModule_GetDict"))(module);
+    const code = try std.fmt.allocPrintSentinel(gpa, "(__import__('dispram').map_glued({d}, {d}) if __import__('dispram').available() else None)", .{ total, device }, 0);
+    defer gpa.free(code);
+    const result = (try symbol(*const fn ([*:0]const u8, c_int, *anyopaque, *anyopaque, ?*anyopaque) callconv(.c) ?*anyopaque, l, "PyRun_StringFlags"))(code, 258, dict, dict, null) orelse {
+        (try symbol(*const fn () callconv(.c) void, l, "PyErr_Print"))();
+        return error.DispramClient;
+    };
+    defer (symbol(*const fn (*anyopaque) callconv(.c) void, l, "Py_DecRef") catch unreachable)(result);
+    const item = try symbol(*const fn (*anyopaque, isize) callconv(.c) ?*anyopaque, l, "PyTuple_GetItem");
+    const integer = try symbol(*const fn (*anyopaque) callconv(.c) u64, l, "PyLong_AsUnsignedLongLong");
+    const ptr = integer(item(result, 0) orelse return error.DispramClient);
+    const tail = integer(item(result, 2) orelse return error.DispramClient);
+    const occurred = try symbol(*const fn () callconv(.c) ?*anyopaque, l, "PyErr_Occurred");
+    if (occurred() != null or ptr == 0 or tail < display) return error.DisplayShort;
+    return .{ .ptr = ptr, .d = d };
+}
+test "display configuration and fewest latent planes match reference boundaries" {
+    try std.testing.expectEqual(@as(usize, 0), try mib(null));
+    try std.testing.expectEqual(@as(usize, 1792), try mib(" 1792 "));
+    for ([_][]const u8{ "-16", "1", "2048", "nan", "16.0" }) |raw| try std.testing.expectError(error.InvalidDisplayMiB, mib(raw));
+    try std.testing.expectEqual(Backend.dispram, try backend(" DisPrAm "));
+    try std.testing.expectError(error.InvalidDisplayBackend, backend("host"));
+    try std.testing.expectEqual(@as(usize, 2), try planes(11, 1024, 1025));
+    try std.testing.expectEqual(@as(usize, 1), try planes(11, 1024, 1024));
+    try std.testing.expectError(error.DisplayTooLarge, planes(2, 1024, 2049));
+}
+
+const Fake = struct {
+    d: *const cuda.Driver = undefined,
+    step: usize = 0,
+    fail: usize = 0,
+    closed: usize = 0,
+    gems: usize = 0,
+    unmapped: usize = 0,
+    unregistered: usize = 0,
+    short: bool = false,
+    separate: bool = false,
+    fn next(f: *Fake) !void {
+        f.step += 1;
+        if (f.step == f.fail) return error.Injected;
+    }
+    fn openCard(f: *Fake) !c_int {
+        try f.next();
+        return 3;
+    }
+    fn create(f: *Fake, _: c_int, n: usize) !struct { handle: u32, size: usize } {
+        try f.next();
+        return .{ .handle = 7, .size = if (f.short) n - 1 else n };
+    }
+    fn offset(f: *Fake, _: c_int, _: u32) !u64 {
+        try f.next();
+        return 4096;
+    }
+    fn reserve(f: *Fake, _: usize) !usize {
+        try f.next();
+        return 0x10000;
+    }
+    fn ordinary(f: *Fake, base: usize, n: usize) !void {
+        try f.next();
+        try std.testing.expectEqual(@as(usize, 0x10000), base);
+        try std.testing.expectEqual(@as(usize, 4096), n);
+    }
+    fn display(f: *Fake, base: usize, _: usize, _: c_int, _: u64) !void {
+        try f.next();
+        try std.testing.expect(base == 0x11000 or base == 0x10000);
+    }
+    fn register(f: *Fake, base: usize, _: usize, is_io: bool) !void {
+        try f.next();
+        try std.testing.expectEqual(base != 0x10000 or f.step == 6, is_io);
+    }
+    fn pointer(f: *Fake, base: usize) !u64 {
+        try f.next();
+        return base + if (f.separate and base != 0x10000) @as(usize, 1) else 0;
+    }
+    fn unregister(f: *Fake, _: usize) void {
+        f.unregistered += 1;
+    }
+    fn unmap(f: *Fake, _: usize, _: usize) void {
+        f.unmapped += 1;
+    }
+    fn closeGem(f: *Fake, _: c_int, _: u32) void {
+        f.gems += 1;
+    }
+    fn closeFd(f: *Fake, _: c_int) void {
+        f.closed += 1;
+    }
+};
+test "DRM span unwinds every failed driver step and rejects a short or noncontiguous span" {
+    for (1..11) |fail| {
+        var f: Fake = .{ .fail = fail };
+        try std.testing.expectError(error.Injected, mapDrm(&f, 4096, 16384));
+        try std.testing.expectEqual(@as(usize, @intFromBool(fail > 1)), f.closed);
+        try std.testing.expectEqual(@as(usize, @intFromBool(fail > 2)), f.gems);
+        try std.testing.expectEqual(@as(usize, @intFromBool(fail > 4)), f.unmapped);
+        try std.testing.expectEqual(@as(usize, @intFromBool(fail > 7) + @as(usize, @intFromBool(fail > 8))), f.unregistered);
+    }
+    var f: Fake = .{};
+    const span = try mapDrm(&f, 4096, 16384);
+    try std.testing.expectEqual(@as(u64, 0x10000), span.ptr);
+    try std.testing.expectEqual(@as(usize, 0), f.closed);
+    f = .{ .short = true };
+    try std.testing.expectError(error.DisplayShort, mapDrm(&f, 4096, 16384));
+    try std.testing.expectEqual(@as(usize, 1), f.closed);
+    f = .{ .separate = true };
+    try std.testing.expectError(error.DisplayNotContiguous, mapDrm(&f, 4096, 16384));
+    try std.testing.expectEqual(@as(usize, 2), f.unregistered);
+    f = .{};
+    _ = try mapDrm(&f, 0, 16384);
+    try std.testing.expectEqual(@as(usize, 8), f.step);
+}
+
+test "a connected output on the configured card refuses display memory" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = std.testing.io;
+    try tmp.dir.createDir(io, "card0-HDMI-A-1", .default_dir);
+    try tmp.dir.createDir(io, "card1-DP-1", .default_dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "card0-HDMI-A-1/status", .data = "connected\n" });
+    try tmp.dir.writeFile(io, .{ .sub_path = "card1-DP-1/status", .data = "disconnected\n" });
+    const path = try std.fmt.allocPrint(std.testing.allocator, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer std.testing.allocator.free(path);
+    try std.testing.expectError(error.DisplayConnected, headless(std.testing.allocator, io, path, "/dev/dri/card0"));
+    try headless(std.testing.allocator, io, path, "/dev/dri/card1");
+    try tmp.dir.writeFile(io, .{ .sub_path = "card0-HDMI-A-1/status", .data = "disconnected\n" });
+    try headless(std.testing.allocator, io, path, "/dev/dri/card0");
+}
diff --git a/zig/src/families/glm_cuda/cuda_draft_policy.zig b/zig/src/families/glm_cuda/cuda_draft_policy.zig
new file mode 100644
index 00000000..3a38e6e2
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_draft_policy.zig
@@ -0,0 +1,135 @@
+//! TensorFold glm5_next/cuda/dflash2.py: merge_candidates, Drafter.chain, best_depth.
+//! Ash Hart and TensorFold contributors. Proposals only; keyed target sampling stays in P7.
+const std = @import("std");
+const sampling = @import("lanes").sampling;
+extern "c" fn exp(f64) f64;
+extern "c" fn log(f64) f64;
+pub const Sampling = sampling.Sampling;
+pub const Candidate = struct { id: u32, value: f64 };
+fn before(_: void, a: Candidate, b: Candidate) bool {
+    return a.value > b.value or (a.value == b.value and a.id < b.id);
+}
+/// Packed [world, rows, 2*k] fp32: values followed by bitcast int32 global IDs.
+pub fn merge(pack_buf: []const f32, world: usize, rows: usize, k: usize, vocab: usize, out: []Candidate) !void {
+    if (world == 0 or world > 4 or k == 0 or k > 16 or pack_buf.len != world * rows * 2 * k or out.len != rows * k) return error.BadCandidates;
+    var buf: [64]Candidate = undefined;
+    for (0..rows) |r| {
+        for (0..world) |rank| for (0..k) |j| {
+            const base = (rank * rows + r) * 2 * k;
+            const id: u32 = @bitCast(pack_buf[base + k + j]);
+            if (id >= vocab or !std.math.isFinite(pack_buf[base + j])) return error.BadCandidates;
+            buf[rank * k + j] = .{ .id = id, .value = pack_buf[base + j] };
+        };
+        std.mem.sort(Candidate, buf[0 .. world * k], {}, before);
+        @memcpy(out[r * k ..][0..k], buf[0..k]);
+    }
+}
+pub const Selector = struct {
+    pred: []const f32,
+    succ: []const f32,
+    rank: usize = 256,
+    pub fn validate(s: Selector, vocab: usize) !void {
+        if (s.rank == 0 or s.pred.len != vocab * s.rank or s.succ.len != s.pred.len) return error.BadSelector;
+    }
+};
+pub const Policy = struct {
+    most: usize = 7,
+    threshold: f64 = 0.3,
+    beta: f64 = 2,
+    /// Supported served policy, as parsed by multi_tune.py: fnc7:0.3.
+    pub fn parse(code: []const u8) !Policy {
+        if (!std.mem.startsWith(u8, code, "fnc")) return error.BadDraftPolicy;
+        const colon = std.mem.indexOfScalar(u8, code, ':') orelse return error.BadDraftPolicy;
+        const n = std.fmt.parseInt(usize, code[3..colon], 10) catch return error.BadDraftPolicy;
+        const p = std.fmt.parseFloat(f64, code[colon + 1 ..]) catch return error.BadDraftPolicy;
+        if (n < 1 or n > 7 or !std.math.isFinite(p) or p < 0 or p > 1) return error.BadDraftPolicy;
+        return .{ .most = n, .threshold = p };
+    }
+};
+pub fn bestDepth(q: []const f64, round_ms: []const f64) !usize {
+    if (round_ms.len < q.len + 1) return error.BadDraftCosts;
+    var alive: f64 = 1;
+    var expect: f64 = 1;
+    var best: f64 = -1;
+    var depth: usize = 0;
+    for (0..q.len + 1) |k| {
+        if (k > 0) {
+            alive *= q[k - 1];
+            expect += alive;
+        }
+        if (!std.math.isFinite(round_ms[k]) or round_ms[k] <= 0) return error.BadDraftCosts;
+        const rate = expect / round_ms[k];
+        if (rate > best) {
+            best = rate;
+            depth = k;
+        }
+    }
+    return depth;
+}
+/// Candidate rows and selector projection are private copies of one stream's block results.
+pub fn chain(candidates: []const Candidate, projection: []const f32, selector: Selector, anchor: u32, first: usize, s: ?Sampling, policy: Policy, out: []u32, costs: ?[]const f64) !usize {
+    const k: usize = 16;
+    if (policy.most < 1 or policy.most > 7 or !std.math.isFinite(policy.beta) or policy.beta <= 0 or !std.math.isFinite(policy.threshold) or policy.threshold < 0 or policy.threshold > 1) return error.BadDraftPolicy;
+    if (candidates.len % k != 0 or projection.len != candidates.len / k * selector.rank or selector.rank == 0 or selector.pred.len % selector.rank != 0) return error.BadCandidates;
+    const vocab = selector.pred.len / selector.rank;
+    try selector.validate(vocab);
+    if (anchor >= vocab) return error.BadCandidates;
+    const depth = @min(@min(out.len, policy.most), candidates.len / k);
+    var prev = anchor;
+    var product: f64 = 1;
+    var conf: [7]f64 = undefined;
+    var count: usize = 0;
+    const sampled = s != null and s.?.temperature > 0;
+    const temp: f64 = if (sampled) s.?.temperature else 1;
+    for (0..depth) |d| {
+        var z: [16]f64 = undefined;
+        var max_pick: f64 = -std.math.inf(f64);
+        var max_z: f64 = -std.math.inf(f64);
+        var pick: usize = 0;
+        for (candidates[d * k ..][0..k], 0..) |c, j| {
+            if (c.id >= vocab or !std.math.isFinite(c.value)) return error.BadCandidates;
+            var edge: f64 = 0;
+            for (0..selector.rank) |i| edge += @as(f64, selector.succ[@as(usize, c.id) * selector.rank + i]) * (@as(f64, selector.pred[@as(usize, prev) * selector.rank + i]) * projection[d * selector.rank + i]);
+            const score = (c.value + 0.6 * edge) / temp;
+            const noise: f64 = if (sampled) -log(-log(sampling.uniform(s.?.seed, first + d, c.id))) else 0;
+            const value = score + 0.7 * noise;
+            if (value > max_pick) {
+                max_pick = value;
+                pick = j;
+            }
+            z[j] = (score + noise) / policy.beta;
+            max_z = @max(max_z, z[j]);
+        }
+        var sum: f64 = 0;
+        for (&z) |*v| {
+            v.* = exp(v.* - max_z);
+            sum += v.*;
+        }
+        conf[d] = z[pick] / sum;
+        product *= conf[d];
+        if (costs == null and d > 0 and product < policy.threshold) break;
+        prev = candidates[d * k + pick].id;
+        out[count] = prev;
+        count += 1;
+    }
+    return if (costs) |ms| try bestDepth(conf[0..count], ms) else count;
+}
+test "merge rank ordered values and bitcast IDs, reject corrupt IDs" {
+    var out: [2]Candidate = undefined;
+    const g = [_]f32{ 5, 4, @bitCast(@as(u32, 9)), @bitCast(@as(u32, 2)), 5, 3, @bitCast(@as(u32, 1)), @bitCast(@as(u32, 3)) };
+    try merge(&g, 2, 1, 2, 10, &out);
+    try std.testing.expectEqual(@as(u32, 1), out[0].id);
+    try std.testing.expectEqual(@as(u32, 9), out[1].id);
+    try std.testing.expectError(error.BadCandidates, merge(&g, 2, 1, 2, 5, &out));
+}
+test "fnc always keeps first, cumulative noisy confidence stops later drafts" {
+    const p = try Policy.parse("fnc7:0.3");
+    var cs: [112]Candidate = undefined;
+    for (&cs, 0..) |*c, i| c.* = .{ .id = @intCast(i % 16), .value = 0 };
+    const code: [16]f32 = @splat(0);
+    const proj: [7]f32 = @splat(0);
+    var out: [7]u32 = undefined;
+    try std.testing.expectEqual(@as(usize, 1), try chain(&cs, &proj, .{ .pred = &code, .succ = &code, .rank = 1 }, 0, 22, null, p, &out, null));
+    try std.testing.expectEqual(@as(usize, 7), try chain(&cs, &proj, .{ .pred = &code, .succ = &code, .rank = 1 }, 0, 22, null, .{ .threshold = 0 }, &out, null));
+    try std.testing.expectEqual(@as(usize, 1), try bestDepth(&.{ 0.9, 0.1 }, &.{ 1, 1.1, 2 }));
+}
diff --git a/zig/src/families/glm_cuda/cuda_engine.zig b/zig/src/families/glm_cuda/cuda_engine.zig
new file mode 100644
index 00000000..f9af7c04
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_engine.zig
@@ -0,0 +1,1170 @@
+//! GLM CUDA decode engine: P4 KDA inside P6 forward, P7 rounds, lanes and sampler.
+//! Prompt prefill is package P8. DFlash2 drafts are package P9. Triton cubins are package P1.
+//! A missing piece returns its error. This file does not substitute that math.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const aot = cuda.aot;
+const cfgs = @import("cuda_config.zig");
+const weights = @import("cuda_weights.zig");
+const model_weights = @import("cuda_model_weights.zig");
+const state = @import("cuda_state.zig");
+const seg = @import("cuda_segments.zig");
+const kda = @import("cuda_kda.zig");
+const mm = @import("cuda_matmuls.zig");
+const hc = @import("cuda_hc.zig");
+const tri = @import("cuda_triton.zig");
+const fwd = @import("cuda_forward.zig");
+const verify = @import("cuda_verify.zig");
+const side_mod = @import("cuda_side.zig");
+const prompt_micro = @import("cuda_prompt_micro.zig");
+const prefill_split = @import("cuda_prefill_split.zig");
+const rounds = @import("cuda_rounds.zig");
+const sampler = @import("cuda_sampler.zig");
+const grammar = @import("cuda_grammar.zig");
+const comm = @import("cuda_comm.zig");
+const mirror = @import("cuda_mirror.zig");
+const ops = @import("cuda_torch_ops.zig");
+const prefill_mod = @import("cuda_prefill.zig");
+const prefill_loop = @import("cuda_prefill_loop.zig");
+const draft_pkg = @import("cuda_dflash_package.zig");
+const dflash = @import("cuda_dflash.zig");
+const dflash_config = @import("cuda_dflash_config.zig");
+const snapshot = @import("cuda_snapshot.zig");
+const cache_plan = @import("cuda_cache_plan.zig");
+const spill_mod = @import("cuda_spill.zig");
+const mtp_mod = @import("cuda_mtp.zig");
+const choice_mod = @import("cuda_mtp_choice.zig");
+const vision_tower = @import("cuda_vision.zig");
+const G = state.Geometry;
+const pool_mod = @import("cuda_pool.zig");
+const capacity = @import("cuda_pool_capacity.zig");
+const display = @import("cuda_display_kv.zig");
+
+pub const Options = struct {
+    context: usize,
+    drafts: bool,
+    streams: usize = 1,
+    rank: u32 = 0,
+    world: u32 = 1,
+    comm: ?*const comm.Comm = null,
+    /// Skip graph capture. The first forward still runs the real kernels and fails closed on a missing cubin.
+    eager: bool = false,
+    draft_dir: ?[]const u8 = null,
+    draft_choice: ?choice_mod.Choice = null,
+    /// picture and clip input; rank 0 also loads the tower (the Zig backend; the Python backend brings features)
+    vision: bool = false,
+    tower: bool = false,
+};
+
+/// `tag`: the id of the kept state this sequence's caches stand at (set when it is saved from or restored into the
+/// sequence; the position tells whether anything was written since), so a resume of the same state skips the copy.
+/// `eid`: the shared KV pool extent this sequence holds.
+pub const Seq = struct { slot: usize, st: state.State, alive: bool = false, tag: u64 = 0, eid: ?u64 = null };
+/// A kept prompt state (cuda_snapshot.zig): one device buffer holding the sequence's state after `pos` tokens.
+/// `refs`: the owner's, and one for each background write that reads the buffer (the last release frees it).
+pub const Snap = struct { id: u64 = 0, pos: usize = 0, mtp_len: usize = 0, buf: ?cuda.DeviceBuffer = null, sec: snapshot.Sections = undefined, refs: std.atomic.Value(u32) = .init(1) };
+const SpillJob = struct { snap: *Snap, tokens: []u32, at: u32, key: u64 };
+/// `mask`: structured output's bits for the first token (one row, the grammar's words); empty: unconstrained.
+/// `media`: picture and clip rows for this prompt.
+pub const PrefillOptions = struct { keep_at: ?usize = null, resume_from: ?*const Snap = null, mask: []const u32 = &.{}, media: ?*const lanes.Media = null };
+pub const Prefilled = struct { first: u32, kept: ?*Snap = null };
+
+/// A prompt's feature rows while it prefills: the prompt rows they replace (host copy, ascending) and the device
+/// copies of both. Every rank holds them (rank 1 by broadcast).
+const Attached = struct {
+    host_rows: []u32,
+    rows: cuda.DeviceBuffer,
+    feats: cuda.DeviceBuffer,
+};
+
+pub const media_width: usize = 4096;
+
+pub const Engine = struct {
+    /// Lane code looks these up on the engine type (E.Window, E.DraftReq, E.ManyPrompt).
+    pub const Window = struct { seq: *Seq, tokens: []const u32 };
+    pub const DraftSource = union(enum) { prefill_last, window: usize };
+    pub const DraftReq = struct {
+        seq: *Seq,
+        source: DraftSource,
+        next: []const u32,
+        count: usize,
+        sampling: ?lanes.Sampling = null,
+        confidence: f64 = 0,
+        out: []u32,
+        drafted: usize = 0,
+    };
+    /// Kept states are device buffers of their own (takeSnap / restoreSnap); the lanes keep no keeper sequence.
+    pub const snap_holds_rows = true;
+    pub const ManyPrompt = struct { seq: *Seq, prompt: []const u32, sampling: ?lanes.Sampling };
+
+    gpa: std.mem.Allocator,
+    g: G,
+    context: usize,
+    window: usize,
+    drafts: bool,
+    drafter: ?*draft_pkg.Package = null,
+    mtp: ?mtp_mod.Head = null,
+    draft_choice: choice_mod.Choice = .dflash2,
+    prompt_tokens: []const u32 = &.{},
+    prompt_at: usize = 0,
+    lt: ?cuda.cublaslt.Library = null,
+    prefill_rows: usize = 2048,
+    cfg: cfgs.Config,
+    cat: weights.Catalog,
+    plan: weights.Plan,
+    prepared: model_weights.Prepared,
+    set: aot.Set,
+    kda_k: kda.Kernels,
+    entries: mm.Entries,
+    torch: ops.Ops,
+    stream: cuda.Stream,
+    slots: state.Slots,
+    caches: state.Caches,
+    pool: pool_mod.Pool,
+    pool_free: std.atomic.Value(usize) = .init(0),
+    tables: seg.SegRows,
+    memo: tri.Memo,
+    fwd: fwd.Forward,
+    side: ?side_mod.Side = null,
+    verify: verify.Verify,
+    pe: prefill_mod.Engine,
+    sampler: sampler.Sampler,
+    comm: ?*const comm.Comm = null,
+    seqs: [8]Seq = undefined,
+    used: [8]bool = @splat(false),
+    bound: ?*Seq = null,
+    sampling: ?lanes.Sampling = null,
+    round_n: usize = 0,
+    round_row0: [8]usize = @splat(0),
+    round_len: [8]usize = @splat(0),
+    committed: [8]bool = @splat(false),
+    host_tokens: [8][64]i32 = undefined,
+    round_st: [8]*state.State = undefined,
+    commit_words: [48]i32 = @splat(0),
+    commit_nseg: usize = 0,
+    /// structured output's logits mask, loaded at the first constrained draw
+    gmask: ?grammar.Mask = null,
+    /// the last kept state's id (Snap.id, Seq.tag)
+    snap_next: u64 = 0,
+    /// MEMORY_RESERVE_GIB in bytes: a kept state is refused when the machine would be left under it (0: no check)
+    keep_reserve: u64 = 0,
+    /// the spill tier (SPILL_GIB; null: off), opened by cuda_native and owned by the engine
+    spill: ?*spill_mod.Tier = null,
+    /// the CUDA context: the prompt cache's calls run on the lane host's thread, which may not have made it current yet
+    ctx: ?*const cuda.Context = null,
+    /// the spill tier's writer: jobs wait here for its thread, which copies a state off the device and into its file
+    spill_jobs: std.ArrayList(SpillJob) = .empty,
+    spill_mu: std.atomic.Mutex = .unlocked,
+    spill_thread: ?std.Thread = null,
+    spill_quit: std.atomic.Value(bool) = .init(false),
+    /// jobs queued or running
+    spill_busy: std.atomic.Value(u32) = .init(0),
+    /// how long a clean stop waits for the writer (SPILL_FLUSH_S)
+    spill_wait_ns: u64 = 60 * std.time.ns_per_s,
+    /// the tokens of the stored state `spillBest` last found (the lane thread's)
+    spill_hit: std.ArrayList(u32) = .empty,
+    /// the prompt in prefill when it has pictures or clips: the tower's rows, on the device (every rank)
+    media: ?Attached = null,
+    vision: bool = false,
+    /// rank 0 with --vision-backend zig: the vision tower (null: the server brings the features)
+    tower: ?vision_tower.Tower = null,
+
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: []const u8, o: Options) !*Engine {
+        if (o.world < 1 or o.world > 4) return error.UnsupportedTp;
