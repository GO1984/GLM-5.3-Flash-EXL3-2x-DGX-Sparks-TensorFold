+    try std.testing.expectEqual(Seg{ .row0 = 3, .rows = 2, .slot = 4, .parity = 1, .conv = 7, .keep = 1 }, out[1]);
+    try std.testing.expectEqual(Seg{ .row0 = 5, .rows = 0, .slot = 0, .parity = 0, .conv = 0, .keep = 0 }, out[2]);
