diff --git a/zig/src/families/glm_cuda/cuda_quantize.zig b/zig/src/families/glm_cuda/cuda_quantize.zig
new file mode 100644
index 00000000..72786ab9
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_quantize.zig
@@ -0,0 +1,261 @@
+//! Port of glm5_next/cuda/qmm.py quantize4_mse_raw, make_f8 and cuda/kernels/qmm.py pack.
+//! Authored by Ash Hart and TensorFold contributors; numeric conversion helpers from TensorFold's Flash Next port.
+const std = @import("std");
+pub fn f32Bits(x: f32) u32 {
+    return @bitCast(x);
+}
+
+pub fn bitsF32(b: u32) f32 {
+    return @bitCast(b);
+}
+
+pub fn bf16ToF32(b: u16) f32 {
+    return @bitCast(@as(u32, b) << 16);
+}
+
+/// fp32 -> bf16, round to nearest even; NaN -> 0x7FC0 (c10::BFloat16's round_to_nearest_even).
+pub fn bf16Rne(x: f32) u16 {
+    const u = f32Bits(x);
+    if (std.math.isNan(x)) return 0x7FC0;
+    const r = u +% 0x7FFF +% ((u >> 16) & 1);
+    return @intCast(r >> 16);
+}
+
+/// e4m3fn byte -> its exact fp32 value (no infinities; 0x7F and 0xFF are NaN).
+pub fn e4m3ToF32(b: u8) f32 {
+    const e: u32 = (b >> 3) & 0xF;
+    const m: u32 = b & 0x7;
+    const sign: u32 = @as(u32, b & 0x80) << 24;
+    if (e == 15 and m == 7) return bitsF32(0x7FC00000 | sign);
+    if (e == 0) {
+        const v: f32 = @as(f32, @floatFromInt(m)) * (1.0 / 512.0); // m * 2**-9, exact
+        return bitsF32(f32Bits(v) | sign);
+    }
+    return bitsF32(sign | ((e + 120) << 23) | (m << 20));
+}
+
+/// fp32 -> e4m3fn, round to nearest even, as c10's fp8e4m3fn_from_fp32_value (|x| >= 480 -> NaN 0x7F).
+pub fn f32ToE4m3(x: f32) u8 {
+    var bits = f32Bits(x);
+    const sign = bits & 0x80000000;
+    bits ^= sign;
+    var out: u8 = undefined;
+    if (bits >= (@as(u32, 1087) << 20)) {
+        out = 0x7F;
+    } else if (bits < (@as(u32, 121) << 23)) {
+        const denorm: u32 = @as(u32, 141) << 23;
+        const sum = bitsF32(bits) + bitsF32(denorm);
+        out = @intCast(f32Bits(sum) - denorm);
+    } else {
+        const odd = (bits >> 20) & 1;
+        bits = bits -% (@as(u32, 120) << 23) +% 0x7FFFF; // the exponent rebased by 7 - 127, then RNE
+        bits +%= odd;
+        out = @truncate(bits >> 20);
+    }
+    return out | @as(u8, @intCast(sign >> 24));
+}
+
+pub fn roundEven(x: f32) f32 {
+    const a = @floor(x);
+    const d = x - a;
+    return if (d < 0.5 or (d == 0.5 and @mod(a, 2) == 0)) a else a + 1;
+}
+fn code(x: f32, s: f32, b: f32) u32 {
+    return @intFromFloat(std.math.clamp(roundEven((x - b) / s), 0, 15));
+}
+/// Input BF16 [n,k]; raw MLX words [n,k/8], scales and biases [n,k/64].
+/// MSE sum uses a fixed binary tree; CUDA ATen reduction parity must be verified before loader integration.
+pub fn quantize4(rows: []const u16, n: usize, k: usize, words: []u32, scales: []u16, biases: []u16, mse: bool) void {
+    @setFloatMode(.strict);
+    std.debug.assert(k % 64 == 0 and rows.len == n * k and words.len == n * k / 8 and scales.len == n * k / 64 and biases.len == scales.len);
+    const kg = k / 64;
+    for (0..n * kg) |g| {
+        const x = rows[g * 64 ..][0..64];
+        var lo: f32 = std.math.inf(f32);
+        var hi: f32 = -std.math.inf(f32);
+        for (x) |v| {
+            const w = bf16ToF32(v);
+            lo = @min(lo, w);
+            hi = @max(hi, w);
+        }
+        var best: f32 = std.math.inf(f32);
+        var bs: u16 = 0;
+        var bb: u16 = 0;
+        for (0..if (mse) @as(usize, 16) else 1) |i| {
+            const a: f32 = @floatCast(1.0 - 0.45 * @as(f64, @floatFromInt(i)) / 15.0);
+            const l = lo * a;
+            const h = hi * a;
+            const sb = bf16Rne(@max((h - l) / 15.0, 1e-8));
+            const bi = bf16Rne(l);
+            const s = bf16ToF32(sb);
+            const b = bf16ToF32(bi);
+            var errs: [64]f32 = undefined;
+            for (x, &errs) |v, *e| {
+                const w = bf16ToF32(v);
+                const q: f32 = @floatFromInt(code(w, s, b));
+                const d = q * s + b - w;
+                e.* = d * d;
+            }
+            var step: usize = 32;
+            while (step > 0) : (step /= 2) for (0..step) |j| {
+                errs[j] += errs[j + step];
+            };
+            if (i == 0 or errs[0] < best) {
+                best = errs[0];
+                bs = sb;
+                bb = bi;
+            }
+        }
+        scales[g] = bs;
+        biases[g] = bb;
+        for (0..8) |j| {
+            var w: u32 = 0;
+            for (0..8) |p| w |= code(bf16ToF32(x[j * 8 + p]), bf16ToF32(bs), bf16ToF32(bb)) << @as(u5, @intCast(p * 4));
+            words[g * 8 + j] = w;
+        }
+    }
+}
+/// Tile permutation [npad/64, k/64, 8,32,2], and group-major scale/bias arrays, n padded to 128.
+pub fn pack(words: []const u32, scales: []const u16, biases: []const u16, n: usize, k: usize, out: []u32, so: []u16, bo: []u16) void {
+    const npad = (n + 127) / 128 * 128;
+    const kg = k / 64;
+    std.debug.assert(k % 64 == 0 and out.len == npad * k / 8 and so.len == npad * kg and bo.len == so.len);
+    @memset(out, 0);
+    @memset(so, 0);
+    @memset(bo, 0);
+    packRows(words, scales, biases, n, k, out, so, bo, 0, n);
+}
+/// pack for source rows r0..r1 only (the outputs of different rows are disjoint; the caller zeroed them).
+pub fn packRows(words: []const u32, scales: []const u16, biases: []const u16, n: usize, k: usize, out: []u32, so: []u16, bo: []u16, r0: usize, r1: usize) void {
+    const npad = (n + 127) / 128 * 128;
+    const kg = k / 64;
+    const offsets = [_]usize{ 0, 8, 16, 24, 1, 9, 17, 25 };
+    for (r0..r1) |r| for (0..kg) |g| {
+        so[g * npad + r] = scales[r * kg + g];
+        bo[g * npad + r] = biases[r * kg + g];
+        for (0..4) |c| for (0..2) |v| {
+            var w: u32 = 0;
+            for (offsets, 0..) |off, p| {
+                const col = g * 64 + v * 32 + 2 * c + off;
+                const q = (words[r * (k / 8) + col / 8] >> @as(u5, @intCast((col % 8) * 4))) & 15;
+                w |= q << @as(u5, @intCast(p * 4));
+            }
+            out[((r / 64 * kg + g) * 8 + r % 64 / 8) * 64 + (r % 8 * 4 + c) * 2 + v] = w;
+        };
+    };
+}
+pub fn makeF8(rows: []const u16, codes: []u8, scales: []f32) void {
+    @setFloatMode(.strict);
+    std.debug.assert(rows.len % 128 == 0 and codes.len == rows.len and scales.len == rows.len / 128);
+    for (scales, 0..) |*s, g| {
+        var top: f32 = 0;
+        for (rows[g * 128 ..][0..128]) |v| top = @max(top, @abs(bf16ToF32(v)));
+        // ATen divides a tensor by a Python scalar as a multiply by the fp32 reciprocal.
+        const recip: f32 = 1.0 / 448.0;
+        s.* = @max(top * recip, 1e-30);
+        for (0..128) |j| codes[g * 128 + j] = f32ToE4m3(std.math.clamp(bf16ToF32(rows[g * 128 + j]) / s.*, -448, 448));
+    }
+}
+/// Checkpoint int16 trellis bits, [K/16,N/16,64], viewed little endian int32 without reordering.
+pub fn trellisWords(src: []const u16, dst: []u32) void {
+    std.debug.assert(src.len == dst.len * 2);
+    for (dst, 0..) |*w, i| w.* = @as(u32, src[2 * i]) | (@as(u32, src[2 * i + 1]) << 16);
+}
+pub fn sharedSuh(suh: []const u16, up: []const u16, experts: usize, k: usize) bool {
+    if (!std.mem.eql(u16, suh, up)) return false;
+    std.debug.assert(suh.len == experts * k and experts > 0);
+    for (1..experts) |e| if (!std.mem.eql(u16, suh[0..k], suh[e * k ..][0..k])) return false;
+    return true;
+}
+test "MSE ties, padded pack, FP8 and trellis" {
+    var x: [64]u16 = @splat(bf16Rne(1));
+    var w: [8]u32 = undefined;
+    var s: [1]u16 = undefined;
+    var b: [1]u16 = undefined;
+    quantize4(&x, 1, 64, &w, &s, &b, true);
+    try std.testing.expectEqual(bf16Rne(1), b[0]);
+    try std.testing.expectEqual(@as(u32, 0), w[0]);
+    var out: [1024]u32 = undefined;
+    var so: [128]u16 = undefined;
+    var bo: [128]u16 = undefined;
+    pack(&w, &s, &b, 1, 64, &out, &so, &bo);
+    try std.testing.expectEqual(b[0], bo[0]);
+    try std.testing.expectEqual(@as(u16, 0), bo[1]);
+    var t: [1]u32 = undefined;
+    trellisWords(&.{ 0x1234, 0xabcd }, &t);
+    try std.testing.expectEqual(@as(u32, 0xabcd1234), t[0]);
+    try std.testing.expectEqual(@as(f32, 2), roundEven(2.5));
+    try std.testing.expectEqual(@as(f32, 4), roundEven(3.5));
+    var fp: [128]u8 = undefined;
+    var fs: [1]f32 = undefined;
+    const fx: [128]u16 = @splat(bf16Rne(448));
+    makeF8(&fx, &fp, &fs);
+    try std.testing.expectEqual(@as(f32, 1), fs[0]);
+    try std.testing.expectEqual(@as(u8, 0x7e), fp[0]);
+}
+test "nonzero g64 permutation across N padding and multiple K groups" {
+    const n = 65;
+    const k = 128;
+    const npad = 128;
+    var words: [n * k / 8]u32 = @splat(0);
+    var sc: [n * k / 64]u16 = undefined;
+    var bi: [n * k / 64]u16 = undefined;
+    for (0..n) |r| for (0..k) |c| {
+        const nib: u32 = @intCast((r * 3 + c / 32 + c * 7) % 16);
+        words[r * k / 8 + c / 8] |= nib << @as(u5, @intCast(4 * (c % 8)));
+    };
+    for (&sc, &bi, 0..) |*s, *b, i| {
+        s.* = @intCast(i + 1);
+        b.* = @intCast(1000 + i);
+    }
+    var dst: [npad * k / 8]u32 = undefined;
+    var so: [npad * k / 64]u16 = undefined;
+    var bo: [npad * k / 64]u16 = undefined;
+    pack(&words, &sc, &bi, n, k, &dst, &so, &bo);
+    const offsets = [_]usize{ 0, 8, 16, 24, 1, 9, 17, 25 };
+    for (dst, 0..) |w, idx| {
+        const v = idx % 2;
+        const lane = idx / 2 % 32;
+        const j = idx / 64 % 8;
+        const group = idx / 512 % 2;
+        const block = idx / 1024;
+        const r = block * 64 + j * 8 + lane / 4;
+        for (offsets, 0..) |off, p| {
+            const c = group * 64 + v * 32 + 2 * (lane % 4) + off;
+            const expected: u32 = if (r < n) @intCast((r * 3 + c / 32 + c * 7) % 16) else 0;
+            try std.testing.expectEqual(expected, (w >> @as(u5, @intCast(4 * p))) & 15);
+        }
+    }
+    for (0..2) |g| for (0..npad) |r| {
+        try std.testing.expectEqual(if (r < n) sc[r * 2 + g] else @as(u16, 0), so[g * npad + r]);
+        try std.testing.expectEqual(if (r < n) bi[r * 2 + g] else @as(u16, 0), bo[g * npad + r]);
+    };
+}
+test "shared gate and up suh compares bits including signed zero" {
+    try std.testing.expect(sharedSuh(&.{ 0, 0x8000, 0, 0x8000 }, &.{ 0, 0x8000, 0, 0x8000 }, 2, 2));
+    try std.testing.expect(!sharedSuh(&.{ 0, 0x8000, 0, 0x8000 }, &.{ 0, 0, 0, 0 }, 2, 2));
+    try std.testing.expect(!sharedSuh(&.{ 0, 0, 0, 0x8000 }, &.{ 0, 0, 0, 0x8000 }, 2, 2));
+}
+test "MSE clipping improves an outlier group over the full range" {
+    var x: [64]u16 = undefined;
+    for (&x, 0..) |*v, i| v.* = bf16Rne(if (i == 63) @as(f32, 4) else @as(f32, @floatFromInt(i % 9)) * 0.0625 - 0.25);
+    var w: [8]u32 = undefined;
+    var s: [1]u16 = undefined;
+    var b: [1]u16 = undefined;
+    var mw: [8]u32 = undefined;
+    var ms: [1]u16 = undefined;
+    var mb: [1]u16 = undefined;
+    quantize4(&x, 1, 64, &w, &s, &b, false);
+    quantize4(&x, 1, 64, &mw, &ms, &mb, true);
+    var err: f32 = 0;
+    var merr: f32 = 0;
+    for (x, 0..) |v, i| {
+        const q: f32 = @floatFromInt((w[i / 8] >> @as(u5, @intCast(i % 8 * 4))) & 15);
+        const mq: f32 = @floatFromInt((mw[i / 8] >> @as(u5, @intCast(i % 8 * 4))) & 15);
+        const d = q * bf16ToF32(s[0]) + bf16ToF32(b[0]) - bf16ToF32(v);
+        const md = mq * bf16ToF32(ms[0]) + bf16ToF32(mb[0]) - bf16ToF32(v);
+        err += d * d;
+        merr += md * md;
+    }
+    try std.testing.expect(merr <= err);
+}
diff --git a/zig/src/families/glm_cuda/cuda_ring_exchange.zig b/zig/src/families/glm_cuda/cuda_ring_exchange.zig
new file mode 100644
index 00000000..90b615b7
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_ring_exchange.zig
@@ -0,0 +1,185 @@
+//! The routing of the Python engine's ring exchange (tensorfold/cuda/comm.py `_exchange_ring` / `_ring_links`, recipe
+//! patches 0098 renumbered 0112 in the v1.11 tree): an all-to-all of row blocks on a ring of ranks cabled to their two
+//! neighbours only. A message from rank s to rank t goes the shorter way round, one hop a step; to the rank opposite
+//! (N even) half of each tensor goes each way (the first `numel / 2` elements clockwise). floor(N / 2) steps: in step h
+//! every rank runs one two-rank all-gather on each of its two links, carrying what leaves that way on its h-th hop.
+//!
+//! This file holds the schedule alone (which bytes cross which link in which step, in the one order both ends of a link
+//! list them), as pure functions with a byte-level simulation test, so the NCCL half (neighbour communicators, graph
+//! files, a stream a link, events between hops) can be written against a checked plan. The Zig GLM prefill does not
+//! split rows yet (it gathers whole fp32 partials: HANDOFF-ZIG.md P8b), so nothing calls this on the GPU today.
+const std = @import("std");
+
+pub const max_ranks = 4;
+pub const max_tensors = 4;
+pub const max_msgs = max_ranks * max_tensors * 2;
+
+/// One message (or one half of one): destination rank, tensor index, element range, and the hops it travels.
+pub const Msg = struct { t: u8, i: u8, lo: usize, hi: usize, hops: u8 };
+
+pub const Moving = struct {
+    n: usize = 0,
+    msgs: [max_msgs]Msg = undefined,
+};
+
+const Seg = struct { lo: usize, hi: usize, dir: i8, hops: u8 };
+
+/// The segments of the message s -> t of tensor i with `numel` elements: (lo, hi, direction, hops).
+fn segments(n_ranks: usize, s: usize, t: usize, numel: usize, out: *[2]Seg) usize {
+    const d = (t + n_ranks - s) % n_ranks;
+    if (2 * d < n_ranks) {
+        out[0] = .{ .lo = 0, .hi = numel, .dir = 1, .hops = @intCast(d) };
+        return 1;
+    }
+    if (2 * d > n_ranks) {
+        out[0] = .{ .lo = 0, .hi = numel, .dir = -1, .hops = @intCast(n_ranks - d) };
+        return 1;
+    }
+    out[0] = .{ .lo = 0, .hi = numel / 2, .dir = 1, .hops = @intCast(d) };
+    out[1] = .{ .lo = numel / 2, .hi = numel, .dir = -1, .hops = @intCast(d) };
+    return 2;
+}
+
+/// The messages from `src` that travel `direction` (+1: to the next rank) on their h-th hop, in the one order both ends
+/// of a link list them: by destination, tensor, segment. `numel[i]` is tensor i's element count, the same for every
+/// peer (row blocks of equal shares), so a relaying rank knows each message's size.
+pub fn moving(n_ranks: usize, numel: []const usize, src: usize, direction: i8, h: u8) Moving {
+    var m: Moving = .{};
+    for (0..n_ranks) |t| {
+        if (t == src) continue;
+        for (numel, 0..) |ne, i| {
+            var segs: [2]Seg = undefined;
+            const k = segments(n_ranks, src, t, ne, &segs);
+            for (segs[0..k]) |sg| {
+                if (sg.dir == direction and sg.hops >= h and sg.hi > sg.lo) {
+                    m.msgs[m.n] = .{ .t = @intCast(t), .i = @intCast(i), .lo = sg.lo, .hi = sg.hi, .hops = sg.hops };
+                    m.n += 1;
+                }
+            }
+        }
+    }
+    return m;
+}
+
+/// What rank `me` sends on its link toward `direction` in step h and what arrives there: the source of the bytes that
+/// leave (which `held` entries or, in step 1, which `sends` it packs) and of those that arrive.
+pub const Step = struct { src_out: usize, src_in: usize, leave: Moving, arrive: Moving };
+
+pub fn step(n_ranks: usize, numel: []const usize, me: usize, direction: i8, h: u8) Step {
+    const n: i64 = @intCast(n_ranks);
+    const d: i64 = direction;
+    const src_out: usize = @intCast(@mod(@as(i64, @intCast(me)) - d * (h - 1), n));
+    const src_in: usize = @intCast(@mod(@as(i64, @intCast(me)) + d * h, n));
+    return .{ .src_out = src_out, .src_in = src_in, .leave = moving(n_ranks, numel, src_out, direction, h), .arrive = moving(n_ranks, numel, src_in, -direction, h) };
+}
+
+/// The launch order of a rank's two links in a step (so link kernels that cannot run at once never wait on each other
+/// round the ring): the link to the previous rank first, except on rank 0, whose link 0 (to the next rank) comes first.
+pub fn linkOrder(n_ranks: usize, me: usize) [2]i8 {
+    const to_prev = (me + n_ranks - 1) % n_ranks;
+    // sort by the index of the link: link a joins rank a and rank a + 1; the link toward the next rank is `me`, toward the
+    // previous one `me - 1`
+    return if (to_prev < me) .{ -1, 1 } else .{ 1, -1 };
+}
+
+fn Sim(comptime elem: usize) type {
+    return struct {
+        const Self = @This();
+        n: usize,
+        numel: []const usize,
+        // sends[rank][peer][tensor] -> bytes
+        sends: [max_ranks][max_ranks][max_tensors][]u8 = undefined,
+        recvs: [max_ranks][max_ranks][max_tensors][]u8 = undefined,
+
+        fn chunk(self: *Self, s: usize, t: usize, i: usize, lo: usize, hi: usize) []u8 {
+            return self.sends[s][t][i][lo * elem .. hi * elem];
+        }
+    };
+}
+
+test "the ring exchange delivers every message to its rank, for 2 to 4 ranks and odd sizes" {
+    const gpa = std.testing.allocator;
+    for ([_]usize{ 2, 3, 4 }) |n_ranks| {
+        for ([_][]const usize{ &.{7}, &.{5, 12}, &.{1, 2, 3} }) |numel| {
+            const elem = 4;
+            var arena = std.heap.ArenaAllocator.init(gpa);
+            defer arena.deinit();
+            const a = arena.allocator();
+            var sim: Sim(elem) = .{ .n = n_ranks, .numel = numel };
+            for (0..n_ranks) |s| for (0..n_ranks) |t| for (numel, 0..) |ne, i| {
+                sim.sends[s][t][i] = try a.alloc(u8, ne * elem);
+                sim.recvs[s][t][i] = try a.alloc(u8, ne * elem);
+                @memset(sim.recvs[s][t][i], 0);
+                for (sim.sends[s][t][i], 0..) |*b, k| b.* = @intCast((s * 61 + t * 29 + i * 13 + k * 5 + 1) & 0xff);
+            };
+            // held[rank]: relayed bytes keyed by (src, t, i, lo)
+            const Key = struct { s: usize, t: usize, i: usize, lo: usize };
+            var held: [max_ranks]std.AutoHashMap(Key, []u8) = undefined;
+            for (0..n_ranks) |r| held[r] = std.AutoHashMap(Key, []u8).init(a);
+            var h: u8 = 1;
+            while (h <= n_ranks / 2) : (h += 1) {
+                // every rank's packed bytes this step, per link direction, then what its neighbours read
+                var wire: [max_ranks][2][]u8 = undefined; // wire[rank][0: toward +1, 1: toward -1]
+                for (0..n_ranks) |me| for ([_]i8{ 1, -1 }) |dir| {
+                    const st = step(n_ranks, numel, me, dir, h);
+                    var total: usize = 0;
+                    for (st.leave.msgs[0..st.leave.n]) |m| total += (m.hi - m.lo) * elem;
+                    const buf = try a.alloc(u8, total);
+                    var at: usize = 0;
+                    for (st.leave.msgs[0..st.leave.n]) |m| {
+                        const bytes = if (h == 1) sim.chunk(me, m.t, m.i, m.lo, m.hi) else held[me].get(.{ .s = st.src_out, .t = m.t, .i = m.i, .lo = m.lo }).?;
+                        if (h != 1) _ = held[me].remove(.{ .s = st.src_out, .t = m.t, .i = m.i, .lo = m.lo });
+                        @memcpy(buf[at..][0..bytes.len], bytes);
+                        at += bytes.len;
+                    }
+                    wire[me][if (dir == 1) 0 else 1] = buf;
+                };
+                for (0..n_ranks) |me| for ([_]i8{ 1, -1 }) |dir| {
+                    const st = step(n_ranks, numel, me, dir, h);
+                    const neighbour = st.src_in; // not always the neighbour: the bytes' source; the link's other end is me + dir
+                    _ = neighbour;
+                    const other = (me + n_ranks + @as(usize, if (dir == 1) 1 else n_ranks - 1)) % n_ranks;
+                    // the neighbour sent on its link toward -dir
+                    const theirs = wire[other][if (dir == 1) 1 else 0];
+                    var at: usize = 0;
+                    for (st.arrive.msgs[0..st.arrive.n]) |m| {
+                        const bytes = theirs[at..][0 .. (m.hi - m.lo) * elem];
+                        at += bytes.len;
+                        if (m.hops == h) {
+                            try std.testing.expectEqual(@as(usize, m.t), me);
+                            @memcpy(sim.recvs[me][st.src_in][m.i][m.lo * elem .. m.hi * elem], bytes);
+                        } else {
+                            try held[me].put(.{ .s = st.src_in, .t = m.t, .i = m.i, .lo = m.lo }, bytes);
+                        }
+                    }
+                    try std.testing.expectEqual(theirs.len, at);
+                };
+            }
+            for (0..n_ranks) |r| try std.testing.expectEqual(@as(u32, 0), held[r].count());
+            for (0..n_ranks) |t| for (0..n_ranks) |s| {
+                if (s == t) continue;
+                for (numel, 0..) |_, i| try std.testing.expectEqualSlices(u8, sim.sends[s][t][i], sim.recvs[t][s][i]);
+            };
+        }
+    }
+}
+
+test "at four ranks the opposite rank's tensor splits at numel / 2 and takes two hops" {
+    const m = moving(4, &.{7}, 0, 1, 1);
+    // to rank 1 (1 hop clockwise) all 7; to rank 2 (opposite) the first 3; to rank 3 the other way, so not here
+    try std.testing.expectEqual(@as(usize, 2), m.n);
+    try std.testing.expectEqual(@as(u8, 1), m.msgs[0].t);
+    try std.testing.expectEqual(@as(usize, 7), m.msgs[0].hi);
+    try std.testing.expectEqual(@as(u8, 2), m.msgs[1].t);
+    try std.testing.expectEqual(@as(usize, 3), m.msgs[1].hi);
+    // in the second hop only the opposite rank's half is still on its way
+    try std.testing.expectEqual(@as(usize, 1), moving(4, &.{7}, 0, 1, 2).n);
+    const back = moving(4, &.{7}, 0, -1, 1);
+    try std.testing.expectEqual(@as(usize, 2), back.n); // rank 3 (1 hop) and the opposite rank's second half
+    try std.testing.expectEqual(@as(usize, 3), back.msgs[0].lo);
+}
+
+test "link launch order: the link to the previous rank first, rank 0 starts with link 0" {
+    try std.testing.expectEqual([2]i8{ 1, -1 }, linkOrder(4, 0));
+    for (1..4) |me| try std.testing.expectEqual([2]i8{ -1, 1 }, linkOrder(4, me));
+}
diff --git a/zig/src/families/glm_cuda/cuda_rounds.zig b/zig/src/families/glm_cuda/cuda_rounds.zig
new file mode 100644
index 00000000..4a12114f
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_rounds.zig
@@ -0,0 +1,157 @@
+//! glm5_next/cuda/{multi.py:_round,verify.py:BatchedVerify.commit}.
+//! Ash Hart and TensorFold contributors. P6 supplies forward/replay launches;
+//! _conv_shift_seg stays Triton and is replayed by P1, never reimplemented here.
+const std = @import("std");
+const State = @import("cuda_state.zig").State;
+pub const Window = struct { state: *State, tokens: []const u32, eos: []const u32 = &.{} };
+/// keep = 1 + matching draft prefix, stopping before feeding an EOS draw.
+pub fn accept(tokens: []const u32, sampled: []const u32, eos: []const u32) !usize {
+    if (tokens.len == 0 or sampled.len != tokens.len) return error.BadWindow;
+    var keep: usize = 1;
+    for (tokens[1..], sampled[0 .. sampled.len - 1]) |draft, drawn| {
+        if (draft != drawn or std.mem.indexOfScalar(u32, eos, drawn) != null) break;
+        keep += 1;
+    }
+    return keep;
+}
+/// Per-segment KDA table entries (verify.py:_tables): row0, rows, slot,
+/// parity, conv slot, keep. All recurrent layers have the same parity.
+pub fn table(windows: []const Window, keeps: ?[]const usize, out: []i32) !usize {
+    if (windows.len == 0 or windows.len > 8 or out.len != windows.len * 6 or (keeps != null and keeps.?.len != windows.len)) return error.BadWindow;
+    var row0: usize = 0;
+    for (windows, 0..) |w, i| {
+        if (w.tokens.len == 0 or w.state.pos > w.state.capacity or w.tokens.len > w.state.capacity - w.state.pos) return error.BadWindow;
+        for (windows[0..i]) |prev| if (prev.state == w.state or prev.state.slot == w.state.slot) return error.DuplicateSlot;
+        for (w.state.cur) |cur| if (cur != w.state.cur[0]) return error.MixedParity;
+        const keep = if (keeps) |k| k[i] else w.tokens.len;
+        if (keep < 1 or keep > w.tokens.len) return error.BadKeep;
+        const fields = [_]usize{ row0, w.tokens.len, w.state.slot, w.state.cur[0], w.state.slot, keep };
+        for (fields, 0..) |x, j| {
+            if (x > std.math.maxInt(i32)) return error.BadWindow;
+            out[6 * i + j] = @intCast(x);
+        }
+        row0 += w.tokens.len;
+    }
+    return row0;
+}
+/// Backend E: forward(windows, table), sample(windows, out), stageCommit(table),
+/// replay(), convShift(), setPosition(state, pos), commitDrafts(windows, keeps).
+/// Device failures propagate; callers must stop a failed multi-rank engine.
+pub fn Round(comptime E: type) type {
+    return struct {
+        engine: *E,
+        limit: usize = 64,
+        active: bool = false,
+        windows: [8]Window = undefined,
+        count: usize = 0,
+        rows: usize = 0,
+        ktable: [48]i32 = undefined,
+        pub fn verify(r: *@This(), windows: []const Window, sampled: []u32) !void {
+            if (r.active) return error.UncommittedWindow;
+            if (windows.len == 0 or windows.len > 8) return error.BadWindow;
+            const rows = try table(windows, null, r.ktable[0 .. windows.len * 6]);
+            if (sampled.len != rows or rows > r.limit) return error.BadWindow;
+            try r.engine.forward(windows, r.ktable[0 .. windows.len * 6]);
+            try r.engine.sample(windows, sampled);
+            @memcpy(r.windows[0..windows.len], windows);
+            r.count = windows.len;
+            r.rows = rows;
+            r.active = true;
+        }
+        pub fn commit(r: *@This(), keeps: []const usize) !void {
+            if (!r.active or keeps.len != r.count) return error.NoVerifyWindow;
+            const windows = r.windows[0..r.count];
+            _ = try table(windows, keeps, r.ktable[0 .. r.count * 6]);
+            try r.engine.stageCommit(r.ktable[0 .. r.count * 6]);
+            var replay = false;
+            for (windows, keeps) |w, k| replay = replay or k < w.tokens.len;
+            if (replay) try r.engine.replay();
+            try r.engine.convShift();
+            for (windows, keeps) |w, k| try r.engine.setPosition(w.state, w.state.pos + k);
+            for (windows, keeps) |w, k| {
+                w.state.pos += k;
+                w.state.cur = @splat(1 - w.state.cur[0]);
+            }
+            r.active = false;
+            try r.engine.commitDrafts(windows, keeps);
+        }
+        pub fn run(r: *@This(), windows: []const Window, sampled: []u32, keeps: []usize) !void {
+            if (windows.len != keeps.len) return error.BadWindow;
+            try r.verify(windows, sampled);
+            var at: usize = 0;
+            for (windows, keeps) |w, *k| {
+                k.* = try accept(w.tokens, sampled[at..][0..w.tokens.len], w.eos);
+                at += w.tokens.len;
+            }
+            try r.commit(keeps);
+        }
+    };
+}
+/// cat(taps[0..4], dim=-1)[:keep] strides, source [5, total_rows, 4096] bf16.
+pub fn packTaps(th: anytype, source: u64, total_rows: usize, row0: usize, keep: usize, dst: u64) !void {
+    if (row0 > total_rows or keep > total_rows - row0) return error.BadWindow;
+    for (0..5) |i| try th.slotCopy(source + (i * total_rows + row0) * 4096 * 2, 4096 * 2, dst + i * 4096 * 2, 5 * 4096 * 2, 4096 * 2, keep);
+}
+test "accept rejects mismatch and stops EOS before committing its input row" {
+    try std.testing.expectEqual(@as(usize, 3), try accept(&.{ 1, 2, 3 }, &.{ 2, 3, 4 }, &.{}));
+    try std.testing.expectEqual(@as(usize, 2), try accept(&.{ 1, 2, 3 }, &.{ 2, 9, 4 }, &.{}));
+    try std.testing.expectEqual(@as(usize, 1), try accept(&.{ 1, 2, 3 }, &.{ 2, 3, 4 }, &.{2}));
+}
+test "round replays partial windows once, shifts conv, then publishes parity and position" {
+    const Toy = struct {
+        replayed: usize = 0,
+        shifted: usize = 0,
+        drafted: usize = 0,
+        fn forward(_: *@This(), _: []const Window, _: []const i32) !void {}
+        fn sample(_: *@This(), _: []const Window, out: []u32) !void {
+            @memcpy(out, &[_]u32{ 2, 9, 8, 5 });
+        }
+        fn stageCommit(_: *@This(), t: []const i32) !void {
+            try std.testing.expectEqualSlices(i32, &.{ 0, 3, 0, 0, 0, 2, 3, 1, 1, 1, 1, 1 }, t);
+        }
+        fn replay(e: *@This()) !void {
+            e.replayed += 1;
+        }
+        fn convShift(e: *@This()) !void {
+            e.shifted += 1;
+        }
+        fn setPosition(_: *@This(), _: *State, _: usize) !void {}
+        fn commitDrafts(e: *@This(), _: []const Window, _: []const usize) !void {
+            e.drafted += 1;
+        }
+    };
+    var a: State = .{ .slot = 0, .base = 0, .capacity = 2048, .fixed = undefined, .cache = undefined };
+    var b: State = .{ .slot = 1, .base = 2048, .capacity = 2048, .pos = 7, .cur = @splat(1), .fixed = undefined, .cache = undefined };
+    var toy: Toy = .{};
+    var r: Round(Toy) = .{ .engine = &toy };
+    var out: [4]u32 = undefined;
+    var keeps: [2]usize = undefined;
+    try r.run(&.{ .{ .state = &a, .tokens = &.{ 1, 2, 3 } }, .{ .state = &b, .tokens = &.{4} } }, &out, &keeps);
+    try std.testing.expectEqualSlices(usize, &.{ 2, 1 }, &keeps);
+    try std.testing.expectEqual(@as(usize, 2), a.pos);
+    try std.testing.expectEqual(@as(usize, 8), b.pos);
+    try std.testing.expectEqual(@as(u1, 1), a.cur[0]);
+    try std.testing.expectEqual(@as(u1, 0), b.cur[0]);
+    try std.testing.expectEqual(@as(usize, 1), toy.replayed);
+    try std.testing.expectEqual(@as(usize, 1), toy.shifted);
+    try std.testing.expectError(error.NoVerifyWindow, r.commit(&keeps));
+}
+
+test "drafter tap concatenation copies five row-strided planes into accepted rows" {
+    const Spy = struct {
+        called: usize = 0,
+        fn slotCopy(s: *@This(), src: u64, src_ld: usize, dst: u64, dst_ld: usize, row_bytes: usize, rows: usize) !void {
+            try std.testing.expectEqual(@as(u64, 0x1000 + (s.called * 10 + 3) * 8192), src);
+            try std.testing.expectEqual(@as(u64, 0x100000 + s.called * 8192), dst);
+            try std.testing.expectEqual(@as(usize, 8192), src_ld);
+            try std.testing.expectEqual(@as(usize, 5 * 8192), dst_ld);
+            try std.testing.expectEqual(@as(usize, 8192), row_bytes);
+            try std.testing.expectEqual(@as(usize, 2), rows);
+            s.called += 1;
+        }
+    };
+    var spy: Spy = .{};
+    try packTaps(&spy, 0x1000, 10, 3, 2, 0x100000);
+    try std.testing.expectEqual(@as(usize, 5), spy.called);
+    try std.testing.expectError(error.BadWindow, packTaps(&spy, 0x1000, 10, 9, 2, 0x100000));
+}
