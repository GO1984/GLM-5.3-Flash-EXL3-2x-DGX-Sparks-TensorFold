+                },
+                .dsa => |w| {
+                    if (ai >= 11) return error.BadRows;
+                    try e.dsaLayer(w, ai, rows, pos, done);
+                    ai += 1;
+                },
+            }
+            if (split_on) done = try e.splitGlue(&run, layer.ffn, null, false, ffnFront(layer), true) else {
+                try e.post(rows);
+                try e.hcPre(layer.ffn, rows);
+            }
+            try e.ffn(layer, rows, done);
+            done = null;
+            var tap: ?usize = null;
+            for ([_]usize{ 5, 14, 24, 33, 42 }, 0..) |t, slot| if (index == t) {
+                tap = slot;
+            };
+            if (split_on) {
+                done = try e.splitGlue(&run, if (index + 1 < nl) e.weights.layers[index + 1].attn else null, tap, index + 1 == nl, if (index + 1 < nl) mixerFront(e.weights.layers[index + 1]) else .none, !(index + 1 < nl and e.ownDsa(rows) and e.weights.layers[index + 1].mixer == .dsa));
+            } else {
+                try e.post(rows);
+                if (tap) |slot| try e.tri.stream_mean(.{ rows, 4, 1 }, e.b.x, e.b.taps + slot * e.b.rows * 4096 * 2, .{ .D = 4096, .S = 4, .BLOCK = 1024 });
+            }
+            if (e.observer) |o| try o.call(o.ctx, index, e.b.x, rows * 16384 * 2);
+        }
+        if (!split_on) try e.tri.stream_mean(.{ rows, 4, 1 }, e.b.x, e.b.hidden, .{ .D = 4096, .S = 4, .BLOCK = 1024 });
+        try e.norm(e.b.hidden, 4096, e.weights.norm, e.b.normed, 4096, rows);
+        e.last_hidden = e.b.normed + (rows - 1) * 4096 * 2;
+        if (head) {
+            const cfg = mm.headConfig(1);
+            try e.tri.fmm(.{ cdiv(1, cfg.bm), cdiv(e.g.vocab, cfg.bn), 1 }, e.last_hidden, e.weights.head, e.weights.head_scale, e.b.logits, e.b.logits, 1, 4096, .{ .N = cz(e.g.vocab), .K = 4096, .SK = 1, .BM = cz(cfg.bm), .BLOCK_N = cz(cfg.bn), .BK = 64, .F32 = 0, .SEQ = 0 });
+        }
+        try e.putI32(e.pos_dev, try ci(pos + rows));
+    }
+};
+
+fn hook(ctx: *fw.PromptCtx, rows: usize, pos: usize, parity: *[34]u1, head: bool) anyerror!void {
+    const e: *Engine = @ptrCast(@alignCast(ctx));
+    try e.chunk(rows, pos, parity, head);
+}
+
+pub fn bindForwardHook() void {
+    fw.prompt_enter = hook;
+}
+
+pub fn chunkHook(e: *Engine, rows: usize, pos: usize, parity: *[34]u1, head: bool) !void {
+    bindForwardHook();
+    try fw.enterPrompt(@ptrCast(e), rows, pos, parity, head);
+}
+
+/// Prompt-only Triton kernels. P1 captures these signatures; this package does not invent their arithmetic.
+pub const p1_kernels = [_][]const u8{
+    "_hc_partial_mma", "_lat_write",  "_absorb_mma",  "_expand_mma",  "_dense_chunks", "_index_write",
+    "_pool_keys",      "_scores",     "_scores_rows", "_select_rows", "_select_split", "_tokens",
+    "_sparse_onepass", "_conv_shift",
+};
+
+test "compile the unsplit prompt launch chain without a GPU" {
+    std.testing.refAllDecls(Scratch);
+    std.testing.refAllDecls(Engine);
+    try std.testing.expectEqual(@as(usize, 14), p1_kernels.len);
+    try std.testing.expectEqualSlices(i32, &.{ 0, 0, 1, 1, 1, 1, 1 }, &grid.arithCode());
+    if (std.c.getenv("TF_GLM_P8_COMPILE_PROBE") != null) {
+        var engine: Engine = undefined;
+        var parity: [34]u1 = @splat(0);
+        try engine.chunk(1, 0, &parity, false);
+        var scratch = try Scratch.init(undefined, try state.Geometry.init(2, 0), 2048, 8192);
+        scratch.deinit();
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_prefill_check.zig b/zig/src/families/glm_cuda/cuda_prefill_check.zig
new file mode 100644
index 00000000..4596ad14
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prefill_check.zig
@@ -0,0 +1,169 @@
+//! Prompt-chunk byte oracle. tools/zig/glm_prefill_dump.py writes version 2. Version 1 is the decode window oracle.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Dump = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    dir: []const u8,
+    manifest: std.json.Parsed(std.json.Value),
+    rows: usize,
+    rank: usize,
+    world: usize,
+    pos: usize,
+    grid: usize,
+    chunk: usize,
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !Dump {
+        const path = try std.fs.path.join(gpa, &.{ dir, "manifest.json" });
+        defer gpa.free(path);
+        const raw = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+        defer gpa.free(raw);
+        const parsed = try std.json.parseFromSlice(std.json.Value, gpa, raw, .{});
+        errdefer parsed.deinit();
+        if (parsed.value != .object) return error.BadLayerDump;
+        const obj = parsed.value.object;
+        for ([_]struct { []const u8, i64 }{ .{ "version", 2 }, .{ "layers", 45 }, .{ "hidden", 4096 }, .{ "streams", 4 } }) |field| {
+            const val = obj.get(field[0]) orelse return error.BadLayerDump;
+            if (val != .integer or val.integer != field[1]) return error.BadLayerDump;
+        }
+        for ([_]struct { []const u8, []const u8 }{ .{ "dtype", "bf16" }, .{ "endian", "little" } }) |field| {
+            const val = obj.get(field[0]) orelse return error.BadLayerDump;
+            if (val != .string or !std.mem.eql(u8, val.string, field[1])) return error.BadLayerDump;
+        }
+        const rows = try integer(obj, "rows");
+        const rank = try integer(obj, "rank");
+        const world = try integer(obj, "world");
+        const pos = try integer(obj, "pos");
+        const prompt_grid = try integer(obj, "grid");
+        const chunk = try integer(obj, "chunk");
+        if (rows < 1 or rows > 2048 or world < 1 or world > 4 or rank >= world) return error.BadLayerDump;
+        return .{ .gpa = gpa, .io = io, .dir = dir, .manifest = parsed, .rows = rows, .rank = rank, .world = world, .pos = pos, .grid = prompt_grid, .chunk = chunk };
+    }
+    fn integer(obj: std.json.ObjectMap, name: []const u8) !usize {
+        const val = obj.get(name) orelse return error.BadLayerDump;
+        if (val != .integer or val.integer < 0) return error.BadLayerDump;
+        return @intCast(val.integer);
+    }
+    pub fn deinit(d: *Dump) void {
+        d.manifest.deinit();
+    }
+    pub fn layer(d: Dump, index: usize) ![]u8 {
+        if (index >= 45) return error.BadLayer;
+        var name: [32]u8 = undefined;
+        const path = try std.fs.path.join(d.gpa, &.{ d.dir, try std.fmt.bufPrint(&name, "layer-{d:0>2}.bf16", .{index}) });
+        defer d.gpa.free(path);
+        const raw = try std.Io.Dir.cwd().readFileAlloc(d.io, path, d.gpa, .limited(d.rows * 16384 * 2 + 1));
+        errdefer d.gpa.free(raw);
+        if (raw.len != d.rows * 16384 * 2) return error.BadLayerBytes;
+        return raw;
+    }
+};
+
+pub fn compare(index: usize, expected: []const u8, actual: []const u8) !void {
+    if (expected.len != actual.len) return error.BadLayerBytes;
+    for (expected, actual, 0..) |a, b, byte| if (a != b) {
+        const elem = byte / 2;
+        std.log.err("prompt layer {d}: byte {d}, row {d}, stream {d}, column {d}: expected 0x{x:0>2}, got 0x{x:0>2}", .{ index, byte, elem / 16384, elem % 16384 / 4096, elem % 4096, a, b });
+        return error.LayerMismatch;
+    };
+}
+
+/// Attach call to Engine.observer. It synchronizes at the layer boundary, so it stays off a captured graph.
+pub const Observer = struct {
+    dump: *const Dump,
+    stream: cuda.Stream,
+    checked: usize = 0,
+    pub fn call(ctx: *anyopaque, index: usize, ptr: u64, bytes: usize) !void {
+        const o: *Observer = @ptrCast(@alignCast(ctx));
+        if (index != o.checked or bytes != o.dump.rows * 16384 * 2) return error.BadLayerSequence;
+        try o.stream.synchronize();
+        const expected = try o.dump.layer(index);
+        defer o.dump.gpa.free(expected);
+        const actual = try o.dump.gpa.alloc(u8, bytes);
+        defer o.dump.gpa.free(actual);
+        const view: cuda.DeviceBuffer = .{ .d = o.stream.d, .ptr = ptr, .len = bytes };
+        try view.download(0, actual);
+        try compare(index, expected, actual);
+        o.checked += 1;
+    }
+    pub fn finish(o: Observer) !void {
+        if (o.checked != 45) return error.IncompleteForward;
+    }
+};
+
+pub fn compareDirectories(gpa: std.mem.Allocator, io: std.Io, expected_dir: []const u8, actual_dir: []const u8) !void {
+    var expected = try Dump.open(gpa, io, expected_dir);
+    defer expected.deinit();
+    var actual = try Dump.open(gpa, io, actual_dir);
+    defer actual.deinit();
+    if (expected.rows != actual.rows or expected.world != actual.world or expected.rank != actual.rank or expected.pos != actual.pos or expected.grid != actual.grid or expected.chunk != actual.chunk) return error.DumpGeometryMismatch;
+    for ([_][]const u8{ "tokens", "segments", "initial_state_sha256", "pos", "grid", "chunk" }) |key| {
+        const a = expected.manifest.value.object.get(key) orelse return error.BadLayerDump;
+        const b = actual.manifest.value.object.get(key) orelse return error.BadLayerDump;
+        const ta = try std.json.Stringify.valueAlloc(gpa, a, .{});
+        defer gpa.free(ta);
+        const tb = try std.json.Stringify.valueAlloc(gpa, b, .{});
+        defer gpa.free(tb);
+        if (!std.mem.eql(u8, ta, tb)) return error.DumpInputMismatch;
+    }
+    for (0..45) |i| {
+        const a = try expected.layer(i);
+        defer gpa.free(a);
+        const b = try actual.layer(i);
+        defer gpa.free(b);
+        try compare(i, a, b);
+    }
+}
+
+const manifest_v2 =
+    \\{"version":2,"layers":45,"hidden":4096,"streams":4,"rows":8,"rank":0,"world":1,"pos":2048,"grid":64,"chunk":2048,"dtype":"bf16","endian":"little","tokens":[1,2],"segments":[{"slot":0,"pos":2048,"rows":8}],"initial_state_sha256":"aa"}
+;
+
+fn writeDump(dir: std.Io.Dir, io: std.Io, body: []const u8) !void {
+    try dir.writeFile(io, .{ .sub_path = "manifest.json", .data = body });
+}
+
+test "version 2 rejects a decode dump and rows outside 1..2048" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = std.testing.io;
+    try writeDump(tmp.dir, io, "{\"version\":1,\"layers\":45,\"hidden\":4096,\"streams\":4,\"rows\":8,\"rank\":0,\"world\":1,\"dtype\":\"bf16\",\"endian\":\"little\"}");
+    const v1 = try std.fmt.allocPrint(std.testing.allocator, ".zig-cache/tmp/{s}", .{tmp.sub_path});
+    defer std.testing.allocator.free(v1);
+    try std.testing.expectError(error.BadLayerDump, Dump.open(std.testing.allocator, io, v1));
+    try writeDump(tmp.dir, io, "{\"version\":2,\"layers\":45,\"hidden\":4096,\"streams\":4,\"rows\":0,\"rank\":0,\"world\":1,\"pos\":0,\"grid\":64,\"chunk\":2048,\"dtype\":\"bf16\",\"endian\":\"little\"}");
+    try std.testing.expectError(error.BadLayerDump, Dump.open(std.testing.allocator, io, v1));
+    try writeDump(tmp.dir, io, "{\"version\":2,\"layers\":45,\"hidden\":4096,\"streams\":4,\"rows\":2049,\"rank\":0,\"world\":1,\"pos\":0,\"grid\":64,\"chunk\":2048,\"dtype\":\"bf16\",\"endian\":\"little\"}");
+    try std.testing.expectError(error.BadLayerDump, Dump.open(std.testing.allocator, io, v1));
+    try writeDump(tmp.dir, io, manifest_v2);
+    var dump = try Dump.open(std.testing.allocator, io, v1);
+    defer dump.deinit();
+    try std.testing.expectEqual(@as(usize, 2048), dump.pos);
+    try std.testing.expectEqual(@as(usize, 64), dump.grid);
+    try std.testing.expectEqual(@as(usize, 2048), dump.chunk);
+}
+
+test "prompt manifests must agree on position, grid and chunk before any layer byte" {
+    var a = std.testing.tmpDir(.{});
+    defer a.cleanup();
+    var b = std.testing.tmpDir(.{});
+    defer b.cleanup();
+    const io = std.testing.io;
+    try writeDump(a.dir, io, manifest_v2);
+    try writeDump(b.dir, io, "{\"version\":2,\"layers\":45,\"hidden\":4096,\"streams\":4,\"rows\":8,\"rank\":0,\"world\":1,\"pos\":0,\"grid\":64,\"chunk\":2048,\"dtype\":\"bf16\",\"endian\":\"little\",\"tokens\":[1,2],\"segments\":[{\"slot\":0,\"pos\":2048,\"rows\":8}],\"initial_state_sha256\":\"aa\"}");
+    const da = try std.fmt.allocPrint(std.testing.allocator, ".zig-cache/tmp/{s}", .{a.sub_path});
+    defer std.testing.allocator.free(da);
+    const db = try std.fmt.allocPrint(std.testing.allocator, ".zig-cache/tmp/{s}", .{b.sub_path});
+    defer std.testing.allocator.free(db);
+    try std.testing.expectError(error.DumpGeometryMismatch, compareDirectories(std.testing.allocator, io, da, db));
+    try compare(3, &.{ 0, 0x3f }, &.{ 0, 0x3f });
+    try std.testing.expectError(error.BadLayerBytes, compare(3, &.{0}, &.{}));
+    try std.testing.expectError(error.IncompleteForward, (Observer{ .dump = undefined, .stream = undefined }).finish());
+}
+
+test "compile the prompt observer without a GPU" {
+    if (std.c.getenv("TF_GLM_P8_COMPILE_PROBE") != null) {
+        try Observer.call(undefined, 0, 0, 0);
+        try compareDirectories(std.testing.allocator, undefined, "", "");
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_prefill_grid.zig b/zig/src/families/glm_cuda/cuda_prefill_grid.zig
new file mode 100644
index 00000000..c18df9fc
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prefill_grid.zig
@@ -0,0 +1,187 @@
+//! Prompt chunk planner from glm5_next/cuda/{engine.py prompt_grid, sparse.py pool_count, forward.py dense_rows}.
+//! UNSPLIT scheduling only. SPLIT exchanges are P8b. No device arithmetic.
+const std = @import("std");
+
+pub const chunk_rows: usize = 2048;
+pub const busy_rows: usize = 1024;
+pub const state_grid: usize = 64;
+pub const att_rows: usize = 512;
+pub const select_rows: usize = 512;
+pub const sparse_from: usize = 2051;
+pub const score_loop: usize = 32;
+pub const topk_pools: usize = 512;
+pub const tokens: usize = 2051;
+pub const pool: usize = 4;
+pub const split_rows: usize = 64;
+pub const split_from: usize = 8192;
+pub const prompt_rows: usize = 64;
+pub const row_score_g: usize = 128;
+pub const dense_scale: f32 = @bitCast(@as(u32, 0x3d800000));
+pub const score_scale: f32 = @bitCast(@as(u32, 0x3db504f3));
+pub const wscale_h32: f32 = @bitCast(@as(u32, 0x3e3504f3));
+pub const index_eps: f32 = @bitCast(@as(u32, 0x358637bd));
+
+pub const Span = struct { start: usize, rows: usize };
+
+fn cdiv(a: usize, b: usize) usize {
+    return (a + b - 1) / b;
+}
+
+/// TF_GLM_PROMPT_GRID. Chunked KDA with an unset grid is 64. 0 is off only when chunked is false.
+pub fn promptGrid(prefill_rows: usize, requested: ?usize, chunked: bool) !usize {
+    // An explicit 0 with chunked KDA is the same as unset: the 32-row sub-chunks need a 64-token grid.
+    var grid = requested orelse if (chunked) state_grid else 0;
+    if (grid == 0) {
+        if (!chunked) return 0;
+        grid = state_grid;
+    }
+    if (grid != 16 and grid != 32 and grid != 64 and grid != 128) return error.BadGrid;
+    if (chunked and grid % 32 != 0) return error.BadGrid;
+    if (prefill_rows % grid != 0) return error.BadGrid;
+    return grid;
+}
+
+/// engine.py grid_point. null means the kept state has nowhere to sit past `cut`.
+pub fn gridPoint(n: usize, cut: usize, grid: usize) ?usize {
+    if (grid == 0 or n % grid == 0) return n;
+    const point = n / grid * grid;
+    return if (point > cut) point else null;
+}
+
+pub fn checkResume(begin: usize, grid: usize) !void {
+    if (grid != 0 and begin % grid != 0) return error.OffGrid;
+}
+
+pub fn chunkLimit(busy: bool, configured: usize) usize {
+    return if (busy) @min(configured, busy_rows) else configured;
+}
+
+pub fn chunks(len: usize, begin: usize, limit: usize, out: []Span) ![]Span {
+    if (limit == 0 or begin > len) return error.BadChunk;
+    var n: usize = 0;
+    var at = begin;
+    while (at < len) {
+        if (n == out.len) return error.TooManyChunks;
+        const rows = @min(limit, len - at);
+        out[n] = .{ .start = at, .rows = rows };
+        n += 1;
+        at += rows;
+    }
+    return out[0..n];
+}
+
+pub fn extentTokens(n: usize) usize {
+    return std.mem.alignForward(usize, @max(n, 1), 2048);
+}
+
+/// Pools a prompt chunk scores: visible pools, rounded up to a multiple of 1024, at most np_max.
+pub fn poolCount(pos: usize, rows: usize, np_max: usize) usize {
+    const visible = (pos + rows) / pool + 1;
+    return @min(np_max, cdiv(visible, 1024) * 1024);
+}
+
+/// Power-of-two bucket used by a tail shorter than PROMPT_ROWS, and by the scores allocation.
+pub fn poolBucket(pos: usize, rows: usize, np_max: usize) usize {
+    const visible = (pos + rows) / pool + 1;
+    const pow = std.math.ceilPowerOfTwo(usize, @max(visible, 1)) catch unreachable;
+    return @min(np_max, @max(@as(usize, 1024), pow));
+}
+
+pub fn chunksFor(pos: usize, rows: usize) usize {
+    return cdiv(pos + rows, att_rows);
+}
+
+pub fn denseRows(rows: usize, host_pos: usize) usize {
+    if (host_pos >= sparse_from) return 0;
+    return @min(rows, sparse_from - host_pos);
+}
+
+pub fn headBlock(rows: usize) usize {
+    return if (rows >= prompt_rows) 32 else 16;
+}
+
+pub fn routerBm(m: usize) usize {
+    return if (m <= 16) 16 else if (m <= 32) 32 else if (m <= 64) 64 else 128;
+}
+
+pub const Onepass = struct { hbt: usize, warps: usize, stages: usize, prefetch: usize, split: usize };
+
+pub fn onepassLaunch(heads: usize) Onepass {
+    const pow = std.math.ceilPowerOfTwo(usize, @max(heads, 1)) catch unreachable;
+    const hbt = @max(@as(usize, 16), @min(@as(usize, 32), pow));
+    const small = heads <= 16;
+    return .{ .hbt = hbt, .warps = if (small) 4 else 8, .stages = 1, .prefetch = 1, .split = 1 };
+}
+
+pub const SelectKind = enum { rows, split };
+pub const SelectLaunch = struct { kind: SelectKind, block: usize, warps: usize, vis: bool };
+
+/// `prompt_block` is a `_prompt_blocks` tile (VIS off). A short tail passes false (VIS on).
+pub fn selectLaunch(n: usize, np: usize, prompt_block: bool) !SelectLaunch {
+    if (np < topk_pools) return error.UnsupportedPools;
+    if (n < split_rows and np >= split_from) return .{ .kind = .split, .block = 0, .warps = 4, .vis = !prompt_block };
+    const wide = n < split_rows and np > 1024;
+    return .{ .kind = .rows, .block = if (wide) 4096 else 1024, .warps = if (wide) 8 else 4, .vis = !prompt_block };
+}
+
+/// prompt_arith_code defaults: fp32 partials, MSA off, EXL3 prompt, sparse onepass, latent MMA, HC MMA, KDA chunked.
+pub fn arithCode() [7]i32 {
+    return .{ 0, 0, 1, 1, 1, 1, 1 };
+}
+
+test "prompt chunks, the 64-token grid and pool columns match the reference" {
+    var buf: [8]Span = undefined;
+    const full = try chunks(5000, 0, chunk_rows, &buf);
+    try std.testing.expectEqual(@as(usize, 3), full.len);
+    try std.testing.expectEqual(Span{ .start = 0, .rows = 2048 }, full[0]);
+    try std.testing.expectEqual(Span{ .start = 2048, .rows = 2048 }, full[1]);
+    try std.testing.expectEqual(Span{ .start = 4096, .rows = 904 }, full[2]);
+    const busy = try chunks(5000, 0, chunkLimit(true, chunk_rows), &buf);
+    try std.testing.expectEqual(@as(usize, 5), busy.len);
+    try std.testing.expectEqual(Span{ .start = 4096, .rows = 904 }, busy[4]);
+    try checkResume(2048, state_grid);
+    try checkResume(0, state_grid);
+    try std.testing.expectError(error.OffGrid, checkResume(100, state_grid));
+    try std.testing.expectEqual(@as(?usize, 4992), gridPoint(5000, 0, state_grid));
+    try std.testing.expectEqual(@as(?usize, null), gridPoint(5000, 4992, state_grid));
+    try std.testing.expectEqual(@as(?usize, 5000), gridPoint(5000, 0, 0));
+    try std.testing.expectEqual(state_grid, try promptGrid(chunk_rows, null, true));
+    try std.testing.expectEqual(state_grid, try promptGrid(chunk_rows, 0, true));
+    try std.testing.expectEqual(@as(usize, 0), try promptGrid(chunk_rows, 0, false));
+    try std.testing.expectError(error.BadGrid, promptGrid(chunk_rows, 16, true));
+    try std.testing.expectEqual(@as(usize, 1024), poolCount(0, 2048, 2048));
+    try std.testing.expectEqual(@as(usize, 2048), poolCount(2048, 2048, 2048));
+    try std.testing.expectEqual(@as(usize, 1024), poolBucket(0, 64, 4096));
+    try std.testing.expectEqual(@as(usize, 4), chunksFor(0, 2048));
+    try std.testing.expectEqual(@as(usize, 9), chunksFor(2050, 2048));
+    try std.testing.expectEqual(@as(usize, 2048), denseRows(2048, 0));
+    try std.testing.expectEqual(@as(usize, 3), denseRows(2048, 2048));
+    try std.testing.expectEqual(@as(usize, 0), denseRows(64, sparse_from));
+    try std.testing.expectEqual(@as(usize, 32), headBlock(64));
+    try std.testing.expectEqual(@as(usize, 16), headBlock(63));
+    try std.testing.expectEqual(@as(usize, 128), routerBm(2048));
+    try std.testing.expectEqual(@as(usize, 16), routerBm(1));
+    try std.testing.expectEqual(@as(usize, 32), onepassLaunch(32).hbt);
+    try std.testing.expectEqual(@as(usize, 8), onepassLaunch(32).warps);
+    try std.testing.expectEqual(@as(usize, 16), onepassLaunch(16).hbt);
+    try std.testing.expectEqual(@as(usize, 4), onepassLaunch(16).warps);
+    const wide = try selectLaunch(512, 2048, true);
+    try std.testing.expectEqual(SelectKind.rows, wide.kind);
+    try std.testing.expectEqual(false, wide.vis);
+    try std.testing.expectEqual(@as(usize, 1024), wide.block);
+    try std.testing.expectEqual(@as(usize, 4), wide.warps);
+    const rem = try selectLaunch(8, 2048, true);
+    try std.testing.expectEqual(@as(usize, 4096), rem.block);
+    try std.testing.expectEqual(@as(usize, 8), rem.warps);
+    try std.testing.expectEqual(SelectKind.split, (try selectLaunch(8, 8192, true)).kind);
+    try std.testing.expectEqual(false, (try selectLaunch(8, 8192, true)).vis);
+    try std.testing.expectEqual(true, (try selectLaunch(8, 8192, false)).vis);
+    try std.testing.expectError(error.UnsupportedPools, selectLaunch(8, 400, true));
+    try std.testing.expectEqual(@as(usize, 4096), extentTokens(3000));
+    try std.testing.expectEqual(@as(i32, 1), arithCode()[6]);
+    try std.testing.expectEqual(@as(u32, 0x3d800000), @as(u32, @bitCast(dense_scale)));
+    try std.testing.expectEqual(@as(u32, 0x3db504f3), @as(u32, @bitCast(score_scale)));
+    try std.testing.expectEqual(@as(u32, 0x3e3504f3), @as(u32, @bitCast(wscale_h32)));
+    try std.testing.expectEqual(@as(u32, 0x358637bd), @as(u32, @bitCast(index_eps)));
+    try std.testing.expectEqual(@as(u32, 0x358637bd), @as(u32, @bitCast(@as(f32, 1e-6))));
+}
diff --git a/zig/src/families/glm_cuda/cuda_prefill_loop.zig b/zig/src/families/glm_cuda/cuda_prefill_loop.zig
new file mode 100644
index 00000000..5e322017
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prefill_loop.zig
@@ -0,0 +1,117 @@
+//! Host loop over a long prompt: 2048-row chunks (1024 while others decode), the 64-token grid, pool growth, one segment.
+//! glm5_next/cuda/decode.py prefill / prefill_chunk. SPLIT exchanges and overlap are P8b. Snapshots use gridPoint; this loop runs to the end.
+//! Ash Hart and TensorFold contributors; CUDA launch patterns by jschmied (PR #443).
+const std = @import("std");
+const cuda = @import("cuda");
+const pool = @import("cuda_pool.zig");
+const seg = @import("cuda_segments.zig");
+const grid = @import("cuda_prefill_grid.zig");
+const prefill = @import("cuda_prefill.zig");
+
+pub const gridPoint = grid.gridPoint;
+
+/// Grow an extent in place so it covers `tokens`. Moving a cache is a later package.
+pub fn ensureExtent(p: *pool.Pool, eid: u64, tokens: usize) !usize {
+    const need = grid.extentTokens(tokens);
+    if (need > (try p.get(eid)).size) try p.resize(eid, need);
+    return (try p.get(eid)).size;
+}
+
+/// One segment for this chunk. `fill` always; `stage` only when the table has device memory.
+pub fn noteChunk(t: *seg.SegRows, base: usize, pos: usize, rows: usize, ring_base: ?usize) !bool {
+    _ = try t.fill(&.{.{ .base = base, .pos = pos, .rows = rows, .ring_base = ring_base }}, grid.sparse_from);
+    if (t.dev != null) try t.stage();
+    return t.anySparse();
+}
+
+fn stageIds(e: *const prefill.Engine, ids: []const i32) !void {
+    if (ids.len > e.b.rows) return error.BadRows;
+    const view: cuda.DeviceBuffer = .{ .d = e.tri.s.d, .ptr = e.b.ids, .len = e.b.rows * 4 };
+    try view.uploadAsync(0, std.mem.sliceAsBytes(ids), e.tri.s.handle);
+}
+
+pub const Job = struct {
+    tokens: []const i32,
+    tap_ctx: ?*anyopaque = null,
+    on_taps: ?*const fn (*anyopaque, usize) anyerror!void = null,
+    begin: usize = 0,
+    busy: bool = false,
+    limit: usize = grid.chunk_rows,
+    /// null or 0 with chunked KDA selects the 64-token grid.
+    prompt_grid: ?usize = null,
+    /// Sample flag: the head runs on every chunk and overwrites the one-row logits buffer.
+    head: bool = false,
+    extents: ?*pool.Pool = null,
+    extent: ?u64 = null,
+    base: usize = 0,
+    slot: usize = 0,
+    ring: ?usize = null,
+    segments: ?*seg.SegRows = null,
+};
+
+/// Validate the resume point and the chunk width. Returns the rows one chunk may take.
+pub fn checkJob(len: usize, begin: usize, limit: usize, requested: ?usize, busy: bool) !usize {
+    if (len == 0 or begin >= len) return error.BadChunk;
+    const g = try grid.promptGrid(limit, requested, true);
+    try grid.checkResume(begin, g);
+    const step = grid.chunkLimit(busy, limit);
+    if (g != 0 and step % g != 0) return error.BadGrid;
+    return step;
+}
+
+/// Commit every chunk through `len`. Parity flips inside the chunk. The conv window is shifted there, not again here.
+/// Returns the sequence position after the last row.
+pub fn run(e: *prefill.Engine, parity: *[34]u1, job: Job) !usize {
+    const step = try checkJob(job.tokens.len, job.begin, job.limit, job.prompt_grid, job.busy);
+    var pos = job.begin;
+    while (pos < job.tokens.len) {
+        const rows = @min(step, job.tokens.len - pos);
+        const end = pos + rows;
+        if (job.extents) |p| {
+            const eid = job.extent orelse return error.NoExtent;
+            const size = try ensureExtent(p, eid, end);
+            if (size / 4 > e.s.pools) return error.ScoresScratch;
+            e.cache.capacity = size;
+        } else if (end > e.cache.capacity) return error.BadExtent;
+        if (job.segments) |t| {
+            const ring_base: ?usize = if (t.ring != null) job.slot * (job.ring orelse return error.BadRing) else null;
+            _ = try noteChunk(t, job.base, pos, rows, ring_base);
+        }
+        try stageIds(e, job.tokens[pos..end]);
+        try e.chunk(rows, pos, parity, job.head);
+        if (job.on_taps) |hook| try hook(job.tap_ctx orelse return error.MissingTapContext, rows);
+        pos = end;
+    }
+    return pos;
+}
+
+test "pool growth stays in place and a chunk is one segment" {
+    var p = try pool.Pool.init(std.testing.allocator, 8192);
+    defer p.deinit();
+    const a = (try p.alloc(2048)).?;
+    try std.testing.expectEqual(@as(usize, 4096), try ensureExtent(&p, a, 3000));
+    const b = (try p.alloc(2048)).?;
+    try std.testing.expectError(error.Overlap, ensureExtent(&p, a, 5000));
+    try std.testing.expectError(error.BadExtent, ensureExtent(&p, b, 8192));
+    var dense = try seg.SegRows.init(std.testing.allocator, 2048, 1, 2112);
+    defer dense.deinit();
+    try std.testing.expect(!try noteChunk(&dense, 0, 0, 2048, 0));
+    var sparse = try seg.SegRows.init(std.testing.allocator, 8, 1, 2112);
+    defer sparse.deinit();
+    try std.testing.expect(try noteChunk(&sparse, 0, 2048, 8, 0));
+    try std.testing.expectEqual(@as(i32, 1), sparse.plane(3)[3]);
+    try std.testing.expectError(error.BadChunk, checkJob(0, 0, 2048, null, false));
+    try std.testing.expectError(error.BadChunk, checkJob(5000, 5000, 2048, null, false));
+    try std.testing.expectError(error.OffGrid, checkJob(5000, 100, 2048, null, false));
+    try std.testing.expectEqual(@as(usize, 1024), try checkJob(5000, 2048, 2048, null, true));
+    try std.testing.expectEqual(@as(?usize, 4992), gridPoint(5000, 0, 64));
+}
+
+test "compile the prompt loop without a GPU" {
+    std.testing.refAllDecls(@This());
+    if (std.c.getenv("TF_GLM_P8_COMPILE_PROBE") != null) {
+        var engine: prefill.Engine = undefined;
+        var parity: [34]u1 = @splat(0);
+        _ = try run(&engine, &parity, .{ .tokens = &.{ 1, 2, 3 } });
+    }
+}
diff --git a/zig/src/families/glm_cuda/cuda_prefill_split.zig b/zig/src/families/glm_cuda/cuda_prefill_split.zig
new file mode 100644
index 00000000..b94eb1a3
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prefill_split.zig
@@ -0,0 +1,221 @@
+//! TF_GLM_HC_SPLIT=1 (recipe patch 0010, glm5_next/cuda/hcsplit.py) for the Zig prompt chunk, two ranks: the chunk's
+//! hyper-connection glue is split by rows. Rank r owns rows [r H, r H + H), H = padded(R) / 2 (an odd chunk gets one zero
+//! pad row). At each of a layer's two sites a rank sends the peer its fp32 partial of the peer's rows, receives the
+//! peer's partial of its own, sums them rank 0 first (the same `_hc_post` kernel on a [2, H, D] block), runs the next
+//! hc_pre on its own rows and swaps its normed rows (bf16) for the peer's. Every glue kernel is row-independent and the
+//! partial sum order is the unsplit one, so every bit is the unsplit path's. Past two ranks the engine runs unsplit.
+//! Pure row arithmetic here; the launches are in cuda_prefill.zig.
+//! Ash Hart and TensorFold contributors wrote the Python engine; this port is by Mia's AI Lab.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Settings = struct {
+    on: bool = false, // TF_GLM_HC_SPLIT
+    min_rows: usize = 64, // TF_GLM_HC_SPLIT_MIN_ROWS: shorter chunks run unsplit
+    overlap: u8 = 0, // TF_GLM_PREFILL_OVERLAP: 0, 1 (side stream, row pieces), 2 (and the next block's front on own rows)
+    pieces: usize = 2, // TF_GLM_OVERLAP_PIECES
+    own_front: bool = false, // TF_GLM_PROMPT_OWN_FRONT: DSA's replicated front on own rows, its outputs shared
+};
+
+pub fn padded(rows: usize, world: usize) usize {
+    return (rows + world - 1) / world * world;
+}
+
+/// Whether a chunk of `rows` rows runs split: the feature on, two ranks, long enough, pad rows fit the buffers.
+pub fn applies(s: Settings, world: usize, rows: usize, alloc_rows: usize) bool {
+    return s.on and world == 2 and rows >= s.min_rows and padded(rows, world) <= alloc_rows;
+}
+
+pub const Piece = struct { off: usize, n: usize };
+
+/// A rank's rows in pieces (hcsplit.py begin): n pieces of ceil(H / n) rows, whole 64-row tiles where possible.
+pub fn pieces(h: usize, count: usize, out: []Piece) []Piece {
+    std.debug.assert(count <= max_pieces);
+    var size = (h + count - 1) / count;
+    if (size > 64) size = @min(h, (size + 63) / 64 * 64);
+    var k: usize = 0;
+    var off: usize = 0;
+    while (off < h) : (off += size) {
+        out[k] = .{ .off = off, .n = @min(size, h - off) };
+        k += 1;
+    }
+    return out[0..k];
+}
+
+/// TF_GLM_PREFILL_OVERLAP=1: the second stream and the events that order it with the main one (hcsplit.py HcSplit).
+pub const max_pieces = 8;
+pub const Lane = struct {
+    stream: cuda.Stream,
+    fill: [max_pieces]cuda.Event, // main -> side: piece j of the partial is written
+    part: [max_pieces]cuda.Event, // side -> main: piece j's partial exchange is done
+    glue: [max_pieces]cuda.Event, // main -> side: piece j's glued rows are ready to swap
+    own: cuda.Event, // main -> side at the start of a chunk
+    done: cuda.Event, // side -> main: the swaps are done
+    hf: [2]cuda.Event, // micro-batching: main -> side, half's partial is written
+    hd: [2]cuda.Event, // micro-batching: side -> main, half's chain is done
+    share_in: cuda.Event, // main -> side: an own-row share's rows are written
+    share_out: cuda.Event, // side -> main: the share has arrived
+    pub fn init(d: *const cuda.Driver) !Lane {
+        var l: Lane = undefined;
+        l.stream = try cuda.Stream.init(d, true);
+        for (0..max_pieces) |i| {
+            l.fill[i] = try cuda.Event.init(d, false);
+            l.part[i] = try cuda.Event.init(d, false);
+            l.glue[i] = try cuda.Event.init(d, false);
+        }
+        l.own = try cuda.Event.init(d, false);
+        l.done = try cuda.Event.init(d, false);
+        for (0..2) |i| {
+            l.hf[i] = try cuda.Event.init(d, false);
+            l.hd[i] = try cuda.Event.init(d, false);
+        }
+        l.share_in = try cuda.Event.init(d, false);
+        l.share_out = try cuda.Event.init(d, false);
+        return l;
+    }
+    pub fn deinit(l: *Lane) void {
+        for (0..max_pieces) |i| {
+            l.fill[i].deinit();
+            l.part[i].deinit();
+            l.glue[i].deinit();
+        }
+        l.own.deinit();
+        l.done.deinit();
+        for (0..2) |i| {
+            l.hf[i].deinit();
+            l.hd[i].deinit();
+        }
+        l.share_in.deinit();
+        l.share_out.deinit();
+        l.stream.deinit();
+    }
+};
+
+/// One split chunk's row arithmetic.
+pub const Run = struct {
+    rows: usize,
+    h: usize,
+    mine: usize,
+    theirs: usize,
+    np: usize,
+    pieces: [max_pieces]Piece,
+    lane: bool,
+
+    pub fn init(rows: usize, rank: usize, s: Settings) Run {
+        var r: Run = undefined;
+        r.rows = rows;
+        r.h = padded(rows, 2) / 2;
+        r.mine = rank * r.h;
+        r.theirs = (1 - rank) * r.h;
+        r.lane = s.overlap != 0;
+        const count: usize = if (r.lane) s.pieces else 1;
+        const ps = pieces(r.h, count, &r.pieces);
+        r.np = ps.len;
+        return r;
+    }
+};
+
+pub fn flagEnv(env: anytype, name: []const u8) !bool {
+    const t = std.mem.trim(u8, env.get(name) orelse "", " \t\r\n");
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    return error.BadPromptSetting;
+}
+
+fn intEnv(env: anytype, name: []const u8, default: usize, lo: usize, hi: usize) !usize {
+    const t = std.mem.trim(u8, env.get(name) orelse "", " \t\r\n");
+    if (t.len == 0) return default;
+    const n = std.fmt.parseInt(usize, t, 10) catch return error.BadPromptSetting;
+    if (n < lo or n > hi) return error.BadPromptSetting;
+    return n;
+}
+
+pub fn parse(env: anytype) !Settings {
+    const on = try flagEnv(env, "TF_GLM_HC_SPLIT");
+    const lvl = std.mem.trim(u8, env.get("TF_GLM_PREFILL_OVERLAP") orelse "", " \t\r\n");
+    const overlap: u8 = if (lvl.len == 0 or std.mem.eql(u8, lvl, "0")) 0 else if (std.mem.eql(u8, lvl, "1")) 1 else if (std.mem.eql(u8, lvl, "2")) 2 else return error.BadPromptSetting;
+    if (overlap != 0 and !on) return error.OverlapNeedsSplit;
+    const own = try flagEnv(env, "TF_GLM_PROMPT_OWN_FRONT");
+    if (own and !on) return error.OwnFrontNeedsSplit;
+    return .{
+        .own_front = own,
+        .on = on,
+        .min_rows = try intEnv(env, "TF_GLM_HC_SPLIT_MIN_ROWS", 64, 2, 16384),
+        .overlap = overlap,
+        .pieces = try intEnv(env, "TF_GLM_OVERLAP_PIECES", 2, 1, 8),
+    };
+}
+
+const ProcessEnv = struct {
+    fn get(_: ProcessEnv, name: []const u8) ?[]const u8 {
+        var buf: [96:0]u8 = undefined;
+        @memcpy(buf[0..name.len], name);
+        buf[name.len] = 0;
+        return if (std.c.getenv(&buf)) |p| std.mem.span(p) else null;
+    }
+};
+/// TF_GLM_PREFILL_ROWS: 64 to 16384, a multiple of 64 (the KDA grid); unset is 2048.
+pub fn prefillRows(env: anytype) !usize {
+    const n = try intEnv(env, "TF_GLM_PREFILL_ROWS", 2048, 64, 16384);
+    if (n % 64 != 0) return error.BadPromptSetting;
+    return n;
+}
+pub fn rowsFromEnv() !usize {
+    return prefillRows(ProcessEnv{});
+}
+
+pub fn fromEnv() !Settings {
+    return parse(ProcessEnv{});
+}
+
+const Fake = struct {
+    pairs: []const [2][]const u8,
+    fn get(e: Fake, name: []const u8) ?[]const u8 {
+        for (e.pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+        return null;
+    }
+};
+
+test "recipe split settings: SPLIT=1 with OVERLAP=2, default pieces" {
+    const s = try parse(Fake{ .pairs = &.{ .{ "TF_GLM_HC_SPLIT", "1" }, .{ "TF_GLM_PREFILL_OVERLAP", "2" } } });
+    try std.testing.expect(s.on and s.overlap == 2 and s.pieces == 2 and s.min_rows == 64);
+    try std.testing.expect(!(try parse(Fake{ .pairs = &.{} })).on);
+    try std.testing.expectError(error.OverlapNeedsSplit, parse(Fake{ .pairs = &.{.{ "TF_GLM_PREFILL_OVERLAP", "1" }} }));
+    try std.testing.expectError(error.BadPromptSetting, parse(Fake{ .pairs = &.{ .{ "TF_GLM_HC_SPLIT", "1" }, .{ "TF_GLM_PREFILL_OVERLAP", "3" } } }));
+}
+
+test "applies: two ranks, long enough, pad rows fit" {
+    const s: Settings = .{ .on = true };
+    try std.testing.expect(applies(s, 2, 2048, 2048));
+    try std.testing.expect(applies(s, 2, 925, 2048));
+    try std.testing.expect(!applies(s, 2, 63, 2048));
+    try std.testing.expect(!applies(s, 2, 2047, 2047)); // pad row would not fit
+    try std.testing.expect(!applies(s, 3, 2048, 2048)); // past two ranks: unsplit for now
+    try std.testing.expect(!applies(.{}, 2, 2048, 2048));
+}
+
+test "pieces tile a rank's rows, whole 64-row tiles where possible" {
+    var buf: [8]Piece = undefined;
+    const p = pieces(1024, 2, &buf);
+    try std.testing.expectEqual(@as(usize, 2), p.len);
+    try std.testing.expectEqual(Piece{ .off = 0, .n = 512 }, p[0]);
+    try std.testing.expectEqual(Piece{ .off = 512, .n = 512 }, p[1]);
+    var buf2: [8]Piece = undefined;
+    const t = pieces(463, 2, &buf2); // a 925-row tail: 232 -> 256-row tiles
+    try std.testing.expectEqual(@as(usize, 2), t.len);
+    try std.testing.expectEqual(Piece{ .off = 256, .n = 207 }, t[1]);
+    var buf3: [8]Piece = undefined;
+    const one = pieces(32, 2, &buf3);
+    try std.testing.expectEqual(@as(usize, 2), one.len);
+    var sum: usize = 0;
+    for (p) |x| sum += x.n;
+    try std.testing.expectEqual(@as(usize, 1024), sum);
+    try std.testing.expectEqual(@as(usize, 926), padded(925, 2));
+}
+
+test "TF_GLM_PREFILL_ROWS: default 2048, multiples of 64 up to 16384" {
+    try std.testing.expectEqual(@as(usize, 2048), try prefillRows(Fake{ .pairs = &.{} }));
+    try std.testing.expectEqual(@as(usize, 4096), try prefillRows(Fake{ .pairs = &.{.{ "TF_GLM_PREFILL_ROWS", "4096" }} }));
+    try std.testing.expectError(error.BadPromptSetting, prefillRows(Fake{ .pairs = &.{.{ "TF_GLM_PREFILL_ROWS", "4100" }} }));
+    try std.testing.expectError(error.BadPromptSetting, prefillRows(Fake{ .pairs = &.{.{ "TF_GLM_PREFILL_ROWS", "32768" }} }));
+}
diff --git a/zig/src/families/glm_cuda/cuda_prompt_micro.zig b/zig/src/families/glm_cuda/cuda_prompt_micro.zig
new file mode 100644
index 00000000..dd8533bd
--- /dev/null
+++ b/zig/src/families/glm_cuda/cuda_prompt_micro.zig
@@ -0,0 +1,381 @@
+//! The TP=4 recipe's prompt speed features that sit on the row-split prompt chunk: TF_GLM_PROMPT_OWN_FRONT (patch 0102,
+//! glm5_next/cuda/own_front.py) and TF_GLM_PROMPT_MICROBATCH (patch 0104, microbatch.py). Pure functions and no CUDA:
+//! settings with Python's validation, the half-chunk cut (a multiple of lcm(64, world)), when a chunk runs as two
+//! halves, the halves' row layout, and the step orders (one layer of a microbatched chunk, an own-row front's shares and
+//! waits) that the CPU tests check with fakes. cuda_prefill.zig (`microLayers`, `dsaOwnFront`, `selectOwn`) launches them
+//! on the split chunk (cuda_prefill_split.zig); `cut`, `applies` and the settings are used there as they are.
+//! Ash Hart and TensorFold contributors wrote the Python engine; the two features' design is Mia's AI Lab's
+//! (Apache-2.0), after drowzeys' (github.com/drowzeys/TensorFold, glm53-tp4-2026-10-05) sequence-parallel prompt; no code of theirs.
+const std = @import("std");
+
+pub const grid_rows: usize = 64; // KDA's chunked recurrence keeps prompt rows on a 64-row grid
+
+pub const Settings = struct {
+    split: bool = false, // TF_GLM_HC_SPLIT
+    own_front: bool = false, // TF_GLM_PROMPT_OWN_FRONT
+    microbatch: bool = false, // TF_GLM_PROMPT_MICROBATCH
+    micro_min: usize = 2048, // TF_GLM_PROMPT_MICROBATCH_MIN_ROWS: halves of fewer rows run the chunk whole
+    min_rows: usize = 64, // TF_GLM_HC_SPLIT_MIN_ROWS: shorter chunks run unsplit
+
+    /// Either feature asked for: both live on the row split.
+    pub fn wanted(s: Settings) bool {
+        return s.own_front or s.microbatch;
+    }
+};
+
+fn flag(v: ?[]const u8) !bool {
+    const t = std.mem.trim(u8, v orelse "", " \t\r\n");
+    if (t.len == 0 or std.mem.eql(u8, t, "0")) return false;
+    if (std.mem.eql(u8, t, "1")) return true;
+    return error.BadPromptSetting;
+}
+
+fn int(v: ?[]const u8, default: usize, lo: usize, hi: usize) !usize {
+    const t = std.mem.trim(u8, v orelse "", " \t\r\n");
+    if (t.len == 0) return default;
+    const n = std.fmt.parseInt(usize, t, 10) catch return error.BadPromptSetting;
+    if (n < lo or n > hi) return error.BadPromptSetting;
+    return n;
+}
+
+/// `env.get(name)` returns ?[]const u8 (the process environment, or a fake).
+pub fn parse(env: anytype) !Settings {
+    const s: Settings = .{
+        .split = try flag(env.get("TF_GLM_HC_SPLIT")),
+        .own_front = try flag(env.get("TF_GLM_PROMPT_OWN_FRONT")),
+        .microbatch = try flag(env.get("TF_GLM_PROMPT_MICROBATCH")),
+        .micro_min = try int(env.get("TF_GLM_PROMPT_MICROBATCH_MIN_ROWS"), 2048, 64, 16384),
+        .min_rows = try int(env.get("TF_GLM_HC_SPLIT_MIN_ROWS"), 64, 2, 16384),
+    };
+    if (s.own_front and !s.split) return error.OwnFrontNeedsSplit; // hcsplit.py SplitSettings.__post_init__
+    if (s.microbatch and !s.split) return error.MicrobatchNeedsSplit;
+    return s;
+}
+
+const ProcessEnv = struct {
+    fn get(_: ProcessEnv, name: [:0]const u8) ?[]const u8 {
+        return if (std.c.getenv(name.ptr)) |p| std.mem.span(p) else null;
+    }
+};
+pub fn fromEnv() !Settings {
+    return parse(ProcessEnv{});
+}
+
+/// Rows of a chunk of R rounded up to whole shares a rank (HcSplit.padded).
+pub fn padded(R: usize, world: usize) usize {
+    return (R + world - 1) / world * world;
+}
+
+/// Half A's rows of a chunk of R: about half, a multiple of 64 and of the world size (microbatch.cut).
+pub fn cut(R: usize, world: usize) usize {
+    const unit = grid_rows * world / std.math.gcd(grid_rows, world);
+    return @max(unit, (R / 2) / unit * unit);
+}
+
+/// Whether a row-split chunk of R rows runs as two halves (microbatch.applies): the feature on, one stream's prompt,
+/// both halves at least the minimum rows (and of what the split takes).
+pub fn applies(s: Settings, world: usize, R: usize, one_stream: bool) bool {
+    if (!(s.microbatch and one_stream)) return false;
+    const h = cut(R, world);
+    const least = @max(s.micro_min, s.min_rows);
+    return h >= least and R - h >= least;
+}
+
+/// The two halves of a chunk of R rows: A = rows [0, h) at position p, B = rows [h, R) at p + h, B padded to whole
+/// shares. B's partial staging starts after A's (`world * h * width` elements).
+pub const Halves = struct {
+    h: usize,
+    nb: usize, // B's rows with its pad rows
+    rb: usize, // B's real rows
+    gath_b: usize, // offset of B's staging in elements, for rows of `width`
+
+    pub fn pos(hv: Halves, half: Half, p: usize) usize {
+        return if (half == .a) p else p + hv.h;
+    }
+    pub fn rows(hv: Halves, half: Half) usize {
+        return if (half == .a) hv.h else hv.rb;
+    }
+};
+pub const Half = enum { a, b };
+
+pub fn halves(R: usize, world: usize, alloc_rows: usize, width: usize) !Halves {
+    const h = cut(R, world);
+    if (R <= h) return error.BadRows;
+    const nb = padded(R - h, world);
+    if (h + nb > alloc_rows) return error.HalvesPastBuffers;
+    return .{ .h = h, .nb = nb, .rb = R - h, .gath_b = world * h * width };
+}
+
+pub const Block = enum { mixer, ffn };
+pub const Step = union(enum) {
+    /// The main stream waits for the half's queued chain.
+    join: Half,
+    /// A half's block on the main stream. `own_front`: a DSA block that runs its own-row front.
+    block: struct { half: Half, kind: Block, own_front: bool = false },
+    /// The half's chain (partials' exchange, glue on its own rows, glued rows' swap) queued on the side stream.
+    chain: struct { half: Half, layer_end: bool, share: bool = true },
+};
+
+/// One layer of a microbatched chunk (microbatch.layer_steps): the main stream runs A's attention, B's, A's MoE or
+/// MLP, B's; each half's chain is queued as soon as its block has filled its partials; a half is joined only right
+/// before its next block. `dsa_own`: this layer's block takes the own-row front; `next_dsa_own`: the next layer's does
+/// (the layer-end glue then keeps the normed rows on their owner: share = false). `last`: no next layer.
+pub fn layerSteps(out: *std.ArrayList(Step), gpa: std.mem.Allocator, own_front: bool, dsa_own: bool, next_dsa_own: bool) !void {
+    const hs = [_]Half{ .a, .b };
+    for (hs) |h| {
+        try out.append(gpa, .{ .join = h });
+        try out.append(gpa, .{ .block = .{ .half = h, .kind = .mixer, .own_front = own_front and dsa_own } });
+        try out.append(gpa, .{ .chain = .{ .half = h, .layer_end = false } });
+    }
+    for (hs) |h| {
+        try out.append(gpa, .{ .join = h });
+        try out.append(gpa, .{ .block = .{ .half = h, .kind = .ffn } });
+        try out.append(gpa, .{ .chain = .{ .half = h, .layer_end = true, .share = !(own_front and next_dsa_own) } });
+    }
+}
+
+/// The row ranges of [0, R) outside this rank's [lo, hi) (own_front._others).
+pub fn others(R: usize, lo: usize, hi: usize) [2]?[2]usize {
+    var r: [2]?[2]usize = .{ null, null };
+    const a_end = @min(lo, R);
+    if (a_end > 0) r[0] = .{ 0, a_end };
+    if (R > hi) r[1] = .{ hi, R };
+    return r;
+}
+
+/// A rank's own rows of a split chunk of Rp (padded) rows: [rank H, rank H + H).
+pub fn ownRows(Rp: usize, world: usize, rank: usize) [2]usize {
+    const hh = Rp / world;
+    return .{ rank * hh, rank * hh + hh };
+}
+
+pub const Front = enum {
+    own_projections, // q_a / kv_a and norms, q_b for own heads, indexer kw / gate / query projection on own rows
+    share_keys, // index keys and gates (slot 0)
+    share_rows, // the norms' rows qr / lat (slot 1)
+    wait_keys,
+    index_update, // every row's index key, gate, pooled key
+    select_own, // this rank's rows' pools over those keys
+    share_pools, // slot 2
+    wait_rows,
+    q_b_others, // q_b on the other ranks' rows
+    latent_write,
+    absorb,
+    dense_attention,
+    wait_pools,
+    pool_tokens,
+    sparse_attention,
+    expand,
+    out_proj,
+};
+
+/// An own-row DSA front's order (own_front.front + rest): `indexed` = the layer has the index cache, `sparse_rows` =
+/// some row selects (position + R - 1 past the dense limit), `all_sparse` = every row does (no dense attention).
+pub fn frontSteps(buf: *[20]Front, indexed: bool, sparse_rows: bool, all_sparse: bool) []const Front {
+    var n: usize = 0;
+    const add = struct {
+        fn f(b: *[20]Front, k: *usize, s: Front) void {
+            b[k.*] = s;
+            k.* += 1;
+        }
+    }.f;
+    add(buf, &n, .own_projections);
+    if (indexed) add(buf, &n, .share_keys);
+    add(buf, &n, .share_rows);
+    if (indexed) {
+        add(buf, &n, .wait_keys);
+        add(buf, &n, .index_update);
+        if (sparse_rows) {
+            add(buf, &n, .select_own);
+            add(buf, &n, .share_pools);
+        }
+    }
+    add(buf, &n, .wait_rows);
+    add(buf, &n, .q_b_others);
+    add(buf, &n, .latent_write);
+    add(buf, &n, .absorb);
+    if (!all_sparse) add(buf, &n, .dense_attention);
+    if (sparse_rows) {
+        add(buf, &n, .wait_pools);
+        add(buf, &n, .pool_tokens);
+        add(buf, &n, .sparse_attention);
+    }
+    add(buf, &n, .expand);
+    add(buf, &n, .out_proj);
+    return buf[0..n];
+}
+
+// ---------------------------------------------------------------- tests
+
+const FakeEnv = struct {
+    pairs: []const [2][]const u8,
+    fn get(e: FakeEnv, name: []const u8) ?[]const u8 {
+        for (e.pairs) |p| if (std.mem.eql(u8, p[0], name)) return p[1];
+        return null;
+    }
+};
+
