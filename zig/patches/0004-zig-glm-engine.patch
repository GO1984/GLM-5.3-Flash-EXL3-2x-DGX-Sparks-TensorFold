+    const tp4 = try parse(FakeEnv{ .pairs = &.{ .{ "TF_GLM_HC_SPLIT", "1" }, .{ "TF_GLM_PROMPT_OWN_FRONT", "1" }, .{ "TF_GLM_PROMPT_MICROBATCH", "1" } } });
+    try std.testing.expect(tp4.own_front and tp4.microbatch and tp4.split);
