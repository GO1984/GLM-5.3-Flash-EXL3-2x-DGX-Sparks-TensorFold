+//! CPU HTTP checks using the shipped Mia-AiLab GLM-5.3-Flash template (snapshot 078455ff).
+//! Template by zai-org/GLM; TensorFold prompts.py wrapper by Ash Hart and contributors.
+const std = @import("std");
+const server = @import("root.zig");
+const helper = @import("late_system_test.zig");
+const template = @import("template");
+const source = @embedFile("fixtures_glm_chat.jinja");
+
+test "GLM HTTP chat, SSE and health use the reference thinking-off prompt" {
+    var encoder: helper.DropLate = .{};
+    var text = encoder.text();
+    var hf: server.hf_text.HfText = .{
+        .gpa = std.testing.allocator,
+        .arena = .init(std.testing.allocator),
+        .tok = undefined,
+        .glm = true,
+        .source = source,
+        .compiled = try template.compile(std.testing.allocator, source, null),
+    };
+    defer hf.arena.deinit();
+    defer hf.compiled.?.deinit();
+    var vt = text.vtable.*;
+    vt.render = hf.text().vtable.render;
+    vt.template_source = hf.text().vtable.template_source;
+    text.ctx = &hf;
+    text.vtable = &vt;
+    var backend: helper.Capture = .{};
+    defer std.testing.allocator.free(backend.prompt);
+    var srv = try server.Server.init(std.testing.allocator, std.testing.io, backend.engine(), text, .{ .served_name = "glm5_next", .enable_thinking = false, .model_ids = &.{"glm5_next"} }, null);
+    defer srv.deinit();
+    for ([_]bool{ false, true }) |thinking| {
+        for ([_]bool{ false, true }) |stream| {
+            const body = try std.fmt.allocPrint(std.testing.allocator, "{{\"model\":\"glm5_next\",\"messages\":[{{\"role\":\"user\",\"content\":\"Hi\"}}],\"max_tokens\":4,\"stream\":{s},\"chat_template_kwargs\":{{\"enable_thinking\":{s}}}}}", .{ if (stream) "true" else "false", if (thinking) "true" else "false" });
+            defer std.testing.allocator.free(body);
+            const reply = try helper.exchange(srv, "/v1/chat/completions", body);
+            defer std.testing.allocator.free(reply.body);
+            try std.testing.expectEqual(@as(u16, 200), reply.status);
+            const expected = if (thinking) "[gMASK]<sop><|system|>Reasoning Effort: Max<|user|>Hi<|assistant|><think>" else "[gMASK]<sop><|user|>Hi<|assistant|><think></think>";
+            try std.testing.expectEqual(expected.len, backend.prompt.len);
+            for (expected, backend.prompt) |byte, id| try std.testing.expectEqual(@as(u32, byte), id);
+            try std.testing.expect(std.mem.indexOf(u8, reply.body, if (stream) "[DONE]" else "chat.completion") != null);
+        }
+    }
+    const health = try helper.exchangeMethod(srv, "GET", "/health", "");
+    defer std.testing.allocator.free(health.body);
+    try std.testing.expectEqual(@as(u16, 200), health.status);
+}
diff --git a/zig/src/server/glm_health.zig b/zig/src/server/glm_health.zig
new file mode 100644
index 00000000..0cad527b
--- /dev/null
+++ b/zig/src/server/glm_health.zig
@@ -0,0 +1,98 @@
+//! The fields the recipe's /health answers (Python `cuda/health.py` and the GLM decoder's `health()`), beside the
+//! native server's own: `ok`, `backend`, `busy`, `requests_running`, the totals of finished requests (a bench reads the
+//! `*_total` ones before and after a run), `streams`, `context_length`, and the pool's `pool_tokens` and
+//! `pool_free_tokens` when the engine reports them. The kept-state figures (`kept_*`, `spill`) belong to the prompt cache.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json.zig");
+const Server = @import("server.zig").Server;
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+fn put(a: Allocator, o: *json.Object, key: []const u8, n: anytype) !void {
+    try o.put(a, key, try json.intValue(a, n));
+}
+
+pub fn add(srv: *Server, a: Allocator, o: *json.Object, status: api.Status) !void {
+    const running = srv.in_system.load(.acquire);
+    try o.put(a, "ok", .{ .bool = true });
+    try o.put(a, "backend", .{ .string = "tensorfold" });
+    try o.put(a, "busy", .{ .bool = running > 0 });
+    try put(a, o, "requests_running", running);
+    {
+        const m = &srv.metrics;
+        m.mutex.lockUncancelable(srv.io);
+        defer m.mutex.unlock(srv.io);
+        try put(a, o, "requests_total", m.latency.n);
+        try put(a, o, "prompt_tokens_total", m.prompt);
+        // finished replies' tokens, and the live replies' so far
+        try put(a, o, "completion_tokens_total", m.generation + status.generation_tokens);
+        try o.put(a, "prefill_seconds_total", .{ .float = @round(m.prefill.total * 1e6) / 1e6 });
+        try o.put(a, "decode_seconds_total", .{ .float = @round(m.decode.total * 1e6) / 1e6 });
+        try put(a, o, "cached_tokens_total", m.cached);
+        try put(a, o, "rounds_total", m.rounds);
+        try put(a, o, "drafted_total", m.drafted);
+        try put(a, o, "accepted_total", m.accepted);
+    }
+    const decoding: u32 = @intCast(@min(status.streams, std.math.maxInt(u32)));
+    const filling = status.running -| decoding;
+    const streams = try json.newObject(a);
+    try put(a, streams, "decoding", decoding);
+    try put(a, streams, "prefilling", filling);
+    try put(a, streams, "max", srv.info.lanes);
+    try put(a, streams, "filling", filling);
+    try put(a, streams, "paused", 0);
+    try o.put(a, "streams", .{ .object = streams });
+    if (status.pool_tokens) |n| try put(a, o, "pool_tokens", n);
+    if (status.pool_free_tokens) |n| try put(a, o, "pool_free_tokens", n);
+    if (srv.info.context_window > 0) try put(a, o, "context_length", srv.info.context_window);
+}
+
+fn family(w: *std.Io.Writer, name: []const u8, kind: []const u8, help: []const u8) !void {
+    try w.print("# HELP tensorfold_health:{s} {s}\n# TYPE tensorfold_health:{s} {s}\n", .{ name, help, name, kind });
+}
+
+/// `/metrics`' `tensorfold_health:` families (patch 0045): /health's figures, named as /health names them.
+pub fn metrics(srv: *Server, w: *std.Io.Writer) !void {
+    var status: api.Status = .{};
+    srv.engine.status(&status, &.{});
+    const m = &srv.metrics;
+    m.mutex.lockUncancelable(srv.io);
+    const requests = m.latency.n;
+    const completion = m.generation + status.generation_tokens;
+    const cached = m.cached;
+    const rounds = m.rounds;
+    const prefill = m.prefill.total;
+    const decode = m.decode.total;
+    m.mutex.unlock(srv.io);
+    try family(w, "requests_total", "counter", "Finished requests (as /health's requests_total).");
+    try w.print("tensorfold_health:requests_total {d}\n", .{requests});
+    try family(w, "completion_tokens_total", "counter", "Reply tokens, the running replies' tokens so far included.");
+    try w.print("tensorfold_health:completion_tokens_total {d}\n", .{completion});
+    try family(w, "cached_tokens_total", "counter", "Prompt tokens found cached, finished requests.");
+    try w.print("tensorfold_health:cached_tokens_total {d}\n", .{cached});
+    try family(w, "rounds_total", "counter", "Decode rounds of finished requests.");
+    try w.print("tensorfold_health:rounds_total {d}\n", .{rounds});
+    try family(w, "prefill_seconds_total", "counter", "Engine prefill seconds of finished requests.");
+    try w.print("tensorfold_health:prefill_seconds_total {d}\n", .{prefill});
+    try family(w, "decode_seconds_total", "counter", "Engine decode seconds of finished requests.");
+    try w.print("tensorfold_health:decode_seconds_total {d}\n", .{decode});
+    const decoding: u32 = @intCast(@min(status.streams, std.math.maxInt(u32)));
+    const filling = status.running -| decoding;
+    try family(w, "streams", "gauge", "The concurrent engine's streams by state.");
+    try w.print("tensorfold_health:streams{{state=\"decoding\"}} {d}\ntensorfold_health:streams{{state=\"filling\"}} {d}\ntensorfold_health:streams{{state=\"paused\"}} 0\n", .{ decoding, filling });
+    if (srv.info.context_window > 0) {
+        try family(w, "context_length", "gauge", "Tokens a request's prompt and reply may hold (the server's effective window).");
+        try w.print("tensorfold_health:context_length {d}\n", .{srv.info.context_window});
+    }
+    try family(w, "streams_max", "gauge", "Streams the concurrent engine decodes at most (--parallel).");
+    try w.print("tensorfold_health:streams_max {d}\n", .{srv.info.lanes});
+    if (status.pool_tokens) |n| {
+        try family(w, "pool_tokens", "gauge", "Token rows in the concurrent engine's shared cache pool.");
+        try w.print("tensorfold_health:pool_tokens {d}\n", .{n});
+    }
+    if (status.pool_free_tokens) |n| {
+        try family(w, "pool_free_tokens", "gauge", "Pool rows no stream or kept prompt holds.");
+        try w.print("tensorfold_health:pool_free_tokens {d}\n", .{n});
+    }
+}
diff --git a/zig/src/server/glm_history.zig b/zig/src/server/glm_history.zig
new file mode 100644
index 00000000..36ffd650
--- /dev/null
+++ b/zig/src/server/glm_history.zig
@@ -0,0 +1,325 @@
+//! A chat history as GLM-5.3's template can render it (recipe patches 0051 and 0036; Python
+//! `families/glm5_next/prompts.py:agent_history` and `kept_reasoning.py`), applied before the messages are normalized.
+//!
+//! * `agentHistory`: a call's arguments sent as "" or null are no arguments; a call whose arguments are not a JSON
+//!   object is left out with its result (logged), because an agent replays its history every turn and a refusal would
+//!   end the conversation; results whose ids match none of their calls' ids are rendered in the order sent (the
+//!   template sorts results by id and silently drops one it cannot place).
+//! * `promoteReasoning`: `reasoning` (vLLM's newer replies, OpenRouter) is the step's `reasoning_content`.
+const std = @import("std");
+const json = @import("json.zig");
+const log = @import("log.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+/// `message.get("tool_call_id") or message.get("id")` of a dict, else None.
+fn callId(message: Value) ?Value {
+    if (message != .object) return null;
+    if (message.get("tool_call_id")) |v| if (v.truthy()) return v;
+    if (message.get("id")) |v| if (v.truthy()) return v;
+    return null;
+}
+
+fn sameId(x: ?Value, y: ?Value) bool {
+    if (x == null or y == null) return x == null and y == null;
+    return json.equal(x.?, y.?);
+}
+
+fn isTool(m: Value) bool {
+    return m == .object and m.strField("role") != null and std.mem.eql(u8, m.strField("role").?, "tool");
+}
+
+/// Python's `str.strip()` of a string being empty.
+fn blank(s: []const u8) bool {
+    return std.mem.trim(u8, s, " \t\r\n\x0b\x0c").len == 0;
+}
+
+fn withoutKey(a: Allocator, o: *const json.Object, keys: []const []const u8) Allocator.Error!Value {
+    const out = try json.newObject(a);
+    for (o.keys(), o.values()) |k, v| {
+        var skip = false;
+        for (keys) |drop| {
+            if (std.mem.eql(u8, k, drop)) skip = true;
+        }
+        if (!skip) try out.put(a, k, v);
+    }
+    return .{ .object = out };
+}
+
+/// `agent_history(messages)`: `messages` itself when nothing needs fixing.
+pub fn agentHistory(a: Allocator, messages: Value) Allocator.Error!Value {
+    if (messages != .array) return messages;
+    var out: std.ArrayList(Value) = .empty;
+    try out.appendSlice(a, messages.array);
+    var changed = false;
+    var i: usize = 0;
+    while (i < out.items.len) : (i += 1) {
+        const message = out.items[i];
+        const role = message.strField("role") orelse "";
+        const calls_v = if (message == .object and std.mem.eql(u8, role, "assistant")) message.get("tool_calls") else null;
+        if (calls_v == null or calls_v.? != .array or calls_v.?.array.len == 0) continue;
+        const calls = calls_v.?.array;
+        var fixed: std.ArrayList(Value) = .empty;
+        var bad: std.ArrayList(usize) = .empty;
+        var mended = false;
+        for (calls, 0..) |call, j| {
+            const function: ?Value = if (call == .object) call.get("function") else null;
+            const have_function = function != null and function.? == .object;
+            var arguments: ?Value = .{ .object = try json.newObject(a) }; // `{}` when the function is no dict
+            if (have_function) arguments = function.?.get("arguments") orelse .null;
+            const a_val = arguments.?;
+            if (a_val == .null or (a_val == .string and blank(a_val.string))) {
+                const fn_copy = try json.copyObject(a, function.?.object);
+                try fn_copy.put(a, "arguments", .{ .object = try json.newObject(a) });
+                const call_copy = try json.copyObject(a, call.object);
+                try call_copy.put(a, "function", .{ .object = fn_copy });
+                try fixed.append(a, .{ .object = call_copy });
+                mended = true;
+                continue;
+            } else if (a_val == .string) {
+                const parsed: ?Value = switch (try json.parseText(a, a_val.string)) {
+                    .ok => |v| v,
+                    .err => null,
+                };
+                if (parsed == null or parsed.? != .object) {
+                    const shown = a_val.string[0..@min(a_val.string.len, 80)];
+                    const id = callId(call);
+                    log.line("messages[{d}].tool_calls[{d}] ({s}): arguments are not a JSON object ('{s}'); the call and its result are left out of the prompt", .{ i, j, if (id) |x| (if (x == .string) x.string else "?") else "None", shown });
+                    try bad.append(a, j);
+                    continue;
+                }
+            }
+            try fixed.append(a, call);
+        }
+        var end = i + 1;
+        while (end < out.items.len and isTool(out.items[end])) end += 1;
+        if (bad.items.len > 0) {
+            changed = true;
+            var ids: std.ArrayList(Value) = .empty;
+            for (bad.items) |j| if (callId(calls[j])) |id| try ids.append(a, id);
+            const by_place = ids.items.len == 0 and end - i - 1 == calls.len;
+            var keep: std.ArrayList(Value) = .empty;
+            for (out.items[i + 1 .. end], 0..) |r, k| {
+                var drop = false;
+                if (callId(r)) |rid| for (ids.items) |id| {
+                    if (json.equal(rid, id)) drop = true;
+                };
+                if (by_place and std.mem.indexOfScalar(usize, bad.items, k) != null) drop = true;
+                if (!drop) try keep.append(a, r);
+            }
+            try out.replaceRange(a, i + 1, end - i - 1, keep.items);
+            end = i + 1;
+            while (end < out.items.len and isTool(out.items[end])) end += 1;
+        }
+        if (fixed.items.len > 0) {
+            if (bad.items.len > 0 or mended) {
+                const copy = try json.copyObject(a, message.object);
+                try copy.put(a, "tool_calls", .{ .array = fixed.items });
+                out.items[i] = .{ .object = copy };
+                changed = true;
+            }
+        } else {
+            out.items[i] = try withoutKey(a, message.object, &.{"tool_calls"});
+            changed = true;
+            continue;
+        }
+        // results whose ids match none of the calls' ids: rendered in the order sent, their ids dropped
+        var orphan = false;
+        for (out.items[i + 1 .. end]) |r| {
+            const rid = callId(r) orelse continue;
+            var known = false;
+            for (fixed.items) |c| if (sameId(callId(c), rid)) {
+                known = true;
+            };
+            if (!known) orphan = true;
+        }
+        if (orphan) {
+            for (out.items[i + 1 .. end]) |*r| r.* = try withoutKey(a, r.object, &.{ "tool_call_id", "id" });
+            changed = true;
+        }
+    }
+    return if (changed) .{ .array = try out.toOwnedSlice(a) } else messages;
+}
+
+/// `normalize_messages`' rule for GLM: an assistant message with `reasoning` (a string) and no `reasoning_content`
+/// string gets it as `reasoning_content` (without it a tool step's reasoning is dropped from the resent history).
+pub fn promoteReasoning(a: Allocator, messages: Value) Allocator.Error!Value {
+    if (messages != .array) return messages;
+    var out: ?[]Value = null;
+    for (messages.array, 0..) |m, i| {
+        if (m != .object or !std.mem.eql(u8, m.strField("role") orelse "", "assistant")) continue;
+        if (m.strField("reasoning_content") != null) continue;
+        const r = m.strField("reasoning") orelse continue;
+        if (out == null) out = try a.dupe(Value, messages.array);
+        const copy = try json.copyObject(a, m.object);
+        try copy.put(a, "reasoning_content", .{ .string = r });
+        out.?[i] = .{ .object = copy };
+    }
+    return if (out) |o| .{ .array = o } else messages;
+}
+
+
+fn mediaKind(part: Value) ?[]const u8 {
+    if (part != .object) return null;
+    const t = part.strField("type") orelse return null;
+    if (std.mem.eql(u8, t, "image_url")) return "image";
+    if (std.mem.eql(u8, t, "video_url")) return "video";
+    return null;
+}
+
+fn hasMediaPart(m: Value) bool {
+    const content = if (m == .object) m.get("content") else null;
+    if (content == null or content.? != .array) return false;
+    for (content.?.array) |p| if (mediaKind(p) != null) return true;
+    return false;
+}
+
+/// `prompts.tool_media_parts` (patch 0056, issue #28) for a server without a vision frontend: a tool result's pictures
+/// and clips render as the template's own reminder ("You are unable to process this image ...") instead of a 400, so an
+/// agent session that keeps a screenshot in its history goes on. Messages whose pictures are all in tool results come
+/// back with those parts as the reminder text (never fetched or decoded); a user's (or any other message's) pictures
+/// leave the messages as they were, to be refused as before.
+pub fn toolMedia(a: Allocator, messages: Value) Allocator.Error!Value {
+    if (messages != .array) return messages;
+    var any = false;
+    for (messages.array) |m| if (hasMediaPart(m)) {
+        if (!isTool(m)) return messages;
+        any = true;
+    };
+    if (!any) return messages;
+    const out = try a.alloc(Value, messages.array.len);
+    for (messages.array, out) |m, *slot| {
+        slot.* = m;
+        if (!hasMediaPart(m)) continue;
+        const parts = try a.alloc(Value, m.get("content").?.array.len);
+        for (m.get("content").?.array, parts) |part, *p| {
+            if (mediaKind(part)) |kind| {
+                const text = try std.fmt.allocPrint(a, "<reminder>You are unable to process this {s} because you don't have multi-modal input ability. Try different methods.</reminder>", .{kind});
+                const o = try json.newObject(a);
+                try o.put(a, "type", .{ .string = "text" });
+                try o.put(a, "text", .{ .string = text });
+                p.* = .{ .object = o };
+            } else p.* = part;
+        }
+        const copy = try json.copyObject(a, m.object);
+        try copy.put(a, "content", .{ .array = parts });
+        slot.* = .{ .object = copy };
+    }
+    return .{ .array = out };
+}
+
+test "a tool result's pictures become the template's reminder; a user's are left to be refused" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"tool","tool_call_id":"c","content":[{"type":"text","text":"shot: "},{"type":"image_url","image_url":{"url":"data:image/png;base64,AAAA"}},{"type":"video_url","video_url":{"url":"http://x/y.mp4"}}]}]
+    );
+    const out = try toolMedia(a, m);
+    const parts = out.array[1].get("content").?.array;
+    try std.testing.expectEqual(@as(usize, 3), parts.len);
+    try std.testing.expectEqualStrings("shot: ", parts[0].strField("text").?);
+    try std.testing.expectEqualStrings("<reminder>You are unable to process this image because you don't have multi-modal input ability. Try different methods.</reminder>", parts[1].strField("text").?);
+    try std.testing.expect(std.mem.indexOf(u8, parts[2].strField("text").?, "process this video") != null);
+    const user = try parseArr(a,
+        \\[{"role":"user","content":[{"type":"image_url","image_url":{"url":"data:x"}}]},{"role":"tool","content":[{"type":"image_url","image_url":{"url":"data:x"}}]}]
+    );
+    try std.testing.expect((try toolMedia(a, user)).array.ptr == user.array.ptr);
+    const none = try parseArr(a, "[{\"role\":\"user\",\"content\":\"x\"}]");
+    try std.testing.expect((try toolMedia(a, none)).array.ptr == none.array.ptr);
+}
+
+fn parseArr(a: Allocator, text: []const u8) !Value {
+    return (try json.parse(a, text)).ok;
+}
+
+fn dump(a: Allocator, v: Value) ![]u8 {
+    return json.stringify(a, v, .{ .ascii = false });
+}
+
+test "empty and null arguments are no arguments" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"","tool_calls":[{"id":"c1","type":"function","function":{"name":"f","arguments":""}},{"id":"c2","type":"function","function":{"name":"g","arguments":null}},{"id":"c3","type":"function","function":{"name":"h"}}]},{"role":"tool","tool_call_id":"c1","content":"1"},{"role":"tool","tool_call_id":"c2","content":"2"},{"role":"tool","tool_call_id":"c3","content":"3"}]
+    );
+    const out = try agentHistory(a, m);
+    const calls = out.array[1].get("tool_calls").?.array;
+    for (calls) |c| try std.testing.expectEqual(@as(usize, 0), c.get("function").?.get("arguments").?.object.count());
+    try std.testing.expectEqual(@as(usize, 5), out.array.len);
+}
+
+test "a call with arguments that are not a JSON object leaves with its result, by id" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"hmm","tool_calls":[{"id":"c1","type":"function","function":{"name":"f","arguments":"{\"a\": "}},{"id":"c2","type":"function","function":{"name":"g","arguments":"{\"b\":1}"}},{"id":"c3","type":"function","function":{"name":"h","arguments":"[1,2]"}}]},{"role":"tool","tool_call_id":"c1","content":"r1"},{"role":"tool","tool_call_id":"c2","content":"r2"},{"role":"tool","tool_call_id":"c3","content":"r3"}]
+    );
+    const out = try agentHistory(a, m);
+    try std.testing.expectEqual(@as(usize, 3), out.array.len); // c1's and c3's results left with their calls
+    const calls = out.array[1].get("tool_calls").?.array;
+    try std.testing.expectEqual(@as(usize, 1), calls.len);
+    try std.testing.expectEqualStrings("c2", calls[0].strField("id").?);
+    try std.testing.expectEqualStrings("hmm", out.array[1].strField("content").?);
+    try std.testing.expectEqualStrings("r2", out.array[2].strField("content").?);
+    try std.testing.expectEqualStrings("c2", out.array[2].strField("tool_call_id").?);
+}
+
+test "every call bad: the message loses its tool_calls and keeps its text" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"hmm","tool_calls":[{"id":"c1","type":"function","function":{"name":"f","arguments":"{trunc"}}]},{"role":"tool","tool_call_id":"c1","content":"r1"},{"role":"user","content":"again"}]
+    );
+    const out = try agentHistory(a, m);
+    try std.testing.expectEqual(@as(usize, 3), out.array.len);
+    try std.testing.expect(!out.array[1].has("tool_calls"));
+    try std.testing.expectEqualStrings("hmm", out.array[1].strField("content").?);
+    try std.testing.expectEqualStrings("user", out.array[2].strField("role").?);
+}
+
+test "no ids: the bad call's result goes by its place" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"","tool_calls":[{"type":"function","function":{"name":"f","arguments":"{\"a\":1}"}},{"type":"function","function":{"name":"g","arguments":"nope"}}]},{"role":"tool","content":"r1"},{"role":"tool","content":"r2"}]
+    );
+    const out = try agentHistory(a, m);
+    try std.testing.expectEqual(@as(usize, 3), out.array.len);
+    try std.testing.expectEqualStrings("r1", out.array[2].strField("content").?);
+}
+
+test "results whose ids match none of the calls lose their ids and keep the order sent" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"","tool_calls":[{"id":"call_a","type":"function","function":{"name":"f","arguments":{}}},{"id":"call_b","type":"function","function":{"name":"g","arguments":{}}}]},{"role":"tool","tool_call_id":"zzz","content":"r1"},{"role":"tool","tool_call_id":"yyy","content":"r2"}]
+    );
+    const out = try agentHistory(a, m);
+    try std.testing.expect(!out.array[2].has("tool_call_id"));
+    try std.testing.expect(!out.array[3].has("tool_call_id"));
+    // a history with matching ids is the very same value
+    const ok = try parseArr(a,
+        \\[{"role":"user","content":"x"},{"role":"assistant","content":"","tool_calls":[{"id":"c1","type":"function","function":{"name":"f","arguments":{"a":1}}}]},{"role":"tool","tool_call_id":"c1","content":"r1"}]
+    );
+    const same = try agentHistory(a, ok);
+    try std.testing.expect(same.array.ptr == ok.array.ptr);
+}
+
+test "reasoning becomes reasoning_content where the step has none" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const m = try parseArr(a,
+        \\[{"role":"assistant","content":"a","reasoning":"why"},{"role":"assistant","content":"b","reasoning":"no","reasoning_content":"kept"}]
+    );
+    const out = try promoteReasoning(a, m);
+    try std.testing.expectEqualStrings("why", out.array[0].strField("reasoning_content").?);
+    try std.testing.expectEqualStrings("kept", out.array[1].strField("reasoning_content").?);
+    _ = try dump(a, out);
+}
diff --git a/zig/src/server/glm_kept.zig b/zig/src/server/glm_kept.zig
new file mode 100644
index 00000000..86b7e042
--- /dev/null
+++ b/zig/src/server/glm_kept.zig
@@ -0,0 +1,294 @@
+//! The reasoning of GLM's tool-calling replies, put back into later requests whose client dropped it (recipe patch
+//! 0036; Python `families/glm5_next/cuda/kept_reasoning.py`, whose ReasoningMemory idea is jayleaton/glm53-tensorfold-spark
+//! patch 0620, Apache-2.0).
+//!
+//! GLM-5.3's template renders the reasoning of every assistant step after the last user message (interleaved thinking
+//! inside one tool loop). A client that does not send a step's reasoning back gets `<think></think>` for it: a context
+//! the model never wrote, and a prompt that stops matching the previous one at that step, so the prefix cache re-reads
+//! the rest. With the reasoning kept here, each prompt of a chain continues the last one as it was generated. A step
+//! that carries its own reasoning (`reasoning_content` or `reasoning`, or a `<think>` block in its content) is never
+//! changed; an empty one is none.
+//!
+//! TF_GLM_KEEP_REASONING: replies kept (default 1024; 0 turns this off); TF_GLM_KEEP_REASONING_MB: their text at most
+//! (default 32 MiB); the oldest go first.
+const std = @import("std");
+const json = @import("json.zig");
+const reply_text = @import("reply_text.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+const Entry = struct { text: []u8, keys: [][]u8 };
+
+pub const KeptReasoning = struct {
+    gpa: Allocator,
+    io: std.Io,
+    entries: u32,
+    chars: usize,
+    mutex: std.Io.Mutex = .init,
+    items: std.AutoArrayHashMapUnmanaged(u64, Entry) = .empty, // insertion order, oldest first (moved on a hit)
+    by_key: std.StringHashMapUnmanaged(u64) = .empty,
+    size: usize = 0,
+    next: u64 = 0,
+
+    pub fn init(gpa: Allocator, io: std.Io, entries: u32, megabytes: u32) KeptReasoning {
+        return .{ .gpa = gpa, .io = io, .entries = entries, .chars = @as(usize, megabytes) << 20 };
+    }
+
+    pub fn deinit(k: *KeptReasoning) void {
+        for (k.items.values()) |e| k.free(e);
+        k.items.deinit(k.gpa);
+        k.by_key.deinit(k.gpa);
+    }
+
+    fn free(k: *KeptReasoning, e: Entry) void {
+        for (e.keys) |key| k.gpa.free(key);
+        k.gpa.free(e.keys);
+        k.gpa.free(e.text);
+    }
+
+    /// Keep the `reasoning` of a reply that made `calls` after the request's `messages`.
+    pub fn remember(k: *KeptReasoning, a: Allocator, messages: Value, calls: []const Value, reasoning: ?[]const u8) Allocator.Error!void {
+        const text = reasoning orelse return;
+        if (calls.len == 0 or reply_text.pyStrip(text).len == 0 or text.len > k.chars) return;
+        const found = try keysOf(a, if (messages == .array) messages.array else &.{}, calls);
+        var keys: std.ArrayList([]u8) = .empty;
+        errdefer {
+            for (keys.items) |key| k.gpa.free(key);
+            keys.deinit(k.gpa);
+        }
+        for (found) |key| try keys.append(k.gpa, try k.gpa.dupe(u8, key));
+        const copy = try k.gpa.dupe(u8, text);
+        errdefer k.gpa.free(copy);
+        const owned = try keys.toOwnedSlice(k.gpa);
+        k.mutex.lockUncancelable(k.io);
+        defer k.mutex.unlock(k.io);
+        const n = k.next;
+        k.next += 1;
+        try k.items.put(k.gpa, n, .{ .text = copy, .keys = owned });
+        k.size += copy.len;
+        for (owned) |key| try k.by_key.put(k.gpa, key, n); // a key kept again points at the newer reply
+        while (k.items.count() > k.entries or k.size > k.chars) {
+            const old = k.items.values()[0];
+            const old_n = k.items.keys()[0];
+            k.items.orderedRemoveAt(0);
+            k.size -= old.text.len;
+            for (old.keys) |key| if (k.by_key.get(key)) |at| if (at == old_n) {
+                _ = k.by_key.remove(key);
+            };
+            k.free(old);
+        }
+    }
+
+    fn find(k: *KeptReasoning, a: Allocator, keys: []const []const u8) Allocator.Error!?[]const u8 {
+        k.mutex.lockUncancelable(k.io);
+        defer k.mutex.unlock(k.io);
+        for (keys) |key| if (k.by_key.get(key)) |n| {
+            const index = k.items.getIndex(n) orelse continue;
+            const entry = k.items.values()[index];
+            const text = try a.dupe(u8, entry.text);
+            // a hit is the newest again
+            k.items.orderedRemoveAt(index);
+            try k.items.put(k.gpa, n, entry);
+            return text;
+        };
+        return null;
+    }
+
+    /// `messages` with the kept reasoning of each assistant step that calls tools and carries none (a copy; the
+    /// caller's list and messages are left alone).
+    pub fn restore(k: *KeptReasoning, a: Allocator, messages: Value) Allocator.Error!Value {
+        if (messages != .array or k.items.count() == 0) return messages;
+        var out: ?[]Value = null;
+        for (messages.array, 0..) |m, i| {
+            if (m != .object or !std.mem.eql(u8, m.strField("role") orelse "", "assistant")) continue;
+            const calls = m.get("tool_calls") orelse continue;
+            if (!calls.truthy()) continue;
+            if (reply_text.pyStrip(textOf(m.get("reasoning_content"))).len > 0 or reply_text.pyStrip(textOf(m.get("reasoning"))).len > 0) continue;
+            if (std.mem.indexOf(u8, textOf(m.get("content")), "</think>") != null) continue;
+            const found = try keysOf(a, messages.array[0..i], if (calls == .array) calls.array else &.{});
+            const kept = try k.find(a, found) orelse continue;
+            if (out == null) out = try a.dupe(Value, messages.array);
+            const copy = try json.copyObject(a, m.object);
+            try copy.put(a, "reasoning_content", .{ .string = kept });
+            out.?[i] = .{ .object = copy };
+        }
+        return if (out) |o| .{ .array = o } else messages;
+    }
+};
+
+/// A content as text: a string, or the text parts of a list joined.
+fn textOf(content: ?Value) []const u8 {
+    const c = content orelse return "";
+    return switch (c) {
+        .string => |s| s,
+        else => "", // a list's parts are joined by `textJoined` where the signature needs them
+    };
+}
+
+fn textJoined(a: Allocator, content: ?Value) Allocator.Error![]const u8 {
+    const c = content orelse return "";
+    switch (c) {
+        .string => |s| return s,
+        .array => |parts| {
+            var out: std.ArrayList(u8) = .empty;
+            for (parts) |p| if (p == .object) if (p.strField("text")) |t| try out.appendSlice(a, t);
+            return out.items;
+        },
+        else => return "",
+    }
+}
+
+fn isOurId(id: []const u8) bool {
+    if (id.len != 29 or !std.mem.startsWith(u8, id, "call_")) return false;
+    for (id[5..]) |c| if (!std.ascii.isDigit(c) and !(c >= 'a' and c <= 'f')) return false;
+    return true;
+}
+
+/// The arguments as a JSON value: a string parsed (as given when it is not JSON), none as `{}`.
+fn argumentsOf(a: Allocator, v: ?Value) Allocator.Error!Value {
+    const x = v orelse return .{ .object = try json.newObject(a) };
+    switch (x) {
+        .string => |s| {
+            if (reply_text.pyStrip(s).len == 0) return .{ .object = try json.newObject(a) };
+            return switch (try json.parseText(a, s)) {
+                .ok => |parsed| parsed,
+                .err => x,
+            };
+        },
+        .null => return .{ .object = try json.newObject(a) },
+        else => return x,
+    }
+}
+
+/// Calls as `[name, arguments]`: ids dropped (clients renumber them), arguments parsed (clients re-serialise).
+fn callsOf(a: Allocator, calls: []const Value) Allocator.Error!Value {
+    const out = try a.alloc(Value, calls.len);
+    for (calls, out) |call, *slot| {
+        const f = if (call == .object) call.get("function") else null;
+        const function: Value = if (f != null and f.? == .object) f.? else .{ .object = try json.newObject(a) };
+        const pair = try a.alloc(Value, 2);
+        pair[0] = .{ .string = function.strField("name") orelse "" };
+        pair[1] = try argumentsOf(a, function.get("arguments"));
+        slot.* = .{ .array = pair };
+    }
+    return .{ .array = out };
+}
+
+/// `json.dumps(v, sort_keys=True, separators=(",", ":"), ensure_ascii=False)`.
+fn canonical(a: Allocator, w: *std.ArrayList(u8), v: Value) Allocator.Error!void {
+    switch (v) {
+        .array => |items| {
+            try w.append(a, '[');
+            for (items, 0..) |item, i| {
+                if (i > 0) try w.append(a, ',');
+                try canonical(a, w, item);
+            }
+            try w.append(a, ']');
+        },
+        .object => |o| {
+            const names = try a.dupe([]const u8, o.keys());
+            std.mem.sort([]const u8, names, {}, struct {
+                fn less(_: void, x: []const u8, y: []const u8) bool {
+                    return std.mem.lessThan(u8, x, y);
+                }
+            }.less);
+            try w.append(a, '{');
+            for (names, 0..) |name, i| {
+                if (i > 0) try w.append(a, ',');
+                try w.appendSlice(a, try json.quote(a, name, .{ .ascii = false }));
+                try w.append(a, ':');
+                try canonical(a, w, o.get(name).?);
+            }
+            try w.append(a, '}');
+        },
+        else => try w.appendSlice(a, try json.stringify(a, v, .{ .ascii = false, .compact = true })),
+    }
+}
+
+/// The key of `calls` written after `history`: each message's role, text (stripped, as the template renders it) and
+/// calls, without ids or reasoning, then the calls.
+pub fn signature(a: Allocator, history: []const Value, calls: []const Value) Allocator.Error![]const u8 {
+    var shape: std.ArrayList(Value) = .empty;
+    for (history) |m| {
+        if (m != .object) continue;
+        const entry: std.ArrayList(Value) = blk: {
+            var e: std.ArrayList(Value) = .empty;
+            try e.append(a, .{ .string = m.strField("role") orelse "" });
+            try e.append(a, .{ .string = reply_text.pyStrip(try textJoined(a, m.get("content"))) });
+            if (std.mem.eql(u8, m.strField("role") orelse "", "assistant")) if (m.get("tool_calls")) |tc| if (tc.truthy() and tc == .array)
+                try e.append(a, try callsOf(a, tc.array));
+            break :blk e;
+        };
+        try shape.append(a, .{ .array = entry.items });
+    }
+    const top = try a.alloc(Value, 2);
+    top[0] = .{ .array = shape.items };
+    top[1] = try callsOf(a, calls);
+    var text: std.ArrayList(u8) = .empty;
+    try canonical(a, &text, .{ .array = top });
+    var digest: [32]u8 = undefined;
+    Sha256.hash(text.items, &digest, .{});
+    return std.fmt.allocPrint(a, "sig:{x}", .{&digest});
+}
+
+fn keysOf(a: Allocator, history: []const Value, calls: []const Value) Allocator.Error![]const []const u8 {
+    var out: std.ArrayList([]const u8) = .empty;
+    for (calls) |c| if (c == .object) if (c.strField("id")) |id| if (isOurId(id)) try out.append(a, id);
+    try out.append(a, try signature(a, history, calls));
+    return out.items;
+}
+
+test "a kept reply's reasoning returns to the step whose client dropped it" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var k = KeptReasoning.init(std.testing.allocator, std.testing.io, 8, 1);
+    defer k.deinit();
+    const history = (try json.parse(a, "[{\"role\":\"user\",\"content\":\"go\"}]")).ok;
+    const calls = (try json.parse(a, "[{\"id\":\"call_0123456789abcdef01234567\",\"type\":\"function\",\"function\":{\"name\":\"f\",\"arguments\":\"{\\\"a\\\":1}\"}}]")).ok;
+    try k.remember(a, history, calls.array, "I should call f.");
+    // the next request: the client renumbered the id and dropped the reasoning; the signature finds it
+    const next = (try json.parse(a,
+        \\[{"role":"user","content":" go "},{"role":"assistant","content":"","tool_calls":[{"id":"x1","type":"function","function":{"name":"f","arguments":{"a":1}}}]},{"role":"tool","tool_call_id":"x1","content":"ok"}]
+    )).ok;
+    const restored = try k.restore(a, next);
+    try std.testing.expectEqualStrings("I should call f.", restored.array[1].strField("reasoning_content").?);
+    try std.testing.expect(!next.array[1].has("reasoning_content")); // the caller's messages are left alone
+    // a step that carries its own reasoning, or a think block, is never changed
+    const own = (try json.parse(a,
+        \\[{"role":"user","content":"go"},{"role":"assistant","content":"","reasoning_content":"mine","tool_calls":[{"id":"call_0123456789abcdef01234567","type":"function","function":{"name":"f","arguments":"{}"}}]}]
+    )).ok;
+    try std.testing.expect((try k.restore(a, own)).array.ptr == own.array.ptr);
+    // another conversation is not given it
+    const other = (try json.parse(a,
+        \\[{"role":"user","content":"different"},{"role":"assistant","content":"","tool_calls":[{"id":"y","type":"function","function":{"name":"f","arguments":{"a":1}}}]}]
+    )).ok;
+    try std.testing.expect((try k.restore(a, other)).array.ptr == other.array.ptr);
+    // the id the server made finds it too
+    const by_id = (try json.parse(a,
+        \\[{"role":"user","content":"unrelated"},{"role":"assistant","content":"","tool_calls":[{"id":"call_0123456789abcdef01234567","type":"function","function":{"name":"g","arguments":{}}}]}]
+    )).ok;
+    try std.testing.expectEqualStrings("I should call f.", (try k.restore(a, by_id)).array[1].strField("reasoning_content").?);
+}
+
+test "the oldest replies go first, by count and by size" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var k = KeptReasoning.init(std.testing.allocator, std.testing.io, 2, 1);
+    defer k.deinit();
+    const calls = (try json.parse(a, "[{\"id\":\"call_0123456789abcdef01234567\",\"function\":{\"name\":\"f\",\"arguments\":{}}}]")).ok;
+    for (0..4) |i| {
+        const history = (try json.parse(a, try std.fmt.allocPrint(a, "[{{\"role\":\"user\",\"content\":\"q{d}\"}}]", .{i}))).ok;
+        const c = (try json.parse(a, try std.fmt.allocPrint(a, "[{{\"id\":\"x\",\"function\":{{\"name\":\"f\",\"arguments\":{{\"n\":{d}}}}}}}]", .{i}))).ok;
+        try k.remember(a, history, c.array, "reason");
+    }
+    try std.testing.expectEqual(@as(usize, 2), k.items.count());
+    _ = calls;
+    // a reply longer than the whole budget is not kept
+    var tiny = KeptReasoning.init(std.testing.allocator, std.testing.io, 8, 0);
+    defer tiny.deinit();
+    try tiny.remember(a, .{ .array = &.{} }, (try json.parse(a, "[{\"function\":{\"name\":\"f\"}}]")).ok.array, "x");
+    try std.testing.expectEqual(@as(usize, 0), tiny.items.count());
+}
diff --git a/zig/src/server/glm_keys.zig b/zig/src/server/glm_keys.zig
new file mode 100644
index 00000000..3a848b16
--- /dev/null
+++ b/zig/src/server/glm_keys.zig
@@ -0,0 +1,95 @@
+//! A GLM call whose `<arg_key>` the model left out (recipe patches 0036 and 0053, issue #22): `repair_glm_keys` of
+//! `cuda/reply_text.py`.
+const std = @import("std");
+const reply_text = @import("reply_text.zig");
+const Allocator = std.mem.Allocator;
+
+pub const key_open = "<arg_key>";
+pub const key_close = "</arg_key>";
+pub const value_open = "<arg_value>";
+pub const value_close = "</arg_value>";
+
+/// Whether the end parser repairs missing `<arg_key>` marks (the GLM recipe); set once at start.
+pub var enabled = false;
+
+const Tag = enum { key_open, key_close, value_open, value_close };
+
+const Found = struct { tag: Tag, start: usize, end: usize };
+
+/// `re.finditer(r"</?arg_(?:key|value)>")`'s next match from `from`.
+fn nextTag(text: []const u8, from: usize) ?Found {
+    var i = from;
+    while (std.mem.indexOfScalarPos(u8, text, i, '<')) |at| {
+        const rest = text[at..];
+        const tags = [_]struct { []const u8, Tag }{ .{ key_open, .key_open }, .{ key_close, .key_close }, .{ value_open, .value_open }, .{ value_close, .value_close } };
+        for (tags) |t| if (std.mem.startsWith(u8, rest, t[0])) return .{ .tag = t[1], .start = at, .end = at + t[0].len };
+        i = at + 1;
+    }
+    return null;
+}
+
+fn count(text: []const u8, needle: []const u8) usize {
+    return std.mem.count(u8, text, needle);
+}
+
+/// `repair_glm_keys(block)`: a GLM call whose `<arg_key>` the model left out, writing whitespace where that token
+/// belongs (`read path</arg_key><arg_value>..`, or `</arg_value>\npath</arg_key>`), with it put back: the word before
+/// an unopened `</arg_key>` is its key. A block where nothing is missing comes back as it is.
+pub fn repair(a: Allocator, block: []const u8) Allocator.Error![]const u8 {
+    if (count(block, key_close) <= count(block, key_open)) return block;
+    var out: std.ArrayList(u8) = .empty;
+    var at: usize = 0; // text copied
+    var prev: ?Tag = null; // the last tag seen
+    var prev_end: usize = 0;
+    var from: usize = 0;
+    while (nextTag(block, from)) |tag| {
+        from = tag.end;
+        if (tag.tag == .key_close and (prev == null or prev.? == .value_close)) {
+            const seg_start: usize = if (prev == null) 0 else prev_end;
+            // `(\S+)\s*$` searched in [seg_start, tag.start): the last run of non-space characters
+            const trimmed = std.mem.trimEnd(u8, block[seg_start..tag.start], " \t\r\n\x0b\x0c");
+            if (trimmed.len == 0) return block;
+            var word_start = seg_start + trimmed.len;
+            while (word_start > seg_start and !reply_text.isSpaceByte(block[word_start - 1])) word_start -= 1;
+            // the name's segment keeps a name before the key (`read path`): no word, or no name, is not repaired
+            if (prev == null and reply_text.pyStrip(block[seg_start..word_start]).len == 0) return block;
+            try out.appendSlice(a, block[at..word_start]);
+            try out.appendSlice(a, key_open);
+            at = word_start;
+        }
+        prev = tag.tag;
+        prev_end = tag.end;
+    }
+    try out.appendSlice(a, block[at..]);
+    return out.items;
+}
+
+test "an unopened arg_key is put back before the word that precedes its close" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    // the name, then a key whose opener is missing
+    try std.testing.expectEqualStrings(
+        "read <arg_key>path</arg_key><arg_value>/tmp/x</arg_value>",
+        try repair(a, "read path</arg_key><arg_value>/tmp/x</arg_value>"),
+    );
+    // after a value, the next key's opener is missing
+    try std.testing.expectEqualStrings(
+        "write<arg_key>path</arg_key><arg_value>/tmp/x</arg_value>\n<arg_key>text</arg_key><arg_value>hi</arg_value>",
+        try repair(a, "write<arg_key>path</arg_key><arg_value>/tmp/x</arg_value>\ntext</arg_key><arg_value>hi</arg_value>"),
+    );
+}
+
+test "a block where nothing is missing, or nothing can be told, comes back as it is" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const whole = "read<arg_key>path</arg_key><arg_value>/tmp/x</arg_value>";
+    try std.testing.expectEqualStrings(whole, try repair(a, whole));
+    // no name before the first unopened key: not repaired
+    const nameless = "path</arg_key><arg_value>/tmp/x</arg_value>";
+    try std.testing.expectEqualStrings(nameless, try repair(a, nameless));
+    // no word at all before the close
+    const empty = "read </arg_key><arg_value>x</arg_value>";
+    try std.testing.expectEqualStrings(empty, try repair(a, empty));
+}
diff --git a/zig/src/server/glm_prompts.zig b/zig/src/server/glm_prompts.zig
new file mode 100644
index 00000000..ce5f471b
--- /dev/null
