+    defer gpa.free(ho1);
+    const ho2 = try gpa.alloc(u8, out_bytes);
+    defer gpa.free(ho2);
+    const hs1 = try gpa.alloc(u8, state_bytes);
+    defer gpa.free(hs1);
+    const hs2 = try gpa.alloc(u8, state_bytes);
+    defer gpa.free(hs2);
+    const hk = try gpa.alloc(u8, k_bytes);
+    defer gpa.free(hk);
+    const hk2 = try gpa.alloc(u8, k_bytes);
+    defer gpa.free(hk2);
