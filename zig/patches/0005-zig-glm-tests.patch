+fn segments(hold: *Hold, ops: kda.Ops, stream: cuda.Stream, gpa: std.mem.Allocator, p: u64, a: u64, g: u64, w: u64, p_stride: usize, a_stride: usize, g_stride: usize, b_off: usize, C: usize) !void {
