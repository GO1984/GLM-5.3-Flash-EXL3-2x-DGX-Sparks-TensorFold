+def vid(url="data:video/mp4;base64,AAAA"): return {"type": "video_url", "video_url": {"url": url}}
+def txt(t): return {"type": "text", "text": t}
+def msg(role, content, **kw): return {"role": role, **({"content": content} if content is not ... else {}), **kw}
