+    const hg = try gpa.alloc(u8, gk_bytes);
+    defer gpa.free(hg);
+    const hg2 = try gpa.alloc(u8, gk_bytes);
+    defer gpa.free(hg2);
+    const hb = try gpa.alloc(u8, b_bytes);
