+    "fn_gdn.cu": ("src/tensorfold/families/qwen4_exp/cuda/gdn.cu", 1, 213, (10, 11), (15, "tf_fn_gdn"), FN_GDN_FOOTER),
+    "fn_gdn_io.cu": (
