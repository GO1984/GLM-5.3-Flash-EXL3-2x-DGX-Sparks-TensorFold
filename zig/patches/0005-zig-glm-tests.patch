diff --git a/zig/tests/cuda/glm_p1/README.md b/zig/tests/cuda/glm_p1/README.md
new file mode 100644
index 00000000..7cadbddd
--- /dev/null
+++ b/zig/tests/cuda/glm_p1/README.md
@@ -0,0 +1,31 @@
+Real GLM TP=2 capture and replay (TensorFold/Ash Hart reference)
+
+The recipe worktree is read only. The capture launcher sources its config, mounts
+these hooks through PYTHONPATH, and uses its docker GPU/RDMA/network privileges.
+Only uniquely named glm-p1-* containers created by the launcher are removed.
+
+    flock /tmp/claude-1000/gpu.lock env GLM_GPU_LOCKED=1 \
+      python3 tools/zig/glm_capture.py --out glm-capture
+    python3 tools/zig/glm_aot.py --capture glm-capture \
+      --out zig/tests/cuda/glm_p1/aot \
+      --zig zig/src/families/glm_cuda/cuda_triton_generated.zig
+    ZIG_GLOBAL_CACHE_DIR=$PWD/../.zig-global-cache nice -n 19 zig build glm-p1-replay -j2
+    flock /tmp/claude-1000/gpu.lock zig-out/bin/tf-glm-p1-replay \
+      zig/tests/cuda/glm_p1/aot glm-capture/rank0
+    flock /tmp/claude-1000/gpu.lock zig-out/bin/tf-glm-p1-replay \
+      zig/tests/cuda/glm_p1/aot glm-capture/rank1
+
+GPU-FREE must exist. The lock covers both reference ranks and cleanup. Startup,
+eager decode and eager prefill launches retain the compiled signature, constexprs,
+argument alignment, source, call sites, grid, compiler options and cached cubin.
+Fixtures retain the union of tensor pointer spans per storage, rounded down to a
+16-byte base, preserving offset pointers and aliasing. Each span has before/after
+raw little-endian bytes. The replay restores the complete before image and checks
+the complete after image, including untouched bytes and padding.
+
+The large checkpoint pointer spans live in ignored glm-capture/, not in Git.
+Small wrapper metadata and captured cubins can be kept separately. A snapshot
+size limit is explicit in fixtures.json; skipped snapshots are never reported as
+passing. Graph replays do not reenter JITFunction.run, so fixtures require eager
+batched verify/drafter execution. Captured specializations cover this workload;
+missing variants fail through aot.Set.find instead of approximating arithmetic.
diff --git a/zig/tests/cuda/glm_p1/replay.zig b/zig/tests/cuda/glm_p1/replay.zig
new file mode 100644
index 00000000..704ca0ba
--- /dev/null
+++ b/zig/tests/cuda/glm_p1/replay.zig
@@ -0,0 +1,98 @@
+//! Replay real glm5_next/cuda Triton launches against eager Python CPU pointer-span fixtures.
+//! TensorFold/Ash Hart reference; preserves aliases, view offsets and original specialization.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const aot = cuda.aot;
+const PtrDiff = struct { to: []const u8, from: []const u8, elem: u64 };
+const ArgJson = struct { name: []const u8, type: []const u8, buffer: ?usize = null, offset: u64 = 0, int: ?i64 = null, f32: ?u32 = null, ptrdiff: ?PtrDiff = null };
+
+fn addressOf(sample: Sample, buffers: []const cuda.DeviceBuffer, name: []const u8) !u64 {
+    for (sample.args) |a| if (std.mem.eql(u8, a.name, name)) return buffers[a.buffer orelse return error.PtrDiffNotPointer].ptr + a.offset;
+    for (sample.extras) |a| if (std.mem.eql(u8, a.name, name)) return buffers[a.buffer orelse return error.PtrDiffNotPointer].ptr + a.offset;
+    return error.PtrDiffUnknownArgument;
+}
+const ConstJson = struct { int: ?i64 = null, f32: ?u32 = null };
+const Sample = struct { @"fn": []const u8, hash: []const u8, phase: []const u8, grid: [3]usize, args: []ArgJson, extras: []ArgJson = &.{}, consts: std.json.ArrayHashMap(ConstJson), folder: []const u8, buffers: []usize };
+const Fixtures = struct { samples: []Sample };
+fn read(gpa: std.mem.Allocator, io: std.Io, root: []const u8, folder: []const u8, index: usize, suffix: []const u8) ![]u8 {
+    const path = try std.fmt.allocPrint(gpa, "{s}/{s}/{d}.{s}.bin", .{ root, folder, index, suffix });
+    defer gpa.free(path);
+    return std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(2 << 30));
+}
+pub fn main(init: std.process.Init) !void {
+    const argv = try init.minimal.args.toSlice(init.arena.allocator());
+    if (argv.len != 3) return error.ExpectedAotDirectoryAndCaptureRankDirectory;
+    const gpa = init.gpa;
+    const io = init.io;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var set = try aot.Set.load(gpa, io, &driver, ctx.device, argv[1]);
+    defer set.deinit();
+    var memo: glm.triton.Memo = .{ .gpa = gpa };
+    defer memo.deinit();
+    const tri: glm.triton.Tri = .{ .set = &set, .s = stream, .memo = &memo };
+    const path = try std.fs.path.join(gpa, &.{ argv[2], "replay.json" });
+    defer gpa.free(path);
+    const raw = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 26));
+    defer gpa.free(raw);
+    const parsed = try std.json.parseFromSlice(Fixtures, gpa, raw, .{ .ignore_unknown_fields = true });
+    defer parsed.deinit();
+    if (parsed.value.samples.len == 0) return error.EmptyFixtureSet;
+    for (parsed.value.samples) |sample| {
+        const buffers = try gpa.alloc(cuda.DeviceBuffer, sample.buffers.len);
+        defer gpa.free(buffers);
+        var loaded: usize = 0;
+        defer for (buffers[0..loaded]) |*b| b.free();
+        for (sample.buffers, 0..) |size, i| {
+            const bytes = try read(gpa, io, argv[2], sample.folder, i, "in");
+            defer gpa.free(bytes);
+            if (bytes.len != size) return error.FixtureSizeMismatch;
+            buffers[i] = try cuda.DeviceBuffer.alloc(&driver, size);
+            loaded += 1;
+            try buffers[i].upload(0, bytes);
+        }
+        var args: [64]aot.Arg = undefined;
+        if (sample.args.len > args.len) return error.TooManyArguments;
+        for (sample.args, 0..) |arg, i| {
+            if (arg.ptrdiff) |d| {
+                // Address-dependent scalar (hc_post_pair's RS): recomputed from this replay's own buffer addresses.
+                const to: i64 = @bitCast(try addressOf(sample, buffers, d.to));
+                const from: i64 = @bitCast(try addressOf(sample, buffers, d.from));
+                const v = @divFloor(to - from, @as(i64, @intCast(d.elem)));
+                // Triton types an integer argument by magnitude: i32 when it fits, else i64.
+                args[i] = if (std.math.cast(i32, v)) |small| aot.int(arg.name, small) else aot.word(arg.name, @bitCast(v));
+                continue;
+            }
+            args[i] = if (arg.buffer) |b| aot.ptr(arg.name, arg.type, buffers[b].ptr + arg.offset) else if (arg.f32) |v| aot.float(arg.name, @bitCast(v)) else if (std.mem.eql(u8, arg.type, "i32")) aot.int(arg.name, @intCast(arg.int.?)) else aot.word(arg.name, @bitCast(arg.int.?));
+        }
+        var consts: [64]aot.Const = undefined;
+        const map = sample.consts.map;
+        if (map.count() > consts.len) return error.TooManyConstants;
+        for (map.keys(), map.values(), 0..) |name, value, i| {
+            consts[i] = .{ .name = name, .int = value.int, .f32 = if (value.f32) |v| @as(f32, @bitCast(v)) else null };
+        }
+        try tri.run(sample.@"fn", sample.grid, args[0..sample.args.len], consts[0..map.count()]);
+        try stream.synchronize();
+        for (buffers, 0..) |buffer, i| {
+            const want = try read(gpa, io, argv[2], sample.folder, i, "out");
+            defer gpa.free(want);
+            const got = try gpa.alloc(u8, want.len);
+            defer gpa.free(got);
+            try buffer.download(0, got);
+            if (!std.mem.eql(u8, want, got)) {
+                for (want, got, 0..) |w, g, at| if (w != g) {
+                    std.log.err("{s} {s} buffer {d} byte {d}: Python {x}, Zig {x}", .{ sample.@"fn", sample.phase, i, at, w, g });
+                    break;
+                };
+                return error.TritonByteMismatch;
+            }
+        }
+        std.log.info("PASS {s} {s} ({s})", .{ sample.@"fn", sample.phase, sample.hash });
+    }
+    std.log.info("all {d} real Python Triton fixtures byte-exact", .{parsed.value.samples.len});
+}
diff --git a/zig/tests/cuda/glm_p23_check.zig b/zig/tests/cuda/glm_p23_check.zig
new file mode 100644
index 00000000..5438d09b
--- /dev/null
+++ b/zig/tests/cuda/glm_p23_check.zig
@@ -0,0 +1,183 @@
+//! Byte checks against tools/zig/glm_p23_oracle.py fixtures. GPU execution requires GPU-FREE and flock.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda").matmuls;
+const Fixture = @import("fixture.zig").Fixture;
+fn size(f: Fixture, name: []const u8) !usize {
+    return @intCast(try f.int(name));
+}
+fn upload(d: *const cuda.Driver, f: Fixture, name: []const u8) !cuda.DeviceBuffer {
+    const bytes = try f.bytes(name);
+    defer f.gpa.free(bytes);
+    return cuda.DeviceBuffer.fromHost(d, bytes);
+}
+pub fn main(init: std.process.Init) !void {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len != 2) return error.ExpectedFixtureDirectory;
+    var f = try Fixture.open(init.gpa, init.io, args[1]);
+    defer f.deinit();
+    const kind = try f.string("kind");
+    if (std.mem.eql(u8, kind, "layout") or std.mem.eql(u8, kind, "fp8")) {
+        try checkLayout(init.gpa, f, kind);
+        std.debug.print("PASS {s} {s}: host byte equality\n", .{ kind, args[1] });
+        return;
+    }
+    var d = try cuda.Driver.open();
+    defer d.close();
+    var ctx = try cuda.Context.init(&d, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&d, true);
+    defer stream.deinit();
+    var e = try glm.Entries.load(&ctx);
+    defer e.deinit();
+    const rows = try size(f, "rows");
+    const n = try size(f, "n");
+    const k = try size(f, "k");
+    var x = try upload(&d, f, "x");
+    defer x.free();
+    const want = try f.bytes("out");
+    defer init.gpa.free(want);
+    var out = try cuda.DeviceBuffer.alloc(&d, want.len);
+    defer out.free();
+    try out.fill8(0, null);
+    if (std.mem.eql(u8, kind, "qmm")) {
+        var w = try upload(&d, f, "w");
+        defer w.free();
+        var sc = try upload(&d, f, "s");
+        defer sc.free();
+        var b = try upload(&d, f, "b");
+        defer b.free();
+        var xs = try upload(&d, f, "xs");
+        defer xs.free();
+        var part = try cuda.DeviceBuffer.alloc(&d, glm.splitK(n, k) * rows * n * 4);
+        defer part.free();
+        const q: glm.Q4 = .{ .w = w.ptr, .s = sc.ptr, .b = b.ptr, .n = n, .k = k };
+        // Both cluster and ordered-buffer reductions must equal the Python oracle.
+        for ([_]bool{ false, true }) |cluster| {
+            try glm.matmul(&e, stream, x.ptr, k, xs.ptr, q, out.ptr, part.ptr, rows, try f.int("f32") != 0, cluster, try f.int("prompt") != 0);
+            try stream.synchronize();
+            try compare(init.gpa, out, want);
+        }
+    } else if (std.mem.eql(u8, kind, "exl3")) {
+        const slots = try size(f, "slots");
+        const ne = try size(f, "experts");
+        const tile = try size(f, "tile");
+        const pairs = rows * slots;
+        const items = glm.experts.maxItems(pairs, ne + 1, tile);
+        const names = [_][]const u8{ "gt", "ut", "dt", "suh_g", "suh_u", "svh_g", "svh_u", "suh_d", "svh_d", "picks" };
+        var buffers: [names.len]cuda.DeviceBuffer = undefined;
+        var loaded: usize = 0;
+        defer for (buffers[0..loaded]) |*v| v.free();
+        for (names, 0..) |name, i| {
+            buffers[i] = try upload(&d, f, name);
+            loaded += 1;
+        }
+        var members = try cuda.DeviceBuffer.alloc(&d, pairs * 4);
+        defer members.free();
+        var it = try cuda.DeviceBuffer.alloc(&d, items * 3 * 4);
+        defer it.free();
+        var cnt = try cuda.DeviceBuffer.alloc(&d, 12);
+        defer cnt.free();
+        var rank = try cuda.DeviceBuffer.alloc(&d, pairs * 4);
+        defer rank.free();
+        var hist = try cuda.DeviceBuffer.alloc(&d, ((pairs + 1023) / 1024) * (ne + 1) * 4);
+        defer hist.free();
+        const p: glm.experts.Plan = .{ .members = members.ptr, .items = it.ptr, .counts = cnt.ptr, .rank = rank.ptr, .hist = hist.ptr, .tile = tile, .experts = ne + 1 };
+        const ex: glm.experts.Experts = .{ .gt = buffers[0].ptr, .ut = buffers[1].ptr, .dt = buffers[2].ptr, .suh_g = buffers[3].ptr, .suh_u = buffers[4].ptr, .svh_g = buffers[5].ptr, .svh_u = buffers[6].ptr, .suh_d = buffers[7].ptr, .svh_d = buffers[8].ptr, .shared_suh = if (try f.int("shared") != 0) buffers[3].ptr else 0, .dims = k, .width = n, .count = ne };
+        var xg = try cuda.DeviceBuffer.alloc(&d, pairs * k * 2);
+        defer xg.free();
+        var xu = try cuda.DeviceBuffer.alloc(&d, pairs * k * 2);
+        defer xu.free();
+        var xd = try cuda.DeviceBuffer.alloc(&d, pairs * n * 2);
+        defer xd.free();
+        var z = try cuda.DeviceBuffer.alloc(&d, 8 * pairs * @max(k, n) * 4);
+        defer z.free();
+        var done = try cuda.DeviceBuffer.alloc(&d, (items * n / 128 + 1) * 4);
+        defer done.free();
+        var order = try cuda.DeviceBuffer.alloc(&d, items * 4);
+        defer order.free();
+        for ([_]cuda.DeviceBuffer{ xg, xu, xd, z, done }) |v| try v.fill8(0, null);
+        const scratch: glm.experts.Scratch = .{ .xg = xg.ptr, .xu = xu.ptr, .xd = xd.ptr, .z = z.ptr, .done = done.ptr, .order = order.ptr, .capacity = rows, .slots = slots };
+        try glm.experts.plan(&e, stream, buffers[9].ptr, pairs, p);
+        for ([_]bool{ false, true }) |grouped| {
+            try glm.experts.routed(&e, stream, x.ptr, k, buffers[9].ptr, p, ex, scratch, out.ptr, rows, 10, grouped);
+            try stream.synchronize();
+            if (grouped and k == 4096 and rows < 64 and (n == 1024 or n == 768 or n == 640 or n == 512)) {
+                // Python runs `dec` here; the grouped kernel is only its documented equivalent. A pick of
+                // `experts` (the fixtures draw 0..experts, inclusive) names no trellis: the grouped kernel
+                // reads past the arrays for it while `dec` skips it, so only in-range pairs are compared.
+                const picks = try f.bytes("picks");
+                defer init.gpa.free(picks);
+                try compareValidPairs(init.gpa, out, want, std.mem.bytesAsSlice(i32, picks), ne, k);
+            } else try compare(init.gpa, out, want);
+        }
+    } else return error.UnknownFixtureKind;
+    std.debug.print("PASS {s} {s}: byte equality\n", .{ kind, args[1] });
+}
+fn compareValidPairs(gpa: std.mem.Allocator, out: cuda.DeviceBuffer, want: []const u8, picks: []align(1) const i32, count: usize, width: usize) !void {
+    const got = try gpa.alloc(u8, want.len);
+    defer gpa.free(got);
+    try out.download(0, got);
+    const stride = width * 4;
+    for (picks, 0..) |pick, pair| {
+        if (pick < 0 or pick >= count) continue;
+        if (!std.mem.eql(u8, got[pair * stride ..][0..stride], want[pair * stride ..][0..stride])) return error.OracleMismatch;
+    }
+}
+fn compare(gpa: std.mem.Allocator, out: cuda.DeviceBuffer, want: []const u8) !void {
+    const got = try gpa.alloc(u8, want.len);
+    defer gpa.free(got);
+    try out.download(0, got);
+    if (!std.mem.eql(u8, got, want)) return error.OracleMismatch;
+}
+
+fn checkLayout(gpa: std.mem.Allocator, f: Fixture, kind: []const u8) !void {
+    const n = try size(f, "n");
+    const k = try size(f, "k");
+    const bytes = try f.bytes("x");
+    defer gpa.free(bytes);
+    const x: []const u16 = @alignCast(std.mem.bytesAsSlice(u16, bytes));
+    if (std.mem.eql(u8, kind, "fp8")) {
+        const codes = try gpa.alloc(u8, n * k);
+        defer gpa.free(codes);
+        const scales = try gpa.alloc(f32, n * k / 128);
+        defer gpa.free(scales);
+        glm.layouts.makeF8(x, codes, scales);
+        try equalBytes(f, "codes", codes);
+        try equalBytes(f, "scales", std.mem.sliceAsBytes(scales));
+        return;
+    }
+    const words = try gpa.alloc(u32, n * k / 8);
+    defer gpa.free(words);
+    const scales = try gpa.alloc(u16, n * k / 64);
+    defer gpa.free(scales);
+    const biases = try gpa.alloc(u16, n * k / 64);
+    defer gpa.free(biases);
+    glm.layouts.quantize4(x, n, k, words, scales, biases, true);
+    try equalBytes(f, "words", std.mem.sliceAsBytes(words));
+    try equalBytes(f, "scales", std.mem.sliceAsBytes(scales));
+    try equalBytes(f, "biases", std.mem.sliceAsBytes(biases));
+    const npad = (n + 127) / 128 * 128;
+    const packed_words = try gpa.alloc(u32, npad * k / 8);
+    defer gpa.free(packed_words);
+    const sc = try gpa.alloc(u16, npad * k / 64);
+    defer gpa.free(sc);
+    const bi = try gpa.alloc(u16, npad * k / 64);
+    defer gpa.free(bi);
+    glm.layouts.pack(words, scales, biases, n, k, packed_words, sc, bi);
+    try equalBytes(f, "w", std.mem.sliceAsBytes(packed_words));
+    try equalBytes(f, "s", std.mem.sliceAsBytes(sc));
+    try equalBytes(f, "b", std.mem.sliceAsBytes(bi));
+}
+fn equalBytes(f: Fixture, name: []const u8, got: []const u8) !void {
+    const want = try f.bytes(name);
+    defer f.gpa.free(want);
+    if (!std.mem.eql(u8, want, got)) {
+        std.debug.print("FAIL loader {s}\n", .{name});
+        for (want, got, 0..) |w, g, i| if (w != g) {
+            std.debug.print("first diff at byte {d}: got {x:0>2} want {x:0>2}\n", .{ i, g, w });
+            break;
+        };
+        return error.OracleMismatch;
+    }
+}
diff --git a/zig/tests/cuda/glm_p5/msa_check.zig b/zig/tests/cuda/glm_p5/msa_check.zig
new file mode 100644
index 00000000..b5a65b72
--- /dev/null
+++ b/zig/tests/cuda/glm_p5/msa_check.zig
@@ -0,0 +1,129 @@
+//! tf-glm-p5-msa: glm_msa.cu (Python msa.cu, TF_GLM_MSA=1) on the GPU against an fp32 host attention over the same FP8 rows.
+//!
+//!   tf-glm-p5-msa [ROWS] [CACHE_ROWS]
+//!
+//! For 16 heads (one m16 tile), 22 (TP=3's 22/21/21) and 32 (TP=2): random bf16 absorbed queries, a random FP8 latent
+//! cache (kv8 rows), ascending token lists of varying length (1, 15, 16, 17, 2051, ...). Checks (a) every row within a
+//! relative tolerance of the host reference, (b) row independence: a row computed alone (R=1) equals its bytes in the
+//! full launch, (c) rows with count 0 are left alone. GPU-only; run under the GPU lock. Exit 1 on any failure.
+const std = @import("std");
+const cuda = @import("cuda");
+const mla = @import("glm_cuda").mla;
+
+const lw = mla.lw;
+
+pub fn main(init: std.process.Init) !u8 {
+    const gpa = init.gpa;
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    const rows: usize = if (args.len > 1) try std.fmt.parseInt(usize, args[1], 10) else 24;
+    const n_cache: usize = if (args.len > 2) try std.fmt.parseInt(usize, args[2], 10) else 4096;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var msa = try mla.Msa.load(&driver);
+    defer msa.deinit();
+
+    var prng = std.Random.DefaultPrng.init(0x6d6c61);
+    const rnd = prng.random();
+    const w = mla.tokens;
+
+    // the cache
+    const cache = try gpa.alloc(u8, n_cache * mla.latent_row);
+    defer gpa.free(cache);
+    {
+        var x: [lw]f32 = undefined;
+        for (0..n_cache) |i| {
+            for (&x) |*v| v.* = mla.bf16((rnd.float(f32) - 0.5) * 8);
+            mla.quantizeRow(&x, cache[i * mla.latent_row ..][0..mla.latent_row]);
+        }
+    }
+    var d_cache = try cuda.DeviceBuffer.fromHost(&driver, cache);
+    defer d_cache.free();
+
+    var fails: usize = 0;
+    for ([_]usize{ 16, 22, 32 }) |h| {
+        const q = try gpa.alloc(f32, rows * h * lw);
+        defer gpa.free(q);
+        const qb = try gpa.alloc(u16, q.len);
+        defer gpa.free(qb);
+        for (q, qb) |*v, *b| {
+            v.* = mla.bf16((rnd.float(f32) - 0.5) * 2);
+            b.* = @intCast(@as(u32, @bitCast(v.*)) >> 16);
+        }
+        const toks = try gpa.alloc(i32, rows * w);
+        defer gpa.free(toks);
+        @memset(toks, -1);
+        const counts = try gpa.alloc(i32, rows);
+        defer gpa.free(counts);
+        const lens = [_]usize{ 1, 15, 16, 17, 100, 513, 2051, 0 };
+        for (0..rows) |r| {
+            const n = lens[r % lens.len];
+            counts[r] = @intCast(n);
+            // ascending distinct tokens
+            var t: usize = rnd.uintLessThan(usize, 3);
+            for (0..n) |i| {
+                toks[r * w + i] = @intCast(@min(t, n_cache - 1));
+                t += 1 + rnd.uintLessThan(usize, @max(1, (n_cache - t) / @max(1, n - i)));
+                if (t >= n_cache) t = n_cache - 1;
+            }
+        }
+        var d_q = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(qb));
+        defer d_q.free();
+        var d_t = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(toks));
+        defer d_t.free();
+        var d_c = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(counts));
+        defer d_c.free();
+        var d_o = try cuda.DeviceBuffer.alloc(&driver, q.len * 2);
+        defer d_o.free();
+        const sentinel = try gpa.alloc(u16, q.len);
+        defer gpa.free(sentinel);
+        @memset(sentinel, 0x7777);
+        try d_o.upload(0, std.mem.sliceAsBytes(sentinel));
+        try msa.prompt(stream, d_q.ptr, d_cache.ptr, d_t.ptr, d_c.ptr, d_o.ptr, rows, h, w, mla.scale);
+        try stream.synchronize();
+        const out = try gpa.alloc(u16, q.len);
+        defer gpa.free(out);
+        try d_o.download(0, std.mem.sliceAsBytes(out));
+
+        var worst: f32 = 0;
+        var ref: [32 * lw]f32 = undefined;
+        for (0..rows) |r| {
+            const row = out[r * h * lw ..][0 .. h * lw];
+            if (counts[r] == 0) {
+                for (row) |v| if (v != 0x7777) {
+                    fails += 1;
+                    std.debug.print("FAIL h={d} row {d}: count 0 but written\n", .{ h, r });
+                    break;
+                };
+                continue;
+            }
+            try mla.msaReference(q[r * h * lw ..][0 .. h * lw], h, cache, toks[r * w ..], @intCast(counts[r]), mla.scale, &ref, gpa);
+            var mx: f32 = 0;
+            for (ref[0 .. h * lw]) |v| mx = @max(mx, @abs(v));
+            for (row, ref[0 .. h * lw]) |g, want| {
+                const got: f32 = @bitCast(@as(u32, g) << 16);
+                worst = @max(worst, @abs(got - want) / @max(mx, 1e-6));
+            }
+        }
+        const ok_ref = worst < 2e-2;
+        // (b) row independence: each row alone
+        var indep = true;
+        const one = try gpa.alloc(u16, h * lw);
+        defer gpa.free(one);
+        for (0..rows) |r| {
+            if (counts[r] == 0) continue;
+            var d_o1 = try cuda.DeviceBuffer.alloc(&driver, h * lw * 2);
+            defer d_o1.free();
+            try msa.prompt(stream, d_q.ptr + r * h * lw * 2, d_cache.ptr, d_t.ptr + r * w * 4, d_c.ptr + r * 4, d_o1.ptr, 1, h, w, mla.scale);
+            try stream.synchronize();
+            try d_o1.download(0, std.mem.sliceAsBytes(one));
+            if (!std.mem.eql(u16, one, out[r * h * lw ..][0 .. h * lw])) indep = false;
+        }
+        std.debug.print("{s} h={d}: worst relative error vs host {d:.5}; row independence {s}\n", .{ if (ok_ref and indep) "PASS" else "FAIL", h, worst, if (indep) "exact" else "BROKEN" });
+        if (!ok_ref or !indep) fails += 1;
+    }
+    return if (fails == 0) 0 else 1;
+}
