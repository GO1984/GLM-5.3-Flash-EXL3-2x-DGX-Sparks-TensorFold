+//! `decode_clip`: a clip's sampled frames, each fitted onto the clip's canvas as it is decoded.
+const std = @import("std");
+const av = @import("av.zig");
+const errors = @import("errors.zig");
+const geometry = @import("geometry.zig");
+const items_mod = @import("items.zig");
+const limits_mod = @import("limits.zig");
+const resize = @import("resize.zig");
+const Allocator = std.mem.Allocator;
+const Diag = errors.Diag;
+
+pub const Params = struct {
+    limits: limits_mod.GlmVisionLimits, // with video_tokens already the clip's share
+    max_dimension: u32 = 8192,
+    max_seconds: f64 = 3600.0,
+};
+
+fn invalidMessage(diag: ?*Diag, code: c_int) errors.Error {
+    return errors.fail(diag, "video bytes are invalid or unsupported ({s}); use MP4 or WebM", .{av.errorName(code)});
+}
+
+/// `deadline_ns`: monotonic (std.Io.Clock.awake) nanoseconds.
+pub fn decodeClip(a: Allocator, io: std.Io, libs: *const av.Libs, data: []const u8, params: Params, deadline_ns: i96, diag: ?*Diag) (Allocator.Error || errors.Error)!items_mod.Clip {
+    const L = params.limits;
+    var c = av.Clip.open(a, libs, data) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        error.NoVideoStream => return errors.fail(diag, "the video has no video stream", .{}),
+        error.Unsupported => return errors.fail(diag, "video bytes are invalid or unsupported (UnsupportedFFmpeg); use MP4 or WebM", .{}),
+        error.Failed => return errors.fail(diag, "video bytes are invalid or unsupported (InvalidDataError); use MP4 or WebM", .{}),
+    };
+    defer c.close();
+    const info = c.info;
+    if (@min(info.width, info.height) == 0 or @max(info.width, info.height) > params.max_dimension)
+        return errors.fail(diag, "video dimensions are missing or exceed the pixel limit", .{});
+    // fps = float(average_rate or guessed_rate or 0)
+    var fps: f64 = 0;
+    if (info.avg_num != 0 and info.avg_den != 0) {
+        fps = @as(f64, @floatFromInt(info.avg_num)) / @as(f64, @floatFromInt(info.avg_den));
+    } else if (info.guessed_num != 0 and info.guessed_den != 0) {
+        fps = @as(f64, @floatFromInt(info.guessed_num)) / @as(f64, @floatFromInt(info.guessed_den));
+    }
+    var total: i64 = info.nb_frames;
+    if (total == 0 and fps > 0) { // WebM and some MKV files carry no frame count
+        var seconds: f64 = 0.0;
+        if (info.duration != av.nopts and info.duration != 0) {
+            // float(stream.duration * stream.time_base): the exact rational, correctly rounded
+            const num: i128 = @as(i128, info.duration) * info.time_base_num;
+            seconds = @as(f64, @floatFromInt(num)) / @as(f64, @floatFromInt(info.time_base_den));
+        } else if (info.container_duration != av.nopts and info.container_duration != 0) {
+            seconds = @as(f64, @floatFromInt(info.container_duration)) / 1e6;
+        }
+        total = geometry.pyRound(seconds * fps);
+    }
+    if (!(fps > 0 and fps <= 1000) or total <= 0) return errors.fail(diag, "the video's frame count or rate is missing", .{});
+    const total_f: f64 = @floatFromInt(total);
+    if (total_f / fps > params.max_seconds) {
+        const minutes = params.max_seconds / 60.0;
+        return errors.fail(diag, "videos are limited to {d} minutes", .{geometry.pyRound(minutes)});
+    }
+    if (total > std.math.maxInt(u32)) return errors.fail(diag, "the video's frame count or rate is missing", .{});
+    const picks = try geometry.sampleFrames(a, @intCast(total), fps, total_f / fps, L);
+    defer a.free(picks);
+    const canvas = try geometry.smartResize(@intCast(picks.len), info.height, info.width, L.video_tokens, L.min_tokens, diag);
+    const content = geometry.contentSize(@intCast(picks.len), info.height, info.width, canvas, L.min_tokens);
+    const plane = 3 * @as(usize, canvas.h) * canvas.w;
+
+    // wanted frames -> their canvases, by index
+    var wanted: std.AutoHashMapUnmanaged(u32, []u8) = .empty;
+    defer {
+        var it = wanted.valueIterator();
+        while (it.next()) |v| a.free(v.*);
+        wanted.deinit(a);
+    }
+    for (picks) |p| try wanted.put(a, p, &.{});
+    const last_pick = picks[picks.len - 1];
+    c.openDecoder() catch |e| switch (e) {
+        error.Failed => return invalidMessage(diag, c.code),
+        error.Unsupported => return errors.fail(diag, "video bytes are invalid or unsupported (UnsupportedFFmpeg); use MP4 or WebM", .{}),
+    };
+    var n: u32 = 0;
+    var best: ?u32 = null; // max(got)
+    while (true) {
+        const more = c.advance() catch return invalidMessage(diag, c.code);
+        if (!more) break;
+        if (n > last_pick or std.Io.Clock.awake.now(io).toNanoseconds() >= deadline_ns) break;
+        if (wanted.getPtr(n)) |slot| {
+            if (slot.len == 0) {
+                const frame = c.convert(a) catch |e| switch (e) {
+                    error.OutOfMemory => return error.OutOfMemory,
+                    error.Failed => return invalidMessage(diag, c.code),
+                };
+                defer a.free(frame.pixels);
+                const buf = try a.alloc(u8, plane);
+                errdefer a.free(buf);
+                try resize.fitInto(a, frame.pixels, frame.h, frame.w, canvas, content, buf);
+                slot.* = buf;
+                if (best == null or n > best.?) best = n;
+            }
+        }
+        n += 1;
+    }
+    if (std.Io.Clock.awake.now(io).toNanoseconds() >= deadline_ns) return errors.fail(diag, "video decoding exceeds the time limit", .{});
+    const last = best orelse return errors.fail(diag, "the video has no decodable frames", .{});
+    const frames = try a.alloc(u8, picks.len * plane);
+    errdefer a.free(frames);
+    for (picks, 0..) |p, i| {
+        const src_idx: u32 = if (p <= last) p else last;
+        const slot = wanted.get(src_idx).?;
+        const pick_src = if (slot.len != 0) slot else wanted.get(last).?; // got.get(i, got[last])
+        @memcpy(frames[i * plane ..][0..plane], pick_src);
+    }
+    const seconds = try a.alloc(f64, picks.len / 2);
+    errdefer a.free(seconds);
+    var k: usize = 0;
+    while (k < picks.len) : (k += 2) seconds[k / 2] = @as(f64, @floatFromInt(picks[k])) / fps;
+    return .{ .frames = frames, .t = @intCast(picks.len), .h = canvas.h, .w = canvas.w, .seconds = seconds };
+}
+
+const fixtures = @import("fixtures.zig");
+
+fn readJson(a: Allocator, name: []const u8) !std.json.Parsed(std.json.Value) {
+    const text = try fixtures.read(a, name, 1 << 24);
+    defer a.free(text);
+    return std.json.parseFromSlice(std.json.Value, a, text, .{ .allocate = .alloc_always });
+}
+
+fn loadOrSkip(a: Allocator) !av.Libs {
+    return av.load(a, std.testing.io) catch |e| switch (e) {
+        error.LibrariesMissing => return error.SkipZigTest,
+        else => return e,
+    };
+}
+
+test "FFmpeg frames are byte-identical to PyAV's (rgb24 per frame, stream properties)" {
+    const a = std.testing.allocator;
+    var libs = try loadOrSkip(a);
+    defer libs.close();
+    const parsed = try readJson(a, "vid/expected.json");
+    defer parsed.deinit();
+    var checked: usize = 0;
+    for (parsed.value.array.items) |e| {
+        const o = e.object;
+        const name = o.get("file").?.string;
+        var path_buf: [128]u8 = undefined;
+        const data = try fixtures.read(a, try std.fmt.bufPrint(&path_buf, "vid/{s}", .{name}), 1 << 24);
+        defer a.free(data);
+        var c = try av.Clip.open(a, &libs, data);
+        defer c.close();
+        try std.testing.expectEqual(@as(u32, @intCast(o.get("width").?.integer)), c.info.width);
+        try std.testing.expectEqual(@as(u32, @intCast(o.get("height").?.integer)), c.info.height);
+        try std.testing.expectEqual(@as(i64, @intCast(o.get("frames").?.integer)), c.info.nb_frames);
+        if (o.get("avg_rate").?.array.items.len == 2) {
+            try std.testing.expectEqual(@as(i32, @intCast(o.get("avg_rate").?.array.items[0].integer)), c.info.avg_num);
+        }
+        try c.openDecoder();
+        const hashes = o.get("frame_hashes").?.array.items;
+        var n: usize = 0;
+        while (try c.advance()) : (n += 1) {
+            const rgb = try c.convert(a);
+            defer a.free(rgb.pixels);
+            try std.testing.expect(n < hashes.len);
+            const hex = fixtures.hexDigest(rgb.pixels);
+            if (!std.mem.eql(u8, hashes[n].string, &hex)) {
+                std.debug.print("frame {d} of {s} differs\n", .{ n, name });
+                return error.FrameMismatch;
+            }
+        }
+        try std.testing.expectEqual(hashes.len, n);
+        checked += 1;
+    }
+    try std.testing.expect(checked >= 15);
+}
+
+test "decode_clip: canvases, frame-pair times and errors as the recipe" {
+    const a = std.testing.allocator;
+    var libs = try loadOrSkip(a);
+    defer libs.close();
+    const parsed = try readJson(a, "vid/clips.json");
+    defer parsed.deinit();
+    for (parsed.value.array.items) |e| {
+        const o = e.object;
+        const name = o.get("file").?.string;
+        var path_buf: [128]u8 = undefined;
+        const data = try fixtures.read(a, try std.fmt.bufPrint(&path_buf, "vid/{s}", .{name}), 1 << 24);
+        defer a.free(data);
+        var lim: limits_mod.GlmVisionLimits = .{};
+        lim.video_tokens = @intCast(o.get("video_tokens").?.integer);
+        lim.video_frames = @intCast(o.get("video_frames").?.integer);
+        var diag: Diag = .{};
+        const res = decodeClip(a, std.testing.io, &libs, data, .{ .limits = lim }, std.math.maxInt(i96), &diag);
+        if (o.get("error")) |want| {
+            if (res) |ok| {
+                var it: items_mod.Item = .{ .clip = ok };
+                it.deinit(a);
+                std.debug.print("{s}/{s}: decoded but the recipe refuses ({s})\n", .{ name, o.get("variant").?.string, want.string });
+                return error.Mismatch;
+            } else |_| try std.testing.expectEqualStrings(want.string, diag.message());
+            continue;
+        }
+        var clip = res catch |err| {
+            std.debug.print("{s}/{s}: refused ({s})\n", .{ name, o.get("variant").?.string, diag.message() });
+            return err;
+        };
+        var item: items_mod.Item = .{ .clip = clip };
+        defer item.deinit(a);
+        const shape = o.get("shape").?.array.items;
+        try std.testing.expectEqual(@as(i64, @intCast(clip.t)), shape[0].integer);
+        try std.testing.expectEqual(@as(i64, @intCast(clip.h)), shape[2].integer);
+        try std.testing.expectEqual(@as(i64, @intCast(clip.w)), shape[3].integer);
+        const secs = o.get("seconds").?.array.items;
+        try std.testing.expectEqual(secs.len, clip.seconds.len);
+        for (secs, clip.seconds) |s, got| try std.testing.expectEqual(try std.fmt.parseFloat(f64, s.string), got);
+        const hash = items_mod.clipContentHash(clip);
+        if (!std.mem.eql(u8, o.get("hash").?.string, &hash)) {
+            std.debug.print("{s}/{s}: pixels differ\n", .{ name, o.get("variant").?.string });
+            return error.PixelMismatch;
+        }
+        clip = undefined;
+    }
+}
diff --git a/zig/src/vision/convert.zig b/zig/src/vision/convert.zig
new file mode 100644
index 00000000..7a37c939
--- /dev/null
+++ b/zig/src/vision/convert.zig
@@ -0,0 +1,112 @@
+//! What images._decode does after loading: exif_transpose, then convert("RGB") -- or, when the picture has an
+//! alpha band or a `transparency` entry, convert("RGBA") pasted on white with Pillow's integer blend.
+const std = @import("std");
+const raster = @import("raster.zig");
+const Raster = raster.Raster;
+const Allocator = std.mem.Allocator;
+
+inline fn div255(a: u32) u8 {
+    const tmp = a + 128;
+    return @intCast(((tmp >> 8) + tmp) >> 8);
+}
+
+/// `BLEND(mask, 255, c)`: ImagingPaste's per-channel mix of white and the source by the mask.
+inline fn onWhite(c: u8, a: u8) u8 {
+    return div255(@as(u32, 255) * (255 - a) + @as(u32, c) * a);
+}
+
+inline fn clip16(lo: u8, hi: u8) u8 {
+    return if (hi != 0) 255 else lo;
+}
+
+/// Pillow's CMYK -> RGB (Convert.c cmyk2rgb): nk = 255 - k; channel = nk - MULDIV255(c, nk).
+inline fn cmykChannel(c: u8, k: u8) u8 {
+    const nk: u32 = 255 - k;
+    const t = @as(u32, c) * nk + 128;
+    const m = ((t >> 8) + t) >> 8;
+    return @intCast(@min(255, nk -| m));
+}
+
+/// RGB bytes (w*h*3) of the picture as `_decode` produces them, before orientation.
+pub fn toRgb(allocator: Allocator, r: *const Raster) Allocator.Error![]u8 {
+    const n = @as(usize, r.w) * r.h;
+    const out = try allocator.alloc(u8, n * 3);
+    errdefer allocator.free(out);
+    const has_alpha = r.mode.hasAlphaBand() or r.transparency != .none;
+    const d = r.data;
+    if (!has_alpha) {
+        switch (r.mode) {
+            .bit1, .l => for (0..n) |i| {
+                @memset(out[i * 3 ..][0..3], d[i]);
+            },
+            .p => {
+                const pal = r.palette.?;
+                for (0..n) |i| @memcpy(out[i * 3 ..][0..3], pal[@as(usize, d[i]) * 3 ..][0..3]);
+            },
+            .rgb => @memcpy(out, d),
+            .i16 => for (0..n) |i| {
+                @memset(out[i * 3 ..][0..3], clip16(d[i * 2], d[i * 2 + 1]));
+            },
+            .cmyk => for (0..n) |i| {
+                const k = d[i * 4 + 3];
+                out[i * 3] = cmykChannel(d[i * 4], k);
+                out[i * 3 + 1] = cmykChannel(d[i * 4 + 1], k);
+                out[i * 3 + 2] = cmykChannel(d[i * 4 + 2], k);
+            },
+            .la, .rgba => unreachable,
+        }
+        return out;
+    }
+    for (0..n) |i| {
+        var px: [4]u8 = undefined;
+        switch (r.mode) {
+            .la => px = .{ d[i * 2], d[i * 2], d[i * 2], d[i * 2 + 1] },
+            .rgba => px = .{ d[i * 4], d[i * 4 + 1], d[i * 4 + 2], d[i * 4 + 3] },
+            .l => {
+                const v = d[i];
+                const a: u8 = switch (r.transparency) {
+                    .gray => |t| if (v == t) 0 else 255,
+                    .index => |t| if (v == t) 0 else 255,
+                    else => 255,
+                };
+                px = .{ v, v, v, a };
+            },
+            .bit1 => {
+                const a: u8 = switch (r.transparency) {
+                    .gray => |t| if (d[i] == t) 0 else 255,
+                    else => 255,
+                };
+                px = .{ d[i], d[i], d[i], a };
+            },
+            .i16 => {
+                const v = clip16(d[i * 2], d[i * 2 + 1]);
+                px = .{ v, v, v, 255 };
+            },
+            .rgb => {
+                const a: u8 = switch (r.transparency) {
+                    .rgb => |t| if (d[i * 3] == t[0] and d[i * 3 + 1] == t[1] and d[i * 3 + 2] == t[2]) 0 else 255,
+                    else => 255,
+                };
+                px = .{ d[i * 3], d[i * 3 + 1], d[i * 3 + 2], a };
+            },
+            .p => {
+                const pal = r.palette.?;
+                const idx = d[i];
+                const a: u8 = switch (r.transparency) {
+                    .index => |t| if (idx == t) 0 else 255,
+                    .table => |t| t[idx],
+                    else => 255,
+                };
+                px = .{ pal[idx * 3], pal[idx * 3 + 1], pal[idx * 3 + 2], a };
+            },
+            .cmyk => {
+                const k = d[i * 4 + 3];
+                px = .{ cmykChannel(d[i * 4], k), cmykChannel(d[i * 4 + 1], k), cmykChannel(d[i * 4 + 2], k), 255 };
+            },
+        }
+        out[i * 3] = onWhite(px[0], px[3]);
+        out[i * 3 + 1] = onWhite(px[1], px[3]);
+        out[i * 3 + 2] = onWhite(px[2], px[3]);
+    }
+    return out;
+}
diff --git a/zig/src/vision/errors.zig b/zig/src/vision/errors.zig
new file mode 100644
index 00000000..fdd06921
--- /dev/null
+++ b/zig/src/vision/errors.zig
@@ -0,0 +1,87 @@
+//! ImageInputError and ValueError as Zig sees them: one error code and the Python message in a Diag.
+//!
+//! The server maps every `error.Input` to a 400 whose text is `diag.message()`; a message that starts with
+//! `context_limit` is served as context_length_exceeded (errors.CONTEXT_LIMIT in the Python server).
+const std = @import("std");
+
+pub const Error = error{Input};
+
+/// OpenAI's wording, which clients match to compact (tensorfold.server.errors.CONTEXT_LIMIT).
+pub const context_limit = "This server's maximum context length is";
+
+pub const Diag = struct {
+    buf: [1024]u8 = undefined,
+    len: usize = 0,
+
+    pub fn message(d: *const Diag) []const u8 {
+        return d.buf[0..d.len];
+    }
+
+    pub fn isContextLimit(d: *const Diag) bool {
+        return std.mem.startsWith(u8, d.message(), context_limit);
+    }
+
+    pub fn set(d: *Diag, comptime fmt: []const u8, args: anytype) void {
+        const out = std.fmt.bufPrint(&d.buf, fmt, args) catch d.buf[0..d.buf.len];
+        d.len = out.len;
+    }
+};
+
+/// Record `fmt` in `diag` (when given) and return the input error.
+pub fn fail(diag: ?*Diag, comptime fmt: []const u8, args: anytype) Error {
+    if (diag) |d| d.set(fmt, args);
+    return error.Input;
+}
+
+/// Python's `f"{n:,}"`.
+pub fn commas(buf: []u8, n: u64) []const u8 {
+    var tmp: [32]u8 = undefined;
+    const digits = std.fmt.bufPrint(&tmp, "{d}", .{n}) catch unreachable;
+    var out: usize = 0;
+    for (digits, 0..) |c, i| {
+        if (i != 0 and (digits.len - i) % 3 == 0) {
+            buf[out] = ',';
+            out += 1;
+        }
+        buf[out] = c;
+        out += 1;
+    }
+    return buf[0..out];
+}
+
+/// Python's repr() of a str (ASCII/UTF-8 text without exotic code points): quotes chosen as Python does.
+pub fn pyRepr(allocator: std.mem.Allocator, s: []const u8) ![]u8 {
+    const has_single = std.mem.indexOfScalar(u8, s, '\'') != null;
+    const has_double = std.mem.indexOfScalar(u8, s, '"') != null;
+    const quote: u8 = if (has_single and !has_double) '"' else '\'';
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(allocator);
+    try out.append(allocator, quote);
+    for (s) |c| {
+        switch (c) {
+            '\\' => try out.appendSlice(allocator, "\\\\"),
+            '\n' => try out.appendSlice(allocator, "\\n"),
+            '\r' => try out.appendSlice(allocator, "\\r"),
+            '\t' => try out.appendSlice(allocator, "\\t"),
+            else => if (c == quote) {
+                try out.append(allocator, '\\');
+                try out.append(allocator, c);
+            } else if (c < 0x20 or c == 0x7f) {
+                var hb: [4]u8 = undefined;
+                try out.appendSlice(allocator, try std.fmt.bufPrint(&hb, "\\x{x:0>2}", .{c}));
+            } else try out.append(allocator, c),
+        }
+    }
+    try out.append(allocator, quote);
+    return out.toOwnedSlice(allocator);
+}
+
+test "commas and repr" {
+    var b: [32]u8 = undefined;
+    try std.testing.expectEqualStrings("1,234,567", commas(&b, 1234567));
+    try std.testing.expectEqualStrings("16", commas(&b, 16));
+    try std.testing.expectEqualStrings("262,144", commas(&b, 262144));
+    const r = try pyRepr(std.testing.allocator, "it's");
+    defer std.testing.allocator.free(r);
+    try std.testing.expectEqualStrings("\"it's\"", r);
+}
diff --git a/zig/src/vision/expand.zig b/zig/src/vision/expand.zig
new file mode 100644
index 00000000..1c302153
--- /dev/null
+++ b/zig/src/vision/expand.zig
@@ -0,0 +1,371 @@
+//! Prompt expansion exactly as `GlmVision.prepare` does it: the rendered text's picture and clip spans become the
+//! checkpoint's placeholder runs; markers a conversation only mentions stay text (zero-width space inside).
+//!
+//! The server tokenizes the expanded text with add_special_tokens=false and hands the ids to `finish`.
+const std = @import("std");
+const errors = @import("errors.zig");
+const items_mod = @import("items.zig");
+const Diag = errors.Diag;
+const Item = items_mod.Item;
+const Allocator = std.mem.Allocator;
+
+pub const IMAGE = "<|image|>";
+pub const VIDEO = "<|video|>";
+pub const IMAGE_SPAN = "<|begin_of_image|><|image|><|end_of_image|>"; // what the chat template writes for a picture
+pub const VIDEO_SPAN = "<|begin_of_video|><|video|><|end_of_video|>"; // and for a clip
+const ZWSP = "\xe2\x80\x8b"; // U+200B
+
+const mentions = [_][]const u8{ "<|begin_of_image|>", "<|end_of_image|>", "<|begin_of_video|>", "<|end_of_video|>", IMAGE, VIDEO };
+
+/// `_as_text`: a zero-width space after the `<|` of every marker mention. Appends to `out`.
+pub fn appendAsText(allocator: Allocator, out: *std.ArrayList(u8), text: []const u8) Allocator.Error!void {
+    if (std.mem.indexOf(u8, text, "<|") == null) return out.appendSlice(allocator, text);
+    var cur: []u8 = try allocator.dupe(u8, text);
+    defer allocator.free(cur);
+    for (mentions) |mark| {
+        if (std.mem.indexOf(u8, cur, mark) == null) continue;
+        var rep_buf: [32]u8 = undefined;
+        const rep = std.fmt.bufPrint(&rep_buf, "<|{s}{s}", .{ ZWSP, mark[2..] }) catch unreachable;
+        const n = std.mem.replacementSize(u8, cur, mark, rep);
+        const next = try allocator.alloc(u8, n);
+        _ = std.mem.replace(u8, cur, mark, rep, next);
+        allocator.free(cur);
+        cur = next;
+    }
+    try out.appendSlice(allocator, cur);
+}
+
+pub fn asText(allocator: Allocator, text: []const u8) Allocator.Error![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(allocator);
+    try appendAsText(allocator, &out, text);
+    return out.toOwnedSlice(allocator);
+}
+
+pub const Span = struct { start: usize, end: usize, video: bool };
+
+/// `_marker_spans`: every picture and clip span in `text`, left to right.
+pub fn markerSpans(allocator: Allocator, text: []const u8) Allocator.Error![]Span {
+    var out: std.ArrayList(Span) = .empty;
+    errdefer out.deinit(allocator);
+    var pos: usize = 0;
+    while (true) {
+        const i = std.mem.indexOfPos(u8, text, pos, IMAGE_SPAN);
+        const v = std.mem.indexOfPos(u8, text, pos, VIDEO_SPAN);
+        if (i == null and v == null) break;
+        if (v == null or (i != null and i.? < v.?)) {
+            try out.append(allocator, .{ .start = i.?, .end = i.? + IMAGE_SPAN.len, .video = false });
+            pos = i.? + IMAGE_SPAN.len;
+        } else {
+            try out.append(allocator, .{ .start = v.?, .end = v.? + VIDEO_SPAN.len, .video = true });
+            pos = v.? + VIDEO_SPAN.len;
+        }
+    }
+    return out.toOwnedSlice(allocator);
+}
+
+/// `GlmVision.escape_quoted(text, mark_ends)`: markers the conversation only quotes become text. `mark_ends` are
+/// byte offsets in `text` where this request's own marks end (a span starting there is the template's own).
+pub fn escapeQuoted(allocator: Allocator, text: []const u8, mark_ends: []const usize) Allocator.Error![]u8 {
+    const spans = try markerSpans(allocator, text);
+    defer allocator.free(spans);
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(allocator);
+    var pos: usize = 0;
+    for (spans) |s| {
+        try appendAsText(allocator, &out, text[pos..s.start]);
+        const own = std.mem.indexOfScalar(usize, mark_ends, s.start) != null;
+        if (own) try out.appendSlice(allocator, text[s.start..s.end]) else try appendAsText(allocator, &out, text[s.start..s.end]);
+        pos = s.end;
+    }
+    try appendAsText(allocator, &out, text[pos..]);
+    return out.toOwnedSlice(allocator);
+}
+
+fn count(text: []const u8, needle: []const u8) usize {
+    var n: usize = 0;
+    var pos: usize = 0;
+    while (std.mem.indexOfPos(u8, text, pos, needle)) |i| {
+        n += 1;
+        pos = i + needle.len;
+    }
+    return n;
+}
+
+pub const Expanded = struct {
+    text: []u8, // owned by the caller's allocator
+    items: []Item, // the media in prompt order (copies of the given records; they share the data)
+
+    pub fn deinit(e: *Expanded, allocator: Allocator) void {
+        allocator.free(e.text);
+        allocator.free(e.items);
+    }
+};
+
+/// `prepare`'s walk: `text` is the rendered prompt; `images` and `videos` are consumed in the order their spans
+/// appear. Errors carry the Python text.
+pub fn expand(allocator: Allocator, text: []const u8, images: []const Item, videos: []const Item, diag: ?*Diag) (Allocator.Error || errors.Error)!Expanded {
+    if (count(text, IMAGE_SPAN) != images.len or count(text, VIDEO_SPAN) != videos.len)
+        return errors.fail(diag, "the prompt's image and video markers do not match its images and videos (is <|image|> or <|video|> in the text?)", .{});
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(allocator);
+    var order: std.ArrayList(Item) = .empty;
+    errdefer order.deinit(allocator);
+    var ii: usize = 0;
+    var vi: usize = 0;
+    var rest = text;
+    while (true) {
+        const i = std.mem.indexOf(u8, rest, IMAGE_SPAN);
+        const v = std.mem.indexOf(u8, rest, VIDEO_SPAN);
+        if (i == null and v == null) {
+            try appendAsText(allocator, &out, rest);
+            break;
+        }
+        if (v == null or (i != null and i.? < v.?)) {
+            const at = i.?;
+            const pic = images[ii];
+            ii += 1;
+            const n: usize = @intCast(pic.rows());
+            try appendAsText(allocator, &out, rest[0..at]);
+            try out.appendSlice(allocator, "<|begin_of_image|>");
+            for (0..n) |_| try out.appendSlice(allocator, IMAGE);
+            try out.appendSlice(allocator, "<|end_of_image|>");
+            try order.append(allocator, pic);
+            rest = rest[at + IMAGE_SPAN.len ..];
+        } else {
+            const at = v.?;
+            const clip = videos[vi];
+            vi += 1;
+            const c = clip.clip;
+            const n = @import("geometry.zig").rowsPerFrame(c.h, c.w);
+            try appendAsText(allocator, &out, rest[0..at]);
+            try out.appendSlice(allocator, "<|begin_of_video|>");
+            for (c.seconds) |s| {
+                try out.appendSlice(allocator, "<|begin_of_image|>");
+                for (0..n) |_| try out.appendSlice(allocator, IMAGE);
+                try out.appendSlice(allocator, "<|end_of_image|>");
+                var nb: [400]u8 = undefined;
+                try out.appendSlice(allocator, pyFixed1(&nb, s));
+                try out.appendSlice(allocator, " seconds");
+            }
+            try out.appendSlice(allocator, "<|end_of_video|>");
+            try order.append(allocator, clip);
+            rest = rest[at + VIDEO_SPAN.len ..];
+        }
+    }
+    return .{ .text = try out.toOwnedSlice(allocator), .items = try order.toOwnedSlice(allocator) };
+}
+
+/// Python's `f"{s:.1f}"`: the exact binary value rounded half to even (Zig's `{d:.1}` rounds ties away).
+pub fn pyFixed1(buf: []u8, s: f64) []const u8 {
+    if (!std.math.isFinite(s) or @abs(s) >= 1e15) return std.fmt.bufPrint(buf, "{d:.1}", .{s}) catch "0.0";
+    const bits: u64 = @bitCast(s);
+    const neg = (bits >> 63) != 0;
+    const exp_field: i32 = @intCast((bits >> 52) & 0x7ff);
+    var mant: u128 = bits & ((1 << 52) - 1);
+    var e: i32 = undefined;
+    if (exp_field == 0) {
+        e = -1074;
+    } else {
+        mant |= 1 << 52;
+        e = exp_field - 1075;
+    }
+    // d = round_half_even(mant * 10 * 2^e)
+    var d: u128 = undefined;
+    const m10 = mant * 10;
+    if (e >= 0) {
+        d = m10 << @intCast(e);
+    } else if (-e > 120) {
+        d = 0;
+    } else {
+        const sh: u7 = @intCast(-e);
+        const q = m10 >> sh;
+        const rem = m10 & ((@as(u128, 1) << sh) - 1);
+        const half = @as(u128, 1) << (sh - 1);
+        d = q;
+        if (rem > half or (rem == half and (q & 1) == 1)) d += 1;
+    }
+    return std.fmt.bufPrint(buf, "{s}{d}.{d}", .{ if (neg) "-" else "", d / 10, d % 10 }) catch "0.0";
+}
+
+pub const Prepared = struct {
+    positions: []u32, // prompt positions of the feature rows, in order
+    content_hash: [64]u8,
+    item_rows: []u32,
+    item_keys: []u64,
+
+    pub fn deinit(p: *Prepared, allocator: Allocator) void {
+        allocator.free(p.positions);
+        allocator.free(p.item_rows);
+        allocator.free(p.item_keys);
+    }
+};
+
+/// The rest of `prepare` once the server has tokenized the expanded text: the context check, the positions of the
+/// picture token, the feature-row count check, the content hash and item keys.
+pub fn finish(allocator: Allocator, ids: []const u32, image_token: u32, items: []const Item, max_prompt_tokens: ?usize, diag: ?*Diag) (Allocator.Error || errors.Error)!Prepared {
+    if (max_prompt_tokens) |m| if (m != 0 and ids.len >= m) {
+        var b: [32]u8 = undefined;
+        return errors.fail(diag, "{s} {d} tokens: the prompt with its images is {s} tokens, which exceeds the context window; send fewer or smaller images, or a shorter video", .{ errors.context_limit, m, errors.commas(&b, ids.len) });
+    };
+    var positions: std.ArrayList(u32) = .empty;
+    errdefer positions.deinit(allocator);
+    for (ids, 0..) |t, p| if (t == image_token) try positions.append(allocator, @intCast(p));
+    var rows: u64 = 0;
+    for (items) |it| rows += it.rows();
+    if (positions.items.len != rows)
+        return errors.fail(diag, "the prompt has {d} image positions for {d} feature rows", .{ positions.items.len, rows });
+    const h = try items_mod.hashItems(allocator, items);
+    return .{ .positions = try positions.toOwnedSlice(allocator), .content_hash = h.content_hash, .item_rows = h.rows, .item_keys = h.keys };
+}
+
+/// `GlmPrepared.keyed_ids`: the prompt's ids with each item's feature rows replaced by -1 - key.
+pub fn keyedIds(allocator: Allocator, ids: []const u32, p: Prepared) Allocator.Error![]i64 {
+    const out = try allocator.alloc(i64, ids.len);
+    for (ids, out) |t, *o| o.* = t;
+    var at: usize = 0;
+    for (p.item_rows, p.item_keys) |rows, key| {
+        for (p.positions[at .. at + rows]) |pos| out[pos] = -1 - @as(i64, @intCast(key));
+        at += rows;
+    }
+    return out;
+}
