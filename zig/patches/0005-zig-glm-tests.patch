+    try expectEq("chain vs wide state", hs1, hs2);
+    try expectEq("chain vs wide k", hk, hk2);
+    try expectEq("chain vs wide v", hv, hv2);
+    try expectEq("chain vs wide g", hg, hg2);
+    try expectEq("chain vs wide beta", hb, hb2);
