diff --git a/zig/src/server/glm_reply.zig b/zig/src/server/glm_reply.zig
new file mode 100644
index 00000000..fbf34b61
--- /dev/null
+++ b/zig/src/server/glm_reply.zig
@@ -0,0 +1,98 @@
+//! The end of a GLM reply that offered tools, as the recipe's `App.run` settles it (patches 0036, 0053, 0055, 0075):
+//! the reasoning and answer split (calls written inside the think block count when they end the reply), the calls the
+//! streamer followed plus the ones the end parser reads, a call the token limit cut (never sent, nor its markup as
+//! content), and the finish reason that follows.
+const std = @import("std");
+const json = @import("json.zig");
+const glm_calls = @import("glm_calls.zig");
+const reply_text = @import("reply_text.zig");
+const tool_parse = @import("tool_parse.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+pub const Input = struct {
+    /// The reply's text through its last token, stop strings applied, `closeCall`'s suffix appended.
+    text: []const u8,
+    tools: []const Value,
+    thinking: bool,
+    markers: reply_text.Markers,
+    think: ?*glm_calls.ThinkSplit,
+    streamer: ?*glm_calls.CallStreamer,
+    /// One call at most (`parallel_tool_calls: false`).
+    single: bool,
+    /// The model's end token ended the reply (not a stop string, the token limit or `ignore_eos`).
+    ended: bool,
+};
+
+pub const Result = struct {
+    reasoning: []const u8,
+    /// The answer with its call blocks hidden (what a stream shows).
+    answer: []const u8,
+    /// The reply's content: the end parser's residue, or the answer when a call was cut.
+    content: []const u8,
+    calls: ?[]Value,
+    /// Streamed calls that became whole at the end, as deltas.
+    call_deltas: []Value,
+    /// Calls already sent as deltas (the first of `calls`).
+    streamed: usize,
+    cut: bool,
+};
+
+pub fn finalize(a: Allocator, in: Input) Allocator.Error!Result {
+    const split: reply_text.Split = if (in.think) |t|
+        try t.split(in.text, true)
+    else if (in.thinking)
+        try reply_text.splitThinking(a, in.text, true, in.markers)
+    else
+        .{ .reasoning = "", .answer = in.text };
+    var hidden: std.ArrayList(u8) = .empty;
+    const answer = try reply_text.hideInto(a, &hidden, split.answer, true);
+    const parsed = try tool_parse.parse(a, split.answer, in.tools, if (in.single) 1 else null);
+    // `parse_tool_calls` strips what is left of the reply, calls or none
+    var content: []const u8 = reply_text.pyStrip(parsed.content);
+    var calls = parsed.calls;
+    var call_deltas: []Value = &.{};
+    var streamed: usize = 0;
+    if (in.streamer) |cs| if (in.think == null or in.think.?.stream_from != null) {
+        // the calls streamed as sent, then any the streamer did not follow; calls held in the think block to the end
+        // (never streamed) are the end parser's, sent whole
+        const feed_text = if (in.think) |t| in.text[t.stream_from.?..] else in.text;
+        call_deltas = try cs.feed(feed_text);
+        streamed = cs.sent;
+        const all = try std.mem.concat(a, Value, &.{ try cs.followed(streamed), try cs.skippedCalls() });
+        calls = if (all.len > 0) all else null;
+    };
+    // a call the token limit cut (the reply ended inside it): never sent, nor its markup as content; one the model's end
+    // token left open that would not parse, its markup as text (`closeCall` closed the others)
+    var cut = if (in.streamer) |cs| cs.open and !in.ended else false;
+    if (cut) {
+        content = reply_text.pyStrip(answer);
+    } else if (!in.ended and in.tools.len > 0) {
+        if (std.mem.lastIndexOf(u8, content, glm_calls.call_open)) |at| {
+            if (std.mem.indexOf(u8, content[at..], glm_calls.call_close) == null) {
+                content = reply_text.pyRstrip(content[0..at]);
+                cut = true;
+            }
+        }
+    }
+    return .{ .reasoning = split.reasoning, .answer = answer, .content = content, .calls = calls, .call_deltas = call_deltas, .streamed = streamed, .cut = cut };
+}
+
+/// `{"tool_calls": [{"index", "id", "type", "function": {"name", "arguments"}}]}` for a call the end parser read: one
+/// delta with its header and its arguments.
+pub fn wholeDelta(a: Allocator, index: usize, call: Value) Allocator.Error!Value {
+    const function = try json.newObject(a);
+    const f = call.get("function") orelse Value{ .object = try json.newObject(a) };
+    try function.put(a, "name", .{ .string = f.strField("name") orelse "" });
+    try function.put(a, "arguments", .{ .string = f.strField("arguments") orelse "" });
+    const one = try json.newObject(a);
+    try one.put(a, "index", try json.intValue(a, index));
+    try one.put(a, "id", .{ .string = call.strField("id") orelse "" });
+    try one.put(a, "type", .{ .string = "function" });
+    try one.put(a, "function", .{ .object = function });
+    const list = try a.alloc(Value, 1);
+    list[0] = .{ .object = one };
+    const d = try json.newObject(a);
+    try d.put(a, "tool_calls", .{ .array = list });
+    return .{ .object = d };
+}
diff --git a/zig/src/server/glm_rig.zig b/zig/src/server/glm_rig.zig
new file mode 100644
index 00000000..8cb14ece
--- /dev/null
+++ b/zig/src/server/glm_rig.zig
@@ -0,0 +1,132 @@
+//! Test rig for the GLM recipe's server behaviours: the shipped GLM-5.3-Flash chat template (fixtures_glm_chat.jinja,
+//! snapshot 078455ff), byte-level token ids, and an engine that plays a script of reply rounds on CPU.
+//! Template by zai-org/GLM; TensorFold prompts.py wrapper by Ash Hart and contributors.
+const std = @import("std");
+const api = @import("engine_api");
+const server = @import("root.zig");
+const helper = @import("late_system_test.zig");
+const template = @import("template");
+const model_text = @import("model_text.zig");
+
+const source = @embedFile("fixtures_glm_chat.jinja");
+
+/// An engine that answers each request with `rounds` (each one a `tokens` event of the bytes of its text), then ends
+/// as `reason`. It keeps what the server submitted.
+pub const Script = struct {
+    rounds: []const []const u8 = &.{"hi"},
+    reason: api.Reason = .stop,
+    lanes: u32 = 1,
+    context_window: u32 = 0,
+    prompt: []u32 = &.{},
+    max_tokens: u32 = 0,
+    loop_guard: bool = false,
+    loop_recipe: bool = false,
+    loop_period: ?u32 = null, // the engine says its guard closed the think block
+    background: bool = false,
+    busy: bool = false, // the next submit answers Busy
+    submits: u32 = 0,
+    /// Called before each round with its index (a test sleeps or reads the server there).
+    before_round: ?*const fn (n: usize) void = null,
+
+    pub fn engine(e: *Script) api.Engine {
+        return .{ .ctx = e, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+
+    fn info(ctx: *anyopaque) api.Info {
+        const e: *Script = @ptrCast(@alignCast(ctx));
+        return .{ .lanes = e.lanes, .context_window = e.context_window, .loop_guard = true };
+    }
+
+    fn submit(ctx: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const e: *Script = @ptrCast(@alignCast(ctx));
+        if (e.busy) return error.Busy;
+        e.submits += 1;
+        std.testing.allocator.free(e.prompt);
+        e.prompt = std.testing.allocator.dupe(u32, request.prompt) catch return error.Busy;
+        e.max_tokens = request.max_tokens;
+        e.loop_guard = request.loop_guard;
+        e.loop_recipe = request.loop_recipe;
+        e.background = request.background;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        for (e.rounds, 0..) |text, n| {
+            if (e.before_round) |f| f(n);
+            var ids: [4096]u32 = undefined;
+            for (text, 0..) |byte, i| ids[i] = byte;
+            sink.event(sink.ctx, id, &.{ .tokens = ids[0..text.len] });
+        }
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = e.reason, .stats = .{ .loop_period = e.loop_period } } });
+    }
+
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+/// The three GLM call marks are whole tokens of the real tokenizer; here they are ids no byte uses.
+fn tokenId(_: *anyopaque, piece: []const u8) ?u32 {
+    const known = [_][]const u8{ "<tool_call>", "<arg_key>", "</arg_value>", "</think>" };
+    for (known, 0..) |k, i| if (std.mem.eql(u8, k, piece)) return 1000 + @as(u32, @intCast(i));
+    return null;
+}
+
+/// The server under test. Fill it in place: `try rig.start(recipe, config)`; `rig.finish()` frees it.
+pub const Rig = struct {
+    encoder: helper.DropLate = .{},
+    hf: server.hf_text.HfText = undefined,
+    vt: model_text.Text.VTable = undefined,
+    backend: Script = .{},
+    srv: *server.Server = undefined,
+
+    pub fn start(rig: *Rig, r: server.recipe.Recipe, config: server.Config) !void {
+        rig.hf = .{
+            .gpa = std.testing.allocator,
+            .arena = .init(std.testing.allocator),
+            .tok = undefined,
+            .glm = true,
+            .source = source,
+            .compiled = try template.compile(std.testing.allocator, source, null),
+            .effort_tail = r.effort_tail,
+            .clear_thinking = r.clear_thinking,
+        };
+        var text = rig.encoder.text();
+        rig.vt = text.vtable.*;
+        rig.vt.render = rig.hf.text().vtable.render;
+        rig.vt.template_source = rig.hf.text().vtable.template_source;
+        rig.hf.eos = &.{3}; // byte 0x03 ends a reply, as <|endoftext|> does
+        rig.vt.eos_ids = rig.hf.text().vtable.eos_ids;
+        rig.vt.token_id = tokenId;
+        text.ctx = &rig.hf;
+        text.vtable = &rig.vt;
+        var c = config;
+        c.recipe = r;
+        c.recipe.glm = true;
+        rig.srv = try server.Server.init(std.testing.allocator, std.testing.io, rig.backend.engine(), text, c, null);
+    }
+
+    pub fn finish(rig: *Rig) void {
+        rig.srv.deinit();
+        std.testing.allocator.free(rig.backend.prompt);
+        rig.hf.arena.deinit();
+        rig.hf.compiled.?.deinit();
+    }
+
+    /// POST /v1/chat/completions with `body`; the caller frees `.body`.
+    pub fn chat(rig: *Rig, body: []const u8) !helper.Reply {
+        return helper.exchange(rig.srv, "/v1/chat/completions", body);
+    }
+
+    /// The prompt the engine last received, as text (the caller frees it).
+    pub fn promptText(rig: *Rig) ![]u8 {
+        const text = try std.testing.allocator.alloc(u8, rig.backend.prompt.len);
+        for (rig.backend.prompt, text) |id, *byte| byte.* = @intCast(id);
+        return text;
+    }
+};
+
+pub const default_config: server.Config = .{ .served_name = "glm5_next", .enable_thinking = true, .model_ids = &.{"glm5_next"}, .use_drafts = false, .default_max_tokens = 32768 };
diff --git a/zig/src/server/playout.zig b/zig/src/server/playout.zig
new file mode 100644
index 00000000..c7adccd5
--- /dev/null
+++ b/zig/src/server/playout.zig
@@ -0,0 +1,271 @@
+//! Smooth streaming (TF_GLM_STREAM_SMOOTH=1; recipe patch 0061, Python `cuda/stream_pacing.py`): a streamed reply's text
+//! goes out token by token at a steady pace from a short playout buffer, instead of a burst of drafted tokens every
+//! round and a pause whenever the engine fills another request's prompt.
+//!
+//! The engine's rounds come in bursts: a round accepts ~3 drafted tokens, a round takes longer while other requests
+//! decode, and while a new prompt fills the rounds wait for its layer slices. The request's tokens enter a queue as they
+//! arrive and a writer thread sends them one event each: the next goes out `hold / queued` after the previous one (never
+//! before it arrived), so the queue settles at about `hold` of tokens and a pause in the rounds shorter than that is
+//! spread over the tokens already queued instead of showing as a freeze. No token is held longer than `longest_hold`
+//! times `hold`.
+//!
+//! The text, its order and the reply's end are unchanged: only when events go out. Events that are not text (tool-call
+//! deltas, keep-alives) keep their place in the queue and are not paced; the round that ends the reply flushes the queue
+//! at once. The engine never waits: the request thread only queues.
+const std = @import("std");
+const json = @import("json.zig");
+const chat = @import("chat.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+/// The default playout buffer: about this much text is held, so shorter pauses never show.
+pub const hold_default_ms: u32 = 400;
+/// No token is held longer than 5/2 times the buffer.
+const longest_num: i96 = 5;
+const longest_den: i96 = 2;
+
+pub const Item = struct { delta: Value, paced: bool, arrived: i96 };
+
+/// The queue's pacing rule, apart from threads and clocks.
+pub const Timing = struct {
+    hold_ns: i96,
+    last: ?i96 = null, // when the previous event went out
+    paced: usize = 0, // paced items queued
+    flushing: bool = false,
+
+    /// When the front of the queue goes out (the queue is not empty).
+    pub fn due(t: *const Timing, front: Item, now: i96) i96 {
+        if (t.flushing or !front.paced or t.last == null) return now;
+        const spread = @divTrunc(t.hold_ns, @as(i96, @intCast(@max(t.paced, 1))));
+        const at = @max(front.arrived, t.last.? + spread);
+        return @min(at, front.arrived + @divTrunc(t.hold_ns * longest_num, longest_den));
+    }
+};
+
+pub const Playout = struct {
+    gpa: Allocator,
+    io: std.Io,
+    out: chat.Sink,
+    cancelled: ?Cancelled,
+    timing: Timing,
+    mutex: std.Io.Mutex = .init,
+    cond: std.Io.Condition = .init,
+    queue: std.ArrayList(Item) = .empty,
+    /// The queued deltas' own copies: a delta's text may lie in a buffer the reply moves on (the decode buffer grows).
+    copies: std.heap.ArenaAllocator = undefined,
+    head: usize = 0,
+    closed: bool = false,
+    gone: bool = false,
+    thread: ?std.Thread = null,
+
+    pub const Cancelled = struct { ctx: *anyopaque, check: *const fn (ctx: *anyopaque) bool };
+
+    pub fn start(p: *Playout, gpa: Allocator, io: std.Io, hold_ms: u32, out: chat.Sink, cancelled: ?Cancelled) !void {
+        p.* = .{ .gpa = gpa, .io = io, .out = out, .cancelled = cancelled, .timing = .{ .hold_ns = @as(i96, hold_ms) * std.time.ns_per_ms }, .copies = .init(gpa) };
+        p.thread = try std.Thread.spawn(.{}, run, .{p});
+    }
+
+    /// The sink the reply writes to: it queues.
+    pub fn sink(p: *Playout) chat.Sink {
+        return .{ .ctx = p, .call = put };
+    }
+
+    fn now(p: *const Playout) i96 {
+        return std.Io.Clock.awake.now(p.io).toNanoseconds();
+    }
+
+    /// A text delta is paced; calls, keepalives and the like keep their place and go out as soon as they are first.
+    fn pacedDelta(delta: Value) bool {
+        return switch (delta) {
+            .string => true,
+            .object => delta.get("content") != null or delta.get("reasoning_content") != null,
+            else => false,
+        };
+    }
+
+    fn put(ctx: *anyopaque, delta: Value) error{Closed}!void {
+        const p: *Playout = @ptrCast(@alignCast(ctx));
+        p.mutex.lockUncancelable(p.io);
+        defer p.mutex.unlock(p.io);
+        if (p.gone) return error.Closed;
+        if (p.closed) return;
+        const paced = pacedDelta(delta);
+        const own = json.deepCopy(p.copies.allocator(), delta) catch return error.Closed;
+        p.queue.append(p.gpa, .{ .delta = own, .paced = paced, .arrived = p.now() }) catch return error.Closed;
+        p.timing.paced += @intFromBool(paced);
+        p.cond.signal(p.io);
+    }
+
+    /// Everything queued goes out at once from now on (the reply's last round).
+    pub fn flush(p: *Playout) void {
+        p.mutex.lockUncancelable(p.io);
+        defer p.mutex.unlock(p.io);
+        p.timing.flushing = true;
+        p.cond.signal(p.io);
+    }
+
+    /// Sends everything still queued at once and stops the writer (the reply's end follows).
+    pub fn close(p: *Playout) void {
+        p.mutex.lockUncancelable(p.io);
+        p.timing.flushing = true;
+        p.closed = true;
+        p.cond.signal(p.io);
+        p.mutex.unlock(p.io);
+        p.join();
+    }
+
+    /// Drops what is queued and stops the writer.
+    pub fn abort(p: *Playout) void {
+        p.mutex.lockUncancelable(p.io);
+        p.queue.clearRetainingCapacity();
+        p.head = 0;
+        p.timing.paced = 0;
+        p.closed = true;
+        p.cond.signal(p.io);
+        p.mutex.unlock(p.io);
+        p.join();
+    }
+
+    fn join(p: *Playout) void {
+        if (p.thread) |t| t.join();
+        p.thread = null;
+        p.queue.deinit(p.gpa);
+        p.queue = .empty;
+        p.copies.deinit();
+        p.copies = .init(p.gpa);
+    }
+
+    fn run(p: *Playout) void {
+        while (true) {
+            p.mutex.lockUncancelable(p.io);
+            var item: Item = undefined;
+            var held = false;
+            while (true) {
+                if (p.head >= p.queue.items.len) {
+                    if (p.closed) {
+                        p.mutex.unlock(p.io);
+                        return;
+                    }
+                    p.cond.waitUncancelable(p.io, &p.mutex);
+                    continue;
+                }
+                const t = p.now();
+                const at = p.timing.due(p.queue.items[p.head], t);
+                if (at <= t) break;
+                // a new token shortens the wait; a flush ends it
+                p.cond.waitTimeout(p.io, &p.mutex, .{ .duration = .{ .raw = .fromNanoseconds(@intCast(at - t)), .clock = .awake } }) catch {};
+            }
+            item = p.queue.items[p.head];
+            p.head += 1;
+            if (p.head == p.queue.items.len) {
+                p.queue.clearRetainingCapacity();
+                p.head = 0;
+            }
+            p.timing.paced -= @intFromBool(item.paced);
+            held = item.paced and !p.timing.flushing and p.now() > item.arrived;
+            p.mutex.unlock(p.io);
+            var ok = true;
+            if (held) if (p.cancelled) |c| if (c.check(c.ctx)) {
+                ok = false;
+            };
+            if (ok) p.out.call(p.out.ctx, item.delta) catch {
+                ok = false;
+            };
+            p.mutex.lockUncancelable(p.io);
+            p.timing.last = p.now();
+            if (!ok) {
+                p.gone = true;
+                p.queue.clearRetainingCapacity();
+                p.head = 0;
+                p.timing.paced = 0;
+                p.mutex.unlock(p.io);
+                return;
+            }
+            p.mutex.unlock(p.io);
+        }
+    }
+};
+
+fn textItem(arrived: i96) Item {
+    return .{ .delta = .{ .string = "x" }, .paced = true, .arrived = arrived };
+}
+
+test "the next token goes out hold / queued after the previous one, never before it arrived" {
+    var t: Timing = .{ .hold_ns = 400 * std.time.ns_per_ms, .paced = 4 };
+    // nothing went out yet: the first goes at once
+    try std.testing.expectEqual(@as(i96, 1000), t.due(textItem(0), 1000));
+    t.last = 1000 * std.time.ns_per_ms;
+    // 4 queued: 100 ms after the previous
+    try std.testing.expectEqual(@as(i96, 1100 * std.time.ns_per_ms), t.due(textItem(500 * std.time.ns_per_ms), 1050 * std.time.ns_per_ms));
+    // a token that arrived later waits for its own arrival
+    try std.testing.expectEqual(@as(i96, 1300 * std.time.ns_per_ms), t.due(textItem(1300 * std.time.ns_per_ms), 1050 * std.time.ns_per_ms));
+    // a long queue: the spread is short
+    t.paced = 40;
+    try std.testing.expectEqual(@as(i96, 1010 * std.time.ns_per_ms), t.due(textItem(900 * std.time.ns_per_ms), 1005 * std.time.ns_per_ms));
+    // one queued: the whole hold
+    t.paced = 1;
+    t.last = 1000 * std.time.ns_per_ms;
+    // but no token is held longer than 2.5 times the buffer after it arrived
+    try std.testing.expectEqual(@as(i96, 1000 * std.time.ns_per_ms), t.due(textItem(0), 900 * std.time.ns_per_ms));
+    // an event that is not text goes out at once, and a flush ends every wait
+    const call: Item = .{ .delta = .null, .paced = false, .arrived = 0 };
+    try std.testing.expectEqual(@as(i96, 5), t.due(call, 5));
+    t.flushing = true;
+    try std.testing.expectEqual(@as(i96, 5), t.due(textItem(0), 5));
+}
+
+const Collect = struct {
+    io: std.Io,
+    stamps: [32]i96 = undefined,
+    order: [32]u8 = undefined,
+    n: usize = 0,
+
+    fn call(ctx: *anyopaque, delta: Value) error{Closed}!void {
+        const c: *Collect = @ptrCast(@alignCast(ctx));
+        if (c.n >= c.order.len) return error.Closed;
+        c.stamps[c.n] = std.Io.Clock.awake.now(c.io).toNanoseconds();
+        c.order[c.n] = delta.string[0];
+        c.n += 1;
+    }
+};
+
+test "queued tokens are spread over the buffer in order, and a close sends the rest at once" {
+    var c: Collect = .{ .io = std.testing.io };
+    var p: Playout = undefined;
+    try p.start(std.testing.allocator, std.testing.io, 200, .{ .ctx = &c, .call = Collect.call }, null);
+    const start = std.Io.Clock.awake.now(std.testing.io).toNanoseconds();
+    const sink = p.sink();
+    const letters = "abcde";
+    for (0..5) |i| try sink.call(sink.ctx, .{ .string = letters[i .. i + 1] });
+    // all five arrived together: the first goes at once, the next after hold / 4, then hold / 3 ... the last after the whole
+    // buffer, but never past 2.5 times it
+    std.Io.sleep(std.testing.io, .fromMilliseconds(800), .awake) catch {};
+    p.close();
+    try std.testing.expectEqual(@as(usize, 5), c.n);
+    try std.testing.expectEqualStrings("abcde", c.order[0..5]);
+    try std.testing.expect(c.stamps[0] - start < 30 * std.time.ns_per_ms);
+    try std.testing.expect(c.stamps[1] - c.stamps[0] >= 40 * std.time.ns_per_ms); // spread, not a burst
+    try std.testing.expect(c.stamps[4] - c.stamps[0] >= 300 * std.time.ns_per_ms);
+    try std.testing.expect(c.stamps[4] - start < 600 * std.time.ns_per_ms); // within 2.5 times the buffer
+}
+
+test "a flush sends what is queued at once, and a client that left stops the writer" {
+    var c: Collect = .{ .io = std.testing.io };
+    var p: Playout = undefined;
+    try p.start(std.testing.allocator, std.testing.io, 5000, .{ .ctx = &c, .call = Collect.call }, null);
+    const sink = p.sink();
+    for (0..4) |_| try sink.call(sink.ctx, .{ .string = "t" });
+    p.flush();
+    std.Io.sleep(std.testing.io, .fromMilliseconds(100), .awake) catch {};
+    p.close();
+    try std.testing.expectEqual(@as(usize, 4), c.n);
+    // a sink that fails: the writer stops and the next put says the client is gone
+    var full: Collect = .{ .io = std.testing.io, .n = 32 };
+    var q: Playout = undefined;
+    try q.start(std.testing.allocator, std.testing.io, 5, .{ .ctx = &full, .call = Collect.call }, null);
+    const s2 = q.sink();
+    try s2.call(s2.ctx, .{ .string = "z" });
+    std.Io.sleep(std.testing.io, .fromMilliseconds(100), .awake) catch {};
+    try std.testing.expectError(error.Closed, s2.call(s2.ctx, .{ .string = "z" }));
+    q.close();
+}
