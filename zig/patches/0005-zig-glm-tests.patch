diff --git a/zig/src/server/glm_calls.zig b/zig/src/server/glm_calls.zig
new file mode 100644
index 00000000..00950b68
--- /dev/null
+++ b/zig/src/server/glm_calls.zig
@@ -0,0 +1,368 @@
+//! GLM's tool calls in a reply as the recipe serves them (patches 0036, 0053, 0055; Python `cuda/reply_text.py`):
+//!
+//! * `ThinkSplit`: calls the model wrote inside the think block are its calls when they end the reply (the rule of
+//!   jayleaton/glm53-tensorfold-spark patch 0620, Apache-2.0, as the recipe adapted it); a held call stays out of the
+//!   reasoning until the reply ends on it or text follows it.
+//! * `CallStreamer`: each `<tool_call>NAME<arg_key>..</arg_key><arg_value>..</arg_value></tool_call>` is followed while
+//!   it is written (its arguments' JSON built as the text arrives, a typed value when whole) and sent whole, header and
+//!   arguments in one delta, once its `</tool_call>` arrives. A call the reply ends inside (its token limit) is never
+//!   sent: a client could store or run its cut arguments.
+//! * `closeCall`: what closes the call a reply ended inside on an end token (issue #22), when it then parses.
+const std = @import("std");
+const json = @import("json");
+const ids = @import("ids.zig");
+const keys = @import("glm_keys.zig");
+const reply_text = @import("reply_text.zig");
+const tool_params = @import("tool_params.zig");
+const tool_parse = @import("tool_parse.zig");
+const tool_specs = @import("tool_specs.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+
+pub const call_open = "<tool_call>";
+pub const call_close = "</tool_call>";
+pub const think_close = "</think>";
+/// Characters of a call written inside the think block held before it streams as a call.
+pub const think_call_hold: usize = 1024;
+/// An idle client (one that drops a reply sending nothing) gets an empty delta this often while a call is held.
+pub const keepalive_s: f64 = 2.0;
+
+const partialTag = reply_text.partialTag;
+const strip = reply_text.pyStrip;
+const lstrip = reply_text.pyLstrip;
+
+fn findFrom(text: []const u8, needle: []const u8, from: usize) ?usize {
+    if (from > text.len) return null;
+    return std.mem.indexOfPos(u8, text, from, needle);
+}
+
+/// `close_glm_call(text, tools)`: what closes the GLM call a reply ended inside when it parses as a whole call to an
+/// offered tool (the model wrote its end token before `</tool_call>`): `</tool_call>`, after `</arg_value>` when a
+/// value is open; "" when the reply is not inside a call, or the closed call would not parse (its markup is then text).
+pub fn closeCall(a: Allocator, text: []const u8, tools: []const Value) Allocator.Error![]const u8 {
+    const at = std.mem.lastIndexOf(u8, text, call_open) orelse return "";
+    const block = text[at + call_open.len ..];
+    if (std.mem.indexOf(u8, block, call_close) != null or std.mem.indexOf(u8, block, think_close) != null) return "";
+    const value_open_at = std.mem.lastIndexOf(u8, block, keys.value_open);
+    const value_close_at = std.mem.lastIndexOf(u8, block, keys.value_close);
+    const open_value = if (value_open_at) |o| (if (value_close_at) |c| o > c else true) else false;
+    const suffix: []const u8 = if (open_value) keys.value_close ++ call_close else call_close;
+    // the strict reading: one whole call, nothing but its markup, arguments a JSON object
+    const closed = try std.mem.concat(a, u8, &.{ call_open, block, suffix });
+    return if ((try tool_parse.parse(a, closed, tools, 1)).calls != null) suffix else "";
+}
+
+pub const RunKind = enum { calls, pending, reasoning };
+
+/// `_call_run`: (where the run of complete `<tool_call>` blocks from `start` ends, what it is): `calls` when the reply
+/// ended on it (nothing after it but whitespace and a closing `</think>`), `pending` while that may still come true,
+/// `reasoning` once text follows it (more reasoning, or an answer after the think block).
+fn callRun(text: []const u8, start: usize, finished: bool) struct { usize, RunKind } {
+    var end = start;
+    var pos = start;
+    while (std.mem.startsWith(u8, text[pos..], call_open)) {
+        const close_at = findFrom(text, call_close, pos + call_open.len) orelse break;
+        end = close_at + call_close.len;
+        pos = text.len - lstrip(text[end..]).len;
+    }
+    var after = lstrip(text[end..]);
+    if (std.mem.startsWith(u8, after, think_close) and strip(after[think_close.len..]).len == 0) after = "";
+    if (after.len == 0) return .{ end, if (finished and end > start) .calls else .pending };
+    if (!finished and (std.mem.startsWith(u8, after, call_open) or std.mem.startsWith(u8, call_open, after) or std.mem.startsWith(u8, think_close, after)))
+        return .{ end, .pending }; // a block, or the think block's close, being written
+    return .{ end, .reasoning };
+}
+
+/// (reasoning, answer) of a thinking GLM reply with tools, streamed or whole: the think block ends at its `</think>`,
+/// and calls the model wrote inside it are its calls only when they end the reply. With `hold`, a held call longer than
+/// `hold` characters is taken as a call at once (`committed`) so a long file write streams while it is written; nothing
+/// after it can make it reasoning again. `stream_from` is where the text a call streamer reads begins once known.
+pub const ThinkSplit = struct {
+    a: Allocator,
+    hold: ?usize = null,
+    floor: usize = 0, // calls before this are reasoning
+    committed: ?usize = null,
+    stream_from: ?usize = null,
+
+    pub fn split(s: *ThinkSplit, text: []const u8, finished: bool) Allocator.Error!reply_text.Split {
+        if (s.committed) |at| {
+            const rest = text[at..];
+            const answer = if (std.mem.indexOf(u8, rest, think_close)) |i|
+                lstrip(try std.mem.concat(s.a, u8, &.{ rest[0..i], rest[i + think_close.len ..] }))
+            else
+                lstrip(rest);
+            return .{ .reasoning = text[0..at], .answer = answer };
+        }
+        const close = std.mem.indexOf(u8, text, think_close);
+        while (true) {
+            const call = findFrom(text, call_open, s.floor);
+            if (close) |c| if (call == null or c < call.?) {
+                s.stream_from = c + think_close.len;
+                return .{ .reasoning = text[0..c], .answer = std.mem.trimStart(u8, text[s.stream_from.?..], "\n") };
+            };
+            const at = call orelse {
+                const held = if (finished) 0 else @max(partialTag(text, think_close), partialTag(text, call_open));
+                return .{ .reasoning = text[0 .. text.len - held], .answer = "" };
+            };
+            const end, const kind = callRun(text, at, finished);
+            switch (kind) {
+                .calls => return .{ .reasoning = text[0..at], .answer = text[at..end] },
+                .reasoning => {
+                    s.floor = @max(end, at + call_open.len);
+                    continue;
+                },
+                .pending => {
+                    if (s.hold) |h| if (text.len - at > h and close == null) {
+                        s.committed = at;
+                        s.stream_from = at;
+                        return s.split(text, finished);
+                    };
+                    return .{ .reasoning = text[0..at], .answer = "" };
+                },
+            }
+        }
+    }
+};
+
+/// One call the streamer follows: its header went out when its name was read.
+pub const Followed = struct {
+    id: []const u8,
+    name: []const u8,
+    arguments: std.ArrayList(u8) = .empty,
+};
+
+fn isWordByte(ch: u8) bool {
+    return std.ascii.isAlphanumeric(ch) or ch == '_' or ch >= 0x80;
+}
+
+/// `_GLM_NAME_RE.fullmatch(name)`: `[\w.:-]+`.
+fn globName(name: []const u8) bool {
+    if (name.len == 0) return false;
+    for (name) |ch| if (!isWordByte(ch) and ch != '.' and ch != ':' and ch != '-') return false;
+    return true;
+}
+
+pub const CallStreamer = struct {
+    a: Allocator,
+    tools: []const Value,
+    known: std.StringHashMapUnmanaged([]const u8) = .empty, // lowercase name -> the offered spelling
+    schemas: tool_params.Schemas,
+    calls: std.ArrayList(Followed) = .empty,
+    skipped: std.ArrayList([]const u8) = .empty, // whole blocks it did not follow, for the end parser
+    pos: usize = 0,
+    state: enum { outside, name, skip, arguments, key, value } = .outside,
+    start: usize = 0,
+    open: bool = false, // the last call's header went out, its </tool_call> has not
+    schema: ?*const json.Object = null, // the current call's parameter schemas
+    value_schema: ?Value = null, // the current typed value's schema, null for text
+    maybe_null: bool = false, // a nullable text value that may still be `null`: held
+    sent: usize = 0, // calls sent whole (the last one may still be open)
+
+    pub fn init(a: Allocator, tools: []const Value) Allocator.Error!CallStreamer {
+        var s: CallStreamer = .{ .a = a, .tools = tools, .schemas = try tool_params.schemas(a, tools) };
+        for (tools) |tool| {
+            const name = try tool_specs.toolName(a, tool);
+            try s.known.put(a, try std.ascii.allocLowerString(a, name), name);
+        }
+        return s;
+    }
+
+    fn args(s: *CallStreamer, piece: []const u8) Allocator.Error!void {
+        try s.calls.items[s.calls.items.len - 1].arguments.appendSlice(s.a, piece);
+    }
+
+    fn jsonText(s: *CallStreamer, v: Value) Allocator.Error![]const u8 {
+        return json.stringify(s.a, v, .{ .ascii = false, .compact = true });
+    }
+
+    /// The reply's answer so far (text that only grows): the calls that became whole since the last feed, each as one
+    /// delta carrying its header and its arguments.
+    pub fn feed(s: *CallStreamer, text: []const u8) Allocator.Error![]Value {
+        try s.follow(text);
+        const whole = s.calls.items.len - @intFromBool(s.open);
+        var out: std.ArrayList(Value) = .empty;
+        var i = s.sent;
+        while (i < whole) : (i += 1) try out.append(s.a, try delta(s.a, i, s.calls.items[i]));
+        s.sent = whole;
+        return out.items;
+    }
+
+    /// `{"tool_calls": [{"index", "id", "type", "function": {"name", "arguments"}}]}`.
+    pub fn delta(a: Allocator, index: usize, c: Followed) Allocator.Error!Value {
+        const function = try json.newObject(a);
+        try function.put(a, "name", .{ .string = c.name });
+        try function.put(a, "arguments", .{ .string = c.arguments.items });
+        const one = try json.newObject(a);
+        try one.put(a, "index", try json.intValue(a, index));
+        try one.put(a, "id", .{ .string = c.id });
+        try one.put(a, "type", .{ .string = "function" });
+        try one.put(a, "function", .{ .object = function });
+        const list = try a.alloc(Value, 1);
+        list[0] = .{ .object = one };
+        const d = try json.newObject(a);
+        try d.put(a, "tool_calls", .{ .array = list });
+        return .{ .object = d };
+    }
+
+    /// Whether the end parser reads a block beginning `name` as a GLM call to an offered tool.
+    fn callable(s: *CallStreamer, name: []const u8) Allocator.Error!bool {
+        if (!globName(name)) return false;
+        if (s.known.get(try std.ascii.allocLowerString(s.a, name)) == null) return false;
+        // a name that is JSON (`true`, `1`) is read as JSON
+        return switch (try json.parseText(s.a, name)) {
+            .ok => false,
+            .err => true,
+        };
+    }
+
+    fn follow(s: *CallStreamer, text: []const u8) Allocator.Error!void {
+        while (true) {
+            const rest = text[@min(s.pos, text.len)..];
+            switch (s.state) {
+                .outside => {
+                    const at = std.mem.indexOf(u8, rest, call_open) orelse return;
+                    s.start = s.pos + at;
+                    s.pos = s.start + call_open.len;
+                    s.state = .name;
+                },
+                .name => { // the end parser's name: the text before <arg_key> or the end
+                    const k = std.mem.indexOf(u8, rest, keys.key_open);
+                    const c = std.mem.indexOf(u8, rest, call_close);
+                    const stop = if (k) |ki| (if (c) |ci| @min(ki, ci) else ki) else c orelse {
+                        if (reply_text.charCount(rest) > 256) {
+                            s.state = .skip;
+                            continue;
+                        }
+                        return;
+                    };
+                    const name = strip(rest[0..stop]);
+                    if (!try s.callable(name)) {
+                        s.state = .skip;
+                        continue;
+                    }
+                    const offered = s.known.get(try std.ascii.allocLowerString(s.a, name)).?;
+                    try s.calls.append(s.a, .{ .id = try ids.make(s.a, "call_", 24), .name = offered });
+                    s.open = true;
+                    s.schema = s.schemas.get(try std.ascii.allocLowerString(s.a, offered));
+                    s.pos += stop;
+                    s.state = .arguments;
+                },
+                .skip => { // a block the end parser decides: to its end
+                    const at = std.mem.indexOf(u8, rest, call_close) orelse return;
+                    s.pos += at + call_close.len;
+                    s.state = .outside;
+                    try s.skipped.append(s.a, try s.a.dupe(u8, text[s.start..s.pos])); // the text lies in a buffer that moves on
+                },
+                .arguments => { // text between arguments is ignored, as the end parser does
+                    const k = std.mem.indexOf(u8, rest, keys.key_open);
+                    const c = std.mem.indexOf(u8, rest, call_close);
+                    if (c != null and (k == null or c.? < k.?)) {
+                        const last = &s.calls.items[s.calls.items.len - 1];
+                        try s.args(if (last.arguments.items.len > 0) "}" else "{}");
+                        s.pos += c.? + call_close.len;
+                        s.state = .outside;
+                        s.open = false;
+                        try s.repaired(text[s.start..s.pos]);
+                    } else if (k) |ki| {
+                        s.pos += ki + keys.key_open.len;
+                        s.state = .key;
+                    } else return;
+                },
+                .key => {
+                    const end = std.mem.indexOf(u8, rest, keys.key_close);
+                    // `\s*<arg_value>` right after the key's closer
+                    var opens_end: ?usize = null;
+                    if (end) |e| {
+                        var j = e + keys.key_close.len;
+                        while (j < rest.len and reply_text.isSpaceByte(rest[j])) j += 1;
+                        if (std.mem.startsWith(u8, rest[j..], keys.value_open)) opens_end = j + keys.value_open.len;
+                    }
+                    const opens = opens_end orelse {
+                        const after: []const u8 = if (end) |e| rest[e + keys.key_close.len ..] else "";
+                        const cut = std.mem.indexOf(u8, if (end == null) rest else after, call_close) != null;
+                        if (!cut and (end == null or strip(after).len == 0 or std.mem.startsWith(u8, keys.value_open, lstrip(after)))) return; // still being written
+                        s.state = .arguments; // not an argument the end parser reads the same way
+                        continue;
+                    };
+                    const key = strip(rest[0..end.?]);
+                    const schema: Value = if (s.schema) |m| (m.get(key) orelse .{ .object = try json.newObject(s.a) }) else .{ .object = try json.newObject(s.a) };
+                    s.value_schema = if (tool_params.typedParameter(schema)) schema else null;
+                    s.maybe_null = s.value_schema == null and tool_params.nullableText(schema);
+                    const last = &s.calls.items[s.calls.items.len - 1];
+                    const opened: []const u8 = if (last.arguments.items.len == 0) "{" else ",";
+                    const quote: []const u8 = if (s.value_schema != null or s.maybe_null) "" else "\"";
+                    try s.args(try std.mem.concat(s.a, u8, &.{ opened, try json.quote(s.a, key, .{ .ascii = false }), ":", quote }));
+                    s.pos += opens;
+                    s.state = .value;
+                },
+                .value => {
+                    const end = std.mem.indexOf(u8, rest, keys.value_close);
+                    const written = if (end) |e| rest[0..e] else rest[0 .. rest.len - partialTag(rest, keys.value_close)];
+                    if (s.value_schema) |schema| { // typed: decoded whole, as the end parser does
+                        const e = end orelse return;
+                        try s.args(try s.jsonText(try tool_params.decode(s.a, rest[0..e], schema, false)));
+                    } else if (s.maybe_null) { // text or null: held while it may still be `null`
+                        if (end != null and std.mem.eql(u8, written, "null")) {
+                            try s.args("null");
+                        } else if (end == null and std.mem.startsWith(u8, "null", written)) {
+                            return;
+                        } else {
+                            try s.args("\"");
+                            s.maybe_null = false;
+                            continue;
+                        }
+                    } else { // text: as it arrives, less a tail that may begin the closer
+                        const quoted = try json.quote(s.a, written, .{ .ascii = false });
+                        const piece = try std.mem.concat(s.a, u8, &.{ quoted[1 .. quoted.len - 1], if (end != null) "\"" else "" });
+                        if (piece.len > 0) try s.args(piece);
+                        if (end == null) {
+                            s.pos += written.len;
+                            return;
+                        }
+                    }
+                    s.pos += end.? + keys.value_close.len;
+                    s.state = .arguments;
+                },
+            }
+        }
+    }
+
+    /// A whole call whose markup lost an `<arg_key>`: its arguments as the end parser reads it repaired (the streamer
+    /// skipped the argument it could not see); it has not been sent yet.
+    fn repaired(s: *CallStreamer, block: []const u8) Allocator.Error!void {
+        if (std.mem.count(u8, block, keys.key_close) <= std.mem.count(u8, block, keys.key_open)) return;
+        const parsed = (try tool_parse.parse(s.a, block, s.tools, null)).calls orelse return;
+        if (parsed.len != 1) return;
+        const function = parsed[0].get("function") orelse return;
+        const last = &s.calls.items[s.calls.items.len - 1];
+        if (!std.mem.eql(u8, function.strField("name") orelse "", last.name)) return;
+        last.arguments.clearRetainingCapacity();
+        try last.arguments.appendSlice(s.a, function.strField("arguments") orelse "");
+    }
+
+    /// The calls the end parser reads in the blocks this streamer skipped (JSON or Qwen markup): sent at the end.
+    pub fn skippedCalls(s: *CallStreamer) Allocator.Error![]Value {
+        var out: std.ArrayList(Value) = .empty;
+        for (s.skipped.items) |block| {
+            const parsed = (try tool_parse.parse(s.a, block, s.tools, null)).calls orelse continue;
+            try out.appendSlice(s.a, parsed);
+        }
+        return out.items;
+    }
+
+    /// The calls followed, as OpenAI tool calls (the first `n`).
+    pub fn followed(s: *CallStreamer, n: usize) Allocator.Error![]Value {
+        const out = try s.a.alloc(Value, @min(n, s.calls.items.len));
+        for (out, s.calls.items[0..out.len]) |*slot, c| {
+            const function = try json.newObject(s.a);
+            try function.put(s.a, "name", .{ .string = c.name });
+            try function.put(s.a, "arguments", .{ .string = c.arguments.items });
+            const call = try json.newObject(s.a);
+            try call.put(s.a, "id", .{ .string = c.id });
+            try call.put(s.a, "type", .{ .string = "function" });
+            try call.put(s.a, "function", .{ .object = function });
+            slot.* = .{ .object = call };
+        }
+        return out;
+    }
+};
diff --git a/zig/src/server/glm_calls_http_test.zig b/zig/src/server/glm_calls_http_test.zig
new file mode 100644
index 00000000..2d97d8c6
--- /dev/null
+++ b/zig/src/server/glm_calls_http_test.zig
@@ -0,0 +1,349 @@
+//! The recipe's tool-call serving, end to end on CPU: a scripted engine plays rounds of GLM text, the server streams
+//! or returns them (patches 0036, 0053, 0055, 0075): each call sent whole once written, calls in the think block,
+//! a call the token limit cuts never sent, one the model's end token leaves open closed when it parses.
+const std = @import("std");
+const json = @import("json");
+const rig = @import("glm_rig.zig");
+const Value = json.Value;
+
+const tools =
+    \\"tools":[{"type":"function","function":{"name":"read_file","parameters":{"type":"object","properties":{"path":{"type":"string"},"limit":{"type":"integer"},"mode":{"type":["string","null"]}}}}},{"type":"function","function":{"name":"ls","parameters":{"type":"object","properties":{}}}}]
+;
+const user = "\"messages\":[{\"role\":\"user\",\"content\":\"go\"}]," ++ tools;
+
+/// The `data:` events of an SSE body, decoded; the caller's arena owns them.
+fn events(a: std.mem.Allocator, body: []const u8) ![]Value {
+    var out: std.ArrayList(Value) = .empty;
+    var lines = std.mem.splitSequence(u8, body, "\n\n");
+    while (lines.next()) |block| {
+        if (!std.mem.startsWith(u8, block, "data: ")) continue;
+        const payload = block["data: ".len..];
+        if (std.mem.eql(u8, payload, "[DONE]")) continue;
+        try out.append(a, (try json.parse(a, payload)).ok);
+    }
+    return out.items;
+}
+
+fn delta(event: Value) Value {
+    return event.get("choices").?.array[0].get("delta") orelse .null;
+}
+
+fn finishOf(event: Value) ?[]const u8 {
+    const f = event.get("choices").?.array[0].get("finish_reason") orelse return null;
+    return if (f == .string) f.string else null;
+}
+
+/// Everything a stream says, folded: text, reasoning, calls (index -> name, arguments), the finish reason, empty deltas.
+const Folded = struct {
+    content: []const u8 = "",
+    reasoning: []const u8 = "",
+    names: [8][]const u8 = @splat(""),
+    arguments: [8][]const u8 = @splat(""),
+    call_deltas: usize = 0,
+    count: usize = 0,
+    empty: usize = 0,
+    finish: []const u8 = "",
+    role_first: bool = false,
+};
+
+fn fold(a: std.mem.Allocator, body: []const u8) !Folded {
+    var f: Folded = .{};
+    var content: std.ArrayList(u8) = .empty;
+    var reasoning: std.ArrayList(u8) = .empty;
+    for (try events(a, body), 0..) |e, n| {
+        const choices = e.get("choices") orelse continue;
+        if (choices.array.len == 0) continue;
+        const d = delta(e);
+        if (n == 0) f.role_first = d.strField("role") != null;
+        if (d == .object and d.object.count() == 0) f.empty += 1;
+        if (d.strField("content")) |c| try content.appendSlice(a, c);
+        if (d.strField("reasoning_content")) |c| try reasoning.appendSlice(a, c);
+        if (d.get("tool_calls")) |calls| for (calls.array) |c| {
+            f.call_deltas += 1;
+            const i: usize = @intCast(c.get("index").?.int64().?);
+            f.count = @max(f.count, i + 1);
+            if (c.get("function")) |fun| {
+                if (fun.strField("name")) |name| f.names[i] = name;
+                if (fun.strField("arguments")) |args| f.arguments[i] = try std.mem.concat(a, u8, &.{ f.arguments[i], args });
+            }
+        };
+        if (finishOf(e)) |r| f.finish = r;
+    }
+    f.content = content.items;
+    f.reasoning = reasoning.items;
+    return f;
+}
+
+const call_a = "<tool_call>read_file<arg_key>path</arg_key><arg_value>/tmp/a</arg_value><arg_key>limit</arg_key><arg_value>20</arg_value></tool_call>";
+
+fn serve(r: *rig.Rig, extra: []const u8, rounds: []const []const u8, reason: @import("engine_api").Reason) !struct { status: u16, body: []u8 } {
+    r.backend.rounds = rounds;
+    r.backend.reason = reason;
+    const body = try std.mem.concat(std.testing.allocator, u8, &.{ "{", user, ",\"max_tokens\":4000", extra, "}" });
+    defer std.testing.allocator.free(body);
+    const reply = try r.chat(body);
+    return .{ .status = reply.status, .body = reply.body };
+}
+
+test "a streamed call goes out whole once written, text first, then finish tool_calls" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    // the call arrives over four rounds
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &.{ "Sure, ", "reading it.\n<tool_call>read_file<arg_key>path</arg_k", "ey><arg_value>/tmp/a</arg_value><arg_key>limit</arg_key><arg_val", "ue>20</arg_value></tool_call>\x03" }, .stop);
+    defer std.testing.allocator.free(reply.body);
+    try std.testing.expectEqual(@as(u16, 200), reply.status);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expect(f.role_first);
+    try std.testing.expectEqualStrings("Sure, reading it.", f.content);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    try std.testing.expectEqual(@as(usize, 1), f.call_deltas); // header and arguments in one delta
+    try std.testing.expectEqualStrings("read_file", f.names[0]);
+    try std.testing.expectEqualStrings("{\"path\":\"/tmp/a\",\"limit\":20}", f.arguments[0]);
+    try std.testing.expectEqualStrings("tool_calls", f.finish);
+    // the markup never reaches the text
+    try std.testing.expect(std.mem.indexOf(u8, reply.body, "<tool_call>") == null);
+}
+
+test "two calls, then a non-streamed reply returns the same calls beside the text" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    const rounds = [_][]const u8{ "Two reads.\n" ++ call_a, "\n<tool_call>ls</tool_call>\x03" };
+    const streamed = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .stop);
+    defer std.testing.allocator.free(streamed.body);
+    const f = try fold(a, streamed.body);
+    try std.testing.expectEqual(@as(usize, 2), f.count);
+    try std.testing.expectEqualStrings("read_file", f.names[0]);
+    try std.testing.expectEqualStrings("ls", f.names[1]);
+    try std.testing.expectEqualStrings("{}", f.arguments[1]);
+    try std.testing.expectEqualStrings("tool_calls", f.finish);
+
+    const whole = try serve(&r, ",\"reasoning_effort\":\"none\"", &rounds, .stop);
+    defer std.testing.allocator.free(whole.body);
+    const doc = (try json.parse(a, whole.body)).ok;
+    const choice = doc.get("choices").?.array[0];
+    const message = choice.get("message").?;
+    try std.testing.expectEqualStrings("tool_calls", choice.strField("finish_reason").?);
+    try std.testing.expectEqualStrings("Two reads.", message.strField("content").?); // the text before the calls stays
+    const calls = message.get("tool_calls").?.array;
+    try std.testing.expectEqual(@as(usize, 2), calls.len);
+    try std.testing.expectEqualStrings("{\"path\":\"/tmp/a\",\"limit\":20}", calls[0].get("function").?.strField("arguments").?);
+    try std.testing.expect(std.mem.startsWith(u8, calls[0].strField("id").?, "call_"));
+}
+
+test "a call the token limit cuts is never sent, nor its markup as content (0053)" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    const rounds = [_][]const u8{ "Writing now.\n<tool_call>read_file<arg_key>path</arg_key><arg_value>/tmp/a</arg_value><arg_key>mode</arg_key><arg_value>some long te", "xt that never ends" };
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .length);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 0), f.count);
+    try std.testing.expectEqualStrings("Writing now.", f.content);
+    try std.testing.expectEqualStrings("length", f.finish);
+    // and the same without streaming
+    const whole = try serve(&r, ",\"reasoning_effort\":\"none\"", &rounds, .length);
+    defer std.testing.allocator.free(whole.body);
+    const doc = (try json.parse(arena.allocator(), whole.body)).ok;
+    const choice = doc.get("choices").?.array[0];
+    try std.testing.expectEqualStrings("length", choice.strField("finish_reason").?);
+    try std.testing.expect(choice.get("message").?.get("tool_calls") == null);
+    try std.testing.expectEqualStrings("Writing now.", choice.get("message").?.strField("content").?);
+}
+
+test "a call the model's end token leaves open is closed when it parses, else it is text (0036, issue #22)" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    // the end token comes before </tool_call>, a value still open: both closers are added
+    const open = [_][]const u8{"<tool_call>read_file<arg_key>path</arg_key><arg_value>/tmp/a\x03"};
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &open, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    try std.testing.expectEqualStrings("{\"path\":\"/tmp/a\"}", f.arguments[0]);
+    try std.testing.expectEqualStrings("tool_calls", f.finish);
+    // a call that would not parse whole stays the reply's text, finish stop
+    const bad = [_][]const u8{"Hmm <tool_call>delete_all<arg_key>x</arg_key><arg_value>1\x03"};
+    const reply2 = try serve(&r, ",\"reasoning_effort\":\"none\"", &bad, .stop);
+    defer std.testing.allocator.free(reply2.body);
+    const doc = (try json.parse(arena.allocator(), reply2.body)).ok;
+    const choice = doc.get("choices").?.array[0];
+    try std.testing.expectEqualStrings("stop", choice.strField("finish_reason").?);
+    try std.testing.expect(choice.get("message").?.get("tool_calls") == null);
+}
+
+test "calls written inside the think block are the reply's calls when they end it (0055)" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    // thinking on: the reply ends inside the think block on a call
+    const ends = [_][]const u8{ "I need the file.\n", call_a, "\n</think>\x03" };
+    const reply = try serve(&r, ",\"stream\":true", &ends, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    try std.testing.expectEqualStrings("tool_calls", f.finish);
+    try std.testing.expectEqualStrings("I need the file.\n", f.reasoning);
+    try std.testing.expect(std.mem.indexOf(u8, f.reasoning, "<tool_call>") == null);
+    // text after it makes it reasoning after all
+    const more = [_][]const u8{ "I need the file.\n", call_a, "\nOr maybe not.\n</think>\nAnswer.\x03" };
+    const reply2 = try serve(&r, ",\"stream\":true", &more, .stop);
+    defer std.testing.allocator.free(reply2.body);
+    const f2 = try fold(arena.allocator(), reply2.body);
+    try std.testing.expectEqual(@as(usize, 0), f2.count);
+    try std.testing.expectEqualStrings("stop", f2.finish);
+    try std.testing.expectEqualStrings("Answer.", f2.content);
+    try std.testing.expect(std.mem.indexOf(u8, f2.reasoning, "Or maybe not.") != null);
+    // a call after the think block is an ordinary call
+    const after = [_][]const u8{ "Think.\n</think>\n", call_a, "\x03" };
+    const reply3 = try serve(&r, ",\"stream\":true", &after, .stop);
+    defer std.testing.allocator.free(reply3.body);
+    const f3 = try fold(arena.allocator(), reply3.body);
+    try std.testing.expectEqual(@as(usize, 1), f3.count);
+    try std.testing.expectEqualStrings("Think.", std.mem.trim(u8, f3.reasoning, "\n"));
+}
+
+test "parallel_tool_calls false keeps one call and sends it from the end parser" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    const rounds = [_][]const u8{ "Reads.\n" ++ call_a ++ "<tool_call>ls</tool_call>\x03" };
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\",\"parallel_tool_calls\":false", &rounds, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    try std.testing.expectEqualStrings("read_file", f.names[0]);
+    try std.testing.expectEqualStrings("tool_calls", f.finish);
+}
+
+test "a missing arg_key is put back and typed values keep their types" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    const rounds = [_][]const u8{"<tool_call>read_file path</arg_key><arg_value>/q</arg_value><arg_key>limit</arg_key><arg_value>7</arg_value><arg_key>mode</arg_key><arg_value>null</arg_value></tool_call>\x03"};
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    try std.testing.expectEqualStrings("{\"path\":\"/q\",\"limit\":7,\"mode\":null}", f.arguments[0]);
+}
+
+var nap_ns: u64 = 0;
+
+fn nap(n: usize) void {
+    if (n == 1) std.Io.sleep(std.testing.io, .fromNanoseconds(@intCast(nap_ns)), .awake) catch {};
+}
+
+test "a held call sends an empty delta every two seconds so an idle client keeps waiting" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    nap_ns = 2_200_000_000;
+    r.backend.before_round = nap;
+    // the call opens in round 0, nothing arrives for 2.2 s, then the rest
+    const rounds = [_][]const u8{ "<tool_call>read_file<arg_key>path</arg_key><arg_value>/tmp/", "a</arg_value></tool_call>\x03", "" };
+    const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const f = try fold(arena.allocator(), reply.body);
+    try std.testing.expectEqual(@as(usize, 1), f.count);
+    // round 2 (after the nap) found the call whole, so it was a delta, not a keepalive; hold the call open instead
+    try std.testing.expectEqualStrings("{\"path\":\"/tmp/a\"}", f.arguments[0]);
+    r.backend.before_round = nap;
+    const held = [_][]const u8{ "<tool_call>read_file<arg_key>path</arg_key><arg_value>/tmp/", "a", "b</arg_value></tool_call>\x03" };
+    const reply2 = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &held, .stop);
+    defer std.testing.allocator.free(reply2.body);
+    const f2 = try fold(arena.allocator(), reply2.body);
+    try std.testing.expect(f2.empty >= 1); // the nap fell while the call was open
+    try std.testing.expectEqualStrings("{\"path\":\"/tmp/ab\"}", f2.arguments[0]);
+}
+
+test "a tool-calling step's reasoning is put back into the next request when the client drops it (TF_GLM_KEEP_REASONING)" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var r: rig.Rig = .{};
+    try r.start(.{}, rig.default_config);
+    defer r.finish();
+    const rounds = [_][]const u8{ "Let me read the file first.\n</think>\n", call_a, "\x03" };
+    const reply = try serve(&r, "", &rounds, .stop);
+    defer std.testing.allocator.free(reply.body);
+    const doc = (try json.parse(a, reply.body)).ok;
+    const message = doc.get("choices").?.array[0].get("message").?;
+    const id = message.get("tool_calls").?.array[0].strField("id").?;
+    // the agent sends the step back without its reasoning
+    const next = try std.fmt.allocPrint(a,
+        \\{{"max_tokens":4,{s},"messages":[{{"role":"user","content":"go"}},{{"role":"assistant","content":"","tool_calls":[{{"id":"{s}","type":"function","function":{{"name":"read_file","arguments":"{{\"path\":\"/tmp/a\",\"limit\":20}}"}}}}]}},{{"role":"tool","tool_call_id":"{s}","content":"file text"}}]}}
+    , .{ tools, id, id });
+    r.backend.rounds = &.{"done"};
+    const second = try r.chat(next);
+    defer std.testing.allocator.free(second.body);
+    const prompt = try r.promptText();
+    defer std.testing.allocator.free(prompt);
+    try std.testing.expect(std.mem.indexOf(u8, prompt, "<|assistant|><think>Let me read the file first.\n</think>") != null);
+}
+
+fn contentEvents(a: std.mem.Allocator, body: []const u8) !usize {
+    var n: usize = 0;
+    for (try events(a, body)) |e| {
+        const choices = e.get("choices") orelse continue;
+        if (choices.array.len == 0) continue;
+        if (delta(e).strField("content") != null) n += 1;
+    }
+    return n;
+}
+
+test "smooth streaming sends a round's tokens one event each, the text and its end unchanged (0061)" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const rounds = [_][]const u8{ "hello wo", "rld\x03" };
+    {
+        var r: rig.Rig = .{};
+        try r.start(.{}, rig.default_config);
+        defer r.finish();
+        const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .stop);
+        defer std.testing.allocator.free(reply.body);
+        try std.testing.expectEqual(@as(usize, 2), try contentEvents(a, reply.body)); // a round, an event
+    }
+    {
+        var r: rig.Rig = .{};
+        try r.start(.{ .stream_smooth = true, .stream_smooth_ms = 40 }, rig.default_config);
+        defer r.finish();
+        const reply = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &rounds, .stop);
+        defer std.testing.allocator.free(reply.body);
+        const f = try fold(a, reply.body);
+        try std.testing.expectEqualStrings("hello world", f.content);
+        // a token, an event (the space waits for the character after it)
+        try std.testing.expect(try contentEvents(a, reply.body) >= 10);
+        try std.testing.expectEqualStrings("stop", f.finish);
+        try std.testing.expect(f.role_first);
+        // a tool call keeps its place after the text before it
+        const calls = [_][]const u8{ "Reading.\n", call_a, "\x03" };
+        const with_call = try serve(&r, ",\"stream\":true,\"reasoning_effort\":\"none\"", &calls, .stop);
+        defer std.testing.allocator.free(with_call.body);
+        const g = try fold(a, with_call.body);
+        try std.testing.expectEqualStrings("Reading.", g.content);
+        try std.testing.expectEqual(@as(usize, 1), g.count);
+        try std.testing.expectEqualStrings("tool_calls", g.finish);
+    }
+}
diff --git a/zig/src/server/glm_calls_test.zig b/zig/src/server/glm_calls_test.zig
