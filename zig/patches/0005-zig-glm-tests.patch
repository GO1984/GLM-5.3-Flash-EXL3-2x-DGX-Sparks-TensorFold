+//! JPEG decoder bit-exact with libjpeg-turbo's defaults as Pillow 12.3 uses them: ISLOW integer IDCT ("jidctint"),
+//! fancy (triangle) chroma upsampling for h2v1 / h2v2 / h1v2 and replication otherwise, the table-driven YCC->RGB
+//! conversion, YCCK/CMYK (Adobe inverted samples), baseline / extended sequential / progressive Huffman, restart
+//! intervals. Not supported (refused): arithmetic coding, lossless, 12-bit, DNL.
+const std = @import("std");
+const raster = @import("raster.zig");
+const Allocator = std.mem.Allocator;
+
+pub const Error = error{Invalid} || Allocator.Error;
+
+const zigzag = [64]u8{
+    0,  1,  8,  16, 9,  2,  3,  10,
+    17, 24, 32, 25, 18, 11, 4,  5,
+    12, 19, 26, 33, 40, 48, 41, 34,
+    27, 20, 13, 6,  7,  14, 21, 28,
+    35, 42, 49, 56, 57, 50, 43, 36,
+    29, 22, 15, 23, 30, 37, 44, 51,
+    58, 59, 52, 45, 38, 31, 39, 46,
+    53, 60, 61, 54, 47, 55, 62, 63,
+};
+
+const Component = struct {
+    id: u8,
+    h: u8,
+    v: u8,
+    tq: u8,
+    // geometry (after SOF)
+    blocks_w: usize = 0, // allocated blocks per row (padded to the MCU grid)
+    blocks_h: usize = 0,
+    width_in_blocks: usize = 0, // real blocks (for non-interleaved scans)
+    height_in_blocks: usize = 0,
+    ds_w: usize = 0, // downsampled width/height in samples
+    ds_h: usize = 0,
+    coefs: []i16 = &.{},
+};
+
+const HuffTable = struct {
+    present: bool = false,
+    nsym: usize = 0,
+    // canonical decoding
+    maxcode: [18]i32 = undefined,
+    valptr: [17]i32 = undefined,
+    mincode: [17]i32 = undefined,
+    values: [256]u8 = undefined,
+    lookup: [512]u16 = undefined, // 9-bit lookahead: (len << 8) | symbol, 0 = needs the long path
+
+    fn build(t: *HuffTable, counts: *const [16]u8, vals: []const u8) bool {
+        var total: usize = 0;
+        for (counts) |c| total += c;
+        if (total > 256 or vals.len < total) return false;
+        @memcpy(t.values[0..total], vals[0..total]);
+        t.nsym = total;
+        var code: i32 = 0;
+        var k: i32 = 0;
+        @memset(&t.lookup, 0);
+        for (1..17) |l| {
+            const n: i32 = counts[l - 1];
+            t.valptr[l] = k;
+            t.mincode[l] = code;
+            if (n != 0) {
+                if (code + n > (@as(i32, 1) << @intCast(l))) return false;
+                if (l <= 9) {
+                    var i: i32 = 0;
+                    while (i < n) : (i += 1) {
+                        const c = code + i;
+                        const base: usize = @intCast(c << @intCast(9 - l));
+                        const cnt: usize = @as(usize, 1) << @intCast(9 - l);
+                        for (0..cnt) |j| t.lookup[base + j] = @intCast((@as(u32, @intCast(l)) << 8) | t.values[@intCast(k + i)]);
+                    }
+                }
+                k += n;
+                code += n;
+                t.maxcode[l] = code - 1;
+            } else t.maxcode[l] = -1;
+            code <<= 1;
+        }
+        t.maxcode[17] = 0x7fffffff;
+        t.present = true;
+        return true;
+    }
+};
+
+const BitReader = struct {
+    data: []const u8,
+    pos: usize,
+    bits: u32 = 0,
+    count: u6 = 0, // bits in `bits` (real ones first, then `fake` zero padding)
+    fake: u6 = 0, // zero bits supplied after a marker
+    marker: ?u8 = null, // a marker found inside the entropy-coded data (its FF is at `pos`)
+    eof: bool = false, // the file ended inside entropy-coded data (libjpeg would suspend: Pillow calls it truncated)
+    insufficient: bool = false, // zero bits were consumed (libjpeg's insufficient_data): the rest of the segment is skipped
+
+    fn fill(r: *BitReader) void {
+        while (r.count <= 24) {
+            var b: u32 = 0;
+            var padded = false;
+            if (r.marker == null and !r.eof) {
+                if (r.pos >= r.data.len) {
+                    r.eof = true;
+                    padded = true;
+                } else {
+                    const c = r.data[r.pos];
+                    if (c == 0xff) {
+                        var p = r.pos + 1;
+                        while (p < r.data.len and r.data[p] == 0xff) p += 1;
+                        if (p >= r.data.len) {
+                            r.eof = true;
+                            r.pos = r.data.len;
+                            padded = true;
+                        } else if (r.data[p] == 0) {
+                            b = 0xff;
+                            r.pos = p + 1;
+                        } else {
+                            r.marker = r.data[p];
+                            r.pos = p - 1; // at the FF of the marker
+                            padded = true;
+                        }
+                    } else {
+                        b = c;
+                        r.pos += 1;
+                    }
+                }
+            } else padded = true;
+            r.bits |= b << @intCast(24 - @as(u32, r.count));
+            r.count += 8;
+            if (padded) r.fake += 8;
+        }
+    }
+
+    inline fn peek(r: *BitReader, n: u5) u32 {
+        if (r.count < n) r.fill();
+        return r.bits >> @intCast(32 - @as(u32, n));
+    }
+    inline fn skip(r: *BitReader, n: u5) void {
+        r.bits <<= @intCast(n);
+        r.count -= @as(u6, n);
+        if (r.count < r.fake) {
+            r.insufficient = true;
+            r.fake = r.count;
+        }
+    }
+    inline fn get(r: *BitReader, n: u5) u32 {
+        if (n == 0) return 0;
+        const v = r.peek(n);
+        r.skip(n);
+        return v;
+    }
+    fn reset(r: *BitReader) void {
+        r.bits = 0;
+        r.count = 0;
+        r.fake = 0;
+    }
+
+    /// jpeg_huff_decode: a code that matches nothing yields symbol 0 after 17 bits (libjpeg warns and goes on).
+    fn decode(r: *BitReader, t: *const HuffTable) Error!u8 {
+        if (r.count < 25) r.fill();
+        const look = t.lookup[r.bits >> 23];
+        if (look != 0) {
+            r.skip(@intCast(look >> 8));
+            return @intCast(look & 0xff);
+        }
+        var l: u5 = 10;
+        while (l <= 16) : (l += 1) {
+            const code: i32 = @intCast(r.bits >> @intCast(32 - @as(u32, l)));
+            if (t.maxcode[l] >= 0 and code <= t.maxcode[l]) {
+                r.skip(l);
+                const idx = t.valptr[l] + code - t.mincode[l];
+                return t.values[@as(usize, @intCast(idx)) & 0xff];
+            }
+        }
+        r.skip(17);
+        return 0;
+    }
+};
+
+inline fn extend(v: u32, s: u5) i32 {
+    if (s == 0) return 0;
+    const vt: i32 = @as(i32, 1) << @intCast(s - 1);
+    const vi: i32 = @intCast(v);
+    return if (vi < vt) vi - (@as(i32, 1) << @intCast(s)) + 1 else vi;
+}
+
+const Frame = struct {
+    w: usize,
+    h: usize,
+    progressive: bool,
+    comps: [4]Component,
+    n: usize,
+    hmax: u8,
+    vmax: u8,
+    mcus_x: usize,
+    mcus_y: usize,
+};
+
+const Info = struct {
+    jfif: bool = false,
+    adobe: bool = false,
+    adobe_transform: u8 = 0,
+    exif: ?[]const u8 = null,
+    xmp: ?[]const u8 = null,
+};
+
+/// (width, height) from the first SOF; null if the markers up to it are malformed.
+pub fn header(data: []const u8) ?struct { w: u32, h: u32 } {
+    if (data.len < 4 or data[0] != 0xff or data[1] != 0xd8) return null;
+    var p: usize = 2;
+    while (p + 4 <= data.len) {
+        if (data[p] != 0xff) {
+            p += 1;
+            continue;
+        }
+        const m = data[p + 1];
+        if (m == 0xff) {
+            p += 1;
+            continue;
+        }
+        if (m == 0 or m == 0x01 or (m >= 0xd0 and m <= 0xd8)) {
+            p += 2;
+            continue;
+        }
+        if (m == 0xd9 or m == 0xda) return null;
+        const len = std.mem.readInt(u16, data[p + 2 ..][0..2], .big);
+        if (len < 2 or p + 2 + len > data.len) return null;
+        if (m >= 0xc0 and m <= 0xcf and m != 0xc4 and m != 0xc8 and m != 0xcc) {
+            if (len < 8) return null;
+            const body = data[p + 4 ..];
+            const h = std.mem.readInt(u16, body[1..3], .big);
+            const w = std.mem.readInt(u16, body[3..5], .big);
+            if (body[0] != 8 or w == 0 or h == 0) return null;
+            if (body[5] != 1 and body[5] != 3 and body[5] != 4) return null;
+            return .{ .w = w, .h = h };
+        }
+        p += 2 + len;
+    }
+    return null;
+}
+
+// ---- IDCT (jidctint.c, jpeg_idct_islow) ---------------------------------------------------------------------
+const CONST_BITS = 13;
+const PASS1_BITS = 2;
+const F_0_298631336: i32 = 2446;
+const F_0_390180644: i32 = 3196;
+const F_0_541196100: i32 = 4433;
+const F_0_765366865: i32 = 6270;
+const F_0_899976223: i32 = 7373;
+const F_1_175875602: i32 = 9633;
+const F_1_501321110: i32 = 12299;
+const F_1_847759065: i32 = 15137;
+const F_1_961570560: i32 = 16069;
+const F_2_053119869: i32 = 16819;
+const F_2_562915447: i32 = 20995;
+const F_3_072711026: i32 = 25172;
+
+inline fn descale(x: i32, comptime n: u5) i32 {
+    return (x +% (@as(i32, 1) << (n - 1))) >> n;
+}
+
+inline fn rangeLimit(x: i32) u8 {
+    const t = x & 1023;
+    const s = if (t < 512) t else t - 1024;
+    return @intCast(std.math.clamp(s + 128, 0, 255));
+}
+
+fn idctIslow(coef: *const [64]i16, quant: *const [64]u16, out: []u8, stride: usize) void {
+    var ws: [64]i32 = undefined;
+    for (0..8) |c| {
+        const q = quant;
+        var all_zero = true;
+        for (1..8) |r| if (coef[r * 8 + c] != 0) {
+            all_zero = false;
+            break;
+        };
+        if (all_zero) {
+            const dc: i32 = (@as(i32, coef[c]) *% @as(i32, q[c])) << PASS1_BITS;
+            for (0..8) |r| ws[r * 8 + c] = dc;
+            continue;
+        }
+        var z2: i32 = @as(i32, coef[2 * 8 + c]) *% q[2 * 8 + c];
+        var z3: i32 = @as(i32, coef[6 * 8 + c]) *% q[6 * 8 + c];
+        var z1 = (z2 +% z3) *% F_0_541196100;
+        var tmp2 = z1 +% z3 *% -F_1_847759065;
+        var tmp3 = z1 +% z2 *% F_0_765366865;
+        z2 = @as(i32, coef[c]) *% q[c];
+        z3 = @as(i32, coef[4 * 8 + c]) *% q[4 * 8 + c];
+        var tmp0 = (z2 +% z3) << CONST_BITS;
+        var tmp1 = (z2 -% z3) << CONST_BITS;
+        const tmp10 = tmp0 +% tmp3;
+        const tmp13 = tmp0 -% tmp3;
+        const tmp11 = tmp1 +% tmp2;
+        const tmp12 = tmp1 -% tmp2;
+        tmp0 = @as(i32, coef[7 * 8 + c]) *% q[7 * 8 + c];
+        tmp1 = @as(i32, coef[5 * 8 + c]) *% q[5 * 8 + c];
+        tmp2 = @as(i32, coef[3 * 8 + c]) *% q[3 * 8 + c];
+        tmp3 = @as(i32, coef[1 * 8 + c]) *% q[1 * 8 + c];
+        z1 = tmp0 +% tmp3;
+        z2 = tmp1 +% tmp2;
+        z3 = tmp0 +% tmp2;
+        var z4 = tmp1 +% tmp3;
+        const z5 = (z3 +% z4) *% F_1_175875602;
+        tmp0 = tmp0 *% F_0_298631336;
+        tmp1 = tmp1 *% F_2_053119869;
+        tmp2 = tmp2 *% F_3_072711026;
+        tmp3 = tmp3 *% F_1_501321110;
+        z1 = z1 *% -F_0_899976223;
+        z2 = z2 *% -F_2_562915447;
+        z3 = z3 *% -F_1_961570560;
+        z4 = z4 *% -F_0_390180644;
+        z3 +%= z5;
+        z4 +%= z5;
+        tmp0 +%= z1 +% z3;
+        tmp1 +%= z2 +% z4;
+        tmp2 +%= z2 +% z3;
+        tmp3 +%= z1 +% z4;
+        ws[0 * 8 + c] = descale(tmp10 +% tmp3, CONST_BITS - PASS1_BITS);
+        ws[7 * 8 + c] = descale(tmp10 -% tmp3, CONST_BITS - PASS1_BITS);
+        ws[1 * 8 + c] = descale(tmp11 +% tmp2, CONST_BITS - PASS1_BITS);
+        ws[6 * 8 + c] = descale(tmp11 -% tmp2, CONST_BITS - PASS1_BITS);
+        ws[2 * 8 + c] = descale(tmp12 +% tmp1, CONST_BITS - PASS1_BITS);
+        ws[5 * 8 + c] = descale(tmp12 -% tmp1, CONST_BITS - PASS1_BITS);
+        ws[3 * 8 + c] = descale(tmp13 +% tmp0, CONST_BITS - PASS1_BITS);
+        ws[4 * 8 + c] = descale(tmp13 -% tmp0, CONST_BITS - PASS1_BITS);
+    }
+    for (0..8) |r| {
+        const w = ws[r * 8 ..][0..8];
+        const o = out[r * stride ..][0..8];
+        var z2: i32 = w[2];
+        var z3: i32 = w[6];
+        var z1 = (z2 +% z3) *% F_0_541196100;
+        var tmp2 = z1 +% z3 *% -F_1_847759065;
+        var tmp3 = z1 +% z2 *% F_0_765366865;
+        var tmp0 = (@as(i32, w[0]) +% w[4]) << CONST_BITS;
+        var tmp1 = (@as(i32, w[0]) -% w[4]) << CONST_BITS;
+        const tmp10 = tmp0 +% tmp3;
+        const tmp13 = tmp0 -% tmp3;
+        const tmp11 = tmp1 +% tmp2;
+        const tmp12 = tmp1 -% tmp2;
+        tmp0 = w[7];
+        tmp1 = w[5];
+        tmp2 = w[3];
+        tmp3 = w[1];
+        z1 = tmp0 +% tmp3;
+        z2 = tmp1 +% tmp2;
+        z3 = tmp0 +% tmp2;
+        var z4 = tmp1 +% tmp3;
+        const z5 = (z3 +% z4) *% F_1_175875602;
+        tmp0 = tmp0 *% F_0_298631336;
+        tmp1 = tmp1 *% F_2_053119869;
+        tmp2 = tmp2 *% F_3_072711026;
+        tmp3 = tmp3 *% F_1_501321110;
+        z1 = z1 *% -F_0_899976223;
+        z2 = z2 *% -F_2_562915447;
+        z3 = z3 *% -F_1_961570560;
+        z4 = z4 *% -F_0_390180644;
+        z3 +%= z5;
+        z4 +%= z5;
+        tmp0 +%= z1 +% z3;
+        tmp1 +%= z2 +% z4;
+        tmp2 +%= z2 +% z3;
+        tmp3 +%= z1 +% z4;
+        o[0] = rangeLimit(descale(tmp10 +% tmp3, CONST_BITS + PASS1_BITS + 3));
+        o[7] = rangeLimit(descale(tmp10 -% tmp3, CONST_BITS + PASS1_BITS + 3));
+        o[1] = rangeLimit(descale(tmp11 +% tmp2, CONST_BITS + PASS1_BITS + 3));
+        o[6] = rangeLimit(descale(tmp11 -% tmp2, CONST_BITS + PASS1_BITS + 3));
+        o[2] = rangeLimit(descale(tmp12 +% tmp1, CONST_BITS + PASS1_BITS + 3));
+        o[5] = rangeLimit(descale(tmp12 -% tmp1, CONST_BITS + PASS1_BITS + 3));
+        o[3] = rangeLimit(descale(tmp13 +% tmp0, CONST_BITS + PASS1_BITS + 3));
+        o[4] = rangeLimit(descale(tmp13 -% tmp0, CONST_BITS + PASS1_BITS + 3));
+    }
+}
+
+// ---- colour conversion tables (jdcolor.c) -----------------------------------------------------------------------
+const ColorTables = struct {
+    cr_r: [256]i32,
+    cb_b: [256]i32,
+    cr_g: [256]i32,
+    cb_g: [256]i32,
+};
+
+fn fix(x: f64) i32 {
+    return @intFromFloat(x * 65536.0 + 0.5);
+}
+
+fn colorTables() ColorTables {
+    var t: ColorTables = undefined;
+    for (0..256) |i| {
+        const x: i32 = @as(i32, @intCast(i)) - 128;
+        t.cr_r[i] = (fix(1.40200) * x + 32768) >> 16;
+        t.cb_b[i] = (fix(1.77200) * x + 32768) >> 16;
+        t.cr_g[i] = -fix(0.71414) * x;
+        t.cb_g[i] = -fix(0.34414) * x + 32768;
+    }
+    return t;
+}
+
+inline fn clamp8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+// ---- decoder ------------------------------------------------------------------------------------------------------
+const Decoder = struct {
+    allocator: Allocator,
+    data: []const u8,
+    quant: [4][64]u16 = undefined, // natural order
+    quant_set: [4]bool = .{ false, false, false, false },
+    dc: [4]HuffTable = .{ .{}, .{}, .{}, .{} },
+    ac: [4]HuffTable = .{ .{}, .{}, .{}, .{} },
+    frame: ?Frame = null,
+    restart: usize = 0,
+    info: Info = .{},
+    scans: usize = 0,
+    eob_run: u32 = 0,
+
+    fn deinit(d: *Decoder) void {
+        if (d.frame) |*f| for (f.comps[0..f.n]) |c| if (c.coefs.len != 0) d.allocator.free(c.coefs);
+    }
+
+    fn u16at(d: *Decoder, p: usize) Error!u16 {
+        if (p + 2 > d.data.len) return error.Invalid;
+        return std.mem.readInt(u16, d.data[p..][0..2], .big);
+    }
+
+    fn parseSof(d: *Decoder, seg: []const u8, progressive: bool) Error!void {
+        if (d.frame != null) return error.Invalid;
+        if (seg.len < 6) return error.Invalid;
+        if (seg[0] != 8) return error.Invalid;
+        const h = std.mem.readInt(u16, seg[1..3], .big);
+        const w = std.mem.readInt(u16, seg[3..5], .big);
+        const n = seg[5];
+        if (w == 0 or h == 0 or (n != 1 and n != 3 and n != 4) or seg.len < 6 + 3 * @as(usize, n)) return error.Invalid;
+        var f: Frame = undefined;
+        f.w = w;
+        f.h = h;
+        f.progressive = progressive;
+        f.n = n;
+        f.hmax = 1;
+        f.vmax = 1;
+        for (0..n) |i| {
+            const b = seg[6 + 3 * i ..][0..3];
+            const hs = b[1] >> 4;
+            const vs = b[1] & 15;
+            if (hs == 0 or hs > 4 or vs == 0 or vs > 4 or b[2] > 3) return error.Invalid;
+            f.comps[i] = .{ .id = b[0], .h = hs, .v = vs, .tq = b[2] };
+            f.hmax = @max(f.hmax, hs);
+            f.vmax = @max(f.vmax, vs);
+        }
+        f.mcus_x = (w + 8 * @as(usize, f.hmax) - 1) / (8 * @as(usize, f.hmax));
+        f.mcus_y = (h + 8 * @as(usize, f.vmax) - 1) / (8 * @as(usize, f.vmax));
+        for (f.comps[0..n]) |*c| {
+            c.blocks_w = f.mcus_x * c.h;
+            c.blocks_h = f.mcus_y * c.v;
+            c.ds_w = (@as(usize, w) * c.h + f.hmax - 1) / f.hmax;
+            c.ds_h = (@as(usize, h) * c.v + f.vmax - 1) / f.vmax;
+            c.width_in_blocks = (c.ds_w + 7) / 8;
+            c.height_in_blocks = (c.ds_h + 7) / 8;
+            const total = c.blocks_w * c.blocks_h * 64;
+            c.coefs = try d.allocator.alloc(i16, total);
+            @memset(c.coefs, 0);
+        }
+        d.frame = f;
+    }
+
+    fn parseDht(d: *Decoder, seg: []const u8) Error!void {
+        var p: usize = 0;
+        while (p < seg.len) {
+            if (p + 17 > seg.len) return error.Invalid;
+            const tc = seg[p] >> 4;
+            const th = seg[p] & 15;
+            if (tc > 1 or th > 3) return error.Invalid;
+            const counts: *const [16]u8 = seg[p + 1 ..][0..16];
+            var total: usize = 0;
+            for (counts) |c| total += c;
+            if (p + 17 + total > seg.len) return error.Invalid;
+            const t = if (tc == 0) &d.dc[th] else &d.ac[th];
+            if (!t.build(counts, seg[p + 17 .. p + 17 + total])) return error.Invalid;
+            p += 17 + total;
+        }
+    }
+
+    fn parseDqt(d: *Decoder, seg: []const u8) Error!void {
+        var p: usize = 0;
+        while (p < seg.len) {
+            const pq = seg[p] >> 4;
+            const tq = seg[p] & 15;
+            if (tq > 3 or pq > 1) return error.Invalid;
+            p += 1;
+            const need: usize = if (pq == 0) 64 else 128;
+            if (p + need > seg.len) return error.Invalid;
+            for (0..64) |i| {
+                const v: u16 = if (pq == 0) seg[p + i] else std.mem.readInt(u16, seg[p + 2 * i ..][0..2], .big);
+                d.quant[tq][zigzag[i]] = v;
+            }
+            d.quant_set[tq] = true;
+            p += need;
+        }
+    }
+
+    fn app(d: *Decoder, marker: u8, seg: []const u8) void {
+        if (marker == 0xe0 and seg.len >= 5 and std.mem.eql(u8, seg[0..5], "JFIF\x00")) d.info.jfif = true;
+        if (marker == 0xee and seg.len >= 12 and std.mem.eql(u8, seg[0..5], "Adobe")) {
+            d.info.adobe = true;
+            d.info.adobe_transform = seg[11];
+        }
+        if (marker == 0xe1) {
+            if (seg.len >= 5 and std.mem.eql(u8, seg[0..5], "Exif\x00")) {
+                if (d.info.exif == null) d.info.exif = seg;
+            } else if (seg.len >= 29 and std.mem.eql(u8, seg[0..29], "http://ns.adobe.com/xap/1.0/\x00")) {
+                if (d.info.xmp == null) d.info.xmp = seg[29..];
+            }
+        }
+    }
+
+    /// next_marker: scan forward for FF xx (xx not 0 or FF). Returns the position of the FF and xx.
+    fn nextMarker(d: *Decoder, from: usize) ?struct { at: usize, m: u8 } {
+        var p = from;
+        while (p + 1 < d.data.len) {
+            if (d.data[p] == 0xff) {
+                var q = p + 1;
+                while (q < d.data.len and d.data[q] == 0xff) q += 1;
+                if (q >= d.data.len) return null;
+                if (d.data[q] != 0) return .{ .at = q - 1, .m = d.data[q] };
+                p = q + 1;
+            } else p += 1;
+        }
+        return null;
+    }
+
+    /// process_restart + read_restart_marker + jpeg_resync_to_restart
+    fn processRestart(d: *Decoder, r: *BitReader, next_rst: *u8, pred: *[4]i32) Error!void {
+        r.reset();
+        if (r.marker == null) {
+            if (r.eof) return error.Invalid;
+            const nm = d.nextMarker(r.pos) orelse return error.Invalid;
+            r.marker = nm.m;
+            r.pos = nm.at;
+        }
+        const desired: u8 = next_rst.*;
+        while (true) {
+            const m = r.marker.?;
+            if (m == 0xd0 + desired) {
+                r.pos += 2;
+                r.marker = null;
+                break;
+            }
+            var action: u8 = 1;
+            if (m < 0xc0) {
+                action = 2;
+            } else if (m < 0xd0 or m > 0xd7) {
+                action = 3;
+            } else {
+                const k: u8 = m - 0xd0;
+                if (k == ((desired + 1) & 7) or k == ((desired + 2) & 7)) {
+                    action = 3;
+                } else if (k == ((desired -% 1) & 7) or k == ((desired -% 2) & 7)) {
+                    action = 2;
+                } else action = 1;
+            }
+            switch (action) {
+                1 => {
+                    r.pos += 2;
+                    r.marker = null;
+                },
+                2 => {
+                    const nm = d.nextMarker(r.pos + 2) orelse {
+                        r.eof = true;
+                        return error.Invalid;
+                    };
+                    r.marker = nm.m;
+                    r.pos = nm.at;
+                    continue;
+                },
+                else => {},
+            }
+            break;
+        }
+        next_rst.* = (desired + 1) & 7;
+        pred.* = @splat(0);
+        d.eob_run = 0;
+        if (r.marker == null) r.insufficient = false;
+    }
+
+    fn decodeScan(d: *Decoder, hdr: []const u8, start: usize) Error!usize {
+        const f = &(d.frame orelse return error.Invalid);
+        if (hdr.len < 1) return error.Invalid;
+        const ns = hdr[0];
+        if (ns < 1 or ns > 4 or hdr.len < 1 + 2 * @as(usize, ns) + 3) return error.Invalid;
+        var scan_comps: [4]usize = undefined;
+        var dc_sel: [4]u8 = undefined;
+        var ac_sel: [4]u8 = undefined;
+        for (0..ns) |i| {
+            const cid = hdr[1 + 2 * i];
+            const sel = hdr[2 + 2 * i];
+            var found: ?usize = null;
+            for (f.comps[0..f.n], 0..) |c, k| if (c.id == cid) {
+                found = k;
+                break;
+            };
+            scan_comps[i] = found orelse return error.Invalid;
+            dc_sel[i] = sel >> 4;
+            ac_sel[i] = sel & 15;
+            if (dc_sel[i] > 3 or ac_sel[i] > 3) return error.Invalid;
+        }
+        const ss = hdr[1 + 2 * @as(usize, ns)];
+        const se = hdr[2 + 2 * @as(usize, ns)];
+        const ahl = hdr[3 + 2 * @as(usize, ns)];
+        const ah: u5 = @intCast(ahl >> 4);
+        const al: u5 = @intCast(ahl & 15);
+        const prog_dc = f.progressive and ss == 0;
+        if (f.progressive) {
+            const bad_band = if (prog_dc) se != 0 else (se < ss or se >= 64 or ns != 1);
+            if (bad_band or (ah != 0 and al != ah -% 1) or al > 13) return error.Invalid;
+        }
+        // tables the scan needs must exist; DC tables only hold symbols 0..15
+        for (0..ns) |i| {
+            const need_dc = !f.progressive or (prog_dc and ah == 0);
+            const need_ac = !f.progressive or !prog_dc;
+            if (need_dc) {
+                const t = &d.dc[dc_sel[i]];
+                if (!t.present) return error.Invalid;
+                for (t.values[0..t.nsym]) |v| if (v > 15) return error.Invalid;
+            }
+            if (need_ac and !d.ac[ac_sel[i]].present) return error.Invalid;
+        }
+        var r: BitReader = .{ .data = d.data, .pos = start };
+        var pred: [4]i32 = @splat(0);
+        d.eob_run = 0;
+        var restarts_left: usize = d.restart;
+        var next_rst: u8 = 0;
+
+        const interleaved = ns > 1;
+        if (interleaved) { // libjpeg: D_MAX_BLOCKS_IN_MCU
+            var blocks: usize = 0;
+            for (0..ns) |si| blocks += @as(usize, f.comps[scan_comps[si]].h) * f.comps[scan_comps[si]].v;
+            if (blocks > 10) return error.Invalid;
+        }
+        var mcus_across: usize = undefined;
+        var mcus_down: usize = undefined;
+        if (interleaved) {
+            mcus_across = f.mcus_x;
+            mcus_down = f.mcus_y;
+        } else {
+            const c = f.comps[scan_comps[0]];
+            mcus_across = c.width_in_blocks;
+            mcus_down = c.height_in_blocks;
+        }
+        var my: usize = 0;
+        while (my < mcus_down) : (my += 1) {
+            var mx: usize = 0;
+            while (mx < mcus_across) : (mx += 1) {
+                if (d.restart != 0) {
+                    if (restarts_left == 0) {
+                        try d.processRestart(&r, &next_rst, &pred);
+                        restarts_left = d.restart;
+                    }
+                    restarts_left -= 1;
+                }
+                if (r.eof) return error.Invalid;
+                if (r.insufficient) continue; // out of data: this MCU stays as it is (zeros)
+                for (0..ns) |si| {
+                    const ci = scan_comps[si];
+                    const c = &f.comps[ci];
+                    const blocks_h: usize = if (interleaved) c.v else 1;
+                    const blocks_w: usize = if (interleaved) c.h else 1;
+                    for (0..blocks_h) |by| for (0..blocks_w) |bx| {
+                        const row = if (interleaved) my * c.v + by else my;
+                        const col = if (interleaved) mx * c.h + bx else mx;
+                        const block = c.coefs[(row * c.blocks_w + col) * 64 ..][0..64];
+                        if (!f.progressive) {
+                            try decodeBlockSeq(&r, block, &d.dc[dc_sel[si]], &d.ac[ac_sel[si]], &pred[si]);
+                        } else if (prog_dc) {
+                            if (ah == 0) {
+                                const s = try r.decode(&d.dc[dc_sel[si]]);
+                                const diff = if (s != 0) extend(r.get(@intCast(s)), @intCast(s)) else 0;
+                                pred[si] +%= diff;
+                                block[0] = @truncate(pred[si] << al);
+                            } else {
+                                if (r.get(1) != 0) block[0] |= @as(i16, 1) << @intCast(al);
+                            }
+                        } else if (ah == 0) {
+                            try decodeAcFirst(d, &r, block, &d.ac[ac_sel[si]], ss, se, al);
+                        } else {
+                            try decodeAcRefine(d, &r, block, &d.ac[ac_sel[si]], ss, se, al);
+                        }
+                    };
+                }
+            }
+        }
+        if (r.eof) return error.Invalid;
+        // the scan ends at the next marker (a pending one, or the first after the consumed bytes)
+        if (r.marker != null) return r.pos;
+        const nm = d.nextMarker(r.pos) orelse return error.Invalid;
+        return nm.at;
+    }
+
+    fn decodeBlockSeq(r: *BitReader, block: *[64]i16, dc: *const HuffTable, ac: *const HuffTable, pred: *i32) Error!void {
+        if (!dc.present or !ac.present) return error.Invalid;
+        const s = try r.decode(dc);
+        if (s > 16) return error.Invalid;
+        const diff = if (s != 0) extend(r.get(@intCast(s)), @intCast(s)) else 0;
+        pred.* +%= diff;
+        block[0] = @truncate(pred.*);
+        var k: usize = 1;
+        while (k < 64) : (k += 1) {
+            const rs = try r.decode(ac);
+            const rr = rs >> 4;
+            const ss: u5 = @intCast(rs & 15);
+            if (ss != 0) {
+                k += rr;
+                const v = extend(r.get(ss), ss);
+                block[zigzag[@min(k, 63)]] = @truncate(v);
+            } else {
+                if (rr != 15) break;
+                k += 15;
+            }
+        }
+    }
+
+    fn decodeAcFirst(d: *Decoder, r: *BitReader, block: *[64]i16, ac: *const HuffTable, ss: u8, se: u8, al: u5) Error!void {
+        if (!ac.present) return error.Invalid;
+        if (d.eob_run > 0) {
+            d.eob_run -= 1;
+            return;
+        }
+        var k: usize = ss;
+        while (k <= se) : (k += 1) {
+            const rs = try r.decode(ac);
+            var rr: u32 = rs >> 4;
+            const s: u5 = @intCast(rs & 15);
+            if (s != 0) {
+                k += rr;
+                const v = extend(r.get(s), s);
+                block[zigzag[@min(k, 63)]] = @truncate(v * (@as(i32, 1) << al));
+            } else {
+                if (rr == 15) {
+                    k += 15;
+                } else {
+                    d.eob_run = @as(u32, 1) << @intCast(rr);
+                    if (rr != 0) {
+                        d.eob_run += r.get(@intCast(rr));
+                        rr = 0;
+                    }
+                    d.eob_run -= 1;
+                    break;
+                }
+            }
+        }
+    }
+
+    fn decodeAcRefine(d: *Decoder, r: *BitReader, block: *[64]i16, ac: *const HuffTable, ss: u8, se: u8, al: u5) Error!void {
+        if (!ac.present) return error.Invalid;
+        const p1: i16 = @as(i16, 1) << @intCast(al);
+        const m1: i16 = -p1;
+        var k: usize = ss;
+        if (d.eob_run == 0) {
+            while (k <= se) : (k += 1) {
+                const rs = try r.decode(ac);
+                var rr: i32 = rs >> 4;
+                const s0: u32 = rs & 15;
+                var s: i16 = 0;
+                if (s0 != 0) {
+                    s = if (r.get(1) != 0) p1 else m1;
+                } else if (rr != 15) {
+                    d.eob_run = @as(u32, 1) << @intCast(rr);
+                    if (rr != 0) d.eob_run += r.get(@intCast(rr));
+                    break;
+                }
+                while (k <= se) {
+                    const pos = zigzag[k];
+                    if (block[pos] != 0) {
+                        if (r.get(1) != 0) {
+                            if ((block[pos] & p1) == 0) {
+                                if (block[pos] >= 0) block[pos] +%= p1 else block[pos] +%= m1;
+                            }
+                        }
+                    } else {
+                        rr -= 1;
+                        if (rr < 0) break;
+                    }
+                    k += 1;
+                }
+                if (s != 0) {
+                    if (k > 63) return error.Invalid;
+                    block[zigzag[k]] = s;
+                }
+            }
+        }
+        if (d.eob_run > 0) {
+            while (k <= se) : (k += 1) {
+                const pos = zigzag[k];
+                if (block[pos] != 0) {
+                    if (r.get(1) != 0) {
+                        if ((block[pos] & p1) == 0) {
+                            if (block[pos] >= 0) block[pos] +%= p1 else block[pos] +%= m1;
+                        }
+                    }
+                }
+            }
+            d.eob_run -= 1;
+        }
+    }
+};
+
+/// Fancy upsampling (jdsample.c) of component `c`'s plane (samples, stride `stride`) to w_up x h_up.
+inline fn put(o: []u8, i: usize, v: u32) void {
+    if (i < o.len) o[i] = @intCast(v);
+}
+
+fn upsample(a: Allocator, f: *const Frame, c: *const Component, plane: []const u8, stride: usize, out_w: usize, out_h: usize) Allocator.Error![]u8 {
+    const hexp: usize = f.hmax / c.h;
+    const vexp: usize = f.vmax / c.v;
+    const out = try a.alloc(u8, out_w * out_h);
+    errdefer a.free(out);
+    const dw = c.ds_w;
+    const dh = c.ds_h;
+    if (hexp == 1 and vexp == 1) {
+        for (0..out_h) |y| @memcpy(out[y * out_w ..][0..out_w], plane[y * stride ..][0..out_w]);
+        return out;
+    }
+    const fancy_w = dw > 2;
+    if (hexp == 2 and vexp == 1 and fancy_w) {
+        for (0..out_h) |y| {
+            const in = plane[y * stride ..][0..dw];
+            const o = out[y * out_w ..][0..out_w];
+            // out_w may be smaller than 2*dw by one (odd width): only the first out_w samples are kept
+            var tmp: [2]u8 = undefined;
+            _ = &tmp;
+            var x: usize = 0;
+            put(o, 0, in[0]);
+            put(o, 1, (@as(u32, in[0]) * 3 + in[1] + 2) >> 2);
+            x = 1;
+            while (x < dw - 1) : (x += 1) {
+                const v: u32 = @as(u32, in[x]) * 3;
+                put(o, 2 * x, (v + in[x - 1] + 1) >> 2);
+                put(o, 2 * x + 1, (v + in[x + 1] + 2) >> 2);
+            }
+            put(o, 2 * x, (@as(u32, in[x]) * 3 + in[x - 1] + 1) >> 2);
+            put(o, 2 * x + 1, in[x]);
+        }
+        return out;
+    }
+    if (hexp == 2 and vexp == 2 and fancy_w) {
+        for (0..out_h) |y| {
+            const r = y / 2;
+            const v: usize = y % 2;
+            const r0 = @min(r, dh - 1);
+            const r1: usize = if (v == 0) (if (r0 == 0) 0 else r0 - 1) else @min(r0 + 1, dh - 1);
+            const in0 = plane[r0 * stride ..][0..dw];
+            const in1 = plane[r1 * stride ..][0..dw];
+            const o = out[y * out_w ..][0..out_w];
+            var this: u32 = @as(u32, in0[0]) * 3 + in1[0];
+            var next: u32 = @as(u32, in0[1]) * 3 + in1[1];
+            put(o, 0, (this * 4 + 8) >> 4);
+            put(o, 1, (this * 3 + next + 7) >> 4);
+            var last = this;
+            this = next;
+            var x: usize = 1;
+            while (x < dw - 1) : (x += 1) {
+                next = @as(u32, in0[x + 1]) * 3 + in1[x + 1];
+                put(o, 2 * x, (this * 3 + last + 8) >> 4);
+                put(o, 2 * x + 1, (this * 3 + next + 7) >> 4);
+                last = this;
+                this = next;
+            }
+            put(o, 2 * x, (this * 3 + last + 8) >> 4);
+            put(o, 2 * x + 1, (this * 4 + 7) >> 4);
+        }
+        return out;
+    }
+    if (hexp == 1 and vexp == 2) {
+        for (0..out_h) |y| {
+            const r = y / 2;
+            const v: usize = y % 2;
+            const r0 = @min(r, dh - 1);
+            const r1: usize = if (v == 0) (if (r0 == 0) 0 else r0 - 1) else @min(r0 + 1, dh - 1);
+            const bias: u32 = if (v == 0) 1 else 2;
+            for (0..out_w) |x| {
+                const s: u32 = @as(u32, plane[r0 * stride + x]) * 3 + plane[r1 * stride + x];
+                out[y * out_w + x] = @intCast((s + bias) >> 2);
+            }
+        }
+        return out;
+    }
+    // replication (h2v1/h2v2 narrower than 3 samples, h4v1, ...)
+    for (0..out_h) |y| {
+        const r = @min(y / vexp, dh -| 1);
+        for (0..out_w) |x| out[y * out_w + x] = plane[r * stride + @min(x / hexp, dw -| 1)];
+    }
+    return out;
+}
+
+pub fn decode(a: Allocator, data: []const u8) Error!raster.Raster {
+    if (data.len < 4 or data[0] != 0xff or data[1] != 0xd8) return error.Invalid;
+    var d: Decoder = .{ .allocator = a, .data = data };
+    defer d.deinit();
+    var p: usize = 2;
+    var seen_scan = false;
+    while (true) {
+        // find the next marker
+        while (p < data.len and data[p] != 0xff) p += 1;
+        while (p < data.len and data[p] == 0xff) p += 1;
+        if (p >= data.len) return error.Invalid; // no EOI: the file is truncated
+        const m = data[p];
+        p += 1;
+        if (m == 0 or m == 0x01 or (m >= 0xd0 and m <= 0xd8)) continue;
+        if (m == 0xd9) break;
+        const len: usize = try d.u16at(p);
+        if (len < 2 or p + len > data.len) return error.Invalid;
+        const seg = data[p + 2 .. p + len];
+        switch (m) {
+            0xc0, 0xc1 => try d.parseSof(seg, false),
+            0xc2 => try d.parseSof(seg, true),
+            0xc4 => try d.parseDht(seg),
+            0xdb => try d.parseDqt(seg),
+            0xdd => {
+                if (seg.len < 2) return error.Invalid;
+                d.restart = std.mem.readInt(u16, seg[0..2], .big);
+            },
+            0xda => {
+                if (d.scans >= 600) return error.Invalid; // a scan costs a pass over the image: bound hostile scan lists
+                const np = try d.decodeScan(seg, p + len);
+                seen_scan = true;
+                d.scans += 1;
+                p = np;
+                continue;
+            },
+            0xe0...0xef => d.app(m, seg),
+            0xc3, 0xc5...0xc7, 0xc9...0xcb, 0xcd...0xcf => return error.Invalid, // lossless / arithmetic / hierarchical
+            else => {},
+        }
+        p += len;
+    }
+    if (!seen_scan) return error.Invalid;
+    const f = d.frame orelse return error.Invalid;
+    for (f.comps[0..f.n]) |c| if (!d.quant_set[c.tq]) return error.Invalid;
+
+    // IDCT every component into a plane
+    var planes: [4][]u8 = undefined;
+    var strides: [4]usize = undefined;
+    var have: usize = 0;
+    defer for (planes[0..have]) |pl| a.free(pl);
+    for (f.comps[0..f.n], 0..) |*c, ci| {
+        const stride = c.blocks_w * 8;
+        const plane = try a.alloc(u8, stride * c.blocks_h * 8);
+        planes[ci] = plane;
+        strides[ci] = stride;
+        have += 1;
+        const q = &d.quant[c.tq];
+        for (0..c.blocks_h) |by| for (0..c.blocks_w) |bx| {
+            const blk: *const [64]i16 = c.coefs[(by * c.blocks_w + bx) * 64 ..][0..64];
+            idctIslow(blk, q, plane[(by * 8) * stride + bx * 8 ..], stride);
+        };
+    }
+    const w = f.w;
+    const h = f.h;
+    // upsample to full resolution
+    var full: [4][]u8 = undefined;
+    var nfull: usize = 0;
+    defer for (full[0..nfull]) |pl| a.free(pl);
+    for (f.comps[0..f.n], 0..) |*c, ci| {
+        if (f.hmax % c.h != 0 or f.vmax % c.v != 0) return error.Invalid; // fractional sampling ratio
+        full[ci] = try upsample(a, &f, c, planes[ci], strides[ci], w, h);
+        nfull += 1;
+    }
+
+    const mode: raster.Mode = switch (f.n) {
+        1 => .l,
+        3 => .rgb,
+        else => .cmyk,
+    };
+    const out = try a.alloc(u8, w * h * mode.bytes());
+    errdefer a.free(out);
+    const tab = colorTables();
+    switch (f.n) {
+        1 => @memcpy(out, full[0][0 .. w * h]),
+        3 => {
+            const ycc = blk: {
+                if (d.info.jfif) break :blk true;
+                if (d.info.adobe) break :blk d.info.adobe_transform != 0;
+                const ids = .{ f.comps[0].id, f.comps[1].id, f.comps[2].id };
+                if (ids[0] == 1 and ids[1] == 2 and ids[2] == 3) break :blk true;
+                if (ids[0] == 'R' and ids[1] == 'G' and ids[2] == 'B') break :blk false;
+                break :blk true;
+            };
+            for (0..w * h) |i| {
+                const y: i32 = full[0][i];
+                const cb = full[1][i];
+                const cr = full[2][i];
+                if (ycc) {
+                    out[i * 3] = clamp8(y + tab.cr_r[cr]);
+                    out[i * 3 + 1] = clamp8(y + ((tab.cb_g[cb] + tab.cr_g[cr]) >> 16));
+                    out[i * 3 + 2] = clamp8(y + tab.cb_b[cb]);
+                } else {
+                    out[i * 3] = full[0][i];
+                    out[i * 3 + 1] = cb;
+                    out[i * 3 + 2] = cr;
+                }
+            }
+        },
+        else => {
+            const ycck = d.info.adobe and d.info.adobe_transform != 0;
+            for (0..w * h) |i| {
+                const k = full[3][i];
+                var c4: [3]u8 = undefined;
+                if (ycck) {
+                    const y: i32 = full[0][i];
+                    const cb = full[1][i];
+                    const cr = full[2][i];
+                    c4[0] = clamp8(255 - (y + tab.cr_r[cr]));
+                    c4[1] = clamp8(255 - (y + ((tab.cb_g[cb] + tab.cr_g[cr]) >> 16)));
+                    c4[2] = clamp8(255 - (y + tab.cb_b[cb]));
+                } else {
+                    c4 = .{ full[0][i], full[1][i], full[2][i] };
+                }
+                // Pillow reads these as "CMYK;I": every byte inverted
+                out[i * 4] = 255 - c4[0];
+                out[i * 4 + 1] = 255 - c4[1];
+                out[i * 4 + 2] = 255 - c4[2];
+                out[i * 4 + 3] = 255 - k;
+            }
+        },
+    }
+    var r: raster.Raster = .{ .w = @intCast(w), .h = @intCast(h), .mode = mode, .data = out, .allocator = a };
+    errdefer r.deinit();
+    if (d.info.exif) |e| r.exif = try a.dupe(u8, e);
+    if (d.info.xmp) |x| r.xmp = try a.dupe(u8, x);
+    return r;
+}
diff --git a/zig/src/vision/limits.zig b/zig/src/vision/limits.zig
new file mode 100644
index 00000000..c6912bb9
--- /dev/null
+++ b/zig/src/vision/limits.zig
@@ -0,0 +1,189 @@
+//! GlmVisionLimits, ImageLimits, VideoLimits and the picture-cache knobs (glm.py, images.py, videos.py).
+const std = @import("std");
+const errors = @import("errors.zig");
+const Diag = errors.Diag;
+
+/// Environment lookup (the server passes its own; `libcGetenv` reads the process environment).
+pub const Getenv = *const fn (name: []const u8) ?[]const u8;
+
+pub fn libcGetenv(name: []const u8) ?[]const u8 {
+    var buf: [128:0]u8 = undefined;
+    if (name.len >= buf.len) return null;
+    @memcpy(buf[0..name.len], name);
+    buf[name.len] = 0;
+    const p = std.c.getenv(&buf) orelse return null;
+    return std.mem.span(p);
+}
+
+/// glm.py `_env_int`: empty or unset -> default; otherwise decimal digits within [low, high].
+pub fn envInt(getenv: Getenv, name: []const u8, default: i64, low: i64, high: i64, diag: ?*Diag) errors.Error!i64 {
+    const value = getenv(name) orelse return default;
+    if (value.len == 0) return default;
+    const ok = blk: {
+        for (value) |c| if (c < '0' or c > '9') break :blk false;
+        const v = std.fmt.parseInt(i64, value, 10) catch break :blk false;
+        break :blk v >= low and v <= high;
+    };
+    if (!ok) {
+        if (diag) |d| {
+            var lo: [32]u8 = undefined;
+            var hi: [32]u8 = undefined;
+            var a: [1024]u8 = undefined;
+            const repr = pyReprInto(&a, value);
+            d.set("{s}: {s} to {s}, not {s}", .{ name, errors.commas(&lo, @intCast(low)), errors.commas(&hi, @intCast(high)), repr });
+        }
+        return error.Input;
+    }
+    return std.fmt.parseInt(i64, value, 10) catch unreachable;
+}
+
+fn pyReprInto(buf: []u8, s: []const u8) []const u8 {
+    var fba = std.heap.FixedBufferAllocator.init(buf);
+    return errors.pyRepr(fba.allocator(), s) catch s;
+}
+
+pub const GlmVisionLimits = struct {
+    image_tokens: u32 = 2048, // a picture's tokens at most
+    video_tokens: u32 = 16384, // a clip's tokens at most, over all its frame pairs
+    video_frames: u32 = 128, // frames sampled from a clip at most
+    fps: f64 = 2.0,
+    min_tokens: u32 = 16,
+    max_images: u32 = 50,
+    max_videos: u32 = 4,
+    request_image_tokens: u32 = 16384,
+    request_video_tokens: u32 = 32768,
+
+    pub fn fromEnv(getenv: Getenv, diag: ?*Diag) errors.Error!GlmVisionLimits {
+        const d: GlmVisionLimits = .{};
+        return .{
+            .image_tokens = @intCast(try envInt(getenv, "TENSORFOLD_GLM_IMAGE_TOKENS", d.image_tokens, 16, 8000, diag)),
+            .video_tokens = @intCast(try envInt(getenv, "TENSORFOLD_GLM_VIDEO_TOKENS", d.video_tokens, 64, 240000, diag)),
+            .video_frames = @intCast(try envInt(getenv, "TENSORFOLD_GLM_VIDEO_FRAMES", d.video_frames, 2, 2048, diag)),
+            .max_images = @intCast(try envInt(getenv, "TENSORFOLD_GLM_MAX_IMAGES", d.max_images, 1, 256, diag)),
+            .max_videos = @intCast(try envInt(getenv, "TENSORFOLD_GLM_MAX_VIDEOS", d.max_videos, 1, 16, diag)),
+            .request_image_tokens = @intCast(try envInt(getenv, "TENSORFOLD_GLM_REQUEST_IMAGE_TOKENS", d.request_image_tokens, 16, 262144, diag)),
+            .request_video_tokens = @intCast(try envInt(getenv, "TENSORFOLD_GLM_REQUEST_VIDEO_TOKENS", d.request_video_tokens, 64, 1048576, diag)),
+        };
+    }
+
+    /// Each picture's token cap in a request with `pictures` of them.
+    pub fn pictureTokens(l: GlmVisionLimits, pictures: usize) u32 {
+        const share: u32 = @intCast(@min(l.request_image_tokens / @max(1, pictures), std.math.maxInt(u32)));
+        return @max(l.min_tokens, @min(l.image_tokens, share));
+    }
+
+    /// Each clip's token cap in a request with `clips` of them.
+    pub fn clipTokens(l: GlmVisionLimits, clips: usize) u32 {
+        const share: u32 = @intCast(@min(l.request_video_tokens / @max(1, clips), std.math.maxInt(u32)));
+        return @max(64, @min(l.video_tokens, share));
+    }
+};
+
+pub const PictureCacheConfig = struct {
+    enabled: bool = true,
+    mb: u32 = 384,
+    canvases: u32 = 8,
+
+    pub const uncapped: u64 = 8 * 1024 * 1024; // a decode with less room than this was squeezed; not remembered
+
+    pub fn fromEnv(getenv: Getenv, diag: ?*Diag) errors.Error!PictureCacheConfig {
+        var c: PictureCacheConfig = .{};
+        if (getenv("TENSORFOLD_GLM_PICTURE_CACHE")) |raw| {
+            const v = std.mem.trim(u8, raw, " \t\n\r\x0b\x0c");
+            var lower: [16]u8 = undefined;
+            const low = if (v.len <= lower.len) std.ascii.lowerString(&lower, v) else v;
+            c.enabled = !(std.mem.eql(u8, low, "0") or std.mem.eql(u8, low, "off") or std.mem.eql(u8, low, "no") or std.mem.eql(u8, low, "false"));
+        }
+        c.mb = @intCast(try envInt(getenv, "TENSORFOLD_GLM_PICTURE_CACHE_MB", 384, 16, 8192, diag));
+        c.canvases = @intCast(try envInt(getenv, "TENSORFOLD_GLM_PICTURE_CANVASES", 8, 0, 64, diag));
+        return c;
+    }
+};
+
+/// images.py ImageLimits.
+pub const ImageLimits = struct {
+    max_images: u32 = 4,
+    max_encoded_bytes: u64 = 10 * 1024 * 1024,
+    max_total_encoded_bytes: u64 = 20 * 1024 * 1024,
+    max_dimension: u32 = 8192,
+    max_pixels: u64 = 16 * 1024 * 1024,
+    max_total_pixels: u64 = 32 * 1024 * 1024,
+    timeout_seconds: f64 = 10.0,
+    total_timeout_seconds: f64 = 30.0,
+    max_redirects: u32 = 3,
+    max_url_chars: u32 = 4096,
+
+    pub const default: ImageLimits = .{};
+
+    /// GlmVision.image_limits: the shared limits with this frontend's picture count; bytes and pixels scale with it.
+    pub fn forGlm(glm: GlmVisionLimits) ImageLimits {
+        const d: ImageLimits = .default;
+        const n = glm.max_images;
+        var out = d;
+        out.max_images = n;
+        if (n <= d.max_images) return out;
+        out.max_total_encoded_bytes = 64 * 1024 * 1024;
+        out.max_total_pixels = @max(d.max_total_pixels, @as(u64, n) * 8 * 1024 * 1024);
+        out.total_timeout_seconds = @max(d.total_timeout_seconds, 2.0 * @as(f64, @floatFromInt(n)));
+        return out;
+    }
+};
+
+/// videos.py VideoLimits (the shared defaults; GLM's own caps are in GlmVisionLimits).
+pub const VideoLimits = struct {
+    max_videos: u32 = 2,
+    max_encoded_bytes: u64 = 64 * 1024 * 1024,
+    max_total_encoded_bytes: u64 = 96 * 1024 * 1024,
+    max_dimension: u32 = 8192,
+    max_seconds: f64 = 3600.0,
+    timeout_seconds: f64 = 20.0,
+    total_timeout_seconds: f64 = 120.0,
+    max_redirects: u32 = 3,
+    max_url_chars: u32 = 4096,
+
+    pub const default: VideoLimits = .{};
+};
+
+var test_env: ?[]const []const u8 = null; // name, value pairs
+fn testGetenv(name: []const u8) ?[]const u8 {
+    const e = test_env orelse return null;
+    var i: usize = 0;
+    while (i + 1 < e.len) : (i += 2) if (std.mem.eql(u8, e[i], name)) return e[i + 1];
+    return null;
+}
+
+test "defaults, token shares and env validation" {
+    test_env = null;
+    var diag: Diag = .{};
+    const l = try GlmVisionLimits.fromEnv(testGetenv, &diag);
+    try std.testing.expectEqual(@as(u32, 2048), l.image_tokens);
+    try std.testing.expectEqual(@as(u32, 2048), l.pictureTokens(8)); // 16384 / 8
+    try std.testing.expectEqual(@as(u32, 327), l.pictureTokens(50)); // 16384 // 50
+    try std.testing.expectEqual(@as(u32, 16), l.pictureTokens(10000));
+    try std.testing.expectEqual(@as(u32, 16384), l.clipTokens(2));
+    try std.testing.expectEqual(@as(u32, 8192), l.clipTokens(4));
+    const il = ImageLimits.forGlm(l);
+    try std.testing.expectEqual(@as(u64, 64 * 1024 * 1024), il.max_total_encoded_bytes);
+    try std.testing.expectEqual(@as(u64, 400 * 1024 * 1024), il.max_total_pixels);
+    try std.testing.expectEqual(@as(f64, 100.0), il.total_timeout_seconds);
+    const four = ImageLimits.forGlm(.{ .max_images = 3 });
+    try std.testing.expectEqual(@as(u32, 3), four.max_images);
+    try std.testing.expectEqual(@as(u64, 20 * 1024 * 1024), four.max_total_encoded_bytes);
+
+    test_env = &.{ "TENSORFOLD_GLM_IMAGE_TOKENS", "4096", "TENSORFOLD_GLM_VIDEO_FRAMES", "" };
+    const l2 = try GlmVisionLimits.fromEnv(testGetenv, &diag);
+    try std.testing.expectEqual(@as(u32, 4096), l2.image_tokens);
+    try std.testing.expectEqual(@as(u32, 128), l2.video_frames);
+
+    test_env = &.{ "TENSORFOLD_GLM_MAX_IMAGES", "0" };
+    try std.testing.expectError(error.Input, GlmVisionLimits.fromEnv(testGetenv, &diag));
+    try std.testing.expectEqualStrings("TENSORFOLD_GLM_MAX_IMAGES: 1 to 256, not '0'", diag.message());
+    test_env = &.{ "TENSORFOLD_GLM_REQUEST_VIDEO_TOKENS", "x1" };
+    try std.testing.expectError(error.Input, GlmVisionLimits.fromEnv(testGetenv, &diag));
+    try std.testing.expectEqualStrings("TENSORFOLD_GLM_REQUEST_VIDEO_TOKENS: 64 to 1,048,576, not 'x1'", diag.message());
+    test_env = &.{ "TENSORFOLD_GLM_PICTURE_CACHE", " Off ", "TENSORFOLD_GLM_PICTURE_CACHE_MB", "16" };
+    const pc = try PictureCacheConfig.fromEnv(testGetenv, &diag);
+    try std.testing.expect(!pc.enabled);
+    try std.testing.expectEqual(@as(u32, 16), pc.mb);
+    test_env = null;
+}
diff --git a/zig/src/vision/patches.zig b/zig/src/vision/patches.zig
new file mode 100644
index 00000000..18e16962
--- /dev/null
+++ b/zig/src/vision/patches.zig
@@ -0,0 +1,134 @@
+//! Canvas -> patches: `GlmVisionTower.patches` on the CPU, the unit-test oracle for the GPU tower.
+//!
+//! Input: uint8 frames [T, 3, H, W] (T even, H and W multiples of 28), the canvas as `fit` leaves it.
+//! Output: float32 [T/2 * (H/14) * (W/14), 1176], row-major, where
+//!   x = (frames.float() - mean255) / std255     (IEEE fp32 subtract, then fp32 divide; mean255 = float32(MEAN) * 255
+//!                                                and std255 = float32(STD) * 255, each product rounded to fp32)
+//!   x.view(T/2, 2, C, H/14/2, 2, 14, W/14/2, 2, 14)
+//!    .permute(0, 3, 6, 4, 7, 2, 1, 5, 8)         # (pair, hblock, wblock, mh, mw, channel, t, y, x)
+//!    .reshape(T/2 * (H/14) * (W/14), 3 * 2 * 14 * 14)
+//! so rows are the 2x2 merge blocks' patches (pair-major, then merge block row/column, then the position inside
+//! the block) and a row's 1176 values run (channel, time within the pair, y in the patch, x in the patch).
+//! A single picture is encoded as a frame pair of the same frame twice (`frames.unsqueeze(0).expand(2, ...)`).
+const std = @import("std");
+
+pub const MEAN = [3]f32{ 0.48145466, 0.4578275, 0.40821073 }; // CLIP's, from processor_config.json
+pub const STD = [3]f32{ 0.26862954, 0.26130258, 0.27577711 };
+pub const patch = 14;
+pub const merge = 2;
+pub const temporal = 2;
+pub const row_len = 3 * temporal * patch * patch;
+
+pub fn mean255() [3]f32 {
+    var out: [3]f32 = undefined;
+    for (MEAN, &out) |m, *o| o.* = m * @as(f32, 255.0);
+    return out;
+}
+
+pub fn std255() [3]f32 {
+    var out: [3]f32 = undefined;
+    for (STD, &out) |m, *o| o.* = m * @as(f32, 255.0);
+    return out;
+}
+
+pub fn rowCount(t: usize, h: usize, w: usize) usize {
+    return t / 2 * (h / patch) * (w / patch);
+}
+
+/// Fill `out` (rowCount * 1176 floats) from `frames` ([t,3,h,w] uint8).
+pub fn patches(out: []f32, frames: []const u8, t: usize, h: usize, w: usize) void {
+    std.debug.assert(t % 2 == 0 and h % 28 == 0 and w % 28 == 0);
+    std.debug.assert(frames.len == t * 3 * h * w and out.len == rowCount(t, h, w) * row_len);
+    const m255 = mean255();
+    const s255 = std255();
+    const gh = h / patch / merge;
+    const gw = w / patch / merge;
+    var row: usize = 0;
+    for (0..t / 2) |pair| {
+        for (0..gh) |hb| for (0..gw) |wb| for (0..merge) |mh| for (0..merge) |mw| {
+            var col: usize = 0;
+            for (0..3) |c| for (0..temporal) |tt| for (0..patch) |py| {
+                const y = (hb * merge + mh) * patch + py;
+                const base = (((pair * 2 + tt) * 3 + c) * h + y) * w + (wb * merge + mw) * patch;
+                const dst = out[row * row_len + col ..][0..patch];
+                for (dst, frames[base..][0..patch]) |*d, v| d.* = (@as(f32, @floatFromInt(v)) - m255[c]) / s255[c];
+                col += patch;
+            };
+            row += 1;
+        };
+    }
+}
+
+/// One fitted picture ([3, H, W] uint8) as the tower encodes it: the same frame twice (`unsqueeze(0).expand(2, ...)`).
+pub fn patchesImage(out: []f32, canvas: []const u8, h: usize, w: usize) void {
+    std.debug.assert(canvas.len == 3 * h * w and out.len == rowCount(2, h, w) * row_len);
+    const m255 = mean255();
+    const s255 = std255();
+    const gh = h / patch / merge;
+    const gw = w / patch / merge;
+    var row: usize = 0;
+    for (0..gh) |hb| for (0..gw) |wb| for (0..merge) |mh| for (0..merge) |mw| {
+        var col: usize = 0;
+        for (0..3) |c| for (0..temporal) |_| for (0..patch) |py| {
+            const y = (hb * merge + mh) * patch + py;
+            const base = (c * h + y) * w + (wb * merge + mw) * patch;
+            const dst = out[row * row_len + col ..][0..patch];
+            for (dst, canvas[base..][0..patch]) |*d, v| d.* = (@as(f32, @floatFromInt(v)) - m255[c]) / s255[c];
+            col += patch;
+        };
+        row += 1;
+    };
+}
+
+pub fn alloc(allocator: std.mem.Allocator, frames: []const u8, t: usize, h: usize, w: usize) ![]f32 {
+    const out = try allocator.alloc(f32, rowCount(t, h, w) * row_len);
+    patches(out, frames, t, h, w);
+    return out;
+}
+
+const fixtures = @import("fixtures.zig");
+
+test "patches match GlmVisionTower.patches bit for bit" {
+    const a = std.testing.allocator;
+    const text = try fixtures.read(a, "patches.txt", 1 << 16);
+    defer a.free(text);
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    var n: usize = 0;
+    while (lines.next()) |line| {
+        var t = std.mem.tokenizeScalar(u8, line, ' ');
+        _ = t.next();
+        const seed = try std.fmt.parseInt(u64, t.next().?, 10);
+        const T = try std.fmt.parseInt(usize, t.next().?, 10);
+        const H = try std.fmt.parseInt(usize, t.next().?, 10);
+        const W = try std.fmt.parseInt(usize, t.next().?, 10);
+        const rows = try std.fmt.parseInt(usize, t.next().?, 10);
+        const want = t.next().?;
+        const frames = try a.alloc(u8, T * 3 * H * W);
+        defer a.free(frames);
+        fixtures.lcgBytes(frames, seed);
+        const out = try alloc(a, frames, T, H, W);
+        defer a.free(out);
+        try std.testing.expectEqual(rows * row_len, out.len);
+        const got = fixtures.hexDigest(std.mem.sliceAsBytes(out));
+        try std.testing.expectEqualStrings(want, &got);
+        n += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 6), n);
+}
+
+test "a picture's patches equal those of the same frame twice" {
+    const a = std.testing.allocator;
+    const h = 56;
+    const w = 84;
+    var canvas: [3 * h * w]u8 = undefined;
+    fixtures.lcgBytes(&canvas, 321);
+    var doubled: [2 * 3 * h * w]u8 = undefined;
+    @memcpy(doubled[0 .. 3 * h * w], &canvas);
+    @memcpy(doubled[3 * h * w ..], &canvas);
+    const want = try alloc(a, &doubled, 2, h, w);
+    defer a.free(want);
+    const got = try a.alloc(f32, want.len);
+    defer a.free(got);
+    patchesImage(got, &canvas, h, w);
+    try std.testing.expectEqualSlices(f32, want, got);
+}
diff --git a/zig/src/vision/png.zig b/zig/src/vision/png.zig
new file mode 100644
index 00000000..2ca11db7
--- /dev/null
+++ b/zig/src/vision/png.zig
@@ -0,0 +1,334 @@
+//! PNG decoder with Pillow 12's modes, sample unpacking and `info["transparency"]` (all colour types and bit depths,
+//! Adam7, PLTE/tRNS, eXIf). Strict like `Image.open` + `verify()` + `load()`: every chunk's CRC is checked and the
+//! file must reach IEND.
+const std = @import("std");
+const raster = @import("raster.zig");
+const inflate = @import("inflate.zig");
+const Allocator = std.mem.Allocator;
+const Raster = raster.Raster;
+const Crc32 = std.hash.crc.@"CRC-32/ISO-HDLC";
+
+pub const Error = error{ Invalid, Animated } || Allocator.Error;
+
+pub const signature = "\x89PNG\r\n\x1a\n";
+
+pub fn matches(data: []const u8) bool {
+    return data.len >= 8 and std.mem.eql(u8, data[0..8], signature);
+}
+
+/// Size from IHDR (as `Image.open` reads it: a valid first chunk), or null.
+pub fn header(data: []const u8) ?struct { w: u32, h: u32 } {
+    if (!matches(data) or data.len < 8 + 12 + 13) return null;
+    if (std.mem.readInt(u32, data[8..12], .big) != 13 or !std.mem.eql(u8, data[12..16], "IHDR")) return null;
+    var crc = Crc32.init();
+    crc.update(data[12..29]);
+    if (crc.final() != std.mem.readInt(u32, data[29..33], .big)) return null;
+    const w = std.mem.readInt(u32, data[16..20], .big);
+    const h = std.mem.readInt(u32, data[20..24], .big);
+    if (w == 0 or h == 0 or w > 0x7fffffff or h > 0x7fffffff) return null;
+    if (data[26] != 0 or data[27] != 0 or data[28] > 1 or modeFor(data[25], data[24]) == null) return null;
+    return .{ .w = w, .h = h };
+}
+
+fn paeth(a: u8, b: u8, c: u8) u8 {
+    const p: i32 = @as(i32, a) + b - c;
+    const pa = @abs(p - a);
+    const pb = @abs(p - b);
+    const pc = @abs(p - c);
+    if (pa <= pb and pa <= pc) return a;
+    if (pb <= pc) return b;
+    return c;
+}
+
+fn unfilter(buf: []u8, rows: usize, row_bytes: usize, bpp: usize) Error!void {
+    // buf holds rows * (1 + row_bytes) bytes: filter type, then the row
+    var prev: ?[]u8 = null;
+    for (0..rows) |y| {
+        const line = buf[y * (1 + row_bytes) ..][0 .. 1 + row_bytes];
+        const ft = line[0];
+        const row = line[1..];
+        switch (ft) {
+            0 => {},
+            1 => for (bpp..row_bytes) |i| {
+                row[i] +%= row[i - bpp];
+            },
+            2 => if (prev) |p| for (0..row_bytes) |i| {
+                row[i] +%= p[i];
+            },
+            3 => for (0..row_bytes) |i| {
+                const a: u32 = if (i >= bpp) row[i - bpp] else 0;
+                const b: u32 = if (prev) |p| p[i] else 0;
+                row[i] +%= @intCast((a + b) >> 1);
+            },
+            4 => for (0..row_bytes) |i| {
+                const a: u8 = if (i >= bpp) row[i - bpp] else 0;
+                const b: u8 = if (prev) |p| p[i] else 0;
+                const c: u8 = if (i >= bpp and prev != null) prev.?[i - bpp] else 0;
+                row[i] +%= paeth(a, b, c);
+            },
+            else => return error.Invalid,
+        }
+        prev = row;
+    }
+}
+
+const Pass = struct { x0: u32, y0: u32, dx: u32, dy: u32 };
+const adam7 = [7]Pass{ .{ .x0 = 0, .y0 = 0, .dx = 8, .dy = 8 }, .{ .x0 = 4, .y0 = 0, .dx = 8, .dy = 8 }, .{ .x0 = 0, .y0 = 4, .dx = 4, .dy = 8 }, .{ .x0 = 2, .y0 = 0, .dx = 4, .dy = 4 }, .{ .x0 = 0, .y0 = 2, .dx = 2, .dy = 4 }, .{ .x0 = 1, .y0 = 0, .dx = 2, .dy = 2 }, .{ .x0 = 0, .y0 = 1, .dx = 1, .dy = 2 } };
+
+fn passDim(total: u32, start: u32, step: u32) u32 {
+    return if (total > start) (total - start + step - 1) / step else 0;
+}
+
+const Info = struct { w: u32, h: u32, depth: u8, ctype: u8, interlace: u8, mode: raster.Mode };
+
+fn modeFor(ctype: u8, depth: u8) ?raster.Mode {
+    return switch (ctype) {
+        0 => switch (depth) {
+            1 => .bit1,
+            2, 4, 8 => .l,
+            16 => .i16,
+            else => null,
+        },
+        2 => if (depth == 8 or depth == 16) .rgb else null,
+        3 => if (depth == 1 or depth == 2 or depth == 4 or depth == 8) .p else null,
+        4 => if (depth == 8 or depth == 16) (if (depth == 8) raster.Mode.la else raster.Mode.rgba) else null,
+        6 => if (depth == 8 or depth == 16) .rgba else null,
+        else => null,
+    };
+}
+
+fn channels(ctype: u8) usize {
+    return switch (ctype) {
+        0, 3 => 1,
+        2 => 3,
+        4 => 2,
+        6 => 4,
+        else => 0,
+    };
+}
+
+/// Write the unfiltered scanline `row` (packed samples) into pixel row `dst` positions x0 + k*dx.
+fn storeRow(r: *Raster, info: Info, row: []const u8, y: u32, x0: u32, dx: u32, count: u32) void {
+    const nb = r.mode.bytes();
+    const d = info.depth;
+    var k: u32 = 0;
+    while (k < count) : (k += 1) {
+        const x = x0 + k * dx;
+        const out = r.data[(@as(usize, y) * r.w + x) * nb ..][0..nb];
+        switch (info.ctype) {
+            0 => switch (d) {
+                16 => {
+                    out[0] = row[k * 2 + 1];
+                    out[1] = row[k * 2];
+                },
+                8 => out[0] = row[k],
+                else => {
+                    const per: u32 = 8 / d;
+                    const byte = row[k / per];
+                    const shift: u3 = @intCast(8 - d - (k % per) * d);
+                    const v = (byte >> shift) & ((@as(u8, 1) << @intCast(d)) - 1);
+                    out[0] = switch (d) {
+                        1 => if (v != 0) 255 else 0,
+                        2 => v * 85,
+                        4 => v * 17,
+                        else => unreachable,
+                    };
+                },
+            },
+            3 => switch (d) {
+                8 => out[0] = row[k],
+                else => {
+                    const per: u32 = 8 / d;
+                    const byte = row[k / per];
+                    const shift: u3 = @intCast(8 - d - (k % per) * d);
+                    out[0] = (byte >> shift) & ((@as(u8, 1) << @intCast(d)) - 1);
+                },
+            },
+            2 => if (d == 8) @memcpy(out, row[k * 3 ..][0..3]) else {
+                out[0] = row[k * 6];
+                out[1] = row[k * 6 + 2];
+                out[2] = row[k * 6 + 4];
+            },
+            4 => if (d == 8) @memcpy(out, row[k * 2 ..][0..2]) else {
+                // LA;16B -> RGBA: gray from the high byte, alpha from the high byte
+                out[0] = row[k * 4];
+                out[1] = row[k * 4];
+                out[2] = row[k * 4];
+                out[3] = row[k * 4 + 2];
+            },
+            6 => if (d == 8) @memcpy(out, row[k * 4 ..][0..4]) else {
+                out[0] = row[k * 8];
+                out[1] = row[k * 8 + 2];
+                out[2] = row[k * 8 + 4];
+                out[3] = row[k * 8 + 6];
+            },
+            else => unreachable,
+        }
+    }
+}
+
+pub fn decode(allocator: Allocator, data: []const u8, max_pixels: u64) Error!Raster {
+    if (!matches(data)) return error.Invalid;
+    var pos: usize = 8;
+    var info: ?Info = null;
+    var plte: ?[]const u8 = null;
+    var trns: ?[]const u8 = null;
+    var exif: ?[]const u8 = null;
+    var xmp: ?[]const u8 = null;
+    var idat: std.ArrayList(u8) = .empty;
+    defer idat.deinit(allocator);
+    var seen_idat = false;
+    var seen_iend = false;
+    var actl: ?u32 = null;
+    var fctl_before_idat = false;
+    while (pos + 12 <= data.len) {
+        const len = std.mem.readInt(u32, data[pos..][0..4], .big);
+        if (len > 0x7fffffff) return error.Invalid;
+        const typ = data[pos + 4 ..][0..4];
+        if (pos + 12 + len > data.len) return error.Invalid;
+        const body = data[pos + 8 ..][0..len];
+        const want_crc = std.mem.readInt(u32, data[pos + 8 + len ..][0..4], .big);
+        var crc = Crc32.init();
+        crc.update(typ);
+        crc.update(body);
+        if (crc.final() != want_crc) return error.Invalid;
+        pos += 12 + len;
+        if (info == null and !std.mem.eql(u8, typ, "IHDR")) return error.Invalid;
+        if (std.mem.eql(u8, typ, "IHDR")) {
+            if (info != null or len != 13) return error.Invalid;
+            const w = std.mem.readInt(u32, body[0..4], .big);
+            const h = std.mem.readInt(u32, body[4..8], .big);
+            const depth = body[8];
+            const ctype = body[9];
+            if (body[10] != 0 or body[11] != 0 or body[12] > 1) return error.Invalid;
+            if (w == 0 or h == 0 or w > 0x7fffffff or h > 0x7fffffff) return error.Invalid;
+            if (@as(u64, w) * h > max_pixels) return error.Invalid;
+            const mode = modeFor(ctype, depth) orelse return error.Invalid;
+            info = .{ .w = w, .h = h, .depth = depth, .ctype = ctype, .interlace = body[12], .mode = mode };
+        } else if (std.mem.eql(u8, typ, "PLTE")) {
+            if (!seen_idat) plte = body;
+        } else if (std.mem.eql(u8, typ, "tRNS")) {
+            if (!seen_idat) trns = body;
+        } else if (std.mem.eql(u8, typ, "IDAT")) {
+            seen_idat = true;
+            try idat.appendSlice(allocator, body);
+        } else if (std.mem.eql(u8, typ, "eXIf")) {
+            exif = body;
+        } else if (std.mem.eql(u8, typ, "acTL")) {
+            if (len != 8) return error.Invalid;
+            actl = std.mem.readInt(u32, body[0..4], .big);
+        } else if (std.mem.eql(u8, typ, "fcTL")) {
+            if (!seen_idat) fctl_before_idat = true;
+        } else if (std.mem.eql(u8, typ, "iTXt")) {
+            // XMP: keyword "XML:com.adobe.xmp", flags, language, translated keyword, text
+            const kw = "XML:com.adobe.xmp";
+            if (body.len > kw.len + 5 and std.mem.startsWith(u8, body, kw) and body[kw.len] == 0 and body[kw.len + 1] == 0 and body[kw.len + 2] == 0) {
+                if (std.mem.indexOfScalarPos(u8, body, kw.len + 3, 0)) |e1| {
+                    if (std.mem.indexOfScalarPos(u8, body, e1 + 1, 0)) |e2| xmp = body[e2 + 1 ..];
+                }
+            }
+        } else if (std.mem.eql(u8, typ, "IEND")) {
+            seen_iend = true;
+            break;
+        }
+    }
+    if (!seen_iend) return error.Invalid;
+    const im = info orelse return error.Invalid;
+    if (actl) |n| {
+        if (n != 0 and n <= 0x80000000) {
+            const frames = n + @as(u32, if (fctl_before_idat) 0 else 1);
+            if (frames != 1) return error.Animated;
+            return error.Invalid; // a one-frame APNG with a frame control chunk: not supported here
+        }
+    }
+    if (im.ctype == 3 and plte == null) {
+        // Pillow keeps its default (grey ramp) palette; kept below
+    }
+
+    // raw bytes needed
+    const bits_pp: usize = channels(im.ctype) * im.depth;
+    var total_raw: usize = 0;
+    if (im.interlace == 0) {
+        const rb = (@as(usize, im.w) * bits_pp + 7) / 8;
+        total_raw = (rb + 1) * im.h;
+    } else for (adam7) |p| {
+        const pw = passDim(im.w, p.x0, p.dx);
+        const ph = passDim(im.h, p.y0, p.dy);
+        if (pw == 0 or ph == 0) continue;
+        total_raw += ((@as(usize, pw) * bits_pp + 7) / 8 + 1) * ph;
+    }
+    const raw = try allocator.alloc(u8, total_raw);
+    defer allocator.free(raw);
+    const got = inflate.inflateZlib(allocator, idat.items, raw) catch |e| switch (e) {
+        error.OutOfMemory => return error.OutOfMemory,
+        else => return error.Invalid,
+    };
+    if (got != total_raw) return error.Invalid;
+
+    const nb = im.mode.bytes();
+    const pix = try allocator.alloc(u8, @as(usize, im.w) * im.h * nb);
+    errdefer allocator.free(pix);
+    var r: Raster = .{ .w = im.w, .h = im.h, .mode = im.mode, .data = pix, .allocator = allocator };
+    errdefer r.deinit();
+    const bpp = @max(1, bits_pp / 8);
+    if (im.interlace == 0) {
+        const rb = (@as(usize, im.w) * bits_pp + 7) / 8;
+        try unfilter(raw, im.h, rb, bpp);
+        for (0..im.h) |y| storeRow(&r, im, raw[y * (rb + 1) + 1 ..][0..rb], @intCast(y), 0, 1, im.w);
+    } else {
+        var off: usize = 0;
+        for (adam7) |p| {
+            const pw = passDim(im.w, p.x0, p.dx);
+            const ph = passDim(im.h, p.y0, p.dy);
+            if (pw == 0 or ph == 0) continue;
+            const rb = (@as(usize, pw) * bits_pp + 7) / 8;
+            try unfilter(raw[off..], ph, rb, bpp);
+            for (0..ph) |k| storeRow(&r, im, raw[off + k * (rb + 1) + 1 ..][0..rb], p.y0 + @as(u32, @intCast(k)) * p.dy, p.x0, p.dx, pw);
+            off += (rb + 1) * ph;
+        }
+    }
+
+    if (im.mode == .p) {
+        if (plte) |pl| r.setPalette(pl) else {
+            var ramp: [768]u8 = undefined;
+            for (0..256) |i| {
+                ramp[i * 3] = @intCast(i);
+                ramp[i * 3 + 1] = @intCast(i);
+                ramp[i * 3 + 2] = @intCast(i);
+            }
+            r.palette = ramp;
+        }
+    }
+    if (trns) |s| switch (im.mode) {
+        .p => {
+            // _simple_palette = ^\xff*\x00\xff*$ : one fully transparent entry, the rest opaque -> that index
+            var zeros: usize = 0;
+            var first_zero: usize = 0;
+            var others_opaque = true;
+            for (s, 0..) |b, i| {
+                if (b == 0) {
+                    if (zeros == 0) first_zero = i;
+                    zeros += 1;
+                } else if (b != 255) others_opaque = false;
+            }
+            if (zeros == 1 and others_opaque) {
+                r.transparency = .{ .index = @intCast(first_zero) };
+            } else {
+                var t: [256]u8 = @splat(255);
+                const n = @min(s.len, 256);
+                @memcpy(t[0..n], s[0..n]);
+                r.transparency = .{ .table = t };
+            }
+        },
+        .bit1, .l, .i16 => if (s.len >= 2) {
+            r.transparency = .{ .gray = std.mem.readInt(u16, s[0..2], .big) };
+        },
+        .rgb => if (s.len >= 6) {
+            r.transparency = .{ .rgb = .{ std.mem.readInt(u16, s[0..2], .big), std.mem.readInt(u16, s[2..4], .big), std.mem.readInt(u16, s[4..6], .big) } };
+        },
+        else => {},
+    };
+    if (exif) |e| r.exif = try allocator.dupe(u8, e);
+    if (xmp) |x| r.xmp = try allocator.dupe(u8, x);
+    return r;
+}
diff --git a/zig/src/vision/raster.zig b/zig/src/vision/raster.zig
new file mode 100644
index 00000000..d4cf9906
--- /dev/null
+++ b/zig/src/vision/raster.zig
@@ -0,0 +1,192 @@
+//! Decoded pictures as Pillow holds them after `load()` (mode + pixels + `info["transparency"]`), and the
+//! conversions images._decode applies: exif_transpose, convert("RGB"), or convert("RGBA") pasted on white.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+pub const Mode = enum {
+    bit1, // "1": one byte per pixel, 0 or 255
+    l, // "L"
+    la, // "LA": 2 bytes
+    p, // "P": palette index
+    rgb, // 3 bytes
+    rgba, // 4 bytes
+    cmyk, // 4 bytes (JPEG CMYK/YCCK, inverted Adobe samples already undone as Pillow does)
+    i16, // "I;16": 2 bytes little endian
+
+    pub fn bytes(m: Mode) usize {
+        return switch (m) {
+            .bit1, .l, .p => 1,
+            .la, .i16 => 2,
+            .rgb => 3,
+            .rgba, .cmyk => 4,
+        };
+    }
+    pub fn hasAlphaBand(m: Mode) bool {
+        return m == .la or m == .rgba;
+    }
+};
+
+/// `image.info["transparency"]`
+pub const Transparency = union(enum) {
+    none,
+    index: u8, // an int (P with one fully transparent entry; or an L/1 value)
+    gray: u16, // L, 1 or I;16 (PNG tRNS sample)
+    rgb: [3]u16, // RGB (PNG tRNS)
+    table: [256]u8, // P: one alpha per palette entry (bytes), entries past the table's length opaque (255)
+};
+
+pub const Raster = struct {
+    w: u32,
+    h: u32,
+    mode: Mode,
+    data: []u8, // w * h * mode.bytes()
+    palette: ?[768]u8 = null, // P only
+    transparency: Transparency = .none,
+    exif: ?[]u8 = null, // owned: the TIFF block (after any "Exif\0\0" header)
+    xmp: ?[]u8 = null, // owned
+    allocator: Allocator,
+
+    pub fn deinit(r: *Raster) void {
+        r.allocator.free(r.data);
+        if (r.exif) |e| r.allocator.free(e);
+        if (r.xmp) |x| r.allocator.free(x);
+    }
+
+    pub fn setPalette(r: *Raster, bytes: []const u8) void {
+        var p: [768]u8 = @splat(0);
+        @memcpy(p[0..@min(768, bytes.len)], bytes[0..@min(768, bytes.len)]);
+        r.palette = p;
+    }
+};
+
+/// Pillow's `DIV255(a)`: (tmp = a + 128, ((tmp >> 8) + tmp) >> 8)
+inline fn div255(a: u32) u8 {
+    const tmp = a + 128;
+    return @intCast(((tmp >> 8) + tmp) >> 8);
+}
+
+/// What PIL.Image.Exif says about tag 0x0112 in IFD0.
+pub const OrientationTag = union(enum) {
+    absent,
+    value: i64, // an integer (SHORT/LONG/SSHORT/SLONG)
+    other, // present, but not an int (BYTE, ...): no transform
+};
+
+fn typeSize(typ: u16) usize {
+    return switch (typ) {
+        1, 2, 6, 7 => 1,
+        3, 8 => 2,
+        4, 9, 11 => 4,
+        5, 10, 12 => 8,
+        else => 0,
+    };
+}
+
+/// The Orientation entry of a TIFF block (the EXIF payload after any `Exif\0\0` header), as Pillow reads it.
+pub fn exifOrientationTag(tiff_in: []const u8) OrientationTag {
+    const tiff = if (std.mem.startsWith(u8, tiff_in, "Exif\x00\x00")) tiff_in[6..] else tiff_in;
+    if (tiff.len < 8) return .absent;
+    const little = std.mem.eql(u8, tiff[0..4], "II*\x00");
+    if (!little and !std.mem.eql(u8, tiff[0..4], "MM\x00*")) return .absent;
+    const endian: std.builtin.Endian = if (little) .little else .big;
+    const off = std.mem.readInt(u32, tiff[4..8], endian);
+    if (off > tiff.len or tiff.len - off < 2) return .absent;
+    const n = std.mem.readInt(u16, tiff[off..][0..2], endian);
+    var found: OrientationTag = .absent;
+    var i: usize = 0;
+    while (i < n) : (i += 1) {
+        const e = @as(usize, off) + 2 + i * 12;
+        if (e + 12 > tiff.len) break;
+        const tag = std.mem.readInt(u16, tiff[e..][0..2], endian);
+        const typ = std.mem.readInt(u16, tiff[e + 2 ..][0..2], endian);
+        const count = std.mem.readInt(u32, tiff[e + 4 ..][0..4], endian);
+        const unit = typeSize(typ);
+        if (unit == 0) continue;
+        const size = @as(u64, count) * unit;
+        var data: []const u8 = tiff[e + 8 ..][0..4];
+        if (size > 4) {
+            const o = std.mem.readInt(u32, tiff[e + 8 ..][0..4], endian);
+            if (@as(u64, o) + size > tiff.len) continue; // Possibly corrupt EXIF data
+            data = tiff[o..][0..@intCast(size)];
+        } else data = data[0..@intCast(size)];
+        if (tag != 0x0112) continue;
+        if (count == 0) continue;
+        found = switch (typ) {
+            3 => .{ .value = std.mem.readInt(u16, data[0..2], endian) },
+            4 => .{ .value = std.mem.readInt(u32, data[0..4], endian) },
+            8 => .{ .value = std.mem.readInt(i16, data[0..2], endian) },
+            9 => .{ .value = std.mem.readInt(i32, data[0..4], endian) },
+            else => .other,
+        };
+    }
+    return found;
+}
+
+/// `tiff:Orientation(="|>)([0-9])` in XMP text (first match).
+pub fn xmpOrientation(xmp: []const u8) ?u8 {
+    if (!std.unicode.utf8ValidateSlice(xmp)) return null;
+    const key = "tiff:Orientation";
+    var from: usize = 0;
+    while (std.mem.indexOfPos(u8, xmp, from, key)) |i| {
+        var j = i + key.len;
+        if (j < xmp.len and xmp[j] == '>') {
+            j += 1;
+        } else if (j + 1 < xmp.len and xmp[j] == '=' and xmp[j + 1] == '"') {
+            j += 2;
+        } else {
+            from = i + 1;
+            continue;
+        }
+        if (j < xmp.len and xmp[j] >= '0' and xmp[j] <= '9') return xmp[j] - '0';
+        from = i + 1;
+    }
+    return null;
+}
+
+/// ImageOps.exif_transpose's orientation for a loaded picture: the EXIF Orientation, else XMP's tiff:Orientation;
+/// 1 when there is none or it is not 2..8.
+pub fn orientationOf(r: *const Raster) u8 {
+    var o: i64 = 1;
+    var have = false;
+    if (r.exif) |e| switch (exifOrientationTag(e)) {
+        .absent => {},
+        .value => |v| {
+            o = v;
+            have = true;
+        },
+        .other => {
+            have = true;
+            o = 1;
+        },
+    };
+    if (!have) if (r.xmp) |x| if (xmpOrientation(x)) |v| {
+        o = v;
+    };
+    return if (o >= 2 and o <= 8) @intCast(o) else 1;
+}
+
+/// Transpose an RGB buffer by an EXIF orientation (ImageOps.exif_transpose). Returns the new dims.
+pub fn orient(allocator: Allocator, rgb: []u8, w: u32, h: u32, o: u8) Allocator.Error!struct { data: []u8, w: u32, h: u32 } {
+    if (o <= 1 or o > 8) return .{ .data = rgb, .w = w, .h = h };
+    const swap = o >= 5;
+    const nw = if (swap) h else w;
+    const nh = if (swap) w else h;
+    const out = try allocator.alloc(u8, rgb.len);
+    errdefer allocator.free(out);
+    for (0..nh) |y| for (0..nw) |x| {
+        // source coordinates for output (x, y)
+        const sx: usize, const sy: usize = switch (o) {
+            2 => .{ w - 1 - x, y }, // FLIP_LEFT_RIGHT
+            3 => .{ w - 1 - x, h - 1 - y }, // ROTATE_180
+            4 => .{ x, h - 1 - y }, // FLIP_TOP_BOTTOM
+            5 => .{ y, x }, // TRANSPOSE
+            6 => .{ y, h - 1 - x }, // ROTATE_270
+            7 => .{ w - 1 - y, h - 1 - x }, // TRANSVERSE
+            8 => .{ w - 1 - y, x }, // ROTATE_90
+            else => unreachable,
+        };
+        @memcpy(out[(y * nw + x) * 3 ..][0..3], rgb[(sy * w + sx) * 3 ..][0..3]);
+    };
+    allocator.free(rgb);
+    return .{ .data = out, .w = nw, .h = nh };
+}
diff --git a/zig/src/vision/resize.zig b/zig/src/vision/resize.zig
new file mode 100644
index 00000000..f83a84ef
--- /dev/null
+++ b/zig/src/vision/resize.zig
@@ -0,0 +1,213 @@
+//! `fit()`: torchvision.transforms.v2.functional.resize(uint8 [3,H,W] CPU tensor, content, BICUBIC, antialias=True),
+//! then zero padding to the canvas -- bit-exact.
+//!
+//! What torch 2.13 runs for a channels-last uint8 frame (the layout the processor hands it) is the integer
+//! separable path of `_upsample_bicubic2d_aa` (Pillow's ImagingResample scheme): the weights are computed in
+//! float64 (`HelperInterpCubic::aa_filter`, a = -0.5, support = 2 * max(scale, 1)), normalised, and converted to
+//! int16 with a per-dimension fixed-point precision (the largest `p` < 22 such that 0.5 + wmax * 2^(p+1) < 2^15);
+//! the horizontal pass runs first and rounds/clamps to uint8 (`(sum + 2^(p-1)) >> p`), then the vertical pass.
+//! A pass whose size does not change is skipped. This is arithmetic on integers, so the AVX2 (x86) and NEON
+//! (aarch64) kernels and the scalar loop below agree bit for bit; the NEON header of torch 2.13 documents the
+//! same operations. (A W == 1 output would take a different, float kernel when the input is NCHW-contiguous;
+//! `fit` is only ever called with channels-last frames, so it never does.)
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const geometry = @import("geometry.zig");
+
+fn cubicAA(x_in: f64) f64 {
+    const a: f64 = -0.5;
+    const x = @abs(x_in);
+    if (x < 1.0) return ((a + 2.0) * x - (a + 3.0)) * x * x + 1.0;
+    if (x < 2.0) return (((x - 5.0) * x + 8.0) * x - 4.0) * a;
+    return 0.0;
+}
+
+const Coeffs = struct {
+    xmin: []i64,
+    size: []i64,
+    weights: []i16, // out * ksize
+    ksize: usize,
+    precision: u5,
+
+    fn deinit(c: Coeffs, a: Allocator) void {
+        a.free(c.xmin);
+        a.free(c.size);
+        a.free(c.weights);
+    }
+};
+
+fn truncToI64(x: f64) i64 {
+    return @intFromFloat(@trunc(x));
+}
+
+fn computeCoeffs(a: Allocator, in_size: usize, out_size: usize) Allocator.Error!Coeffs {
+    const scale: f64 = @as(f64, @floatFromInt(in_size)) / @as(f64, @floatFromInt(out_size));
+    const support: f64 = if (scale >= 1.0) 2.0 * scale else 2.0;
+    const invscale: f64 = if (scale >= 1.0) 1.0 / scale else 1.0;
+    const ksize: usize = @as(usize, @intFromFloat(@ceil(support))) * 2 + 1;
+    const xmin = try a.alloc(i64, out_size);
+    errdefer a.free(xmin);
+    const size = try a.alloc(i64, out_size);
+    errdefer a.free(size);
+    const fw = try a.alloc(f64, out_size * ksize);
+    defer a.free(fw);
+    @memset(fw, 0);
+    var wt_max: f64 = 0.0;
+    for (0..out_size) |i| {
+        const center = scale * (@as(f64, @floatFromInt(i)) + 0.5);
+        const lo = @max(truncToI64(center - support + 0.5), 0);
+        var xs = @min(truncToI64(center + support + 0.5), @as(i64, @intCast(in_size))) - lo;
+        xs = std.math.clamp(xs, 0, @as(i64, @intCast(ksize)));
+        xmin[i] = lo;
+        size[i] = xs;
+        const row = fw[i * ksize ..][0..ksize];
+        var total: f64 = 0.0;
+        var j: usize = 0;
+        while (j < xs) : (j += 1) {
+            const w = cubicAA((@as(f64, @floatFromInt(@as(i64, @intCast(j)) + lo)) - center + 0.5) * invscale);
+            row[j] = w;
+            total += w;
+        }
+        if (total != 0.0) {
+            j = 0;
+            while (j < xs) : (j += 1) {
+                row[j] /= total;
+                wt_max = @max(wt_max, row[j]);
+            }
+        }
+    }
+    var precision: u5 = 0;
+    while (precision < 22) : (precision += 1) {
+        const next: i64 = truncToI64(0.5 + wt_max * @as(f64, @floatFromInt(@as(u64, 1) << (precision + 1))));
+        if (next >= (1 << 15)) break;
+    }
+    const weights = try a.alloc(i16, out_size * ksize);
+    errdefer a.free(weights);
+    const mul: f64 = @floatFromInt(@as(u64, 1) << precision);
+    for (fw, weights) |w, *o| {
+        const v: i64 = if (w < 0) truncToI64(-0.5 + w * mul) else truncToI64(0.5 + w * mul);
+        o.* = @intCast(v);
+    }
+    return .{ .xmin = xmin, .size = size, .weights = weights, .ksize = ksize, .precision = precision };
+}
+
+inline fn clamp8(v: i32) u8 {
+    return @intCast(std.math.clamp(v, 0, 255));
+}
+
+/// Interleaved RGB8 [in_h, in_w, 3] -> [out_h, out_w, 3], torch's uint8 bicubic antialias resize.
+pub fn resizeRgb(a: Allocator, src: []const u8, in_h: usize, in_w: usize, out_h: usize, out_w: usize) Allocator.Error![]u8 {
+    std.debug.assert(src.len == in_h * in_w * 3);
+    if (in_h == out_h and in_w == out_w) return a.dupe(u8, src);
+    const need_h = in_w != out_w;
+    const need_v = in_h != out_h;
+    var mid: []u8 = undefined;
+    var mid_owned = false;
+    defer if (mid_owned) a.free(mid);
+    if (need_h) {
+        const c = try computeCoeffs(a, in_w, out_w);
+        defer c.deinit(a);
+        mid = try a.alloc(u8, in_h * out_w * 3);
+        mid_owned = true;
+        const init: i32 = @as(i32, 1) << (c.precision - 1);
+        for (0..in_h) |y| {
+            const line = src[y * in_w * 3 ..][0 .. in_w * 3];
+            const dst = mid[y * out_w * 3 ..][0 .. out_w * 3];
+            for (0..out_w) |x| {
+                const k = c.weights[x * c.ksize ..][0..c.ksize];
+                const base: usize = @intCast(c.xmin[x]);
+                const n: usize = @intCast(c.size[x]);
+                var s0: i32 = init;
+                var s1: i32 = init;
+                var s2: i32 = init;
+                for (0..n) |i| {
+                    const w: i32 = k[i];
+                    const p = line[(base + i) * 3 ..][0..3];
+                    s0 += w * p[0];
+                    s1 += w * p[1];
+                    s2 += w * p[2];
+                }
+                dst[x * 3] = clamp8(s0 >> c.precision);
+                dst[x * 3 + 1] = clamp8(s1 >> c.precision);
+                dst[x * 3 + 2] = clamp8(s2 >> c.precision);
+            }
+        }
+    } else {
+        mid = @constCast(src);
+    }
+    if (!need_v) {
+        if (mid_owned) {
+            mid_owned = false;
+            return mid;
+        }
+        return a.dupe(u8, mid);
+    }
+    const c = try computeCoeffs(a, in_h, out_h);
+    defer c.deinit(a);
+    const out = try a.alloc(u8, out_h * out_w * 3);
+    errdefer a.free(out);
+    const init: i32 = @as(i32, 1) << (c.precision - 1);
+    const row_len = out_w * 3;
+    for (0..out_h) |y| {
+        const k = c.weights[y * c.ksize ..][0..c.ksize];
+        const base: usize = @intCast(c.xmin[y]);
+        const n: usize = @intCast(c.size[y]);
+        const dst = out[y * row_len ..][0..row_len];
+        for (0..row_len) |j| {
+            var s: i32 = init;
+            for (0..n) |i| s += @as(i32, k[i]) * mid[(base + i) * row_len + j];
+            dst[j] = clamp8(s >> c.precision);
+        }
+    }
+    return out;
+}
+
+/// `fit(frame, canvas, content)`: the interleaved RGB8 `rgb` [h, w, 3] resized to `content` (when it differs),
+/// laid out planar into `out` ([3, canvas.h, canvas.w] uint8), zero padded right and bottom.
+pub fn fitInto(a: Allocator, rgb: []const u8, h: usize, w: usize, canvas: geometry.Size, content: geometry.Size, out: []u8) Allocator.Error!void {
+    std.debug.assert(out.len == 3 * @as(usize, canvas.h) * canvas.w);
+    @memset(out, 0);
+    const resized = try resizeRgb(a, rgb, h, w, content.h, content.w);
+    defer a.free(resized);
+    const plane = @as(usize, canvas.h) * canvas.w;
+    for (0..content.h) |y| for (0..content.w) |x| {
+        const px = resized[(y * content.w + x) * 3 ..][0..3];
+        const o = y * canvas.w + x;
+        out[o] = px[0];
+        out[plane + o] = px[1];
+        out[2 * plane + o] = px[2];
+    };
+}
+
+const fixtures = @import("fixtures.zig");
+
+test "bicubic antialias resize matches torch 2.13 on aarch64 (uint8, channels-last)" {
+    const a = std.testing.allocator;
+    const text = try fixtures.read(a, "resize.txt", 1 << 20);
+    defer a.free(text);
+    var lines = std.mem.tokenizeScalar(u8, text, '\n');
+    var n: usize = 0;
+    var bad: usize = 0;
+    while (lines.next()) |line| {
+        var t = std.mem.tokenizeScalar(u8, line, ' ');
+        const seed = try std.fmt.parseInt(u64, t.next().?, 10);
+        const h = try std.fmt.parseInt(usize, t.next().?, 10);
+        const w = try std.fmt.parseInt(usize, t.next().?, 10);
+        const oh = try std.fmt.parseInt(usize, t.next().?, 10);
+        const ow = try std.fmt.parseInt(usize, t.next().?, 10);
+        const want = t.next().?;
+        const src = try a.alloc(u8, h * w * 3);
+        defer a.free(src);
+        fixtures.lcgBytes(src, seed);
+        const got = try resizeRgb(a, src, h, w, oh, ow);
+        defer a.free(got);
+        const hex = fixtures.hexDigest(got);
+        if (!std.mem.eql(u8, want, &hex)) {
+            std.debug.print("RESIZE MISMATCH {d}x{d} -> {d}x{d}\n", .{ w, h, ow, oh });
+            bad += 1;
+        }
+        n += 1;
+    }
+    try std.testing.expectEqual(@as(usize, 0), bad);
+    try std.testing.expect(n >= 300);
+}
diff --git a/zig/src/vision/split.zig b/zig/src/vision/split.zig
new file mode 100644
index 00000000..575bf65a
--- /dev/null
+++ b/zig/src/vision/split.zig
@@ -0,0 +1,437 @@
+//! The server-side request splitting of tensorfold.vision.images.split_images and tensorfold.server.prompts
+//! (MediaMarks, has_images, tool_media_parts), as pure functions on the server's `json.Value`.
+//!
+//! `splitImages` turns image_url / video_url content parts of user messages (and tool results when `tool_media`)
+//! into the chat template's parts ({"type":"image","detail":..} / {"type":"video"}) and lists the sources in the
+//! order met. `MediaMarks` writes a per-request nonce mark into each such part (`part["tf_mark"]`), reads the
+//! rendered prompt back (marks removed, media order recovered) and lets the frontend escape quoted markers.
+const std = @import("std");
+const json = @import("json");
+const errors = @import("errors.zig");
+const expand_mod = @import("expand.zig");
+const items = @import("items.zig");
+const limits_mod = @import("limits.zig");
+const Value = json.Value;
+const Allocator = std.mem.Allocator;
+const Diag = errors.Diag;
+const Detail = items.Detail;
+
+const media_keys = [_][]const u8{ "image", "images", "image_url", "input_image", "audio", "input_audio", "video", "video_url" };
+
+pub const ImageSource = struct { url: []const u8, detail: Detail };
+pub const VideoSource = struct { url: []const u8 };
+pub const Source = union(enum) {
+    image: ImageSource,
+    video: VideoSource,
+
+    pub fn url(s: Source) []const u8 {
+        return switch (s) {
+            .image => |i| i.url,
+            .video => |v| v.url,
+        };
+    }
+};
+
+pub const Options = struct {
+    limits: limits_mod.ImageLimits = .default,
+    video_limits: limits_mod.VideoLimits = .default,
+    allow_urls: bool = false,
+    allow_videos: bool = false,
+    max_videos: ?u32 = null, // null: the shared video limits' (2)
+    tool_media: bool = false,
+};
+
+pub const Split = struct {
+    messages: Value, // the messages with media parts replaced by template parts (new objects)
+    sources: []Source,
+};
+
+/// Python len(str): code points (WTF-8 continuation bytes are not counted).
+pub fn codepoints(s: []const u8) usize {
+    var n: usize = 0;
+    for (s) |c| n += @intFromBool((c & 0xc0) != 0x80);
+    return n;
+}
+
+fn anyMedia(obj: Value, except: ?[]const u8) bool {
+    for (media_keys) |k| {
+        if (except) |e| if (std.mem.eql(u8, k, e)) continue;
+        if (obj.get(k)) |v| if (v.truthy()) return true;
+    }
+    return false;
+}
+
+fn isRole(role: []const u8) bool {
+    inline for (.{ "system", "developer", "user", "assistant", "tool" }) |r| if (std.mem.eql(u8, role, r)) return true;
+    return false;
+}
+
+/// `_check_source` (the URL rules): data URLs within the byte limit, else public HTTPS when URLs are on.
+pub fn checkImageUrl(url: []const u8, limits: limits_mod.ImageLimits, allow_urls: bool, diag: ?*Diag) errors.Error!void {
+    if (url.len == 0) return errors.fail(diag, "image source must contain a non-empty URL", .{});
+    if (std.mem.startsWith(u8, url, "data:")) {
+        if (codepoints(url) > limits.max_encoded_bytes * 3 + 256) return errors.fail(diag, "image data URL exceeds the encoded byte limit", .{});
+    } else if (!std.mem.startsWith(u8, url, "https://")) {
+        return errors.fail(diag, "images require data URLs or public HTTPS URLs", .{});
+    } else if (!allow_urls) {
+        return errors.fail(diag, "image URLs are off on this server; send the image as a data URL, or start the server with --vision-urls", .{});
+    } else if (codepoints(url) > limits.max_url_chars) {
+        return errors.fail(diag, "image URL is too long", .{});
+    }
+}
+
+fn imageSource(value: ?Value, opts: Options, diag: ?*Diag) errors.Error!ImageSource {
+    const v = value orelse .null;
+    const u = if (v == .object) v.strField("url") else null;
+    if (v != .object or u == null or u.?.len == 0) return errors.fail(diag, "image_url must contain a non-empty url string", .{});
+    var detail: Detail = .auto;
+    if (v.get("detail")) |d| {
+        const ds = if (d == .string) Detail.parse(d.string) else null;
+        if (ds == null) return errors.fail(diag, "image detail must be auto, low or high", .{});
+        detail = ds.?;
+    }
+    try checkImageUrl(u.?, opts.limits, opts.allow_urls, diag);
+    return .{ .url = u.?, .detail = detail };
+}
+
+fn videoSource(value: ?Value, opts: Options, diag: ?*Diag) errors.Error!VideoSource {
+    const v = value orelse .null;
+    const u = if (v == .object) v.strField("url") else null;
+    if (v != .object or u == null or u.?.len == 0) return errors.fail(diag, "video_url must contain a non-empty url string", .{});
+    const url = u.?;
+    if (std.mem.startsWith(u8, url, "data:")) {
+        if (codepoints(url) > opts.video_limits.max_encoded_bytes * 3 / 2 + 256) return errors.fail(diag, "video data URL exceeds the encoded byte limit", .{});
+    } else if (!std.mem.startsWith(u8, url, "https://")) {
+        return errors.fail(diag, "videos require data URLs or public HTTPS URLs", .{});
+    } else if (!opts.allow_urls) {
+        return errors.fail(diag, "video URLs are off on this server; send the video as a data URL, or start the server with --vision-urls", .{});
+    } else if (codepoints(url) > opts.video_limits.max_url_chars) {
+        return errors.fail(diag, "video URL is too long", .{});
+    }
+    return .{ .url = url };
+}
+
+fn strValue(a: Allocator, s: []const u8) Allocator.Error!Value {
+    return .{ .string = try a.dupe(u8, s) };
+}
+
+/// `split_images`. All new objects are allocated in `a` (use an arena); sources borrow the input's strings.
+pub fn splitImages(a: Allocator, messages: Value, opts: Options, diag: ?*Diag) (Allocator.Error || errors.Error)!Split {
+    if (messages != .array or messages.array.len == 0) return errors.fail(diag, "messages must be a non-empty list", .{});
+    const out = try a.alloc(Value, messages.array.len);
+    var sources: std.ArrayList(Source) = .empty;
+    var n_images: usize = 0;
+    var n_videos: usize = 0;
+    for (messages.array, out) |message, *slot| {
+        if (message != .object) return errors.fail(diag, "each message must be an object", .{});
+        const role_v = message.get("role");
+        if (role_v == null or role_v.? != .string or !isRole(role_v.?.string)) return errors.fail(diag, "invalid message role", .{});
+        const role = role_v.?.string;
+        if (anyMedia(message, null)) return errors.fail(diag, "images must be image_url parts in user message content", .{});
+        const content = message.get("content") orelse .null;
+        if (content == .null or content == .string) {
+            slot.* = .{ .object = try json.copyObject(a, message.object) };
+            continue;
+        }
+        if (content != .array) return errors.fail(diag, "message content must be text or an array of content parts", .{});
+        const parts = try a.alloc(Value, content.array.len);
+        for (content.array, parts) |part, *pslot| {
+            if (part != .object) return errors.fail(diag, "each content part must be an object", .{});
+            const kind: []const u8 = if (part.get("type")) |t| (if (t == .string) t.string else "") else "";
+            const kind_is_str = if (part.get("type")) |t| t == .string else false;
+            const user_ok = std.mem.eql(u8, role, "user") or (opts.tool_media and std.mem.eql(u8, role, "tool"));
+            if (kind_is_str and std.mem.eql(u8, kind, "text")) {
+                const t = part.get("text");
+                if (t == null or t.? != .string or anyMedia(part, null)) return errors.fail(diag, "text parts must contain a text string without media", .{});
+                pslot.* = .{ .object = try json.copyObject(a, part.object) };
+            } else if (kind_is_str and std.mem.eql(u8, kind, "video_url") and opts.allow_videos) {
+                if (!user_ok) return errors.fail(diag, "video_url parts are supported only in user messages", .{});
+                if (anyMedia(part, "video_url")) return errors.fail(diag, "video_url parts cannot contain other media", .{});
+                const most: u32 = if (opts.max_videos) |m| (if (m != 0) m else opts.video_limits.max_videos) else opts.video_limits.max_videos;
+                if (n_videos >= most) return errors.fail(diag, "a request supports at most {d} videos", .{most});
+                const src = try videoSource(part.get("video_url"), opts, diag);
+                try sources.append(a, .{ .video = src });
+                n_videos += 1;
+                const o = try json.newObject(a);
+                try o.put(a, "type", try strValue(a, "video"));
+                pslot.* = .{ .object = o };
+            } else if (kind_is_str and std.mem.eql(u8, kind, "image_url")) {
+                if (!user_ok) return errors.fail(diag, "image_url parts are supported only in user messages", .{});
+                if (anyMedia(part, "image_url")) return errors.fail(diag, "image_url parts cannot contain other media", .{});
+                if (n_images >= opts.limits.max_images) return errors.fail(diag, "a request supports at most {d} images", .{opts.limits.max_images});
+                const src = try imageSource(part.get("image_url"), opts, diag);
+                try sources.append(a, .{ .image = src });
+                n_images += 1;
+                const o = try json.newObject(a);
+                try o.put(a, "type", try strValue(a, "image"));
+                try o.put(a, "detail", try strValue(a, @tagName(src.detail)));
+                pslot.* = .{ .object = o };
+            } else {
+                return if (opts.allow_videos)
+                    errors.fail(diag, "content parts must be text, image_url or video_url; audio is unsupported", .{})
+                else
+                    errors.fail(diag, "content parts must be text or image_url; audio and video are unsupported", .{});
+            }
+        }
+        const m = try json.copyObject(a, message.object);
+        try m.put(a, "content", .{ .array = parts });
+        slot.* = .{ .object = m };
+    }
+    return .{ .messages = .{ .array = out }, .sources = try sources.toOwnedSlice(a) };
+}
+
+pub const Partitioned = struct {
+    images: []ImageSource,
+    videos: []VideoSource,
+};
+
+/// `prepare_images`' `sources = [sources[k] for k in order]` and the split into pictures and clips (each list in the
+/// order the template rendered them). `order` null: the sources as they came.
+pub fn partition(a: Allocator, sources: []const Source, order: ?[]const usize) Allocator.Error!Partitioned {
+    var images_: std.ArrayList(ImageSource) = .empty;
+    errdefer images_.deinit(a);
+    var videos_: std.ArrayList(VideoSource) = .empty;
+    errdefer videos_.deinit(a);
+    const n = if (order) |o| o.len else sources.len;
+    for (0..n) |i| {
+        const s = sources[if (order) |o| o[i] else i];
+        switch (s) {
+            .image => |im| try images_.append(a, im),
+            .video => |v| try videos_.append(a, v),
+        }
+    }
+    return .{ .images = try images_.toOwnedSlice(a), .videos = try videos_.toOwnedSlice(a) };
+}
+
+fn isMediaPart(p: Value) bool {
+    if (p != .object) return false;
+    return p.typeIs("image_url") or p.typeIs("video_url");
+}
+
+/// prompts.has_images: any message content part is an image_url or video_url.
+pub fn hasImages(messages: Value) bool {
+    if (messages != .array) return false;
+    for (messages.array) |m| {
+        if (m != .object) continue;
+        const c = m.get("content") orelse continue;
+        if (c != .array) continue;
+        for (c.array) |p| if (isMediaPart(p)) return true;
+    }
+    return false;
+}
+
+/// prompts.tool_media_parts: for a server without a vision frontend: messages whose pictures and clips are all in
+/// tool results, those parts as the template's bare media parts; null when there are none or a non-tool message has some.
+pub fn toolMediaParts(a: Allocator, messages: Value) Allocator.Error!?Value {
+    if (!hasImages(messages)) return null;
+    const out = try a.alloc(Value, messages.array.len);
+    for (messages.array, out) |m, *slot| {
+        const content = if (m == .object) m.get("content") else null;
+        var has = false;
+        if (content) |c| if (c == .array) for (c.array) |p| {
+            if (isMediaPart(p)) has = true;
+        };
+        if (!has) {
+            slot.* = m;
+            continue;
+        }
+        const role = m.strField("role");
+        if (role == null or !std.mem.eql(u8, role.?, "tool")) return null;
+        const parts = try a.alloc(Value, content.?.array.len);
+        for (content.?.array, parts) |p, *ps| {
+            if (isMediaPart(p)) {
+                const t = p.strField("type").?;
+                const o = try json.newObject(a);
+                try o.put(a, "type", try strValue(a, t[0 .. t.len - "_url".len]));
+                ps.* = .{ .object = o };
+            } else ps.* = p;
+        }
+        const mo = try json.copyObject(a, m.object);
+        try mo.put(a, "content", .{ .array = parts });
+        slot.* = .{ .object = mo };
+    }
+    return .{ .array = out };
+}
+
+/// `MediaMarks`: each picture's and clip's place in the rendered prompt, matched by a per-request nonce mark.
+pub const MediaMarks = struct {
+    nonce: [16]u8, // 16 lower-case hex digits
+    count: usize,
+
+    /// Writes `tf_mark` into every image/video part of `template` (mutating it) in message order.
+    pub fn init(a: Allocator, template: Value, nonce_bytes: [8]u8) Allocator.Error!MediaMarks {
+        var m: MediaMarks = .{ .nonce = std.fmt.bytesToHex(nonce_bytes, .lower), .count = 0 };
+        if (template != .array) return m;
+        for (template.array) |message| {
+            const c = message.get("content") orelse continue;
+            if (c != .array) continue;
+            for (c.array) |part| {
+                if (part == .object and (part.typeIs("image") or part.typeIs("video"))) {
+                    const mark = try std.fmt.allocPrint(a, "\x00tf-media-{s}:{d}\x00", .{ m.nonce, m.count });
+                    try part.object.put(a, "tf_mark", .{ .string = mark });
+                    m.count += 1;
+                }
+            }
+        }
+        return m;
+    }
+
+    /// Whether the request carries pictures or clips at all.
+    pub fn wanted(template: Value) bool {
+        if (template != .array) return false;
+        for (template.array) |m| {
+            const c = m.get("content") orelse continue;
+            if (c != .array) continue;
+            for (c.array) |p| if (p == .object and (p.typeIs("image") or p.typeIs("video"))) return true;
+        }
+        return false;
+    }
+
+    pub const Read = struct {
+        text: []u8,
+        order: []usize, // the media's indices in the order the template rendered them
+
+        pub fn deinit(r: *Read, a: Allocator) void {
+            a.free(r.text);
+            a.free(r.order);
+        }
+    };
+
+    /// `read(text, escape)`: the text without its marks and the media order. With `escape`, markers the conversation
+    /// only quotes are neutralized first (the frontend's `escape_quoted`, given where this request's marks end).
+    pub fn read(m: MediaMarks, a: Allocator, text: []const u8, escape: bool, diag: ?*Diag) (Allocator.Error || errors.Error)!Read {
+        var prefix_buf: [40]u8 = undefined;
+        const prefix = std.fmt.bufPrint(&prefix_buf, "\x00tf-media-{s}:", .{m.nonce}) catch unreachable;
+        var order: std.ArrayList(usize) = .empty;
+        errdefer order.deinit(a);
+        var ends: std.ArrayList(usize) = .empty;
+        defer ends.deinit(a);
+        var starts: std.ArrayList(usize) = .empty;
+        defer starts.deinit(a);
+        var pos: usize = 0;
+        while (std.mem.indexOfPos(u8, text, pos, prefix)) |at| {
+            var j = at + prefix.len;
+            const ds = j;
+            while (j < text.len and text[j] >= '0' and text[j] <= '9') j += 1;
+            if (j == ds or j >= text.len or text[j] != 0) {
+                pos = at + 1;
+                continue;
+            }
+            const k = std.fmt.parseInt(usize, text[ds..j], 10) catch std.math.maxInt(usize);
+            try order.append(a, k);
+            try starts.append(a, at);
+            try ends.append(a, j + 1);
+            pos = j + 1;
+        }
+        for (order.items) |k| if (k >= m.count) return errors.fail(diag, "the rendered prompt's media marks do not match the request's media", .{});
+        const source: []u8 = if (escape) try expand_mod.escapeQuoted(a, text, ends.items) else try a.dupe(u8, text);
+        defer a.free(source);
+        // sub: drop the marks. After escaping, the marks still stand where they were, so find them again.
+        var out: std.ArrayList(u8) = .empty;
+        errdefer out.deinit(a);
+        var p2: usize = 0;
+        while (std.mem.indexOfPos(u8, source, p2, prefix)) |at| {
+            var j = at + prefix.len;
+            const ds = j;
+            while (j < source.len and source[j] >= '0' and source[j] <= '9') j += 1;
+            if (j == ds or j >= source.len or source[j] != 0) {
+                try out.appendSlice(a, source[p2 .. at + 1]);
+                p2 = at + 1;
+                continue;
+            }
+            try out.appendSlice(a, source[p2..at]);
+            p2 = j + 1;
+        }
+        try out.appendSlice(a, source[p2..]);
+        return .{ .text = try out.toOwnedSlice(a), .order = try order.toOwnedSlice(a) };
+    }
+};
+
+const fixtures = @import("fixtures.zig");
+
+fn buildOptions(o: json.Object) Options {
+    var opts: Options = .{};
+    if (o.get("max_images")) |v| opts.limits.max_images = @intCast(v.int64().?);
+    if (o.get("allow_urls")) |v| opts.allow_urls = v.bool;
+    if (o.get("allow_videos")) |v| opts.allow_videos = v.bool;
+    if (o.get("tool_media")) |v| opts.tool_media = v.bool;
+    if (o.get("max_videos")) |v| opts.max_videos = if (v == .null) null else @intCast(v.int64().?);
+    return opts;
+}
+
+test "split_images, the Python messages and results" {
+    const a = std.testing.allocator;
+    const text = try fixtures.read(a, "split.json", 1 << 22);
+    defer a.free(text);
+    var arena: std.heap.ArenaAllocator = .init(a);
+    defer arena.deinit();
+    const aa = arena.allocator();
+    const parsed = switch (try json.parseText(aa, text)) {
+        .ok => |v| v,
+        .err => |e| {
+            std.debug.print("fixture: {s}\n", .{e});
+            return error.BadFixture;
+        },
+    };
+    var n: usize = 0;
+    for (parsed.array) |c| {
+        const opts = buildOptions(c.get("opts").?.object.*);
+        var diag: Diag = .{};
+        const res = splitImages(aa, c.get("in").?, opts, &diag);
+        if (c.get("error")) |want| {
+            try std.testing.expectError(error.Input, res);
+            try std.testing.expectEqualStrings(want.string, diag.message());
+        } else {
+            const got = try res;
+            try std.testing.expect(json.equal(c.get("out").?, got.messages));
+            const want_src = c.get("sources").?.array;
+            try std.testing.expectEqual(want_src.len, got.sources.len);
+            for (want_src, got.sources) |w, g| {
+                try std.testing.expectEqualStrings(w.get("url").?.string, g.url());
+                switch (g) {
+                    .image => |im| try std.testing.expectEqualStrings(w.get("detail").?.string, @tagName(im.detail)),
+                    .video => try std.testing.expect(w.get("detail") == null),
+                }
+            }
+        }
+        n += 1;
+    }
+    try std.testing.expect(n >= 40);
+}
+
+test "MediaMarks, the Python template and rendered text" {
+    const a = std.testing.allocator;
+    const text = try fixtures.read(a, "marks.json", 1 << 22);
+    defer a.free(text);
+    var arena: std.heap.ArenaAllocator = .init(a);
+    defer arena.deinit();
+    const aa = arena.allocator();
+    const parsed = switch (try json.parseText(aa, text)) {
+        .ok => |v| v,
+        .err => return error.BadFixture,
+    };
+    for (parsed.array) |c| {
+        var diag: Diag = .{};
+        const template = try json.deepCopy(aa, c.get("template").?);
+        try std.testing.expectEqual(c.get("wanted").?.bool, MediaMarks.wanted(template));
+        var nonce: [8]u8 = undefined;
+        _ = try std.fmt.hexToBytes(&nonce, c.get("nonce").?.string);
+        const marks = try MediaMarks.init(aa, template, nonce);
+        try std.testing.expect(json.equal(c.get("marked").?, template));
+        try std.testing.expectEqual(@as(usize, @intCast(c.get("count").?.int64().?)), marks.count);
+        for (c.get("reads").?.array) |r| {
+            const escape = r.get("escape").?.bool;
+            const res = marks.read(aa, r.get("text").?.string, escape, &diag);
+            if (r.get("error")) |want| {
+                try std.testing.expectError(error.Input, res);
+                try std.testing.expectEqualStrings(want.string, diag.message());
+            } else {
+                const got = try res;
+                try std.testing.expectEqualStrings(r.get("out").?.string, got.text);
+                const want_order = r.get("order").?.array;
+                try std.testing.expectEqual(want_order.len, got.order.len);
+                for (want_order, got.order) |w, g| try std.testing.expectEqual(@as(usize, @intCast(w.int64().?)), g);
+            }
+        }
+    }
+}
