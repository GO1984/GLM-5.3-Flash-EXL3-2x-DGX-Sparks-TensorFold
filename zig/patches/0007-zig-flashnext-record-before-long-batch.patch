zig-engine fix: send a long batch's record before the batch itself (TP control link), so a prompt larger than the
socket buffers cannot deadlock rank 0 (blocked writing the batch) against rank 1 (waiting for the record)
Apply from the checkout root with: git apply 0007-zig-flashnext-record-before-long-batch.patch

diff --git a/zig/src/families/flashnext/cuda_mirror.zig b/zig/src/families/flashnext/cuda_mirror.zig
index f02b489..c0bbd08 100644
--- a/zig/src/families/flashnext/cuda_mirror.zig
+++ b/zig/src/families/flashnext/cuda_mirror.zig
@@ -704,9 +704,11 @@ pub const Records = struct {
         if (r.idle) try r.link.send(.request, &.{}); // rank 1 back on the wire
         r.idle = false;
         const k = packRecord(&r.rec, kind, bytes);
-        // the long batch is on the link before its record: rank 1 reads it after the record
-        if (k == .on_link) try r.link.send(.round, bytes);
+        // The record first, then a long batch on the link: rank 1 reads the link only after the record, so a batch larger
+        // than the sockets can buffer (a few-hundred-thousand-token prompt) would block this write while rank 1 waits for
+        // the record, and neither rank would move.
         try r.wire.put(r.wire.ptr, &r.rec);
+        if (k == .on_link) try r.link.send(.round, bytes);
     }
 
