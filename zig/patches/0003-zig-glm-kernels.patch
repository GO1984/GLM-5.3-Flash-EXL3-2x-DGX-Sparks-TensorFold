+        commit();
+    }
+    for (int it = 0; it < per; ++it) {
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < per) load(next % STAGES, g0 + next);
+        commit();
+        const unsigned char* p = stage(it % STAGES);
