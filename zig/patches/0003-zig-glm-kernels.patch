+// Zig CUDA launch pattern authored by jschmied (TensorFold PR #443).
+// Prefill: w = bf16(fma(q, s, b)), one fp32 chain over K; chunk-invariant bits, not decode's (replies prefill again).
+
+#include <cstdint>
+#include <cuda_runtime.h>
